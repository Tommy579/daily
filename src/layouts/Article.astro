---
import type { MarkdownHeading } from 'astro';
import Base from './Base.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { SITE } from '../consts';
import { readingTime } from '../utils/readingTime';
import { formatDate, textUrl, themeLabel, typeLabel, fr, type Texte } from '../utils/textes';

interface Props {
  entry: Texte;
  headings: MarkdownHeading[];
  prev?: Texte;
  next?: Texte;
}

const { entry, headings, prev, next } = Astro.props;
const {
  title,
  subtitle,
  summary,
  date,
  updated,
  type,
  themes,
  series,
  epigraph,
  epigraphAuthor,
  dropcap,
  references,
} = entry.data;

const minutes = readingTime(entry.body ?? '');
const tocItems = headings.filter((h) => h.depth === 2 || h.depth === 3);
const showToc = tocItems.length >= 3;
const url = new URL(textUrl(entry), Astro.site);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  alternativeHeadline: subtitle,
  description: summary,
  datePublished: date.toISOString(),
  dateModified: (updated ?? date).toISOString(),
  inLanguage: 'fr-FR',
  url: url.href,
  mainEntityOfPage: url.href,
  image: new URL('/og-default.png', Astro.site).href,
  keywords: themes.map(themeLabel).join(', '),
  timeRequired: `PT${minutes}M`,
  author: { '@type': 'Person', name: SITE.author },
  publisher: { '@type': 'Organization', name: SITE.title, url: Astro.site?.href },
};
---

<Base
  title={title}
  description={summary}
  type="article"
  publishedTime={date}
  modifiedTime={updated}
  tags={themes.map(themeLabel)}
  jsonLd={jsonLd}
>
  <ReadingProgress />

  <div class:list={['article-shell', { 'has-toc': showToc }]}>
    <article class="article" data-pagefind-body>
      <header class="article-header">
        <p class="meta kicker">
          <a href={`/textes/?type=${type}`} data-pagefind-ignore>{typeLabel(type)}</a>
          {
            series && (
              <>
                <span class="sep" aria-hidden="true">·</span>
                <span class="series">{series}</span>
              </>
            )
          }
        </p>

        <h1 data-pagefind-meta="title">{fr(title)}</h1>
        {subtitle && <p class="subtitle">{fr(subtitle)}</p>}

        <p class="meta byline" data-pagefind-ignore>
          <time datetime={date.toISOString()}>{formatDate(date)}</time>
          <span class="sep" aria-hidden="true">·</span>
          <span>{minutes} min de lecture</span>
          {
            themes.length > 0 && (
              <>
                <span class="sep" aria-hidden="true">·</span>
                <span class="themes">
                  {themes.map((t, i) => (
                    <>
                      {i > 0 && ', '}
                      <a href={`/themes/${t}/`}>{themeLabel(t)}</a>
                    </>
                  ))}
                </span>
              </>
            )
          }
          <span class="sep" aria-hidden="true">·</span>
          <a
            href={`/rappels/?presetTitle=${encodeURIComponent(`Lire : ${title}`)}&presetType=texte&presetTarget=${encodeURIComponent(textUrl(entry))}`}
            class="article-reminder-link"
            title="Programmer une alerte pour lire ce texte"
          >
            ⏰ Rappel
          </a>
        </p>
      </header>

      {
        epigraph && (
          <figure class="epigraph">
            <blockquote>
              <p>{fr(epigraph)}</p>
            </blockquote>
            {epigraphAuthor && <figcaption>— {epigraphAuthor}</figcaption>}
          </figure>
        )
      }

      <div class:list={['prose', { dropcap, 'prose--dialogue': type === 'dialogue' }]}>
        <slot />
      </div>

      {
        references.length > 0 && (
          <aside class="further" aria-labelledby="pour-aller-plus-loin">
            <h2 id="pour-aller-plus-loin" class="label">Pour aller plus loin</h2>
            <ul>
              {references.map((r) => (
                <li>
                  {r.author && <span class="ref-author">{r.author}, </span>}
                  {r.url ? (
                    <a href={r.url} rel="noopener" target="_blank">
                      <cite>{fr(r.title)}</cite>
                    </a>
                  ) : (
                    <cite>{fr(r.title)}</cite>
                  )}
                  {r.note && <span class="ref-note">. {fr(r.note)}</span>}
                </li>
              ))}
            </ul>
          </aside>
        )
      }

      <footer class="article-end meta" data-pagefind-ignore>
        <span class="fin" aria-hidden="true">∎</span>
        {updated && <span>Mis à jour le {formatDate(updated)}</span>}
      </footer>
    </article>

    {
      showToc && (
        <aside class="toc-wrap" data-pagefind-ignore>
          <TableOfContents headings={headings} />
        </aside>
      )
    }
  </div>

  {
    (prev || next) && (
      <nav class="container article-nav" aria-label="Autres textes" data-pagefind-ignore>
        {next ? (
          <a class="nav-card" href={textUrl(next)} rel="next">
            <span class="label">← Plus récent</span>
            <span class="nav-title">{fr(next.data.title)}</span>
          </a>
        ) : (
          <span />
        )}
        {prev ? (
          <a class="nav-card nav-card--right" href={textUrl(prev)} rel="prev">
            <span class="label">Plus ancien →</span>
            <span class="nav-title">{fr(prev.data.title)}</span>
          </a>
        ) : (
          <span />
        )}
      </nav>
    )
  }
</Base>

<style>
  .article {
    width: min(100% - 2 * var(--gutter), var(--measure));
    margin-inline: auto;
  }

  /* Sommaire dans la marge droite, sur grand écran uniquement */
  .toc-wrap { display: none; }

  @media (min-width: 78rem) {
    .article-shell.has-toc {
      display: grid;
      grid-template-columns: 1fr minmax(0, var(--measure)) 1fr;
      column-gap: 3.5rem;
      padding-inline: var(--gutter);
    }
    .has-toc .article { grid-column: 2; width: 100%; }
    .has-toc .toc-wrap {
      display: block;
      grid-column: 3;
      grid-row: 1;
      max-width: 15rem;
      padding-top: 15rem;
    }
    .has-toc .toc-wrap > :global(.toc) {
      position: sticky;
      top: 3rem;
    }
  }

  .article-header {
    padding-block: clamp(2.5rem, 2rem + 4vw, 5rem) 2.5rem;
  }

  .kicker { margin: 0 0 1.1rem; }
  .kicker a {
    color: var(--fg);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: .12em;
    font-size: .72rem;
  }
  .series { font-style: italic; font-family: var(--font-text); font-size: .95rem; letter-spacing: 0; }

  h1 { margin-bottom: .9rem; }

  .subtitle {
    font-size: clamp(1.2rem, 1.05rem + .6vw, 1.45rem);
    font-style: italic;
    line-height: 1.4;
    color: var(--muted);
    margin: 0 0 1.5rem;
    text-wrap: balance;
  }

  .byline { margin: 0; }
  .themes a { color: var(--fg); text-decoration-color: color-mix(in srgb, currentColor 35%, transparent); }

  /* Épigraphe : italique, alignée à droite */
  .epigraph {
    margin: 0 0 3.5rem auto;
    max-width: 36ch;
    text-align: right;
  }
  .epigraph blockquote {
    margin: 0;
    padding: 0;
    border: 0;
    font-style: italic;
    color: var(--muted);
    line-height: 1.55;
  }
  .epigraph figcaption {
    margin-top: .6rem;
    font-family: var(--font-ui);
    font-size: .8rem;
    letter-spacing: .04em;
    color: var(--muted);
  }

  /* Pour aller plus loin */
  .further {
    margin-top: 4rem;
    padding: 1.6rem 1.75rem;
    background: var(--soft);
    border-radius: var(--radius);
    font-size: .92em;
    transition: background-color var(--dur) ease;
  }
  .further h2 { margin: 0 0 1rem; }
  .further ul { margin: 0; padding: 0; list-style: none; display: grid; gap: .7rem; }
  .further li { line-height: 1.5; }
  .ref-author { font-variant: small-caps; letter-spacing: .03em; }
  .ref-note { color: var(--muted); }

  .article-end {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 3rem;
  }
  .fin { color: var(--fg); font-size: .9rem; }

  /* Navigation précédent / suivant */
  .article-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }
  .nav-card {
    display: grid;
    gap: .4rem;
    text-decoration: none;
    padding: .25rem 0;
  }
  .nav-card--right { text-align: right; }
  .nav-title {
    font-weight: 600;
    line-height: 1.3;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
    text-underline-offset: .2em;
    transition: text-decoration-color .15s ease;
    text-wrap: balance;
  }
  .nav-card:hover .nav-title { text-decoration-color: currentColor; }

  @media (max-width: 34rem) {
    .article-nav { grid-template-columns: 1fr; }
    .nav-card--right { text-align: left; }
  }
</style>
