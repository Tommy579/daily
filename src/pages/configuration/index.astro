---
import Base from '../../layouts/Base.astro';
import { getCourses } from '../../utils/courses';

const subjects = getCourses();
const totalCourses = subjects.length;
const totalFiles = subjects.reduce((acc, s) => acc + s.stats.totalFiles, 0);
---

<Base
  title="Configuration & Paramètres"
  description="Centralisez l'import de votre emploi du temps, vos supports de cours et la planification de vos notifications."
>
  <div class="container config-page" data-config-root>
    <header class="page-header">
      <p class="label"><a href="/">Accueil</a> / Paramètres</p>
      <h1>Configuration & Paramètres</h1>
      <p class="lede">
        Paramétrez vos fichiers de cours, votre calendrier et vos alertes. Toutes vos préférences sont conservées automatiquement sur votre machine pendant un an.
      </p>
    </header>

    <div class="config-grid">
      <!-- 1. Fichiers de Cours & Révisions -->
      <section class="config-card">
        <div class="card-head">
          <span class="card-icon">📂</span>
          <div>
            <h2>Mes Fichiers de Cours & Révisions</h2>
            <p class="meta">Gestion des supports académiques et fiches de révisions importés directement par vos soins</p>
          </div>
        </div>

        <div class="storage-info">
          <p>
            Vos supports de cours et fiches de révisions sont importés directement depuis votre dossier <strong>Semestre 5</strong>. Aucune dépendance externe ni compte en ligne n'est nécessaire : tous vos cours sont disponibles instantanément et consultables dans la visionneuse.
          </p>
          <div class="storage-status-list meta">
            <div class="storage-row">
              <span>Matières répertoriées :</span>
              <strong>{totalCourses} matières actives</strong>
            </div>
            <div class="storage-row">
              <span>Fichiers disponibles :</span>
              <strong>{totalFiles} documents importés</strong>
            </div>
            <div class="storage-row">
              <span>Source :</span>
              <code>Semestre 5 (Local)</code>
            </div>
          </div>
        </div>

        <div class="card-actions">
          <a href="/cours/" class="btn btn-primary">Consulter mes cours</a>
          <a href="/rappels/?presetType=cours" class="btn">Programmer un rappel de cours</a>
        </div>
      </section>

      <!-- 2. Emploi du temps & Calendrier iCal -->
      <section class="config-card">
        <div class="card-head">
          <span class="card-icon">🗓️</span>
          <div>
            <h2>Emploi du temps universitaire</h2>
            <p class="meta">Importation de votre calendrier iCal (.ics) ou flux en ligne</p>
          </div>
        </div>

        <form id="form-timetable" class="config-form">
          <div class="form-group">
            <label for="ics-file" class="field-label">Importer un fichier iCalendar (.ics) :</label>
            <input type="file" id="ics-file" accept=".ics,text/calendar" />
            <span class="help-text">Exportez votre emploi du temps depuis votre ENT (ADE Campus, Zimbra, Google Agenda) et déposez-le ici.</span>
          </div>

          <div class="form-group">
            <label for="ics-url" class="field-label">Ou URL de synchronisation iCal / RSS / Webcal :</label>
            <input
              type="url"
              id="ics-url"
              placeholder="https://ent.universite.fr/agenda/export.ics"
            />
          </div>

          <div class="status-box" id="timetable-status-box">
            <div class="status-indicator">
              <span class="dot-status dot-active" id="timetable-dot"></span>
              <strong id="timetable-status-title">Calendrier actif</strong>
            </div>
            <p class="status-desc meta" id="timetable-status-desc">
              Calendrier par défaut chargé (Licence Philosophie / L2-L3).
            </p>
          </div>

          <div class="card-actions">
            <button type="submit" class="btn btn-primary">Mettre à jour le calendrier</button>
            <button type="button" class="btn btn-danger-subtle" id="btn-reset-timetable">Réinitialiser par défaut</button>
          </div>
        </form>
      </section>

      <!-- 3. Planification des notifications récurrentes -->
      <section class="config-card">
        <div class="card-head">
          <span class="card-icon">⏰</span>
          <div>
            <h2>Rappels récurrents automatiques</h2>
            <p class="meta">Programmation de révisions ou de lectures sans avoir à créer chaque alerte à la main</p>
          </div>
        </div>

        <form id="form-reminders" class="config-form">
          <div class="form-checkbox main-toggle">
            <input type="checkbox" id="reminders-enabled" checked />
            <label for="reminders-enabled"><strong>Activer les rappels récurrents automatiques</strong></label>
          </div>

          <div class="form-group">
            <label for="reminders-frequency" class="field-label">Fréquence des rappels :</label>
            <select id="reminders-frequency">
              <option value="daily">Quotidienne (1 fois par jour)</option>
              <option value="twice_daily">Pluri-quotidienne (2 fois par jour — matin & soir)</option>
              <option value="weekly">Hebdomadaire (1 fois par semaine)</option>
            </select>
          </div>

          <div class="form-group">
            <label for="reminders-content" class="field-label">Contenu suggéré lors du rappel :</label>
            <select id="reminders-content">
              <option value="random">Aléatoire (au choix : texte philosophique ou cours)</option>
              <option value="philo">Uniquement un texte philosophique</option>
              <option value="cours">Uniquement un support de cours</option>
            </select>
          </div>

          <div class="times-subgrid" id="times-container">
            <div class="form-group" id="group-time-1">
              <label for="reminder-time-1" class="field-label" id="label-time-1">Heure de notification :</label>
              <input type="time" id="reminder-time-1" value="09:00" />
            </div>

            <div class="form-group" id="group-time-2" style="display: none;">
              <label for="reminder-time-2" class="field-label">Deuxième heure (soir) :</label>
              <input type="time" id="reminder-time-2" value="18:30" />
            </div>

            <div class="form-group" id="group-weekday" style="display: none;">
              <label for="reminder-weekday" class="field-label">Jour de la semaine :</label>
              <select id="reminder-weekday">
                <option value="1">Lundi</option>
                <option value="2">Mardi</option>
                <option value="3">Mercredi</option>
                <option value="4">Jeudi</option>
                <option value="5">Vendredi</option>
                <option value="6">Samedi</option>
                <option value="0">Dimanche</option>
              </select>
            </div>
          </div>

          <div class="card-actions">
            <button type="submit" class="btn btn-primary">Enregistrer la planification</button>
            <a href="/rappels/" class="btn">Voir la page Rappels →</a>
          </div>
        </form>
      </section>

      <!-- 4. Données, Cookies & Sauvegarde 365j -->
      <section class="config-card">
        <div class="card-head">
          <span class="card-icon">💾</span>
          <div>
            <h2>Persistance des données & Cookies</h2>
            <p class="meta">Gestion du stockage local et des cookies longue durée</p>
          </div>
        </div>

        <div class="storage-info">
          <p>
            Toutes vos informations (calendrier personnalisé, préférences de révision et notifications) sont sauvegardées sur une durée de <strong>365 jours</strong> dans vos cookies sécurisés et votre stockage navigateur.
          </p>
          <div class="storage-status-list meta">
            <div class="storage-row">
              <span>Cookies actifs :</span>
              <strong id="cookie-status">Vérification...</strong>
            </div>
            <div class="storage-row">
              <span>Notifications navigateur :</span>
              <strong id="notif-perm-status">Vérification...</strong>
            </div>
          </div>
        </div>

        <div class="card-actions">
          <button type="button" class="btn" id="btn-request-notif-perm">Activer les notifications navigateur</button>
          <button type="button" class="btn btn-danger-subtle" id="btn-clear-all-data">Effacer toutes mes données</button>
        </div>
      </section>
    </div>
  </div>
</Base>

<script>
  import {
    STORAGE_KEYS,
    savePersistent,
    loadPersistent,
    savePersistentJSON,
    loadPersistentJSON,
    deleteCookie,
    type ReminderScheduleConfig,
  } from '../../utils/persistence';

  function initConfigPage() {
    // ----------------------------------------------------
    // 1. GESTION DE L'EMPLOI DU TEMPS
    // ----------------------------------------------------
    const timetableForm = document.getElementById('form-timetable') as HTMLFormElement;
    const icsFileInput = document.getElementById('ics-file') as HTMLInputElement;
    const icsUrlInput = document.getElementById('ics-url') as HTMLInputElement;
    const timetableDesc = document.getElementById('timetable-status-desc');
    const btnResetTimetable = document.getElementById('btn-reset-timetable');

    const savedIcsUrl = loadPersistent(STORAGE_KEYS.TIMETABLE_URL);
    if (savedIcsUrl && icsUrlInput) icsUrlInput.value = savedIcsUrl;

    const savedIcsRaw = loadPersistent(STORAGE_KEYS.TIMETABLE_ICS);
    if (savedIcsRaw && timetableDesc) {
      timetableDesc.textContent = 'Emploi du temps personnalisé actif (importé par vos soins).';
    }

    timetableForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      if (icsFileInput.files && icsFileInput.files[0]) {
        const file = icsFileInput.files[0];
        const reader = new FileReader();
        reader.onload = (evt) => {
          const content = evt.target?.result as string;
          if (content) {
            savePersistent(STORAGE_KEYS.TIMETABLE_ICS, content);
            if (timetableDesc) timetableDesc.textContent = `Fichier "${file.name}" importé avec succès.`;
            alert('Emploi du temps mis à jour à partir de votre fichier .ics !');
          }
        };
        reader.readAsText(file);
      } else if (icsUrlInput.value.trim()) {
        savePersistent(STORAGE_KEYS.TIMETABLE_URL, icsUrlInput.value.trim());
        if (timetableDesc) timetableDesc.textContent = `Flux distant configuré : ${icsUrlInput.value.trim()}`;
        alert('URL de flux d’emploi du temps enregistrée.');
      }
    });

    btnResetTimetable?.addEventListener('click', () => {
      if (confirm('Voulez-vous réinitialiser l’emploi du temps avec le calendrier par défaut de la faculté ?')) {
        savePersistent(STORAGE_KEYS.TIMETABLE_ICS, '');
        savePersistent(STORAGE_KEYS.TIMETABLE_URL, '');
        deleteCookie(STORAGE_KEYS.TIMETABLE_ICS);
        deleteCookie(STORAGE_KEYS.TIMETABLE_URL);
        if (icsFileInput) icsFileInput.value = '';
        if (icsUrlInput) icsUrlInput.value = '';
        if (timetableDesc) timetableDesc.textContent = 'Calendrier par défaut chargé (Licence Philosophie / L2-L3).';
        alert('Emploi du temps réinitialisé aux cours standards.');
      }
    });

    // ----------------------------------------------------
    // 3. PLANIFICATION DES NOTIFICATIONS RÉCURRENTES
    // ----------------------------------------------------
    const remindersForm = document.getElementById('form-reminders') as HTMLFormElement;
    const remindersEnabled = document.getElementById('reminders-enabled') as HTMLInputElement;
    const remindersFreq = document.getElementById('reminders-frequency') as HTMLSelectElement;
    const remindersContent = document.getElementById('reminders-content') as HTMLSelectElement;
    const time1Input = document.getElementById('reminder-time-1') as HTMLInputElement;
    const time2Input = document.getElementById('reminder-time-2') as HTMLInputElement;
    const weekdayInput = document.getElementById('reminder-weekday') as HTMLSelectElement;

    const groupTime2 = document.getElementById('group-time-2');
    const groupWeekday = document.getElementById('group-weekday');
    const labelTime1 = document.getElementById('label-time-1');

    function updateFreqUI() {
      const val = remindersFreq.value;
      if (val === 'twice_daily') {
        if (groupTime2) groupTime2.style.display = 'grid';
        if (groupWeekday) groupWeekday.style.display = 'none';
        if (labelTime1) labelTime1.textContent = 'Première heure (matin) :';
      } else if (val === 'weekly') {
        if (groupTime2) groupTime2.style.display = 'none';
        if (groupWeekday) groupWeekday.style.display = 'grid';
        if (labelTime1) labelTime1.textContent = 'Heure du rappel :';
      } else {
        if (groupTime2) groupTime2.style.display = 'none';
        if (groupWeekday) groupWeekday.style.display = 'none';
        if (labelTime1) labelTime1.textContent = 'Heure quotidienne :';
      }
    }

    remindersFreq?.addEventListener('change', updateFreqUI);

    const defaultRemindersConfig: ReminderScheduleConfig = {
      enabled: true,
      frequency: 'daily',
      contentPreference: 'random',
      times: ['09:00'],
      weekDay: 1,
    };

    const savedReminders = loadPersistentJSON<ReminderScheduleConfig>(
      STORAGE_KEYS.REMINDERS_CONFIG,
      defaultRemindersConfig
    );

    if (remindersEnabled) remindersEnabled.checked = savedReminders.enabled !== false;
    if (remindersFreq) remindersFreq.value = savedReminders.frequency || 'daily';
    if (remindersContent) remindersContent.value = savedReminders.contentPreference || 'random';
    if (time1Input && savedReminders.times?.[0]) time1Input.value = savedReminders.times[0];
    if (time2Input && savedReminders.times?.[1]) time2Input.value = savedReminders.times[1];
    if (weekdayInput && savedReminders.weekDay !== undefined) weekdayInput.value = String(savedReminders.weekDay);
    updateFreqUI();

    remindersForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      const times: string[] = [time1Input.value || '09:00'];
      if (remindersFreq.value === 'twice_daily') {
        times.push(time2Input.value || '18:30');
      }

      const config: ReminderScheduleConfig = {
        enabled: remindersEnabled.checked,
        frequency: remindersFreq.value as any,
        contentPreference: remindersContent.value as any,
        times,
        weekDay: parseInt(weekdayInput.value || '1', 10),
      };

      savePersistentJSON(STORAGE_KEYS.REMINDERS_CONFIG, config);

      if (Notification.permission !== 'granted') {
        Notification.requestPermission();
      }

      alert('Planification des rappels enregistrée avec succès !');
    });

    // ----------------------------------------------------
    // 4. STATUT COOKIES & NOTIFICATIONS
    // ----------------------------------------------------
    const cookieStatus = document.getElementById('cookie-status');
    const notifPermStatus = document.getElementById('notif-perm-status');
    const btnRequestNotif = document.getElementById('btn-request-notif-perm');
    const btnClearAll = document.getElementById('btn-clear-all-data');

    if (cookieStatus) {
      cookieStatus.textContent = 'Opérationnels (conservation 365j activée)';
    }

    function checkNotifPerm() {
      if (!('Notification' in window)) {
        if (notifPermStatus) notifPermStatus.textContent = 'Non supportées par ce navigateur';
        return;
      }
      const perm = Notification.permission;
      if (notifPermStatus) {
        if (perm === 'granted') notifPermStatus.textContent = 'Autorisées ✅';
        else if (perm === 'denied') notifPermStatus.textContent = 'Bloquées ❌';
        else notifPermStatus.textContent = 'En attente d’autorisation ⚠️';
      }
      if (btnRequestNotif) {
        btnRequestNotif.style.display = perm === 'granted' ? 'none' : 'inline-block';
      }
    }

    checkNotifPerm();

    btnRequestNotif?.addEventListener('click', async () => {
      if ('Notification' in window) {
        await Notification.requestPermission();
        checkNotifPerm();
      }
    });

    btnClearAll?.addEventListener('click', () => {
      if (confirm('Attention : cela supprimera tous vos cours personnalisés, vos rappels et votre calendrier. Continuer ?')) {
        Object.values(STORAGE_KEYS).forEach((k) => {
          deleteCookie(k);
          localStorage.removeItem(k);
        });
        alert('Toutes les données locales ont été réinitialisées.');
        window.location.reload();
      }
    });
  }

  document.addEventListener('astro:page-load', initConfigPage);
</script>

<style>
  .config-page {
    padding-bottom: 5rem;
  }
  .config-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    margin-top: 2rem;
  }
  .config-card {
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.75rem;
  }
  .card-head {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line);
  }
  .card-icon {
    font-size: 2rem;
    line-height: 1;
  }
  .card-head h2 {
    margin: 0 0 0.25rem;
    font-size: 1.25rem;
  }
  .config-form {
    display: grid;
    gap: 1.25rem;
  }
  .form-group {
    display: grid;
    gap: 0.4rem;
  }
  .field-label {
    font-family: var(--font-ui);
    font-size: 0.85rem;
    font-weight: 600;
  }
  .config-form input[type="text"],
  .config-form input[type="url"],
  .config-form input[type="time"],
  .config-form input[type="file"],
  .config-form select {
    padding: 0.65rem 0.85rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg);
    color: var(--fg);
    font-family: inherit;
    font-size: 0.95rem;
  }
  .help-text {
    font-size: 0.8rem;
    color: var(--muted);
    line-height: 1.4;
  }
  .form-checkbox {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    cursor: pointer;
    font-size: 0.9rem;
  }
  .main-toggle {
    background: var(--soft);
    padding: 0.85rem 1rem;
    border-radius: var(--radius);
  }
  .times-subgrid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
    background: var(--soft);
    padding: 1rem;
    border-radius: var(--radius);
  }
  .status-box {
    background: var(--soft);
    padding: 1rem 1.25rem;
    border-radius: var(--radius);
    border-left: 3px solid var(--fg);
  }
  .status-indicator {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.35rem;
  }
  .dot-status {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }
  .dot-active {
    background: #10b981;
  }
  .status-desc {
    margin: 0;
    font-size: 0.85rem;
  }
  .storage-info {
    font-size: 0.95rem;
    line-height: 1.5;
    margin-bottom: 1.5rem;
  }
  .storage-status-list {
    margin-top: 1rem;
    display: grid;
    gap: 0.5rem;
    background: var(--soft);
    padding: 1rem;
    border-radius: var(--radius);
  }
  .storage-row {
    display: flex;
    justify-content: space-between;
  }
  .card-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    align-items: center;
    margin-top: 0.5rem;
  }
  .btn {
    padding: 0.6rem 1.25rem;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--bg);
    color: var(--fg);
    cursor: pointer;
    font-family: var(--font-ui);
    font-size: 0.9rem;
    text-decoration: none;
    transition: all 0.15s ease;
    display: inline-flex;
    align-items: center;
  }
  .btn:hover {
    border-color: var(--fg);
  }
  .btn-primary {
    background: var(--fg);
    color: var(--bg);
    border-color: var(--fg);
  }
  .btn-primary:hover {
    opacity: 0.85;
  }
  .btn-danger-subtle {
    color: #ef4444;
    border-color: rgba(239, 68, 68, 0.3);
  }
  .btn-danger-subtle:hover {
    background: rgba(239, 68, 68, 0.08);
    border-color: #ef4444;
  }
</style>
