---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { getCourses } from '../../utils/courses';
import { AMBIANCE_OPTIONS } from '../../utils/supabase';
import { url } from '../../utils/url';

const subjects = getCourses();
const totalCourses = subjects.length;
const totalFiles = subjects.reduce((acc, s) => acc + s.stats.totalFiles, 0);
---

<Base
  title="Configuration & Paramètres"
  description="Centralisez l'import de votre emploi du temps, vos supports de cours et la planification de vos notifications."
>
  <div class="container container--wide app-page config-page" data-config-root>
    <header class="page-header config-hero">
      <div class="config-hero-top">
        <div>
          <p class="crumbs"><a href={url('/')}>Accueil</a> / Paramètres</p>
          <h1 class="config-title">Configuration & Paramètres</h1>
          <p class="config-motto">
            Paramétrez vos fichiers de cours, votre calendrier et vos alertes en local sur votre machine.
          </p>
        </div>
      </div>
    </header>

    <div class="config-grid">
      <!-- 0. Couleur d'ambiance du site (associée au compte Supabase) -->
      <section class="panel config-card" id="ambiance-settings">
        <div class="card-head">
          <span class="icon-tile"><Icon name="palette" size={20} /></span>
          <div>
            <h2>Couleur d’ambiance du site</h2>
            <p class="meta">Teintes pastel en mode clair et déclinaisons sombres en mode nuit, enregistrées sur votre compte Supabase</p>
          </div>
        </div>

        <div class="config-form">
          <p class="storage-info" style="margin-bottom: 0.25rem;">
            Choisissez l’atmosphère visuelle de votre espace de lecture. Ce réglage est rattaché à votre compte Supabase : chaque compte conserve sa propre couleur d’ambiance sur tous ses appareils, avec une version pastel en thème clair et une version profonde en thème sombre.
          </p>

          <div class="ambiance-grid" id="ambiance-options-grid" role="radiogroup" aria-label="Couleur d'ambiance du site">
            {AMBIANCE_OPTIONS.map((opt) => (
              <button
                type="button"
                class="ambiance-card"
                data-ambiance-choice={opt.id}
                role="radio"
                aria-checked={opt.id === 'default' ? 'true' : 'false'}
              >
                <div class="ambiance-swatches" aria-hidden="true">
                  <span
                    class="swatch-half swatch-light"
                    style={`background: ${opt.lightBg}; border-color: ${opt.lightSoft};`}
                    title="Aperçu mode clair (pastel)"
                  >
                    <span class="swatch-dot" style={`background: ${opt.lightAccent};`}></span>
                    <span class="swatch-tag">Clair</span>
                  </span>
                  <span
                    class="swatch-half swatch-dark"
                    style={`background: ${opt.darkBg}; border-color: ${opt.darkSoft};`}
                    title="Aperçu mode sombre"
                  >
                    <span class="swatch-dot" style={`background: ${opt.darkAccent};`}></span>
                    <span class="swatch-tag">Sombre</span>
                  </span>
                </div>
                <div class="ambiance-card-body">
                  <div class="ambiance-card-title-row">
                    <strong class="ambiance-card-name">{opt.label}</strong>
                    <span class="ambiance-check" aria-hidden="true">
                      <Icon name="check" size={14} />
                    </span>
                  </div>
                  <span class="ambiance-card-sub meta">{opt.subtitle}</span>
                </div>
              </button>
            ))}
          </div>

          <div class="status-box" id="ambiance-status-box">
            <div class="status-indicator">
              <span class="dot-status dot-active" id="ambiance-dot"></span>
              <strong id="ambiance-status-title">Couleur associée à votre compte Supabase</strong>
            </div>
            <p class="status-desc meta" id="ambiance-status-desc">
              Chargement du paramètre de couleur depuis votre compte...
            </p>
          </div>

          <div class="card-actions">
            <button type="button" class="btn btn--sm" id="btn-toggle-dark-preview">
              <Icon name="sun" size={14} />
              Basculer clair / sombre pour prévisualiser
            </button>
            <button type="button" class="btn btn--sm" id="btn-reset-ambiance">
              Rétablir le blanc de base
            </button>
          </div>
        </div>
      </section>

      <!-- 1. Fichiers de Cours & Révisions -->
      <section class="panel config-card">
        <div class="card-head">
          <span class="icon-tile"><Icon name="folder" size={20} /></span>
          <div>
            <h2>Mes Fichiers de Cours & Révisions</h2>
            <p class="meta">Gestion des supports académiques et fiches de révisions importés en local</p>
          </div>
        </div>

        <div class="storage-info">
          <p>
            Vos supports de cours et fiches de révisions sont disponibles instantanément et consultables dans la visionneuse.
          </p>
          <div class="storage-status-list meta">
            <div class="storage-row">
              <span>Matières répertoriées :</span>
              <strong>{totalCourses} matières actives</strong>
            </div>
            <div class="storage-row">
              <span>Fichiers disponibles :</span>
              <strong>{totalFiles} documents disponibles</strong>
            </div>
          </div>
        </div>

        <div class="card-actions">
          <a href={url('/cours/')} class="btn btn--primary btn--sm">Consulter mes cours</a>
          <a href={url('/rappels/?presetType=cours')} class="btn btn--sm">Programmer un rappel de cours</a>
        </div>
      </section>

      <!-- 2. Emploi du temps & Calendrier iCal -->
      <section class="panel config-card" id="calendar-settings">
        <div class="card-head">
          <span class="icon-tile"><Icon name="calendar" size={20} /></span>
          <div>
            <h2>Emploi du temps universitaire</h2>
            <p class="meta">Importation de votre calendrier iCal (.ics) ou flux en ligne</p>
          </div>
        </div>

        <form id="form-timetable" class="config-form">
          <div class="form-group">
            <label for="ics-file" class="field-label">Importer un fichier iCalendar (.ics) :</label>
            <input type="file" id="ics-file" accept=".ics,text/calendar" />
            <span class="help-text">Exportez votre emploi du temps depuis votre ENT (ADE Campus, Zimbra, Google Agenda) et déposez-le ici.</span>
          </div>

          <div class="form-group">
            <label for="ics-url" class="field-label">Ou URL de synchronisation iCal / RSS / Webcal :</label>
            <input
              type="url"
              id="ics-url"
              placeholder="https://ent.universite.fr/agenda/export.ics"
            />
          </div>

          <div class="status-box" id="timetable-status-box">
            <div class="status-indicator">
              <span class="dot-status dot-active" id="timetable-dot"></span>
              <strong id="timetable-status-title">Calendrier actif</strong>
            </div>
            <p class="status-desc meta" id="timetable-status-desc">
              Synchronisé avec votre compte. Aucun calendrier iCal importé.
            </p>
          </div>

          <div class="card-actions">
            <button type="submit" class="btn btn--primary btn--sm">Mettre à jour le calendrier</button>
            <button type="button" class="btn btn--danger btn--sm" id="btn-reset-timetable">Effacer le calendrier importé</button>
          </div>
        </form>
      </section>

      <!-- 3. Planification des notifications récurrentes -->
      <section class="panel config-card">
        <div class="card-head">
          <span class="icon-tile"><Icon name="bell" size={20} /></span>
          <div>
            <h2>Rappels récurrents automatiques</h2>
            <p class="meta">Programmation de révisions ou de lectures sans avoir à créer chaque alerte à la main</p>
          </div>
        </div>

        <form id="form-reminders" class="config-form">
          <div class="form-group">
            <label class="form-checkbox main-toggle">
              <input type="checkbox" id="reminders-enabled" checked />
              <span>Activer la programmation automatique des alertes</span>
            </label>
          </div>

          <div class="form-group">
            <label for="reminders-frequency" class="field-label">Fréquence des rappels :</label>
            <select id="reminders-frequency">
              <option value="daily">Quotidienne (chaque jour)</option>
              <option value="twice_daily">Deux fois par jour (Matin & Soir)</option>
              <option value="weekly">Hebdomadaire (un jour précis de la semaine)</option>
            </select>
          </div>

          <div class="form-group">
            <label for="reminders-content" class="field-label">Type de contenu proposé lors du rappel :</label>
            <select id="reminders-content">
              <option value="all">Aléatoire équilibré (Textes & Cours)</option>
              <option value="philo">Textes de philosophie uniquement</option>
              <option value="cours">Supports de cours uniquement</option>
            </select>
          </div>

          <div class="times-subgrid">
            <div class="form-group" id="group-time-1">
              <label for="reminder-time-1" class="field-label" id="label-time-1">Heure quotidienne :</label>
              <input type="time" id="reminder-time-1" value="09:00" />
            </div>

            <div class="form-group" id="group-time-2" style="display: none;">
              <label for="reminder-time-2" class="field-label">Deuxième heure (soir) :</label>
              <input type="time" id="reminder-time-2" value="18:30" />
            </div>

            <div class="form-group" id="group-weekday" style="display: none;">
              <label for="reminder-weekday" class="field-label">Jour de la semaine :</label>
              <select id="reminder-weekday">
                <option value="1">Lundi</option>
                <option value="2">Mardi</option>
                <option value="3">Mercredi</option>
                <option value="4">Jeudi</option>
                <option value="5">Vendredi</option>
                <option value="6">Samedi</option>
                <option value="7">Dimanche</option>
              </select>
            </div>
          </div>

          <div class="card-actions">
            <button type="submit" class="btn btn--primary btn--sm">Enregistrer mes préférences de rappels</button>
            <a href={url('/rappels/')} class="btn btn--sm">Tester les rappels</a>
          </div>
        </form>
      </section>

      <!-- 4. Comptes & Synchronisation Supabase -->
      <section class="panel config-card" id="supabase-settings">
        <div class="card-head">
          <span class="icon-tile"><Icon name="database" size={20} /></span>
          <div>
            <h2>Comptes & Synchronisation Supabase</h2>
            <p class="meta">Connexion à votre projet Supabase pour l'espace personnel, les cours privés et l'emploi du temps</p>
          </div>
        </div>

        <form id="form-supabase" class="config-form">
          <div class="form-group">
            <label for="supabase-url" class="field-label">Project URL (Supabase) :</label>
            <input
              type="url"
              id="supabase-url"
              placeholder="https://votre-projet.supabase.co"
              autocomplete="off"
              spellcheck="false"
            />
            <span class="help-text">Trouvez cette URL dans votre tableau de bord Supabase : <em>Project Settings &gt; Data API &gt; Project URL</em>.</span>
          </div>

          <div class="form-group">
            <label for="supabase-anon-key" class="field-label">Clé publique (Publishable / Anon key) :</label>
            <input
              type="text"
              id="supabase-anon-key"
              placeholder="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
              autocomplete="off"
              spellcheck="false"
            />
            <span class="help-text">Clé publique conçue pour le navigateur. <strong>Ne collez jamais</strong> la clé <code>service_role</code> (secrète).</span>
          </div>

          <div class="status-box" id="supabase-status-box">
            <div class="status-indicator">
              <span class="dot-status" id="supabase-dot"></span>
              <strong id="supabase-status-title">État de la configuration</strong>
            </div>
            <p class="status-desc meta" id="supabase-status-desc">
              Vérification des paramètres Supabase...
            </p>
          </div>

          <div class="card-actions" style="flex-wrap: wrap;">
            <button type="submit" class="btn btn--primary btn--sm">Enregistrer les identifiants</button>
            <button type="button" class="btn btn--sm" id="btn-test-supabase">Tester la connexion</button>
            <button type="button" class="btn btn--sm" id="btn-reset-supabase-default" title="Réinitialiser avec les clés officielles du projet Marges">Restaurer clés officielles</button>
            <a href={url('/espace/')} class="btn btn--sm">
              <Icon name="user" size={14} />
              Accéder à mon espace
            </a>
          </div>
        </form>
      </section>

      <!-- 5. Persistance des données & Cookies -->
      <section class="panel config-card">
        <div class="card-head">
          <span class="icon-tile"><Icon name="book" size={20} /></span>
          <div>
            <h2>Persistance des données & Cookies</h2>
            <p class="meta">Gestion du stockage local et des préférences de votre session</p>
          </div>
        </div>

        <div class="storage-info">
          <p>
            Toutes vos informations (calendrier personnalisé, préférences de révision et notifications) sont sauvegardées sur une durée de <strong>365 jours</strong> dans vos cookies sécurisés et votre stockage navigateur.
          </p>
          <div class="storage-status-list meta">
            <div class="storage-row">
              <span>Cookies actifs :</span>
              <strong id="cookie-status">Vérification...</strong>
            </div>
            <div class="storage-row">
              <span>Notifications navigateur :</span>
              <strong id="notif-perm-status">Vérification...</strong>
            </div>
          </div>
        </div>

        <div class="card-actions" style="flex-wrap: wrap; gap: 0.5rem;">
          <button type="button" class="btn btn--sm" id="btn-request-notif-perm">Activer les notifications navigateur</button>
          <button type="button" class="btn btn--danger btn--sm" id="btn-delete-all-courses" title="Supprimer tous les cours de votre compte Supabase et du stockage local">
            <Icon name="trash" size={14} />
            Supprimer tous les cours
          </button>
          <button type="button" class="btn btn--danger btn--sm" id="btn-clear-all-data">Effacer toutes mes données</button>
        </div>
      </section>
    </div>
  </div>
</Base>

<script>
  import {
    STORAGE_KEYS,
    savePersistent,
    loadPersistent,
    deleteCookie,
    type ReminderScheduleConfig,
  } from '../../utils/persistence';
  import {
    getUnifiedReminderConfig,
    saveUnifiedReminderConfig,
  } from '../../utils/reminders';
  import {
    fetchCalendarFromUrl,
    syncTimetableState,
  } from '../../utils/timetable';
  import {
    getCurrentUser,
    syncTimetableToSupabase,
    clearUserScheduleEvents,
    clearUserCourses,
    getSupabaseCredentials,
    saveSupabaseCredentials,
    resetSupabaseCredentialsToDefault,
    formatSupabaseError,
    AMBIANCE_OPTIONS,
    fetchUserAmbianceColor,
    saveUserAmbianceColor,
    getCachedAccountAmbianceColor,
    normalizeAmbianceColor,
    type AmbianceColorId,
  } from '../../utils/supabase';

  async function initConfigPage() {
    // 0. GESTION DE LA COULEUR D'AMBIANCE (ASSOCIÉE AU COMPTE SUPABASE)
    const ambianceGrid = document.getElementById('ambiance-options-grid');
    const ambianceButtons = document.querySelectorAll<HTMLButtonElement>('[data-ambiance-choice]');
    const ambianceStatusTitle = document.getElementById('ambiance-status-title');
    const ambianceStatusDesc = document.getElementById('ambiance-status-desc');
    const ambianceDot = document.getElementById('ambiance-dot');
    const btnToggleDarkPreview = document.getElementById('btn-toggle-dark-preview');
    const btnResetAmbiance = document.getElementById('btn-reset-ambiance');

    function getAmbianceLabel(id: AmbianceColorId): string {
      return AMBIANCE_OPTIONS.find((o) => o.id === id)?.label || 'Blanc d’origine';
    }

    function updateAmbianceSelectionUI(activeId: AmbianceColorId) {
      ambianceButtons.forEach((btn) => {
        const id = btn.getAttribute('data-ambiance-choice') as AmbianceColorId;
        const isSelected = id === activeId;
        btn.classList.toggle('is-active', isSelected);
        btn.setAttribute('aria-checked', isSelected ? 'true' : 'false');
      });
    }

    // Initialisation immédiate depuis la session du compte puis synchronisation Supabase
    const initialAmbiance = getCachedAccountAmbianceColor();
    updateAmbianceSelectionUI(initialAmbiance);

    (async () => {
      try {
        const user = await getCurrentUser();
        const remoteColor = await fetchUserAmbianceColor();
        updateAmbianceSelectionUI(remoteColor);
        if (user && ambianceStatusTitle && ambianceStatusDesc && ambianceDot) {
          ambianceDot.className = 'dot-status dot-active';
          ambianceStatusTitle.textContent = `Synchronisé avec le compte ${user.email || 'Supabase'}`;
          ambianceStatusDesc.textContent = `Couleur active enregistrée sur Supabase : ${getAmbianceLabel(remoteColor)} (mode clair pastel et mode sombre).`;
        } else if (ambianceStatusTitle && ambianceStatusDesc && ambianceDot) {
          ambianceDot.className = 'dot-status';
          ambianceDot.style.background = 'var(--warning)';
          ambianceStatusTitle.textContent = 'Compte non connecté';
          ambianceStatusDesc.textContent = 'Connectez-vous à votre compte dans Mon Espace pour enregistrer votre couleur d’ambiance sur Supabase.';
        }
      } catch (err) {
        console.warn('[Ambiance Config] Erreur lecture initiale Supabase:', err);
      }
    })();

    async function handleSelectAmbiance(chosenId: AmbianceColorId) {
      updateAmbianceSelectionUI(chosenId);
      if (ambianceStatusDesc) {
        ambianceStatusDesc.textContent = `Enregistrement de « ${getAmbianceLabel(chosenId)} » sur votre compte Supabase...`;
      }
      try {
        const saved = await saveUserAmbianceColor(chosenId);
        const user = await getCurrentUser();
        if (ambianceStatusTitle && ambianceStatusDesc && ambianceDot) {
          ambianceDot.className = 'dot-status dot-active';
          ambianceStatusTitle.textContent = `Synchronisé avec le compte ${user?.email || 'Supabase'}`;
          ambianceStatusDesc.textContent = `Couleur « ${getAmbianceLabel(saved)} » enregistrée dans vos paramètres Supabase pour ce compte.`;
        }
      } catch (err: any) {
        if (ambianceStatusTitle && ambianceStatusDesc && ambianceDot) {
          ambianceDot.className = 'dot-status';
          ambianceDot.style.background = 'var(--danger)';
          ambianceStatusTitle.textContent = 'Erreur de synchronisation Supabase';
          ambianceStatusDesc.textContent = formatSupabaseError(err);
        }
      }
    }

    ambianceGrid?.addEventListener('click', (e) => {
      const target = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-ambiance-choice]');
      if (!target) return;
      const choice = normalizeAmbianceColor(target.getAttribute('data-ambiance-choice'));
      handleSelectAmbiance(choice);
    });

    btnResetAmbiance?.addEventListener('click', () => {
      handleSelectAmbiance('default');
    });

    btnToggleDarkPreview?.addEventListener('click', () => {
      const root = document.documentElement;
      const isDark =
        root.dataset.theme === 'dark' ||
        (!root.dataset.theme && window.matchMedia('(prefers-color-scheme: dark)').matches);
      const next = isDark ? 'light' : 'dark';
      root.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
        document.cookie = 'theme=' + encodeURIComponent(next) + '; path=/; max-age=31536000; SameSite=Lax';
      } catch {}
    });

    // 1. GESTION DE L'EMPLOI DU TEMPS & SYNCHRONISATION SUPABASE
    const timetableForm = document.getElementById('form-timetable') as HTMLFormElement;
    const icsFileInput = document.getElementById('ics-file') as HTMLInputElement;
    const icsUrlInput = document.getElementById('ics-url') as HTMLInputElement;
    const timetableDesc = document.getElementById('timetable-status-desc');
    const btnResetTimetable = document.getElementById('btn-reset-timetable');

    // Auto-synchronisation Supabase en arrière-plan
    const syncRes = await syncTimetableState().catch(() => null);

    const savedIcsUrl = loadPersistent(STORAGE_KEYS.TIMETABLE_URL);
    if (savedIcsUrl && icsUrlInput) icsUrlInput.value = savedIcsUrl;

    const savedIcsRaw = loadPersistent(STORAGE_KEYS.TIMETABLE_ICS);
    if (savedIcsRaw && timetableDesc) {
      if (syncRes?.synced) {
        timetableDesc.textContent = 'Emploi du temps synchronisé avec votre compte Supabase Cloud (accessible sur votre mobile et PC).';
      } else {
        timetableDesc.textContent = 'Emploi du temps personnalisé actif (importé par vos soins).';
      }
    }

    timetableForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const submitBtn = timetableForm.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Traitement en cours...';
      }

      try {
        if (icsFileInput.files && icsFileInput.files[0]) {
          const file = icsFileInput.files[0];
          if (timetableDesc) timetableDesc.textContent = `Lecture et synchronisation de "${file.name}"...`;
          const reader = new FileReader();
          reader.onload = async (evt) => {
            const content = evt.target?.result as string;
            if (content) {
              savePersistent(STORAGE_KEYS.TIMETABLE_ICS, content);
              let syncMsg = `Fichier "${file.name}" importé avec succès.`;

              try {
                const user = await getCurrentUser();
                if (user) {
                  await syncTimetableToSupabase({
                    icsContent: content,
                    icsUrl: icsUrlInput.value.trim() || undefined,
                  });
                  await clearUserScheduleEvents().catch(() => {});
                  syncMsg += ` Synchronisé avec Supabase Cloud. Accessible sur votre mobile et tous vos écrans !`;
                } else {
                  syncMsg += ` Sauvegardé en local. Connectez-vous à votre Espace pour synchroniser sur mobile.`;
                }
              } catch (err: any) {
                console.warn('[Sync Config] Erreur sync Supabase:', err);
                syncMsg += ` (Sauvegardé localement. Note Supabase: ${err.message || 'connexion échouée'})`;
              }

              if (timetableDesc) timetableDesc.textContent = syncMsg;
              alert(syncMsg);
            }
            if (submitBtn) {
              submitBtn.disabled = false;
              submitBtn.textContent = 'Mettre à jour le calendrier';
            }
          };
          reader.readAsText(file);
        } else if (icsUrlInput.value.trim()) {
          const rawUrl = icsUrlInput.value.trim();
          savePersistent(STORAGE_KEYS.TIMETABLE_URL, rawUrl);
          if (timetableDesc) timetableDesc.textContent = `Téléchargement du flux distant en cours... (${rawUrl})`;

          try {
            const content = await fetchCalendarFromUrl(rawUrl);
            if (content) {
              savePersistent(STORAGE_KEYS.TIMETABLE_ICS, content);
              let syncMsg = `Flux distant synchronisé avec succès.`;

              const user = await getCurrentUser();
              if (user) {
                await syncTimetableToSupabase({
                  icsContent: content,
                  icsUrl: rawUrl,
                });
                await clearUserScheduleEvents().catch(() => {});
                syncMsg += ` Synchronisé avec Supabase Cloud. Accessible sur votre mobile et tous vos écrans !`;
              } else {
                syncMsg += ` Sauvegardé en local. Connectez-vous à votre Espace pour synchroniser sur mobile.`;
              }

              if (timetableDesc) timetableDesc.textContent = syncMsg;
              alert(syncMsg);
            }
          } catch (fetchErr: any) {
            console.warn('[Sync Config] Fetch distant échoué:', fetchErr);
            try {
              const user = await getCurrentUser();
              if (user) {
                await syncTimetableToSupabase({ icsUrl: rawUrl });
              }
            } catch {}

            const msg = `URL enregistrée, mais impossible de récupérer le flux en direct : ${fetchErr.message || fetchErr}\n\nConseil : Pour les ENT ou agendas universitaires avec restrictions de sécurité (CORS ou mot de passe ENT), téléchargez le fichier .ics depuis votre ENT et déposez-le dans le champ "Importer un fichier iCalendar" ci-dessus.`;
            if (timetableDesc) timetableDesc.textContent = `URL enregistrée. Téléchargement direct bloqué par l'ENT : utilisez le fichier .ics.`;
            alert(msg);
          } finally {
            if (submitBtn) {
              submitBtn.disabled = false;
              submitBtn.textContent = 'Mettre à jour le calendrier';
            }
          }
        } else {
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = 'Mettre à jour le calendrier';
          }
        }
      } catch (err: any) {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Mettre à jour le calendrier';
        }
        alert('Erreur: ' + (err.message || err));
      }
    });

    btnResetTimetable?.addEventListener('click', async () => {
      if (confirm('Voulez-vous effacer le calendrier importé (sur cet appareil et sur Supabase) ?')) {
        savePersistent(STORAGE_KEYS.TIMETABLE_ICS, '');
        savePersistent(STORAGE_KEYS.TIMETABLE_URL, '');
        deleteCookie(STORAGE_KEYS.TIMETABLE_ICS);
        deleteCookie(STORAGE_KEYS.TIMETABLE_URL);
        if (icsFileInput) icsFileInput.value = '';
        if (icsUrlInput) icsUrlInput.value = '';

        try {
          const user = await getCurrentUser();
          if (user) {
            await syncTimetableToSupabase({ icsContent: '', icsUrl: '' });
            await clearUserScheduleEvents();
          }
        } catch (err) {
          console.warn('[Sync Config] Erreur suppression Supabase:', err);
        }

        if (timetableDesc) timetableDesc.textContent = 'Aucun calendrier iCal importé.';
        alert('Calendrier importé effacé avec succès.');
      }
    });

    // 2. PLANIFICATION DES NOTIFICATIONS RÉCURRENTES
    const remindersForm = document.getElementById('form-reminders') as HTMLFormElement;
    const remindersEnabled = document.getElementById('reminders-enabled') as HTMLInputElement;
    const remindersFreq = document.getElementById('reminders-frequency') as HTMLSelectElement;
    const remindersContent = document.getElementById('reminders-content') as HTMLSelectElement;
    const time1Input = document.getElementById('reminder-time-1') as HTMLInputElement;
    const time2Input = document.getElementById('reminder-time-2') as HTMLInputElement;
    const weekdayInput = document.getElementById('reminder-weekday') as HTMLSelectElement;

    const groupTime2 = document.getElementById('group-time-2');
    const groupWeekday = document.getElementById('group-weekday');
    const labelTime1 = document.getElementById('label-time-1');

    function updateFreqUI() {
      const val = remindersFreq.value;
      if (val === 'twice_daily') {
        if (groupTime2) groupTime2.style.display = 'grid';
        if (groupWeekday) groupWeekday.style.display = 'none';
        if (labelTime1) labelTime1.textContent = 'Première heure (matin) :';
      } else if (val === 'weekly') {
        if (groupTime2) groupTime2.style.display = 'none';
        if (groupWeekday) groupWeekday.style.display = 'grid';
        if (labelTime1) labelTime1.textContent = 'Heure du rappel :';
      } else {
        if (groupTime2) groupTime2.style.display = 'none';
        if (groupWeekday) groupWeekday.style.display = 'none';
        if (labelTime1) labelTime1.textContent = 'Heure quotidienne :';
      }
    }

    remindersFreq?.addEventListener('change', updateFreqUI);

    const savedConfig: ReminderScheduleConfig = await getUnifiedReminderConfig();

    if (remindersEnabled) remindersEnabled.checked = savedConfig.enabled;
    if (remindersFreq) remindersFreq.value = savedConfig.frequency;
    if (remindersContent && savedConfig.contentType) remindersContent.value = savedConfig.contentType;
    if (savedConfig.times && savedConfig.times[0] && time1Input) time1Input.value = savedConfig.times[0];
    if (savedConfig.times && savedConfig.times[1] && time2Input) time2Input.value = savedConfig.times[1];
    if (savedConfig.weekday && weekdayInput) weekdayInput.value = String(savedConfig.weekday);

    updateFreqUI();

    remindersForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const times: string[] = [];
      if (time1Input.value) times.push(time1Input.value);
      if (remindersFreq.value === 'twice_daily' && time2Input.value) times.push(time2Input.value);

      const newConfig: ReminderScheduleConfig = {
        enabled: remindersEnabled.checked,
        frequency: remindersFreq.value as any,
        times,
        weekday: parseInt(weekdayInput.value, 10),
        contentType: remindersContent.value as any,
      };

      const submitBtn = remindersForm.querySelector('button[type="submit"]') as HTMLButtonElement | null;
      if (submitBtn) submitBtn.disabled = true;

      try {
        await saveUnifiedReminderConfig(newConfig);
        alert('Préférences de rappels synchronisées et sauvegardées avec succès !');
      } catch (err: any) {
        alert(err.message || 'Erreur lors de la sauvegarde.');
      } finally {
        if (submitBtn) submitBtn.disabled = false;
      }
    });

    // 3. CONFIGURATION SUPABASE
    const supabaseForm = document.getElementById('form-supabase') as HTMLFormElement;
    const supabaseUrlInput = document.getElementById('supabase-url') as HTMLInputElement;
    const supabaseAnonInput = document.getElementById('supabase-anon-key') as HTMLInputElement;
    const supabaseDot = document.getElementById('supabase-dot');
    const supabaseTitle = document.getElementById('supabase-status-title');
    const supabaseDesc = document.getElementById('supabase-status-desc');
    const btnTestSupabase = document.getElementById('btn-test-supabase');
    const btnResetSupabaseDefault = document.getElementById('btn-reset-supabase-default');

    function updateSupabaseUI() {
      const creds = getSupabaseCredentials();
      if (supabaseUrlInput && !supabaseUrlInput.value) supabaseUrlInput.value = creds.url;
      if (supabaseAnonInput && !supabaseAnonInput.value) supabaseAnonInput.value = creds.anonKey;

      if (supabaseDot && supabaseTitle && supabaseDesc) {
        if (creds.isConfigured) {
          supabaseDot.className = 'dot-status dot-active';
          supabaseTitle.textContent = 'Projet Supabase connecté';
          supabaseDesc.textContent = `Connecté à l'instance Cloud : ${creds.url}`;
        } else {
          supabaseDot.className = 'dot-status';
          supabaseDot.style.background = 'var(--muted)';
          supabaseTitle.textContent = 'Non configuré';
          supabaseDesc.textContent = 'Renseignez votre Project URL et votre clé publique ci-dessus pour activer les comptes et la synchronisation.';
        }
      }
    }

    updateSupabaseUI();

    btnResetSupabaseDefault?.addEventListener('click', () => {
      resetSupabaseCredentialsToDefault();
      const creds = getSupabaseCredentials();
      if (supabaseUrlInput) supabaseUrlInput.value = creds.url;
      if (supabaseAnonInput) supabaseAnonInput.value = creds.anonKey;
      updateSupabaseUI();
      alert('Clés officielles de Supabase restaurées avec succès !');
    });

    supabaseForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      const urlVal = supabaseUrlInput.value.trim().replace(/\/+$/, '');
      const keyVal = supabaseAnonInput.value.trim();
      if (!urlVal || !keyVal) {
        alert('Veuillez renseigner à la fois le Project URL et la clé publique.');
        return;
      }
      saveSupabaseCredentials(urlVal, keyVal);
      updateSupabaseUI();
      alert('Identifiants Supabase enregistrés dans votre navigateur !');
    });

    btnTestSupabase?.addEventListener('click', async () => {
      const creds = getSupabaseCredentials();
      const urlVal = (supabaseUrlInput.value.trim() || creds.url).replace(/\/+$/, '');
      const keyVal = supabaseAnonInput.value.trim() || creds.anonKey;
      if (!urlVal || !keyVal) {
        alert('Veuillez d’abord renseigner vos identifiants Supabase.');
        return;
      }
      if (supabaseDesc) supabaseDesc.textContent = 'Test de connexion en cours...';
      try {
        const res = await fetch(`${urlVal}/rest/v1/ping?select=id&limit=1`, {
          headers: {
            apikey: keyVal,
            Authorization: `Bearer ${keyVal}`,
          },
        });
        if (res.ok) {
          if (supabaseDesc) supabaseDesc.textContent = 'Connexion à l’API Supabase validée avec succès.';
          alert('Succès : La connexion à votre projet Supabase fonctionne parfaitement !');
        } else if (res.status === 404 || res.status === 401) {
          // Si ping table pas encore créée, tester la racine auth ou schema
          const authRes = await fetch(`${urlVal}/auth/v1/health`, {
            headers: { apikey: keyVal },
          });
          if (authRes.ok) {
            if (supabaseDesc) supabaseDesc.textContent = 'API Supabase Auth joignable.';
            alert('Connexion établie avec le service d’authentification Supabase !');
          } else {
            throw new Error(`Statut HTTP : ${res.status}`);
          }
        } else {
          throw new Error(`Statut HTTP : ${res.status}`);
        }
      } catch (err: any) {
        const formatted = formatSupabaseError(err);
        if (supabaseDesc) supabaseDesc.textContent = `Erreur de connexion : ${formatted}`;
        alert(`Échec du test de connexion : ${formatted}`);
      }
    });

    // 4. COOKIES & DONNÉES
    const cookieStatus = document.getElementById('cookie-status');
    const notifPermStatus = document.getElementById('notif-perm-status');
    const btnReqNotifPerm = document.getElementById('btn-request-notif-perm');
    const btnClearAll = document.getElementById('btn-clear-all-data');

    if (cookieStatus) {
      cookieStatus.textContent = navigator.cookieEnabled ? 'Actifs (365 jours)' : 'Désactivés';
    }

    function checkPerm() {
      if (!('Notification' in window)) {
        if (notifPermStatus) notifPermStatus.textContent = 'Non supportées';
        return;
      }
      const perm = Notification.permission;
      if (notifPermStatus) {
        if (perm === 'granted') notifPermStatus.textContent = 'Autorisées';
        else if (perm === 'denied') notifPermStatus.textContent = 'Bloquées';
        else notifPermStatus.textContent = 'En attente d’autorisation';
      }
    }

    checkPerm();

    btnReqNotifPerm?.addEventListener('click', async () => {
      if ('Notification' in window) {
        await Notification.requestPermission();
        checkPerm();
      }
    });

    const btnDeleteAllCourses = document.getElementById('btn-delete-all-courses');

    btnDeleteAllCourses?.addEventListener('click', async () => {
      if (confirm('Attention : Voulez-vous vraiment supprimer DÉFINITIVEMENT tous vos cours ?\n\nCette action supprimera tous les cours et fiches de révision enregistrés sur votre compte Supabase et dans votre navigateur. Votre emploi du temps sera conservé.\n\nContinuer ?')) {
        try {
          await clearUserCourses();
          alert('Tous vos cours ont été supprimés avec succès.');
        } catch (err: any) {
          alert('Erreur lors de la suppression des cours : ' + formatSupabaseError(err));
        }
      }
    });

    btnClearAll?.addEventListener('click', async () => {
      if (confirm('Attention : cela supprimera tous vos cours personnalisés, vos rappels et votre calendrier. Continuer ?')) {
        try {
          await clearUserCourses().catch(() => {});
          await clearUserScheduleEvents().catch(() => {});
        } catch {}
        Object.values(STORAGE_KEYS).forEach((k) => {
          deleteCookie(k);
          localStorage.removeItem(k);
        });
        localStorage.removeItem('marges_supabase_url');
        localStorage.removeItem('marges_supabase_anon_key');
        alert('Toutes les données locales ont été réinitialisées.');
        window.location.reload();
      }
    });
  }

  if (typeof window !== 'undefined') {
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initConfigPage);
    } else {
      initConfigPage();
    }
    document.addEventListener('astro:page-load', initConfigPage);
  }
</script>

