---
import fs from 'node:fs';
import path from 'node:path';
import { COURS_ROOT, getCourses, type CourseFile, type CourseFolder } from '../../../utils/courses';
import { url } from '../../../utils/url';

export async function getStaticPaths() {
  const subjects = getCourses();
  
  function collectFiles(folder: CourseFolder, subjectId: string): Array<{ file: CourseFile; subjectId: string }> {
    let result: Array<{ file: CourseFile; subjectId: string }> = [];
    for (const f of folder.files) {
      result.push({ file: f, subjectId });
    }
    for (const sub of folder.subfolders) {
      result = result.concat(collectFiles(sub, subjectId));
    }
    return result;
  }

  const allFiles: Array<{ file: CourseFile; subjectId: string }> = [];
  for (const s of subjects) {
    allFiles.push(...collectFiles(s.folder, s.id));
  }

  return allFiles.map((item) => {
    return {
      params: { filepath: item.file.path },
      props: { file: item.file },
    };
  });
}

const { file } = Astro.props;
const fullPath = path.join(COURS_ROOT, file.path);
let content = '';

if (file.type === 'code' || file.type === 'text') {
  try {
    content = fs.readFileSync(fullPath, 'utf-8');
  } catch {
    content = 'Impossible de lire le fichier.';
  }
}
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{file.name} — Marges Cours</title>
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <style>
      :root {
        --bg: #fcfcfb;
        --surface: #ffffff;
        --soft: #f4f3f0;
        --fg: #141414;
        --muted: #66655f;
        --line: #e7e5e0;
        --line-strong: #cfcdc6;
        --font-text: 'Source Serif 4 Variable', Georgia, serif;
        --font-ui: 'Inter Variable', Inter, system-ui, sans-serif;
        --font-mono: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
        --radius: 10px;
        --r-sm: 6px;
      }
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme='light']) {
          --bg: #0b0b0c;
          --surface: #121214;
          --soft: #18181b;
          --fg: #ededec;
          --muted: #9d9c97;
          --line: #242427;
          --line-strong: #3a3a3e;
        }
      }
      :root[data-theme='dark'] {
        --bg: #0b0b0c;
        --surface: #121214;
        --soft: #18181b;
        --fg: #ededec;
        --muted: #9d9c97;
        --line: #242427;
        --line-strong: #3a3a3e;
      }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--fg);
        font-family: var(--font-ui);
      }
      .header {
        position: sticky;
        top: 0;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.75rem 1.5rem;
        background: var(--surface);
        border-bottom: 1px solid var(--line);
        font-size: 0.88rem;
        z-index: 20;
      }
      .header-info {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        min-width: 0;
      }
      .header-title {
        font-weight: 600;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .header-meta {
        color: var(--muted);
        font-size: 0.82rem;
      }
      .header-actions {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        flex: none;
      }
      .btn-header {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.35rem 0.75rem;
        border-radius: var(--r-sm);
        border: 1px solid var(--line);
        background: var(--soft);
        color: var(--fg);
        text-decoration: none;
        font-size: 0.82rem;
        font-weight: 500;
        transition: all 0.15s ease;
      }
      .btn-header:hover {
        border-color: var(--fg);
      }
      .btn-header--primary {
        background: var(--fg);
        color: var(--bg);
        border-color: var(--fg);
      }
      .btn-header--primary:hover {
        opacity: 0.85;
      }

      pre {
        margin: 0;
        padding: 2rem;
        font-family: var(--font-mono);
        font-size: 0.92rem;
        line-height: 1.6;
        background: var(--bg);
        overflow-x: auto;
      }
      iframe {
        width: 100vw;
        height: calc(100vh - 49px);
        border: none;
        background: var(--surface);
      }

      .unsupported-view {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: calc(100vh - 100px);
        padding: 2rem;
      }
      .unsupported-card {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: var(--radius);
        padding: 2.5rem;
        max-width: 480px;
        text-align: center;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
      }
      .unsupported-card h2 {
        font-family: var(--font-text);
        margin: 0 0 0.75rem;
        font-size: 1.4rem;
        word-break: break-word;
      }
      .unsupported-card p {
        margin: 0 0 1.75rem;
        color: var(--muted);
        font-size: 0.92rem;
        line-height: 1.6;
      }
      .actions-group {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
      }
      .btn-download {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        background: var(--fg);
        color: var(--bg);
        padding: 0.65rem 1.25rem;
        border-radius: var(--radius);
        text-decoration: none;
        font-weight: 600;
        font-size: 0.92rem;
        transition: opacity 0.15s ease;
      }
      .btn-download:hover {
        opacity: 0.85;
      }
      .btn-back-link {
        color: var(--muted);
        font-size: 0.85rem;
        text-decoration: underline;
      }
      .btn-back-link:hover {
        color: var(--fg);
      }
    </style>
  </head>
  <body>
    <header class="header">
      <div class="header-info">
        <span class="header-title">{file.name}</span>
        <span class="header-meta">({file.path})</span>
      </div>
      <div class="header-actions">
        <a href={url(`/cours-files/${encodeURI(file.path)}`)} download={file.name} class="btn-header btn-header--primary">
          Télécharger
        </a>
        <a href={url('/cours/')} class="btn-header">
          Retour aux cours
        </a>
      </div>
    </header>

    {file.type === 'pdf' ? (
      <iframe src={url(`/cours-files/${encodeURI(file.path)}`)} title={file.name}></iframe>
    ) : (file.type === 'code' || file.type === 'text') ? (
      <pre><code>{content}</code></pre>
    ) : (
      <main class="unsupported-view">
        <div class="unsupported-card">
          <h2>{file.name}</h2>
          <p>
            Ce format de fichier ({file.ext.toUpperCase() || 'Document'}) ne peut pas être affiché directement dans le navigateur. Vous pouvez l'ouvrir avec l'application appropriée sur votre machine.
          </p>
          <div class="actions-group">
            <a href={url(`/cours-files/${encodeURI(file.path)}`)} download={file.name} class="btn-download">
              Télécharger le fichier
            </a>
            <a href={url('/cours/')} class="btn-back-link">Retour à la liste des cours</a>
          </div>
        </div>
      </main>
    )}
  </body>
</html>
