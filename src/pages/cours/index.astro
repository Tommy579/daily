---
import Base from '../../layouts/Base.astro';
import { getCourses, formatFileSize } from '../../utils/courses';

const subjects = getCourses();
const totalCourses = subjects.length;
const totalFiles = subjects.reduce((acc, s) => acc + s.stats.totalFiles, 0);
const totalPdfs = subjects.reduce((acc, s) => acc + s.stats.pdfCount, 0);
---

<Base
  title="Mes Cours"
  description="Accès direct et visionneuse de vos cours, TD, travaux pratiques et documents académiques."
>
  <div class="container courses-page" data-courses-root>
    <header class="page-header">
      <div class="header-top">
        <div>
          <p class="label"><a href="/">Accueil</a> / Cours</p>
          <h1>Mes Cours</h1>
        </div>
        <a href="/configuration/" class="btn-config meta">
          ⚙️ Paramètres & Configuration
        </a>
      </div>
      <p class="lede">
        Supports de cours, énoncés de TD et fiches de révisions importés pour le Semestre 5.
      </p>
      <div class="meta stats-bar">
        <span>{totalCourses} matières</span>
        <span class="sep">·</span>
        <span>{totalFiles} fichiers</span>
        <span class="sep">·</span>
        <span>{totalPdfs} documents PDF</span>
      </div>
    </header>

    <!-- Matières issues de la base de cours synchronisée -->
    <div class="subjects-grid">
      {subjects.map((sub) => (
        <section class="subject-card">
          <div class="subject-header">
            <div>
              <h2 class="subject-title">{sub.name}</h2>
              <span class="meta">{sub.stats.totalFiles} fichiers ({sub.stats.pdfCount} PDF{sub.stats.docCount ? `, ${sub.stats.docCount} Word/doc` : ''}{sub.stats.codeCount ? `, ${sub.stats.codeCount} code` : ''})</span>
            </div>
            <a class="more" href={`#folder-${sub.id}`}>Explorer <span aria-hidden="true">↓</span></a>
          </div>

          <!-- Arborescence des fichiers -->
          <div class="folder-tree" id={`folder-${sub.id}`}>
            {sub.folder.subfolders.map((td) => (
              <div class="td-section">
                <h3 class="td-title">📂 {td.name}</h3>
                <ul class="file-list" role="list">
                  {td.files.map((file) => (
                    <li class="file-item">
                      <div class="file-info">
                        <span class={`file-badge file-badge--${file.type}`}>
                          {file.ext ? file.ext.replace('.', '').toUpperCase() : 'BIN'}
                        </span>
                        <a href={file.viewerUrl} class="file-name" title={`Ouvrir ${file.name}`}>
                          {file.name}
                        </a>
                      </div>
                      <div class="file-actions meta">
                        <span>{formatFileSize(file.size)}</span>
                        <span class="sep">·</span>
                        <a href={file.viewerUrl} class="action-btn">Consulter</a>
                      </div>
                    </li>
                  ))}
                </ul>
              </div>
            ))}

            {sub.folder.files.length > 0 && (
              <div class="td-section">
                <h3 class="td-title">📄 Documents racines</h3>
                <ul class="file-list" role="list">
                  {sub.folder.files.map((file) => (
                    <li class="file-item">
                      <div class="file-info">
                        <span class={`file-badge file-badge--${file.type}`}>
                          {file.ext ? file.ext.replace('.', '').toUpperCase() : 'BIN'}
                        </span>
                        <a href={file.viewerUrl} class="file-name">
                          {file.name}
                        </a>
                      </div>
                      <div class="file-actions meta">
                        <span>{formatFileSize(file.size)}</span>
                        <span class="sep">·</span>
                        <a href={file.viewerUrl} class="action-btn">Consulter</a>
                      </div>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        </section>
      ))}
    </div>
  </div>
</Base>

<style>
  .courses-page {
    padding-bottom: 5rem;
  }
  .header-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .btn-config {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.75rem;
    background: var(--soft);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    color: var(--fg);
    text-decoration: none;
    transition: border-color 0.15s ease;
  }
  .btn-config:hover {
    border-color: var(--fg);
  }
  .stats-bar {
    margin-top: 0.75rem;
    display: flex;
    align-items: center;
  }

  .subjects-grid {
    display: grid;
    gap: 3.5rem;
    margin-top: 2.5rem;
  }
  .subject-card {
    border-top: 1px solid var(--fg);
    padding-top: 1.5rem;
  }
  .subject-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 1.5rem;
  }
  .subject-title {
    margin: 0 0 0.25rem;
    font-size: 1.75rem;
  }
  .folder-tree {
    display: grid;
    gap: 1.75rem;
  }
  .td-section {
    background: var(--soft);
    border-radius: var(--radius);
    padding: 1.25rem 1.5rem;
  }
  .td-title {
    margin: 0 0 1rem;
    font-size: 1.05rem;
    font-family: var(--font-ui);
    font-weight: 600;
  }
  .file-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.65rem;
  }
  .file-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.4rem 0;
    border-bottom: 1px solid var(--line);
  }
  .file-item:last-child {
    border-bottom: none;
  }
  .file-info {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
  }
  .file-name {
    font-size: 0.95rem;
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 3px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .file-name:hover {
    text-decoration-color: currentColor;
  }
  .file-badge {
    font-family: var(--font-ui);
    font-size: 0.65rem;
    font-weight: 700;
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    border: 1px solid var(--line);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .file-badge--pdf {
    background: #ef4444;
    color: #fff;
    border-color: #ef4444;
  }
  .file-badge--doc {
    background: #0284c7;
    color: #fff;
    border-color: #0284c7;
  }
  .file-badge--code {
    background: #2563eb;
    color: #fff;
    border-color: #2563eb;
  }
  .file-badge--text {
    background: #10b981;
    color: #fff;
    border-color: #10b981;
  }
  .file-badge--other {
    background: #64748b;
    color: #fff;
    border-color: #64748b;
  }
  .file-actions {
    display: flex;
    align-items: center;
    white-space: nowrap;
  }
  .action-btn {
    color: var(--fg);
    text-decoration: underline;
    text-underline-offset: 2px;
    font-family: var(--font-ui);
    font-size: 0.85rem;
  }
  .action-btn:hover {
    opacity: 0.7;
  }
</style>
