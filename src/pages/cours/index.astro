---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { getCourses, formatFileSize } from '../../utils/courses';

const subjects = getCourses();
const totalCourses = subjects.length;
const totalFiles = subjects.reduce((acc, s) => acc + s.stats.totalFiles, 0);
const totalPdfs = subjects.reduce((acc, s) => acc + s.stats.pdfCount, 0);
---

<Base
  title="Mes Cours"
  description="Accès direct et visionneuse de vos cours, TD, travaux pratiques et documents académiques."
>
  <div class="container container--wide app-page courses-page" data-courses-root>
    <header class="page-header courses-hero">
      <div class="courses-hero-top">
        <div>
          <p class="crumbs"><a href="/">Accueil</a> / Cours</p>
          <h1 class="courses-title">Mes Cours</h1>
          <p class="courses-motto">Supports de cours, énoncés de TD et fiches de révisions pour le Semestre 5.</p>
        </div>
        <a href="/configuration/" class="btn btn--sm">
          <Icon name="settings" size={14} />
          Configuration
        </a>
      </div>
      <div class="meta stats-bar">
        <span>{totalCourses} matières</span>
        <span class="sep">·</span>
        <span>{totalFiles} fichiers</span>
        <span class="sep">·</span>
        <span>{totalPdfs} documents PDF</span>
      </div>
    </header>

    <!-- Grille des matières avec DA Marges -->
    <div class="subjects-grid">
      {subjects.map((sub) => (
        <section class="panel subject-card" id={`folder-${sub.id}`}>
          <div class="subject-header">
            <div class="subject-title-wrap">
              <span class="subject-initial" aria-hidden="true">{sub.name.charAt(0).toUpperCase()}</span>
              <div>
                <h2 class="subject-title">{sub.name}</h2>
                <p class="subject-meta meta">
                  {sub.stats.totalFiles} fichiers · {sub.stats.pdfCount} PDF
                  {sub.stats.docCount ? ` · ${sub.stats.docCount} Word` : ''}
                  {sub.stats.codeCount ? ` · ${sub.stats.codeCount} code` : ''}
                </p>
              </div>
            </div>
          </div>

          <!-- Arborescence des dossiers & fichiers -->
          <div class="folder-tree">
            {sub.folder.subfolders.map((td) => (
              <div class="td-section">
                <div class="td-header">
                  <Icon name="folder" size={16} class="td-folder-icon" />
                  <h3 class="td-title">{td.name}</h3>
                  <span class="meta td-count">{td.files.length}</span>
                </div>
                <ul class="file-list" role="list">
                  {td.files.map((file) => (
                    <li class="file-item">
                      <div class="file-info">
                        <span class={`file-badge file-badge--${file.type}`}>
                          {file.ext ? file.ext.replace('.', '').toUpperCase() : 'BIN'}
                        </span>
                        <a href={file.viewerUrl} class="file-name" title={`Ouvrir ${file.name}`}>
                          {file.name}
                        </a>
                      </div>
                      <div class="file-actions meta">
                        <span>{formatFileSize(file.size)}</span>
                        <a href={file.viewerUrl} class="btn-consulter">
                          Consulter <Icon name="arrow-right" size={13} />
                        </a>
                      </div>
                    </li>
                  ))}
                </ul>
              </div>
            ))}

            {sub.folder.files.length > 0 && (
              <div class="td-section">
                <div class="td-header">
                  <Icon name="file" size={16} class="td-folder-icon" />
                  <h3 class="td-title">Documents racines</h3>
                  <span class="meta td-count">{sub.folder.files.length}</span>
                </div>
                <ul class="file-list" role="list">
                  {sub.folder.files.map((file) => (
                    <li class="file-item">
                      <div class="file-info">
                        <span class={`file-badge file-badge--${file.type}`}>
                          {file.ext ? file.ext.replace('.', '').toUpperCase() : 'BIN'}
                        </span>
                        <a href={file.viewerUrl} class="file-name" title={`Ouvrir ${file.name}`}>
                          {file.name}
                        </a>
                      </div>
                      <div class="file-actions meta">
                        <span>{formatFileSize(file.size)}</span>
                        <a href={file.viewerUrl} class="btn-consulter">
                          Consulter <Icon name="arrow-right" size={13} />
                        </a>
                      </div>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        </section>
      ))}
    </div>
  </div>
</Base>

<style>
  .courses-page {
    padding-bottom: 5rem;
  }
  .courses-hero {
    padding-block: clamp(1.5rem, 1rem + 2vw, 3rem) clamp(1rem, 0.75rem + 1vw, 2rem);
    border-bottom: 1px solid var(--line);
    margin-bottom: 2rem;
  }
  .courses-hero-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .courses-title {
    font-family: var(--font-text);
    font-size: clamp(2rem, 1.5rem + 2vw, 3rem);
    letter-spacing: -.03em;
    margin: .35rem 0 .35rem;
  }
  .courses-motto {
    font-family: var(--font-text);
    font-style: italic;
    font-size: 1.1rem;
    color: var(--muted);
    margin: 0;
  }
  .stats-bar {
    margin-top: 1rem;
    display: flex;
    align-items: center;
    gap: .5rem;
    font-size: .88rem;
  }

  .subjects-grid {
    display: grid;
    gap: 2rem;
  }
  .subject-card {
    padding: 1.5rem 1.75rem;
  }
  .subject-header {
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line);
  }
  .subject-title-wrap {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .subject-initial {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    flex: none;
    border-radius: var(--r-sm);
    background: var(--fg);
    color: var(--bg);
    font-weight: 700;
    font-size: 1.15rem;
    font-family: var(--font-ui);
  }
  .subject-title {
    margin: 0 0 0.2rem;
    font-family: var(--font-text);
    font-size: 1.5rem;
    letter-spacing: -.02em;
  }
  .subject-meta {
    margin: 0;
    font-size: 0.85rem;
  }

  .folder-tree {
    display: grid;
    gap: 1.25rem;
  }
  .td-section {
    background: var(--soft);
    border-radius: var(--radius);
    padding: 1rem 1.25rem;
    border: 1px solid var(--line);
  }
  .td-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }
  .td-folder-icon {
    color: var(--muted);
  }
  .td-title {
    margin: 0;
    font-size: 0.95rem;
    font-family: var(--font-ui);
    font-weight: 600;
    letter-spacing: -.01em;
  }
  .td-count {
    margin-left: auto;
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
  }

  .file-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.4rem;
  }
  .file-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.45rem 0.6rem;
    border-radius: var(--r-sm);
    background: var(--surface);
    border: 1px solid var(--line);
    transition: border-color .15s ease, background-color .15s ease;
  }
  .file-item:hover {
    border-color: var(--line-strong);
  }
  .file-info {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    min-width: 0;
  }
  .file-name {
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--fg);
    text-decoration: none;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: color .15s ease;
  }
  .file-name:hover {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .file-badge {
    font-family: var(--font-ui);
    font-size: 0.65rem;
    font-weight: 700;
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
    border: 1px solid var(--line);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: var(--soft);
    color: var(--muted);
  }
  .file-badge--pdf {
    background: color-mix(in srgb, var(--danger) 10%, var(--surface));
    color: var(--danger);
    border-color: color-mix(in srgb, var(--danger) 25%, var(--line));
  }
  .file-badge--doc {
    background: color-mix(in srgb, var(--accent) 10%, var(--surface));
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 25%, var(--line));
  }
  .file-badge--code {
    background: color-mix(in srgb, var(--tone-philo) 10%, var(--surface));
    color: var(--tone-philo);
    border-color: color-mix(in srgb, var(--tone-philo) 25%, var(--line));
  }
  .file-badge--text {
    background: color-mix(in srgb, var(--success) 10%, var(--surface));
    color: var(--success);
    border-color: color-mix(in srgb, var(--success) 25%, var(--line));
  }

  .file-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    white-space: nowrap;
    font-size: 0.8rem;
  }
  .btn-consulter {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    color: var(--fg);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.82rem;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    background: var(--soft);
    border: 1px solid var(--line);
    transition: all .15s ease;
  }
  .btn-consulter:hover {
    background: var(--fg);
    color: var(--bg);
    border-color: var(--fg);
    text-decoration: none;
  }
</style>
