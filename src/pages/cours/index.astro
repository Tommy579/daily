---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import CourseManagerModal from '../../components/CourseManagerModal.astro';
import { getCourses, formatFileSize } from '../../utils/courses';
import { url } from '../../utils/url';

const subjects = getCourses();
const totalCourses = subjects.length;
const totalFiles = subjects.reduce((acc, s) => acc + s.stats.totalFiles, 0);
const totalPdfs = subjects.reduce((acc, s) => acc + s.stats.pdfCount, 0);

const subjectsList = subjects.map((s) => ({
  id: s.id,
  name: s.name,
  subfolders: s.folder.subfolders.map((f) => f.name),
}));
---

<Base
  title="Mes Cours"
  description="Accès direct et visionneuse de vos cours, TD, travaux pratiques et documents académiques."
>
  <div class="container container--wide app-page courses-page" data-courses-root data-subjects={JSON.stringify(subjectsList)}>
    <header class="page-header courses-hero">
      <div class="courses-hero-top">
        <div>
          <p class="crumbs"><a href={url('/')}>Accueil</a> / Cours</p>
          <h1 class="courses-title">Mes Cours</h1>
          <p class="courses-motto">Supports de cours, énoncés de TD et fiches de révisions.</p>
        </div>
        <div class="courses-hero-actions">
          <button type="button" class="btn btn--primary btn--sm" id="btn-open-add-course">
            <Icon name="folder" size={14} />
            Ajouter / Classer un cours
          </button>
          <a href={url('/configuration/')} class="btn btn--sm">
            <Icon name="settings" size={14} />
            Configuration
          </a>
        </div>
      </div>
      <div class="meta stats-bar">
        <span>{totalCourses} matières</span>
        <span class="sep">·</span>
        <span>{totalFiles} fichiers</span>
        <span class="sep">·</span>
        <span>{totalPdfs} documents PDF</span>
      </div>
    </header>

    <!-- Zone de statut / notification d'ajout local -->
    <div id="course-toast" class="panel course-toast" style="display: none;">
      <span class="toast-dot"></span>
      <span id="toast-message">Matière ajoutée avec succès.</span>
    </div>

    <!-- Grille des matières avec DA Marges -->
    <div class="subjects-grid" id="subjects-container">
      {subjects.map((sub) => (
        <section class="panel subject-card" id={`folder-${sub.id}`} data-subject-card={sub.name}>
          <div class="subject-header">
            <div class="subject-title-wrap">
              <span class="subject-initial" aria-hidden="true">{sub.name.charAt(0).toUpperCase()}</span>
              <div>
                <h2 class="subject-title">{sub.name}</h2>
                <p class="subject-meta meta">
                  <span class="subject-count-label">
                    {sub.stats.totalFiles} fichiers · {sub.stats.pdfCount} PDF
                    {sub.stats.docCount ? ` · ${sub.stats.docCount} Word` : ''}
                    {sub.stats.codeCount ? ` · ${sub.stats.codeCount} code` : ''}
                  </span>
                </p>
              </div>
            </div>
            <button
              type="button"
              class="btn btn--sm btn-add-in-subject"
              data-subject-target={sub.name}
              title={`Ajouter un document dans ${sub.name}`}
            >
              + Ajouter un document
            </button>
          </div>

          <!-- Arborescence des dossiers & fichiers -->
          <div class="folder-tree" id={`tree-${sub.id}`}>
            {sub.folder.subfolders.map((td) => (
              <div class="td-section" data-folder-name={td.name}>
                <div class="td-header">
                  <Icon name="folder" size={16} class="td-folder-icon" />
                  <h3 class="td-title">{td.name}</h3>
                  <span class="meta td-count">{td.files.length}</span>
                </div>
                <ul class="file-list" role="list">
                  {td.files.map((file) => (
                    <li class="file-item">
                      <div class="file-info">
                        <span class={`file-badge file-badge--${file.type}`}>
                          {file.ext ? file.ext.replace('.', '').toUpperCase() : 'BIN'}
                        </span>
                        <a href={file.viewerUrl} class="file-name" title={`Ouvrir ${file.name}`}>
                          {file.name}
                        </a>
                      </div>
                      <div class="file-actions meta">
                        <span>{formatFileSize(file.size)}</span>
                        <a href={file.viewerUrl} class="btn-consulter">
                          Consulter <Icon name="arrow-right" size={13} />
                        </a>
                      </div>
                    </li>
                  ))}
                </ul>
              </div>
            ))}

            {sub.folder.files.length > 0 && (
              <div class="td-section" data-folder-name="Documents racines">
                <div class="td-header">
                  <Icon name="file" size={16} class="td-folder-icon" />
                  <h3 class="td-title">Documents racines</h3>
                  <span class="meta td-count">{sub.folder.files.length}</span>
                </div>
                <ul class="file-list" role="list">
                  {sub.folder.files.map((file) => (
                    <li class="file-item">
                      <div class="file-info">
                        <span class={`file-badge file-badge--${file.type}`}>
                          {file.ext ? file.ext.replace('.', '').toUpperCase() : 'BIN'}
                        </span>
                        <a href={file.viewerUrl} class="file-name" title={`Ouvrir ${file.name}`}>
                          {file.name}
                        </a>
                      </div>
                      <div class="file-actions meta">
                        <span>{formatFileSize(file.size)}</span>
                        <a href={file.viewerUrl} class="btn-consulter">
                          Consulter <Icon name="arrow-right" size={13} />
                        </a>
                      </div>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        </section>
      ))}
    </div>

    <!-- Modale de création et de classement de cours -->
    <CourseManagerModal />

    <!-- Modale de consultation d'un cours / note Markdown (Supabase) -->
    <dialog class="panel course-modal" id="modal-view-note" style="max-width: 680px; width: 90%;">
      <div class="modal-inner">
        <header class="modal-header">
          <div>
            <span class="label" id="view-note-meta">Matière / Catégorie</span>
            <h2 class="modal-title" id="view-note-title">Titre</h2>
          </div>
          <button type="button" class="btn-close" id="btn-close-view-note" aria-label="Fermer">✕</button>
        </header>
        <div class="markdown-preview" id="view-note-content" style="max-height: 60vh; overflow-y: auto; padding: 1rem 0;"></div>
        <div class="modal-actions">
          <button type="button" class="btn btn--sm" id="btn-dismiss-note">Fermer</button>
        </div>
      </div>
    </dialog>
  </div>
</Base>

<script>
  import {
    fetchUserCourses,
    createUserCourse,
    deleteUserCourse,
    type DbCourse,
  } from '../../utils/supabase';

  function renderMarkdown(md: string): string {
    if (!md) return '<p class="meta">Aucun contenu.</p>';
    const escaped = md
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;');

    return escaped
      .replace(/^### (.*$)/gim, '<h3>$1</h3>')
      .replace(/^## (.*$)/gim, '<h2>$1</h2>')
      .replace(/^# (.*$)/gim, '<h1>$1</h1>')
      .replace(/^\> (.*$)/gim, '<blockquote>$1</blockquote>')
      .replace(/\*\*(.*?)\*\*/gim, '<strong>$1</strong>')
      .replace(/\*(.*?)\*/gim, '<em>$1</em>')
      .replace(/`([^`]+)`/gim, '<code>$1</code>')
      .replace(/^\- (.*$)/gim, '<li>$1</li>')
      .replace(/\n\n+/g, '</p><p>')
      .replace(/\n/g, '<br />');
  }

  interface CustomCourseItem {
    id: string;
    name: string;
    subjectName: string;
    folderName: string; // "CM", "TD", "Fiches de révisions", or ""
    size: number;
    ext: string;
    type: 'pdf' | 'doc' | 'code' | 'text' | 'other';
    fileData?: string; // Data URL for local viewing
    addedAt: number;
  }

  interface CustomSubjectItem {
    id: string;
    name: string;
    subfolders: string[];
    createdAt: number;
  }

  const STORAGE_CUSTOM_SUBJECTS = 'marges_custom_subjects';
  const STORAGE_CUSTOM_COURSES = 'marges_custom_courses';

  function initCourseManager() {
    const root = document.querySelector('[data-courses-root]');
    if (!root) return;

    const modal = document.getElementById('modal-manage-course') as HTMLDialogElement;
    const btnOpen = document.getElementById('btn-open-add-course');
    const btnClose = document.getElementById('btn-close-course-modal');
    const btnCancelSubject = document.getElementById('btn-cancel-subject');
    const btnCancelFile = document.getElementById('btn-cancel-file');
    const btnCancelNote = document.getElementById('btn-cancel-note');

    const modalViewNote = document.getElementById('modal-view-note') as HTMLDialogElement;
    const viewNoteTitle = document.getElementById('view-note-title');
    const viewNoteMeta = document.getElementById('view-note-meta');
    const viewNoteContent = document.getElementById('view-note-content');
    const btnCloseViewNote = document.getElementById('btn-close-view-note');
    const btnDismissNote = document.getElementById('btn-dismiss-note');

    btnCloseViewNote?.addEventListener('click', () => modalViewNote?.close());
    btnDismissNote?.addEventListener('click', () => modalViewNote?.close());

    const formSubject = document.getElementById('form-create-subject') as HTMLFormElement;
    const formFile = document.getElementById('form-upload-file') as HTMLFormElement;
    const formNote = document.getElementById('form-create-note') as HTMLFormElement;

    const selectTargetSubject = document.getElementById('select-target-subject') as HTMLSelectElement;
    const selectTargetFolder = document.getElementById('select-target-folder') as HTMLSelectElement;
    const selectNoteSubject = document.getElementById('select-note-subject') as HTMLSelectElement;
    const selectNoteFolder = document.getElementById('select-note-folder') as HTMLSelectElement;
    const groupCustomFolder = document.getElementById('group-custom-folder');
    const inputCustomFolder = document.getElementById('input-custom-folder') as HTMLInputElement;

    const noteTitleInput = document.getElementById('note-title-input') as HTMLInputElement;
    const noteBodyInput = document.getElementById('note-body-input') as HTMLTextAreaElement;

    const toast = document.getElementById('course-toast');
    const toastMsg = document.getElementById('toast-message');

    // 1. Lire les matières initiales
    const rawSubjects = root.getAttribute('data-subjects');
    const baseSubjects: Array<{ id: string; name: string; subfolders: string[] }> = rawSubjects ? JSON.parse(rawSubjects) : [];

    function getCustomSubjects(): CustomSubjectItem[] {
      try {
        const raw = localStorage.getItem(STORAGE_CUSTOM_SUBJECTS);
        return raw ? JSON.parse(raw) : [];
      } catch {
        return [];
      }
    }

    function saveCustomSubjects(items: CustomSubjectItem[]) {
      try {
        localStorage.setItem(STORAGE_CUSTOM_SUBJECTS, JSON.stringify(items));
      } catch {}
    }

    function getCustomCourses(): CustomCourseItem[] {
      try {
        const raw = localStorage.getItem(STORAGE_CUSTOM_COURSES);
        return raw ? JSON.parse(raw) : [];
      } catch {
        return [];
      }
    }

    function saveCustomCourses(items: CustomCourseItem[]) {
      try {
        localStorage.setItem(STORAGE_CUSTOM_COURSES, JSON.stringify(items));
      } catch {}
    }

    function showToast(msg: string) {
      if (toast && toastMsg) {
        toastMsg.textContent = msg;
        toast.style.display = 'flex';
        setTimeout(() => {
          toast.style.display = 'none';
        }, 5000);
      }
    }

    // Mise à jour de la liste déroulante des matières
    function populateSubjectsSelect(selectedName?: string) {
      const customSubjects = getCustomSubjects();
      const allNames = Array.from(new Set([...baseSubjects.map((s) => s.name), ...customSubjects.map((s) => s.name)])).sort((a, b) => a.localeCompare(b));

      [selectTargetSubject, selectNoteSubject].forEach((sel) => {
        if (!sel) return;
        sel.innerHTML = '<option value="" disabled selected>Sélectionner une matière...</option>';
        allNames.forEach((name) => {
          const opt = document.createElement('option');
          opt.value = name;
          opt.textContent = name;
          if (selectedName && selectedName === name) opt.selected = true;
          sel.appendChild(opt);
        });
      });
    }

    // Gestion des onglets
    const tabs = document.querySelectorAll<HTMLButtonElement>('.modal-tab');
    const panels = document.querySelectorAll<HTMLElement>('.modal-tab-panel');

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const target = tab.getAttribute('data-tab');
        tabs.forEach((t) => {
          t.classList.remove('active');
          t.setAttribute('aria-selected', 'false');
        });
        panels.forEach((p) => p.classList.remove('active'));

        tab.classList.add('active');
        tab.setAttribute('aria-selected', 'true');
        if (target) {
          document.querySelector(`[data-panel="${target}"]`)?.classList.add('active');
        }
      });
    });

    // Choix sous-dossier custom
    selectTargetFolder?.addEventListener('change', () => {
      if (groupCustomFolder) {
        groupCustomFolder.style.display = selectTargetFolder.value === '__custom__' ? 'grid' : 'none';
      }
    });

    // Ouvrir / Fermer modale
    function openModal(defaultTab: 'tab-subject' | 'tab-file' | 'tab-note' = 'tab-subject', presetSubject?: string) {
      populateSubjectsSelect(presetSubject);
      tabs.forEach((t) => {
        const isMatch = t.getAttribute('data-tab') === defaultTab;
        t.classList.toggle('active', isMatch);
        t.setAttribute('aria-selected', isMatch ? 'true' : 'false');
      });
      panels.forEach((p) => {
        p.classList.toggle('active', p.getAttribute('data-panel') === defaultTab);
      });

      if (modal) modal.showModal();
    }

    btnOpen?.addEventListener('click', () => openModal('tab-subject'));
    btnClose?.addEventListener('click', () => modal?.close());
    btnCancelSubject?.addEventListener('click', () => modal?.close());
    btnCancelFile?.addEventListener('click', () => modal?.close());
    btnCancelNote?.addEventListener('click', () => modal?.close());

    modal?.addEventListener('click', (e) => {
      if (e.target === modal) modal.close();
    });

    // Boutons rapides "Ajouter un document" sur chaque carte matière
    document.querySelectorAll<HTMLButtonElement>('.btn-add-in-subject').forEach((btn) => {
      btn.addEventListener('click', () => {
        const subName = btn.getAttribute('data-subject-target') || '';
        openModal('tab-file', subName);
      });
    });

    // 2. Traitement formulaire : Créer une nouvelle matière
    formSubject?.addEventListener('submit', (e) => {
      e.preventDefault();
      const inputName = document.getElementById('new-subject-name') as HTMLInputElement;
      const name = inputName.value.trim();
      if (!name) return;

      const subfolders: string[] = [];
      if ((document.getElementById('preset-cm') as HTMLInputElement).checked) subfolders.push('CM');
      if ((document.getElementById('preset-td') as HTMLInputElement).checked) subfolders.push('TD');
      if ((document.getElementById('preset-revisions') as HTMLInputElement).checked) subfolders.push('Fiches de révisions');

      const slugId = name
        .toLowerCase()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-|-$/g, '');

      const existing = getCustomSubjects();
      if (!existing.some((s) => s.name.toLowerCase() === name.toLowerCase())) {
        existing.push({
          id: slugId,
          name,
          subfolders,
          createdAt: Date.now(),
        });
        saveCustomSubjects(existing);
      }

      modal?.close();
      inputName.value = '';
      showToast(`Matière « ${name} » ajoutée et répertoriée !`);
      renderDynamicSubjects();
    });

    // 3. Traitement formulaire : Importer / classer un document (Supabase)
    formFile?.addEventListener('submit', (e) => {
      e.preventDefault();
      const targetSubject = selectTargetSubject.value;
      let targetFolder = selectTargetFolder.value;
      if (targetFolder === '__custom__') {
        targetFolder = inputCustomFolder.value.trim() || 'Documents racines';
      }

      const fileInput = document.getElementById('course-file-input') as HTMLInputElement;
      if (!fileInput.files || !fileInput.files[0] || !targetSubject) return;

      const file = fileInput.files[0];
      const reader = new FileReader();

      reader.onload = async (evt) => {
        const dataUrl = evt.target?.result as string;
        try {
          await createUserCourse({
            title: file.name,
            tags: [targetSubject, targetFolder],
            body_md: dataUrl,
          });
          modal?.close();
          fileInput.value = '';
          if (inputCustomFolder) inputCustomFolder.value = '';
          showToast(`Document « ${file.name} » enregistré dans Supabase !`);
          await loadAndRenderSupabaseCourses();
        } catch (err: any) {
          alert('Erreur enregistrement Supabase: ' + err.message);
        }
      };

      reader.readAsDataURL(file);
    });

    // 4. Traitement formulaire : Rédiger une note / cours Markdown (Supabase)
    formNote?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const targetSubject = selectNoteSubject.value;
      const targetFolder = selectNoteFolder.value || 'Fiches de révisions';
      const title = noteTitleInput.value.trim();
      const body_md = noteBodyInput.value.trim();
      if (!targetSubject || !title) return;

      try {
        await createUserCourse({
          title,
          tags: [targetSubject, targetFolder],
          body_md,
        });
        modal?.close();
        noteTitleInput.value = '';
        noteBodyInput.value = '';
        showToast(`Cours « ${title} » enregistré dans Supabase !`);
        await loadAndRenderSupabaseCourses();
      } catch (err: any) {
        alert('Erreur enregistrement Supabase: ' + err.message);
      }
    });

    // 4. Rendu interactif des matières et documents ajoutés localement
    function renderDynamicSubjects() {
      const container = document.getElementById('subjects-container');
      if (!container) return;

      const customSubjects = getCustomSubjects();
      const customCourses = getCustomCourses();

      // Ajouter visuellement les nouvelles matières créées si pas déjà dans le DOM
      customSubjects.forEach((sub) => {
        let card = document.getElementById(`folder-${sub.id}`);
        if (!card) {
          card = document.createElement('section');
          card.className = 'panel subject-card';
          card.id = `folder-${sub.id}`;
          card.setAttribute('data-subject-card', sub.name);

          const subTreeHtml = sub.subfolders
            .map(
              (fName) => `
            <div class="td-section" data-folder-name="${fName}">
              <div class="td-header">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="td-folder-icon"><path d="M3 7.5A2.5 2.5 0 0 1 5.5 5h3.6l2 2.2h7.4A2.5 2.5 0 0 1 21 9.7v7.8a2.5 2.5 0 0 1-2.5 2.5h-13A2.5 2.5 0 0 1 3 17.5z"/></svg>
                <h3 class="td-title">${fName}</h3>
                <span class="meta td-count">0</span>
              </div>
              <ul class="file-list" role="list"></ul>
            </div>
          `
            )
            .join('');

          card.innerHTML = `
            <div class="subject-header">
              <div class="subject-title-wrap">
                <span class="subject-initial" aria-hidden="true">${sub.name.charAt(0).toUpperCase()}</span>
                <div>
                  <h2 class="subject-title">${sub.name}</h2>
                  <p class="subject-meta meta">
                    <span class="subject-count-label">Matière personnalisée</span>
                  </p>
                </div>
              </div>
              <button
                type="button"
                class="btn btn--sm btn-add-in-subject"
                data-subject-target="${sub.name}"
                title="Ajouter un document dans ${sub.name}"
              >
                + Ajouter un document
              </button>
            </div>
            <div class="folder-tree" id="tree-${sub.id}">
              ${subTreeHtml}
            </div>
          `;

          container.appendChild(card);

          card.querySelector('.btn-add-in-subject')?.addEventListener('click', () => {
            openModal('tab-file', sub.name);
          });
        }
      });

      // Injecter les fichiers de cours ajoutés
      customCourses.forEach((item) => {
        // Retrouver la carte de la matière
        const card = document.querySelector(`[data-subject-card="${item.subjectName}"]`);
        if (!card) return;

        const tree = card.querySelector('.folder-tree');
        if (!tree) return;

        const targetFolderName = item.folderName || 'Documents racines';
        let tdSection = tree.querySelector(`[data-folder-name="${targetFolderName}"]`);

        // Si le sous-dossier n'existe pas encore dans la carte, le créer
        if (!tdSection) {
          tdSection = document.createElement('div');
          tdSection.className = 'td-section';
          tdSection.setAttribute('data-folder-name', targetFolderName);
          tdSection.innerHTML = `
            <div class="td-header">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="td-folder-icon"><path d="M3 7.5A2.5 2.5 0 0 1 5.5 5h3.6l2 2.2h7.4A2.5 2.5 0 0 1 21 9.7v7.8a2.5 2.5 0 0 1-2.5 2.5h-13A2.5 2.5 0 0 1 3 17.5z"/></svg>
              <h3 class="td-title">${targetFolderName}</h3>
              <span class="meta td-count">0</span>
            </div>
            <ul class="file-list" role="list"></ul>
          `;
          tree.appendChild(tdSection);
        }

        const fileList = tdSection.querySelector('.file-list');
        if (fileList && !fileList.querySelector(`[data-custom-file-id="${item.id}"]`)) {
          const li = document.createElement('li');
          li.className = 'file-item';
          li.setAttribute('data-custom-file-id', item.id);

          const badgeExt = item.ext.replace('.', '').toUpperCase() || 'BIN';
          const sizeKb = (item.size / 1024).toFixed(1) + ' Ko';

          li.innerHTML = `
            <div class="file-info">
              <span class="file-badge file-badge--${item.type}">
                ${badgeExt}
              </span>
              <a href="${item.fileData || '#'}" download="${item.name}" class="file-name" title="Ouvrir / Télécharger ${item.name}">
                ${item.name}
              </a>
            </div>
            <div class="file-actions meta">
              <span>${sizeKb}</span>
              <a href="${item.fileData || '#'}" download="${item.name}" class="btn-consulter">
                Télécharger <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </a>
            </div>
          `;
          fileList.appendChild(li);

          // Incrémenter le compteur du sous-dossier
          const countBadge = tdSection.querySelector('.td-count');
          if (countBadge) countBadge.textContent = String(fileList.children.length);
        }
      });
    }

    // 5. Charger et afficher les cours depuis la base Supabase
    async function loadAndRenderSupabaseCourses() {
      try {
        const dbCourses = await fetchUserCourses();
        const container = document.querySelector('.subjects-grid');
        document.querySelectorAll('.file-item-supabase').forEach((el) => el.remove());

        dbCourses.forEach((c) => {
          let subject = c.title;
          let folder = 'Fiches & Notes';

          if (c.tags && c.tags.length > 0) {
            const cleanTags = c.tags.filter((t) => t !== 'Université' && t !== 'Dossier importé');
            if (cleanTags.length > 0) {
              subject = cleanTags[0];
              folder = cleanTags[1] || 'Fiches de révisions';
            }
          }

          // Vérifier si une carte existe déjà pour cette matière (par titre exact ou insensible à la casse)
          const allCards = Array.from(document.querySelectorAll<HTMLElement>('.subject-card'));
          const existingCard = allCards.find(
            (sc) =>
              sc.getAttribute('data-subject-card')?.toLowerCase().trim() === subject.toLowerCase().trim() ||
              sc.getAttribute('data-subject-card')?.toLowerCase().trim() === c.title.toLowerCase().trim()
          );

          if (existingCard) {
            subject = existingCard.getAttribute('data-subject-card') || subject;
          }

          const slugId = subject
            .toLowerCase()
            .normalize('NFD')
            .replace(/[\u0300-\u036f]/g, '')
            .replace(/[^a-z0-9]+/g, '-')
            .replace(/^-|-$/g, '');

          let card = existingCard || document.getElementById(`folder-${slugId}`);
          if (!card && container) {
            card = document.createElement('section');
            card.className = 'panel subject-card';
            card.id = `folder-${slugId}`;
            card.setAttribute('data-subject-card', subject);

            card.innerHTML = `
              <div class="subject-header">
                <div class="subject-title-wrap">
                  <span class="subject-initial" aria-hidden="true">${subject.charAt(0).toUpperCase()}</span>
                  <div>
                    <h2 class="subject-title">${subject}</h2>
                    <p class="subject-meta meta">
                      <span class="subject-count-label">Cours & Documents personnels</span>
                    </p>
                  </div>
                </div>
                <button
                  type="button"
                  class="btn btn--sm btn-add-in-subject"
                  data-subject-target="${subject}"
                  title="Ajouter un document dans ${subject}"
                >
                  + Ajouter un cours
                </button>
              </div>
              <div class="folder-tree" id="tree-${slugId}"></div>
            `;

            card.querySelector('.btn-add-in-subject')?.addEventListener('click', () => {
              openModal('tab-note', subject);
            });

            container.appendChild(card);
          }

          const tree = card?.querySelector('.folder-tree');
          if (!tree) return;

          let tdSection = tree.querySelector(`[data-folder-name="${folder}"]`);
          if (!tdSection) {
            tdSection = document.createElement('div');
            tdSection.className = 'td-section';
            tdSection.setAttribute('data-folder-name', folder);
            tdSection.innerHTML = `
              <div class="td-header">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="td-folder-icon"><path d="M3 7.5A2.5 2.5 0 0 1 5.5 5h3.6l2 2.2h7.4A2.5 2.5 0 0 1 21 9.7v7.8a2.5 2.5 0 0 1-2.5 2.5h-13A2.5 2.5 0 0 1 3 17.5z"/></svg>
                <h3 class="td-title">${folder}</h3>
                <span class="meta td-count">0</span>
              </div>
              <ul class="file-list" role="list"></ul>
            `;
            tree.appendChild(tdSection);
          }

          const fileList = tdSection.querySelector('.file-list');
          if (fileList) {
            const li = document.createElement('li');
            li.className = 'file-item file-item-supabase';
            const isDataUrl = c.body_md && c.body_md.startsWith('data:');
            const badgeLabel = isDataUrl ? 'DOC' : 'NOTE';

            li.innerHTML = `
              <div class="file-info">
                <span class="file-badge file-badge--doc">${badgeLabel}</span>
                <span class="file-name" style="cursor: pointer;">${c.title}</span>
              </div>
              <div class="file-actions meta">
                <button type="button" class="btn btn--sm btn-consult-db">Consulter</button>
                <button type="button" class="btn btn--danger btn--sm btn-del-db" title="Supprimer de la base">✕</button>
              </div>
            `;

            li.querySelector('.btn-consult-db')?.addEventListener('click', () => {
              if (isDataUrl) {
                const a = document.createElement('a');
                a.href = c.body_md;
                a.download = c.title;
                a.click();
              } else {
                if (viewNoteTitle) viewNoteTitle.textContent = c.title;
                if (viewNoteMeta) viewNoteMeta.textContent = `${subject} / ${folder}`;
                if (viewNoteContent) viewNoteContent.innerHTML = renderMarkdown(c.body_md);
                modalViewNote?.showModal();
              }
            });

            li.querySelector('.btn-del-db')?.addEventListener('click', async () => {
              if (confirm(`Supprimer définitivement « ${c.title} » de votre base de données Supabase ?`)) {
                try {
                  if (c.id) await deleteUserCourse(c.id);
                  showToast(`« ${c.title} » supprimé.`);
                  await loadAndRenderSupabaseCourses();
                } catch (err: any) {
                  alert(err.message);
                }
              }
            });

            fileList.appendChild(li);

            const countBadge = tdSection.querySelector('.td-count');
            if (countBadge) countBadge.textContent = String(fileList.children.length);
          }
        });
      } catch (err) {
        console.warn('Erreur chargement Supabase courses:', err);
      }
    }

    renderDynamicSubjects();
    loadAndRenderSupabaseCourses();
  }

  document.addEventListener('astro:page-load', initCourseManager);
</script>

