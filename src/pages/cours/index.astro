---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import CourseManagerModal from '../../components/CourseManagerModal.astro';
import PdfViewerModal from '../../components/PdfViewerModal.astro';
import { getCourses, formatFileSize } from '../../utils/courses';
import { url } from '../../utils/url';

const subjects = getCourses();
const totalCourses = subjects.length;
const totalFiles = subjects.reduce((acc, s) => acc + s.stats.totalFiles, 0);
const totalPdfs = subjects.reduce((acc, s) => acc + s.stats.pdfCount, 0);

const subjectsList = subjects.map((s) => ({
  id: s.id,
  name: s.name,
  subfolders: s.folder.subfolders.map((f) => f.name),
}));
---

<Base
  title="Mes Cours"
  description="Accès direct et visionneuse de vos cours, TD, travaux pratiques et documents académiques."
>
  <div class="container container--wide app-page courses-page" data-courses-root data-subjects={JSON.stringify(subjectsList)}>
    <header class="page-header courses-hero">
      <div class="courses-hero-top">
        <div>
          <p class="crumbs"><a href={url('/')}>Accueil</a> / Cours</p>
          <h1 class="courses-title">Mes Cours</h1>
          <p class="courses-motto">Supports de cours, énoncés de TD et fiches de révisions.</p>
        </div>
        <div class="courses-hero-actions">
          <button type="button" class="btn btn--primary btn--sm" id="btn-open-add-course">
            <Icon name="folder" size={14} />
            Ajouter / Classer un cours
          </button>
          <a href={url('/configuration/')} class="btn btn--sm">
            <Icon name="settings" size={14} />
            Configuration
          </a>
        </div>
      </div>
      <div class="meta stats-bar">
        <span>{totalCourses} matières</span>
        <span class="sep">·</span>
        <span>{totalFiles} fichiers</span>
        <span class="sep">·</span>
        <span>{totalPdfs} documents PDF</span>
      </div>
    </header>

    <!-- Zone de statut / notification d'ajout local -->
    <div id="course-toast" class="panel course-toast" style="display: none;">
      <span class="toast-dot"></span>
      <span id="toast-message">Matière ajoutée avec succès.</span>
    </div>

    <!-- Grille des matières avec DA Marges -->
    <div class="subjects-grid" id="subjects-container">
      {subjects.map((sub) => (
        <section class="panel subject-card" id={`folder-${sub.id}`} data-subject-card={sub.name}>
          <div class="subject-header">
            <div class="subject-title-wrap">
              <span class="subject-initial" aria-hidden="true">{sub.name.charAt(0).toUpperCase()}</span>
              <div>
                <h2 class="subject-title">{sub.name}</h2>
                <p class="subject-meta meta">
                  <span class="subject-count-label">
                    {sub.stats.totalFiles} fichiers · {sub.stats.pdfCount} PDF
                    {sub.stats.docCount ? ` · ${sub.stats.docCount} Word` : ''}
                    {sub.stats.codeCount ? ` · ${sub.stats.codeCount} code` : ''}
                  </span>
                </p>
              </div>
            </div>
            <button
              type="button"
              class="btn btn--sm btn-add-in-subject"
              data-subject-target={sub.name}
              title={`Ajouter un document dans ${sub.name}`}
            >
              + Ajouter un document
            </button>
          </div>

          <!-- Arborescence des dossiers & fichiers -->
          <div class="folder-tree" id={`tree-${sub.id}`}>
            {sub.folder.subfolders.map((td) => (
              <div class="td-section" data-folder-name={td.name}>
                <div class="td-header">
                  <Icon name="folder" size={16} class="td-folder-icon" />
                  <h3 class="td-title">{td.name}</h3>
                  <span class="meta td-count">{td.files.length}</span>
                </div>
                <ul class="file-list" role="list">
                  {td.files.map((file) => (
                    <li class="file-item">
                      <div class="file-info">
                        <span class={`file-badge file-badge--${file.type}`}>
                          {file.ext ? file.ext.replace('.', '').toUpperCase() : 'BIN'}
                        </span>
                        <a href={file.viewerUrl} class="file-name" title={`Ouvrir ${file.name}`}>
                          {file.name}
                        </a>
                      </div>
                      <div class="file-actions meta">
                        <span>{formatFileSize(file.size)}</span>
                        <a href={file.viewerUrl} class="btn-consulter">
                          Consulter <Icon name="arrow-right" size={13} />
                        </a>
                      </div>
                    </li>
                  ))}
                </ul>
              </div>
            ))}

            {sub.folder.files.length > 0 && (
              <div class="td-section" data-folder-name="Documents racines">
                <div class="td-header">
                  <Icon name="file" size={16} class="td-folder-icon" />
                  <h3 class="td-title">Documents racines</h3>
                  <span class="meta td-count">{sub.folder.files.length}</span>
                </div>
                <ul class="file-list" role="list">
                  {sub.folder.files.map((file) => (
                    <li class="file-item">
                      <div class="file-info">
                        <span class={`file-badge file-badge--${file.type}`}>
                          {file.ext ? file.ext.replace('.', '').toUpperCase() : 'BIN'}
                        </span>
                        <a href={file.viewerUrl} class="file-name" title={`Ouvrir ${file.name}`}>
                          {file.name}
                        </a>
                      </div>
                      <div class="file-actions meta">
                        <span>{formatFileSize(file.size)}</span>
                        <a href={file.viewerUrl} class="btn-consulter">
                          Consulter <Icon name="arrow-right" size={13} />
                        </a>
                      </div>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        </section>
      ))}
    </div>

    <!-- Modale de création et de classement de cours -->
    <CourseManagerModal />

    <!-- Lecteur PDF immersif -->
    <PdfViewerModal />

    <!-- Modale de consultation d'un cours / note Markdown (Supabase) -->
    <dialog class="panel course-modal" id="modal-view-note" style="max-width: 680px; width: 90%;">
      <div class="modal-inner">
        <header class="modal-header">
          <div>
            <span class="label" id="view-note-meta">Matière / Catégorie</span>
            <h2 class="modal-title" id="view-note-title">Titre</h2>
          </div>
          <button type="button" class="btn-close" id="btn-close-view-note" aria-label="Fermer">✕</button>
        </header>
        <div class="markdown-preview" id="view-note-content" style="max-height: 60vh; overflow-y: auto; padding: 1rem 0;"></div>
        <div class="modal-actions">
          <button type="button" class="btn btn--sm" id="btn-dismiss-note">Fermer</button>
        </div>
      </div>
    </dialog>
  </div>
</Base>

<script>
  import {
    fetchUserCourses,
    getUserCoursesImmediate,
    createUserCourse,
    deleteUserCourse,
    type DbCourse,
  } from '../../utils/supabase';
  import { setupPdfViewerModal, openPdfViewer } from '../../utils/pdfViewer';
  import { saveDocumentBlob } from '../../utils/fileStorage';
  import { processFolderUpload } from '../../utils/courseImport';

  function renderMarkdown(md: string): string {
    if (!md) return '<p class="meta">Aucun contenu.</p>';
    const escaped = md
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;');

    return escaped
      .replace(/^### (.*$)/gim, '<h3>$1</h3>')
      .replace(/^## (.*$)/gim, '<h2>$1</h2>')
      .replace(/^# (.*$)/gim, '<h1>$1</h1>')
      .replace(/^\> (.*$)/gim, '<blockquote>$1</blockquote>')
      .replace(/\*\*(.*?)\*\*/gim, '<strong>$1</strong>')
      .replace(/\*(.*?)\*/gim, '<em>$1</em>')
      .replace(/`([^`]+)`/gim, '<code>$1</code>')
      .replace(/^\- (.*$)/gim, '<li>$1</li>')
      .replace(/\n\n+/g, '</p><p>')
      .replace(/\n/g, '<br />');
  }



  function initCourseManager() {
    const root = document.querySelector('[data-courses-root]');
    if (!root) return;

    const modal = document.getElementById('modal-manage-course') as HTMLDialogElement;
    const btnOpen = document.getElementById('btn-open-add-course');
    const btnClose = document.getElementById('btn-close-course-modal');
    const btnCancelSubject = document.getElementById('btn-cancel-subject');
    const btnCancelFile = document.getElementById('btn-cancel-file');
    const btnCancelNote = document.getElementById('btn-cancel-note');

    const modalViewNote = document.getElementById('modal-view-note') as HTMLDialogElement;
    const viewNoteTitle = document.getElementById('view-note-title');
    const viewNoteMeta = document.getElementById('view-note-meta');
    const viewNoteContent = document.getElementById('view-note-content');
    const btnCloseViewNote = document.getElementById('btn-close-view-note');
    const btnDismissNote = document.getElementById('btn-dismiss-note');

    btnCloseViewNote?.addEventListener('click', () => modalViewNote?.close());
    btnDismissNote?.addEventListener('click', () => modalViewNote?.close());

    const formSubject = document.getElementById('form-create-subject') as HTMLFormElement;
    const formFile = document.getElementById('form-upload-file') as HTMLFormElement;
    const formNote = document.getElementById('form-create-note') as HTMLFormElement;

    const selectTargetSubject = document.getElementById('select-target-subject') as HTMLSelectElement;
    const selectTargetFolder = document.getElementById('select-target-folder') as HTMLSelectElement;
    const selectNoteSubject = document.getElementById('select-note-subject') as HTMLSelectElement;
    const selectNoteFolder = document.getElementById('select-note-folder') as HTMLSelectElement;
    const groupCustomFolder = document.getElementById('group-custom-folder');
    const inputCustomFolder = document.getElementById('input-custom-folder') as HTMLInputElement;

    const noteTitleInput = document.getElementById('note-title-input') as HTMLInputElement;
    const noteBodyInput = document.getElementById('note-body-input') as HTMLTextAreaElement;

    const toast = document.getElementById('course-toast');
    const toastMsg = document.getElementById('toast-message');

    // 1. Lire les matières initiales
    const rawSubjects = root.getAttribute('data-subjects');
    const baseSubjects: Array<{ id: string; name: string; subfolders: string[] }> = rawSubjects ? JSON.parse(rawSubjects) : [];

    let cachedDbCourses: DbCourse[] = [];

    function showToast(msg: string) {
      if (toast && toastMsg) {
        toastMsg.textContent = msg;
        toast.style.display = 'flex';
        setTimeout(() => {
          toast.style.display = 'none';
        }, 5000);
      }
    }

    // Mise à jour de la liste déroulante des matières (Socle + Supabase)
    function populateSubjectsSelect(selectedName?: string) {
      const dbSubjectNames = new Set<string>();
      cachedDbCourses.forEach((c) => {
        if (c.tags && c.tags.length > 0) {
          const s = c.tags[0];
          if (s && s !== 'Université' && s !== 'Dossier importé') dbSubjectNames.add(s);
        } else if (c.title) {
          dbSubjectNames.add(c.title);
        }
      });

      const allNames = Array.from(new Set([...baseSubjects.map((s) => s.name), ...Array.from(dbSubjectNames)])).sort((a, b) => a.localeCompare(b));

      [selectTargetSubject, selectNoteSubject].forEach((sel) => {
        if (!sel) return;
        sel.innerHTML = '<option value="" disabled selected>Sélectionner une matière...</option>';
        allNames.forEach((name) => {
          const opt = document.createElement('option');
          opt.value = name;
          opt.textContent = name;
          if (selectedName && selectedName === name) opt.selected = true;
          sel.appendChild(opt);
        });
      });
    }

    // Gestion des onglets
    const tabs = document.querySelectorAll<HTMLButtonElement>('.modal-tab');
    const panels = document.querySelectorAll<HTMLElement>('.modal-tab-panel');

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const target = tab.getAttribute('data-tab');
        tabs.forEach((t) => {
          t.classList.remove('active');
          t.setAttribute('aria-selected', 'false');
        });
        panels.forEach((p) => p.classList.remove('active'));

        tab.classList.add('active');
        tab.setAttribute('aria-selected', 'true');
        if (target) {
          document.querySelector(`[data-panel="${target}"]`)?.classList.add('active');
        }
      });
    });

    // Choix sous-dossier custom
    selectTargetFolder?.addEventListener('change', () => {
      if (groupCustomFolder) {
        groupCustomFolder.style.display = selectTargetFolder.value === '__custom__' ? 'grid' : 'none';
      }
    });

    // Initialisation du lecteur PDF interactif
    setupPdfViewerModal();

    const btnCancelFolder = document.getElementById('btn-cancel-folder');
    const btnStartFolderImport = document.getElementById('btn-start-folder-import');
    const courseFolderInput = document.getElementById('course-folder-input') as HTMLInputElement | null;
    const folderImportStatus = document.getElementById('folder-import-status');

    btnCancelFolder?.addEventListener('click', () => modal?.close());
    btnStartFolderImport?.addEventListener('click', () => {
      courseFolderInput?.click();
    });

    courseFolderInput?.addEventListener('change', async () => {
      if (!courseFolderInput.files || courseFolderInput.files.length === 0) return;
      try {
        if (folderImportStatus) {
          folderImportStatus.style.display = 'block';
          folderImportStatus.textContent = 'Importation des documents en cours...';
        }
        const res = await processFolderUpload(courseFolderInput.files, (msg) => {
          if (folderImportStatus) folderImportStatus.textContent = msg;
        });
        showToast(`${res.subjectCount} matière(s) et ${res.fileCount} fichier(s) importés !`);
        modal?.close();
        courseFolderInput.value = '';
        if (folderImportStatus) folderImportStatus.style.display = 'none';
        await loadAndRenderSupabaseCourses();
      } catch (err: any) {
        alert('Erreur importation dossier : ' + err.message);
        if (folderImportStatus) folderImportStatus.style.display = 'none';
      }
    });

    // Ouvrir / Fermer modale
    function openModal(defaultTab: 'tab-subject' | 'tab-file' | 'tab-folder' | 'tab-note' = 'tab-subject', presetSubject?: string) {
      populateSubjectsSelect(presetSubject);
      tabs.forEach((t) => {
        const isMatch = t.getAttribute('data-tab') === defaultTab;
        t.classList.toggle('active', isMatch);
        t.setAttribute('aria-selected', isMatch ? 'true' : 'false');
      });
      panels.forEach((p) => {
        p.classList.toggle('active', p.getAttribute('data-panel') === defaultTab);
      });

      if (modal) modal.showModal();
    }

    btnOpen?.addEventListener('click', () => openModal('tab-subject'));
    btnClose?.addEventListener('click', () => modal?.close());
    btnCancelSubject?.addEventListener('click', () => modal?.close());
    btnCancelFile?.addEventListener('click', () => modal?.close());
    btnCancelNote?.addEventListener('click', () => modal?.close());

    modal?.addEventListener('click', (e) => {
      if (e.target === modal) modal.close();
    });

    // Boutons rapides "Ajouter un document" sur chaque carte matière
    document.querySelectorAll<HTMLButtonElement>('.btn-add-in-subject').forEach((btn) => {
      btn.addEventListener('click', () => {
        const subName = btn.getAttribute('data-subject-target') || '';
        openModal('tab-file', subName);
      });
    });

    // 2. Traitement formulaire : Créer une nouvelle matière (enregistrée dans Supabase)
    formSubject?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const inputName = document.getElementById('new-subject-name') as HTMLInputElement;
      const name = inputName.value.trim();
      if (!name) return;

      const subfolders: string[] = [];
      if ((document.getElementById('preset-cm') as HTMLInputElement).checked) subfolders.push('CM');
      if ((document.getElementById('preset-td') as HTMLInputElement).checked) subfolders.push('TD');
      if ((document.getElementById('preset-revisions') as HTMLInputElement).checked) subfolders.push('Fiches de révisions');

      try {
        await createUserCourse({
          title: name,
          tags: [name, 'Matière'],
          body_md: `## Matière : ${name}\n\nSous-dossiers configurés : ${subfolders.join(', ')}`,
        });
        modal?.close();
        inputName.value = '';
        showToast(`Matière « ${name} » enregistrée dans votre banque de cours Supabase !`);
        await loadAndRenderSupabaseCourses();
      } catch (err: any) {
        alert('Erreur enregistrement Supabase : ' + (err.message || err));
      }
    });

    // 3. Traitement formulaire : Importer / classer un document (Supabase + IndexedDB)
    formFile?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const targetSubject = selectTargetSubject.value;
      let targetFolder = selectTargetFolder.value;
      if (targetFolder === '__custom__') {
        targetFolder = inputCustomFolder.value.trim() || 'Documents racines';
      }

      const fileInput = document.getElementById('course-file-input') as HTMLInputElement;
      if (!fileInput.files || !fileInput.files[0] || !targetSubject) return;

      const file = fileInput.files[0];
      const user = getCurrentUserCached();
      const userId = user?.id || '';

      // Sauvegarde immédiate dans IndexedDB pour lecture locale haute performance
      await saveDocumentBlob(`doc:${userId}:${targetSubject}:${targetFolder}:${file.name}`, file);
      await saveDocumentBlob(`doc:${userId}:${file.name}`, file);
      await saveDocumentBlob(`doc:${file.name}`, file);
      await saveDocumentBlob(file.name, file);

      const reader = new FileReader();
      reader.onload = async (evt) => {
        const dataUrl = evt.target?.result as string;
        try {
          const body_md = file.size <= 3 * 1024 * 1024 ? dataUrl : `[Fichier local : ${file.name}]`;
          await createUserCourse({
            title: file.name,
            tags: [targetSubject, targetFolder],
            body_md,
          });
          modal?.close();
          fileInput.value = '';
          if (inputCustomFolder) inputCustomFolder.value = '';
          showToast(`Document « ${file.name} » enregistré et prêt à être lu !`);
          await loadAndRenderSupabaseCourses();
        } catch (err: any) {
          alert('Erreur enregistrement Supabase: ' + err.message);
        }
      };

      reader.readAsDataURL(file);
    });

    // 4. Traitement formulaire : Rédiger une note / cours Markdown (Supabase)
    formNote?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const targetSubject = selectNoteSubject.value;
      const targetFolder = selectNoteFolder.value || 'Fiches de révisions';
      const title = noteTitleInput.value.trim();
      const body_md = noteBodyInput.value.trim();
      if (!targetSubject || !title) return;

      try {
        await createUserCourse({
          title,
          tags: [targetSubject, targetFolder],
          body_md,
        });
        modal?.close();
        noteTitleInput.value = '';
        noteBodyInput.value = '';
        showToast(`Cours « ${title} » enregistré dans Supabase !`);
        await loadAndRenderSupabaseCourses();
      } catch (err: any) {
        alert('Erreur enregistrement Supabase: ' + err.message);
      }
    });

    // 4. Charger et afficher les cours depuis la base Supabase avec classement intelligent
    function getFolderSortScore(name: string): number {
      const low = name.toLowerCase();
      if (low === 'cm' || low.includes('cours')) return 10;
      if (low === 'td' || low.includes('dirigé')) return 20;
      if (low === 'tp' || low.includes('pratique')) return 30;
      if (low.includes('fiche') || low.includes('revision') || low.includes('révision')) return 40;
      if (low.includes('programme') || low.includes('notion') || low.includes('clé')) return 50;
      if (low.includes('document') || low.includes('général') || low.includes('racine')) return 60;
      return 70;
    }

    function parseMarkdownSubfolders(body_md: string) {
      if (!body_md) return [];
      const sections: Array<{ folderName: string; items: Array<{ title: string; url?: string; ext: string; content?: string }> }> = [];
      const lines = body_md.split('\n');
      let currentFolder = '';
      let currentItems: Array<{ title: string; url?: string; ext: string; content?: string }> = [];

      for (let line of lines) {
        const trimmed = line.trim();
        if (trimmed.startsWith('### ')) {
          if (currentFolder && currentItems.length > 0) {
            sections.push({ folderName: currentFolder, items: currentItems });
          }
          currentFolder = trimmed.replace(/^###\s+/, '').trim();
          currentItems = [];
        } else if (trimmed.startsWith('- ') || trimmed.startsWith('* ')) {
          const raw = trimmed.replace(/^[-*]\s+/, '').trim();
          const linkMatch = raw.match(/^\[([^\]]+)\]\(([^)]+)\)/);
          let title = raw;
          let fileUrl = '';
          if (linkMatch) {
            title = linkMatch[1];
            fileUrl = linkMatch[2];
          }
          let ext = 'note';
          const extMatch = title.match(/\.([a-zA-Z0-9]+)(\s|$|\))/);
          if (extMatch) {
            ext = extMatch[1].toLowerCase();
          } else if (fileUrl && fileUrl.endsWith('.pdf')) {
            ext = 'pdf';
          }
          currentItems.push({ title, url: fileUrl, ext, content: raw });
        }
      }

      if (currentFolder && currentItems.length > 0) {
        sections.push({ folderName: currentFolder, items: currentItems });
      }

      if (sections.length === 0 && currentItems.length > 0) {
        sections.push({ folderName: 'Programme & Notions-clés', items: currentItems });
      }

      return sections;
    }

    function renderCoursesGrid(dbCourses: DbCourse[]) {
      const container = document.querySelector('.subjects-grid');
      if (!container) return;

      document.querySelectorAll('.file-item-supabase').forEach((el) => el.remove());
      document.querySelectorAll('.subject-card-supabase').forEach((el) => el.remove());

      if (!dbCourses || dbCourses.length === 0) {
        populateSubjectsSelect();
        return;
      }

      // Regrouper par matière
      interface SubjectData {
        name: string;
        folders: Map<string, Array<{ id?: string; title: string; url?: string; ext: string; rawCourse?: DbCourse; content?: string }>>;
      }

      const subjectsMap = new Map<string, SubjectData>();

      dbCourses.forEach((c) => {
        let subject = '';
        if (c.tags && c.tags.length > 0) {
          const cleanTags = c.tags.filter((t) => t !== 'Université' && t !== 'Dossier importé' && t !== 'Matière' && t !== 'Supports de cours');
          if (cleanTags.length > 0) subject = cleanTags[0];
        }
        if (!subject && c.title) subject = c.title;
        subject = subject.trim();
        if (!subject) subject = 'Général';

        if (!subjectsMap.has(subject)) {
          subjectsMap.set(subject, { name: subject, folders: new Map() });
        }
        const sData = subjectsMap.get(subject)!;

        // Vérifier si c'est un module / conteneur de cours avec sous-dossiers markdown
        const parsedSections = parseMarkdownSubfolders(c.body_md);

        if (parsedSections.length > 0) {
          parsedSections.forEach((sec) => {
            if (!sData.folders.has(sec.folderName)) {
              sData.folders.set(sec.folderName, []);
            }
            const fList = sData.folders.get(sec.folderName)!;
            sec.items.forEach((item) => {
              fList.push({
                id: c.id,
                title: item.title,
                url: item.url,
                ext: item.ext,
                rawCourse: c,
                content: item.content,
              });
            });
          });
        } else if (!c.tags?.includes('Matière')) {
          // Document ou note individuel
          let folder = 'Fiches & Notes';
          if (c.tags && c.tags.length > 1) {
            const cleanTags = c.tags.filter((t) => t !== 'Université' && t !== 'Dossier importé' && t !== 'Matière' && t !== subject);
            if (cleanTags.length > 0) folder = cleanTags[0];
          }
          if (!sData.folders.has(folder)) {
            sData.folders.set(folder, []);
          }
          const isDataUrl = c.body_md && c.body_md.startsWith('data:');
          let ext = isDataUrl ? 'doc' : 'note';
          const extMatch = c.title.match(/\.([a-zA-Z0-9]+)$/);
          if (extMatch) ext = extMatch[1].toLowerCase();

          sData.folders.get(folder)!.push({
            id: c.id,
            title: c.title,
            ext,
            rawCourse: c,
            content: c.body_md,
          });
        }
      });

      let totalSubjectCount = subjectsMap.size;
      let totalDocCount = 0;

      // Trier les matières par ordre alphabétique
      const sortedSubjects = Array.from(subjectsMap.values()).sort((a, b) => a.name.localeCompare(b.name));

      sortedSubjects.forEach((sData) => {
        const subject = sData.name;
        const slugId = subject
          .toLowerCase()
          .normalize('NFD')
          .replace(/[\u0300-\u036f]/g, '')
          .replace(/[^a-z0-9]+/g, '-')
          .replace(/^-|-$/g, '');

        let card = document.getElementById(`folder-${slugId}`);
        if (!card) {
          card = document.createElement('section');
          card.className = 'panel subject-card subject-card-supabase';
          card.id = `folder-${slugId}`;
          card.setAttribute('data-subject-card', subject);

          card.innerHTML = `
            <div class="subject-header">
              <div class="subject-title-wrap">
                <span class="subject-initial" aria-hidden="true">${subject.charAt(0).toUpperCase()}</span>
                <div>
                  <h2 class="subject-title">${subject}</h2>
                  <p class="subject-meta meta">
                    <span class="subject-count-label">Matière synchronisée</span>
                  </p>
                </div>
              </div>
              <button
                type="button"
                class="btn btn--sm btn-add-in-subject"
                data-subject-target="${subject}"
                title="Ajouter un document dans ${subject}"
              >
                + Ajouter un cours
              </button>
            </div>
            <div class="folder-tree" id="tree-${slugId}"></div>
          `;

          card.querySelector('.btn-add-in-subject')?.addEventListener('click', () => {
            openModal('tab-file', subject);
          });

          container.appendChild(card);
        }

        const tree = card.querySelector('.folder-tree');
        if (!tree) return;

        // Trier les dossiers selon l'ordre académique (CM, TD, TP, Fiches, etc.)
        const sortedFolderNames = Array.from(sData.folders.keys()).sort((a, b) => {
          const scoreDiff = getFolderSortScore(a) - getFolderSortScore(b);
          return scoreDiff !== 0 ? scoreDiff : a.localeCompare(b);
        });

        let subjectDocCount = 0;

        sortedFolderNames.forEach((folderName) => {
          const files = sData.folders.get(folderName) || [];
          if (files.length === 0) return;
          subjectDocCount += files.length;
          totalDocCount += files.length;

          let tdSection = tree.querySelector(`[data-folder-name="${folderName}"]`);
          if (!tdSection) {
            tdSection = document.createElement('div');
            tdSection.className = 'td-section';
            tdSection.setAttribute('data-folder-name', folderName);
            tdSection.innerHTML = `
              <div class="td-header">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="td-folder-icon"><path d="M3 7.5A2.5 2.5 0 0 1 5.5 5h3.6l2 2.2h7.4A2.5 2.5 0 0 1 21 9.7v7.8a2.5 2.5 0 0 1-2.5 2.5h-13A2.5 2.5 0 0 1 3 17.5z"/></svg>
                <h3 class="td-title">${folderName}</h3>
                <span class="meta td-count">${files.length}</span>
              </div>
              <ul class="file-list" role="list"></ul>
            `;
            tree.appendChild(tdSection);
          }

          const fileList = tdSection.querySelector('.file-list');
          if (!fileList) return;

          files.forEach((file) => {
            const li = document.createElement('li');
            li.className = 'file-item file-item-supabase';

            const isPdf = file.ext === 'pdf' || file.title.toLowerCase().endsWith('.pdf');
            const badgeClass = isPdf ? 'file-badge--pdf' : 'file-badge--doc';

            li.innerHTML = `
              <div class="file-info">
                <span class="file-badge ${badgeClass}">${badgeLabel}</span>
                <span class="file-name" style="cursor: pointer;" title="Consulter ${file.title}">${file.title}</span>
              </div>
              <div class="file-actions meta">
                <button type="button" class="btn btn--sm btn-consult-db">Consulter</button>
                ${file.id && file.rawCourse && file.rawCourse.title === file.title ? `<button type="button" class="btn btn--danger btn--sm btn-del-db" title="Supprimer">✕</button>` : ''}
              </div>
            `;

            const onConsult = () => {
              if (isPdf) {
                openPdfViewer({
                  title: file.title,
                  subject,
                  folder: folderName,
                  fileUrl: file.url,
                  rawCourse: file.rawCourse,
                });
              } else if (file.url) {
                window.open(file.url, '_blank');
              } else if (file.rawCourse && file.rawCourse.body_md && file.rawCourse.body_md.startsWith('data:')) {
                const a = document.createElement('a');
                a.href = file.rawCourse.body_md;
                a.download = file.title;
                a.click();
              } else {
                if (viewNoteTitle) viewNoteTitle.textContent = file.title;
                if (viewNoteMeta) viewNoteMeta.textContent = `${subject} / ${folderName}`;
                if (viewNoteContent) {
                  viewNoteContent.innerHTML = renderMarkdown(file.content || file.rawCourse?.body_md || file.title);
                }
                modalViewNote?.showModal();
              }
            };

            li.querySelector('.file-name')?.addEventListener('click', onConsult);
            li.querySelector('.btn-consult-db')?.addEventListener('click', onConsult);

            li.querySelector('.btn-del-db')?.addEventListener('click', async () => {
              if (confirm(`Supprimer définitivement « ${file.title} » ?`)) {
                try {
                  if (file.id) await deleteUserCourse(file.id);
                  showToast(`« ${file.title} » supprimé.`);
                  await loadAndRenderSupabaseCourses();
                } catch (err: any) {
                  alert(err.message);
                }
              }
            });

            fileList.appendChild(li);
          });

          const countBadge = tdSection.querySelector('.td-count');
          if (countBadge) countBadge.textContent = String(fileList.children.length);
        });

        // Mettre à jour le libellé de stats de la carte
        const countLabel = card.querySelector('.subject-count-label');
        if (countLabel) {
          const folderCount = sortedFolderNames.length;
          countLabel.textContent = `${folderCount} dossier${folderCount > 1 ? 's' : ''} · ${subjectDocCount} document${subjectDocCount > 1 ? 's' : ''}`;
        }
      });

      // Mettre à jour la barre de stats globale en haut de page
      const statsBar = document.querySelector('.courses-hero .stats-bar');
      if (statsBar && totalSubjectCount > 0) {
        statsBar.innerHTML = `
          <span>${totalSubjectCount} matière${totalSubjectCount > 1 ? 's' : ''}</span>
          <span class="sep">·</span>
          <span>${totalDocCount} document${totalDocCount > 1 ? 's' : ''}</span>
          <span class="sep">·</span>
          <span>Synchronisé</span>
        `;
      }

      populateSubjectsSelect();
    }

    async function loadAndRenderSupabaseCourses() {
      // 1. Affichage instantané depuis le cache local (0 milliseconde de latence)
      const immediateCourses = getUserCoursesImmediate();
      if (immediateCourses && immediateCourses.length > 0) {
        cachedDbCourses = immediateCourses;
        renderCoursesGrid(immediateCourses);
      }

      // 2. Synchronisation transparente avec Supabase en arrière-plan
      try {
        const remoteCourses = await fetchUserCourses().catch(() => immediateCourses);
        if (remoteCourses && remoteCourses.length > 0) {
          cachedDbCourses = remoteCourses;
          renderCoursesGrid(remoteCourses);
        }
      } catch (err) {
        console.warn('[Courses] Synchronisation réseau en arrière-plan:', err);
      }
    }

    loadAndRenderSupabaseCourses();
  }

  if (typeof window !== 'undefined') {
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCourseManager);
    } else {
      initCourseManager();
    }
    document.addEventListener('astro:page-load', initCourseManager);
  }
</script>

