---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { getCourses } from '../../utils/courses';
import { url } from '../../utils/url';

const subjects = getCourses();
const subjectsList = subjects.map((s) => ({
  id: s.id,
  name: s.name,
  subfolders: s.folder.subfolders.map((f) => f.name),
}));
---

<Base
  title="Notes — Prise de notes"
  description="Espace de prise de notes inspiré de Notion. Rédigez en Markdown, classez directement dans vos cours et profitez d'une sauvegarde automatique."
>
  <div class="notes-workspace" data-notes-workspace data-subjects={JSON.stringify(subjectsList)}>
    <!-- 1. Barre latérale Notion (Arborescence et recherche) -->
    <aside class="notes-sidebar" id="notes-sidebar">
      <div class="sidebar-header">
        <div class="workspace-brand">
          <span class="workspace-icon" aria-hidden="true">
            <Icon name="edit" size={15} />
          </span>
          <span class="workspace-title">Mes Notes</span>
        </div>
        <button
          type="button"
          class="btn-icon"
          id="btn-collapse-sidebar"
          title="Masquer la barre latérale"
          aria-label="Masquer la barre latérale"
        >
          <Icon name="layout" size={15} />
        </button>
      </div>

      <!-- Recherche avec conteneur flex aligné -->
      <div class="sidebar-search">
        <div class="search-box">
          <Icon name="search" size={13} class="search-icon" />
          <input
            type="search"
            id="notes-search-input"
            placeholder="Rechercher une note..."
            autocomplete="off"
            aria-label="Rechercher une note"
          />
        </div>
      </div>

      <div class="sidebar-actions">
        <button type="button" class="btn btn--primary btn--sm btn-new-note" id="btn-create-note">
          <Icon name="plus" size={13} />
          <span>Nouvelle note</span>
        </button>
      </div>

      <!-- Liste arborescente des notes classées par matière -->
      <nav class="notes-tree" id="notes-tree-container" aria-label="Liste de vos notes">
        <div class="sidebar-loading">Chargement des notes...</div>
      </nav>

      <div class="sidebar-footer">
        <div class="sync-indicator" id="sidebar-sync-indicator" title="État de la synchronisation">
          <span class="sync-dot"></span>
          <span class="sync-text" id="sync-status-label">Synchronisé</span>
        </div>
        <a href={url('/cours/')} class="sidebar-cours-link" title="Accéder à l'arborescence complète des cours">
          <Icon name="folder" size={13} />
          <span>Mes Cours</span>
        </a>
      </div>
    </aside>
    <div class="sidebar-backdrop" id="sidebar-backdrop" aria-hidden="true"></div>

    <!-- 2. Zone principale : Document Notion -->
    <main class="notes-main" id="notes-main-area">
      <!-- Barre d'outils supérieure du document -->
      <header class="doc-topbar">
        <div class="topbar-left">
          <button
            type="button"
            class="btn-icon btn-toggle-sidebar"
            id="btn-expand-sidebar"
            title="Afficher la barre latérale"
            aria-label="Afficher la barre latérale"
            style="display: none;"
          >
            <Icon name="layout" size={15} />
          </button>

          <nav class="doc-breadcrumbs" aria-label="Fil d'Ariane du document">
            <a href={url('/notes/')}>Notes</a>
            <span class="crumb-sep">/</span>
            <span class="crumb-subject" id="crumb-subject-label">Général</span>
            <span class="crumb-sep">/</span>
            <span class="crumb-title" id="crumb-title-label">Sans titre</span>
          </nav>
        </div>

        <div class="topbar-right">
          <!-- Indicateur d'enregistrement automatique -->
          <div class="autosave-badge" id="autosave-status" aria-live="polite">
            <Icon name="check" size={12} class="save-icon" />
            <span id="autosave-label">Enregistré</span>
          </div>

          <!-- Choix de la police : Sans-serif moderne (Notion) ou Serif littéraire (Marges) -->
          <div class="font-style-group" role="group" aria-label="Style de police de lecture">
            <button type="button" class="btn-font-toggle active" data-font="sans" title="Police moderne sans-serif (Inter)">
              Sans
            </button>
            <button type="button" class="btn-font-toggle" data-font="serif" title="Police classique avec empattements (Serif)">
              Serif
            </button>
          </div>

          <!-- Changement de mode : Éditeur / Double vue / Aperçu -->
          <div class="view-mode-group" role="group" aria-label="Mode d'affichage">
            <button type="button" class="btn-mode active" data-mode="editor" title="Mode édition">
              <Icon name="edit" size={13} />
              <span class="mode-text">Éditer</span>
            </button>
            <button type="button" class="btn-mode" data-mode="split" title="Mode double vue">
              <Icon name="columns" size={13} />
              <span class="mode-text">Double vue</span>
            </button>
            <button type="button" class="btn-mode" data-mode="preview" title="Mode lecture">
              <Icon name="file" size={13} />
              <span class="mode-text">Lecture</span>
            </button>
          </div>

          <div class="topbar-actions">
            <button
              type="button"
              class="btn-icon"
              id="btn-zen-mode"
              title="Mode plein écran (Zen)"
              aria-label="Plein écran"
            >
              <Icon name="maximize" size={15} />
            </button>
            <button
              type="button"
              class="btn-icon"
              id="btn-export-markdown"
              title="Exporter au format Markdown (.md)"
              aria-label="Télécharger en Markdown"
            >
              <Icon name="download" size={15} />
            </button>
            <button
              type="button"
              class="btn-icon btn-danger-icon"
              id="btn-delete-note"
              title="Supprimer cette note"
              aria-label="Supprimer cette note"
            >
              <Icon name="trash" size={15} />
            </button>
          </div>
        </div>
      </header>

      <!-- Canvas du document Notion -->
      <div class="doc-canvas-wrapper" id="doc-canvas-wrapper">
        <article class="doc-canvas font-sans" id="doc-canvas">
          <!-- Icône de page Notion -->
          <div class="doc-cover-area">
            <button type="button" class="page-icon-btn" id="btn-choose-icon" title="Modifier l'icône de la page">
              <span id="page-icon-display">
                <Icon name="file" size={24} />
              </span>
            </button>

            <!-- Menu contextuel de sélection d'icônes -->
            <div class="icon-picker-popover" id="icon-picker-popover" style="display: none;">
              <span class="picker-title">Choisir une icône</span>
              <div class="picker-grid">
                <button type="button" class="picker-item" data-icon="file" title="Document standard">
                  <Icon name="file" size={17} />
                </button>
                <button type="button" class="picker-item" data-icon="book" title="Ouvrage ou manuel">
                  <Icon name="book" size={17} />
                </button>
                <button type="button" class="picker-item" data-icon="code" title="Code informatique">
                  <Icon name="code" size={17} />
                </button>
                <button type="button" class="picker-item" data-icon="edit" title="Prise de notes">
                  <Icon name="edit" size={17} />
                </button>
                <button type="button" class="picker-item" data-icon="sparkle" title="Notion clé ou synthèse">
                  <Icon name="sparkle" size={17} />
                </button>
                <button type="button" class="picker-item" data-icon="clock" title="Séance chronologique">
                  <Icon name="clock" size={17} />
                </button>
              </div>
            </div>
          </div>

          <!-- Titre grand format type Notion (interactif, sans empattement par défaut) -->
          <div class="doc-title-wrap">
            <input
              type="text"
              id="note-title"
              class="notion-title-input"
              placeholder="Sans titre"
              autocomplete="off"
              aria-label="Titre du document"
            />
          </div>

          <!-- Propriétés du document Notion (Matière, Catégorie, Date, Stats) -->
          <section class="notion-properties" aria-label="Propriétés du cours">
            <!-- Matière -->
            <div class="prop-row">
              <div class="prop-label">
                <Icon name="folder" size={13} />
                <span>Matière</span>
              </div>
              <div class="prop-value">
                <select id="prop-subject-select" class="prop-select" aria-label="Matière de rattachement">
                  <option value="Général">Général</option>
                </select>
                <button
                  type="button"
                  class="btn-inline-add"
                  id="btn-add-custom-subject"
                  title="Créer une nouvelle matière"
                >
                  + Nouvelle matière
                </button>
              </div>
            </div>

            <!-- Catégorie / Dossier -->
            <div class="prop-row">
              <div class="prop-label">
                <Icon name="tag" size={13} />
                <span>Catégorie</span>
              </div>
              <div class="prop-value">
                <select id="prop-category-select" class="prop-select" aria-label="Catégorie ou type de document">
                  <option value="CM">CM (Cours Magistral)</option>
                  <option value="TD">TD (Travaux Dirigés)</option>
                  <option value="Fiches de révisions" selected>Fiches de révisions</option>
                  <option value="Documents racines">Documents racines</option>
                  <option value="__new__">+ Nouveau dossier...</option>
                </select>
                <input
                  type="text"
                  id="prop-custom-category-input"
                  placeholder="Nom du dossier..."
                  class="prop-custom-input"
                  style="display: none;"
                />
              </div>
            </div>

            <!-- Dernière modification -->
            <div class="prop-row">
              <div class="prop-label">
                <Icon name="clock" size={13} />
                <span>Modifié le</span>
              </div>
              <div class="prop-value">
                <time id="prop-updated-time" class="meta">À l'instant</time>
              </div>
            </div>

            <!-- Comptage de mots et estimation de lecture -->
            <div class="prop-row">
              <div class="prop-label">
                <Icon name="file" size={13} />
                <span>Lecture</span>
              </div>
              <div class="prop-value">
                <span id="prop-stats-label" class="meta">0 mot · 1 min de lecture</span>
              </div>
            </div>
          </section>

          <hr class="notion-separator" />

          <!-- Barre d'insertion rapide Notion (Sticky toolbar) -->
          <div class="notion-format-toolbar" id="notion-format-toolbar">
            <button type="button" class="fmt-btn fmt-btn--accent" data-fmt="slash" title="Insérer un bloc (/)"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg> Bloc</button><span class="fmt-sep"></span>
            <button type="button" class="fmt-btn" data-fmt="h1" title="Titre 1 (#)">
              <Icon name="heading" size={13} /> 1
            </button>
            <button type="button" class="fmt-btn" data-fmt="h2" title="Titre 2 (##)">
              <Icon name="heading" size={12} /> 2
            </button>
            <button type="button" class="fmt-btn" data-fmt="h3" title="Titre 3 (###)">
              <Icon name="heading" size={11} /> 3
            </button>
            <span class="fmt-sep"></span>
            <button type="button" class="fmt-btn" data-fmt="bold" title="Gras (**texte**)">
              <strong>B</strong>
            </button>
            <button type="button" class="fmt-btn" data-fmt="italic" title="Italique (*texte*)">
              <em>I</em>
            </button>
            <button type="button" class="fmt-btn" data-fmt="code" title="Code inline (`code`)">
              <Icon name="code" size={13} />
            </button>
            <button type="button" class="fmt-btn" data-fmt="highlight" title="Surligner (==texte==)">
              <mark class="fmt-mark">H</mark>
            </button>
            <span class="fmt-sep"></span>
            <button type="button" class="fmt-btn" data-fmt="bullet" title="Liste à puces (- )">
              <Icon name="list" size={13} />
            </button>
            <button type="button" class="fmt-btn" data-fmt="todo" title="Liste de tâches (- [ ] )">
              <Icon name="check-square" size={13} />
            </button>
            <button type="button" class="fmt-btn" data-fmt="quote" title="Citation (> )">
              <Icon name="quote" size={13} />
            </button>
            <button type="button" class="fmt-btn" data-fmt="callout" title="Encadré (> [!NOTE] )">
              <Icon name="sparkle" size={13} />
            </button>
            <button type="button" class="fmt-btn" data-fmt="codeblock" title="Bloc de code (```)">
              ```
            </button>
            <button type="button" class="fmt-btn" data-fmt="divider" title="Séparateur (---)">
              —
            </button>
          </div>

          <!-- Conteneur d'édition / double vue -->
          <div class="notion-editor-split" id="editor-split-container">
            <!-- Zone textarea d'écriture -->
            <div class="editor-pane" id="editor-pane">
              <textarea
                id="note-body"
                class="notion-textarea"
                placeholder="Rédigez ici vos notes de cours... Tapez / pour ouvrir les blocs disponibles."
                spellcheck="true"
                aria-label="Contenu du document"
              ></textarea>
            </div>

            <!-- Zone de rendu / aperçu Markdown dynamique -->
            <div class="preview-pane" id="preview-pane" style="display: none;">
              <div class="notion-rendered-content" id="preview-content"></div>
            </div>
          </div>
        </article>
      </div>

      <!-- Menu contextuel Slash Command Notion (/) -->
      <div class="slash-command-menu" id="slash-command-menu" style="display: none;">
        <div class="slash-header">
          <span>Commandes de base</span>
          <button type="button" class="slash-close-btn" id="btn-close-slash" aria-label="Fermer le menu">✕</button>
        </div>
        <ul class="slash-list" id="slash-command-list" role="listbox">
          <li class="slash-item active" data-cmd="p" role="option">
            <span class="slash-icon"><Icon name="file" size={14} /></span>
            <div class="slash-info">
              <span class="slash-name">Texte simple</span>
              <span class="slash-desc">Paragraphe classique</span>
            </div>
          </li>
          <li class="slash-item" data-cmd="h1" role="option">
            <span class="slash-icon"><Icon name="heading" size={14} /></span>
            <div class="slash-info">
              <span class="slash-name">Titre 1</span>
              <span class="slash-desc">Grand titre de section (#)</span>
            </div>
          </li>
          <li class="slash-item" data-cmd="h2" role="option">
            <span class="slash-icon"><Icon name="heading" size={13} /></span>
            <div class="slash-info">
              <span class="slash-name">Titre 2</span>
              <span class="slash-desc">Sous-titre moyen (##)</span>
            </div>
          </li>
          <li class="slash-item" data-cmd="h3" role="option">
            <span class="slash-icon"><Icon name="heading" size={12} /></span>
            <div class="slash-info">
              <span class="slash-name">Titre 3</span>
              <span class="slash-desc">Sous-section (###)</span>
            </div>
          </li>
          <li class="slash-item" data-cmd="todo" role="option">
            <span class="slash-icon"><Icon name="check-square" size={14} /></span>
            <div class="slash-info">
              <span class="slash-name">Liste de tâches</span>
              <span class="slash-desc">Case à cocher interactive (- [ ])</span>
            </div>
          </li>
          <li class="slash-item" data-cmd="bullet" role="option">
            <span class="slash-icon"><Icon name="list" size={14} /></span>
            <div class="slash-info">
              <span class="slash-name">Liste à puces</span>
              <span class="slash-desc">Points d'énumération (-)</span>
            </div>
          </li>
          <li class="slash-item" data-cmd="callout" role="option">
            <span class="slash-icon"><Icon name="sparkle" size={14} /></span>
            <div class="slash-info">
              <span class="slash-name">Encadré (Callout)</span>
              <span class="slash-desc">Mise en exergue avec icône</span>
            </div>
          </li>
          <li class="slash-item" data-cmd="quote" role="option">
            <span class="slash-icon"><Icon name="quote" size={14} /></span>
            <div class="slash-info">
              <span class="slash-name">Citation</span>
              <span class="slash-desc">Extrait ou citation d'auteur (>)</span>
            </div>
          </li>
          <li class="slash-item" data-cmd="code" role="option">
            <span class="slash-icon"><Icon name="code" size={14} /></span>
            <div class="slash-info">
              <span class="slash-name">Bloc de code</span>
              <span class="slash-desc">Snippet avec coloration (```)</span>
            </div>
          </li>
          <li class="slash-item" data-cmd="divider" role="option">
            <span class="slash-icon">—</span>
            <div class="slash-info">
              <span class="slash-name">Séparateur</span>
              <span class="slash-desc">Ligne de démarcation (---)</span>
            </div>
          </li>
        </ul>
      </div>
    </main>
  </div>
</Base>

<style>
  /* -------------------------------------------------------------
     Structure globale du workspace Notion
     ------------------------------------------------------------- */
  .notes-workspace {
    font-family: var(--font-ui);
    display: flex;
    height: calc(100dvh - 3.75rem);
    background: var(--bg);
    color: var(--fg);
    position: relative;
    overflow: hidden;
  }

  /* Application plein écran : pas de pied de page sous l'éditeur */
  :global(body:has([data-notes-workspace]) .site-footer) {
    display: none;
  }

  /* Mode Zen : on retire aussi l'en-tête du site */
  :global(body:has(.notes-workspace.zen-mode) .site-header) {
    display: none;
  }
  .notes-workspace.zen-mode {
    height: 100dvh;
  }
  .notes-workspace.zen-mode .notes-main {
    height: 100dvh;
  }

  .sidebar-backdrop {
    display: none;
  }

  /* -------------------------------------------------------------
     1. Barre latérale Notion (Arborescence et recherche)
     ------------------------------------------------------------- */
  .notes-sidebar {
    width: 272px;
    flex-shrink: 0;
    background: var(--soft);
    border-right: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    transition: transform var(--dur) var(--ease), width var(--dur) var(--ease), margin-left var(--dur) var(--ease);
    z-index: 20;
    font-family: var(--font-ui);
  }

  .notes-sidebar.collapsed {
    margin-left: -272px;
    pointer-events: none;
  }

  .sidebar-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.85rem 0.85rem 0.4rem 1rem;
  }

  .workspace-brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
    font-size: 0.92rem;
    font-family: var(--font-ui);
  }

  .workspace-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border-radius: var(--r-sm);
    background: var(--surface);
    color: var(--accent);
    border: 1px solid var(--line);
  }

  /* Boîte de recherche propre en flex */
  .sidebar-search {
    padding: 0.4rem 0.85rem 0.4rem;
  }

  .search-box {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.6rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .search-box:focus-within {
    border-color: var(--accent);
    box-shadow: 0 0 0 1px var(--accent);
  }

  .search-icon {
    color: var(--muted);
    flex-shrink: 0;
  }

  .search-box input {
    width: 100%;
    border: none;
    outline: none;
    background: transparent;
    color: var(--fg);
    font-family: var(--font-ui);
    font-size: 0.83rem;
    padding: 0;
  }

  .search-box input::placeholder {
    color: var(--muted);
    opacity: 0.8;
  }

  .sidebar-actions {
    padding: 0.25rem 0.85rem 0.5rem;
  }

  .btn-new-note {
    width: 100%;
    justify-content: center;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-ui);
    font-size: 0.83rem;
    font-weight: 550;
    padding: 0.4rem 0.75rem;
  }

  .notes-tree {
    flex: 1;
    overflow-y: auto;
    padding: 0.35rem 0.6rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    font-family: var(--font-ui);
  }

  :global(.sidebar-loading),
  :global(.sidebar-empty) {
    padding: 1.5rem 0.75rem;
    font-size: 0.82rem;
    color: var(--muted);
    text-align: center;
    font-family: var(--font-ui);
    font-style: italic;
  }

  /* Groupes de matières Notion */
  :global(.subject-group) {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  :global(.subject-group-header) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.35rem 0.5rem;
    font-family: var(--font-ui);
    font-size: 0.73rem;
    font-weight: 650;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--muted);
    cursor: pointer;
    border-radius: var(--r-sm);
    user-select: none;
    gap: 0.35rem;
    transition: background 0.1s ease, color 0.1s ease;
  }

  :global(.subject-group-header:hover) {
    background: color-mix(in srgb, var(--fg) 6%, transparent);
    color: var(--fg);
  }

  :global(.group-title-wrap) {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    min-width: 0;
    flex: 1;
  }

  :global(.group-chevron) {
    color: var(--muted);
    transition: transform 0.15s ease;
    flex-shrink: 0;
  }

  :global(.group-chevron.collapsed) {
    transform: rotate(-90deg);
  }

  :global(.group-name) {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  :global(.group-badge) {
    font-size: 0.68rem;
    font-weight: 500;
    color: var(--muted);
    background: color-mix(in srgb, var(--fg) 6%, transparent);
    padding: 0.1rem 0.4rem;
    border-radius: 999px;
    flex-shrink: 0;
  }

  /* Arborescence indentée sous la matière */
  :global(.subject-notes-list) {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    margin-left: 0.75rem;
    padding-left: 0.5rem;
    border-left: 1px solid var(--line);
    margin-top: 0.15rem;
    margin-bottom: 0.25rem;
  }

  :global(.note-tree-item) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.32rem 0.45rem;
    border-radius: var(--r-sm);
    font-family: var(--font-ui);
    font-size: 0.83rem;
    color: var(--fg);
    cursor: pointer;
    text-decoration: none;
    transition: background 0.1s ease, color 0.1s ease;
    gap: 0.45rem;
  }

  :global(.note-tree-item:hover) {
    background: color-mix(in srgb, var(--fg) 6%, transparent);
  }

  :global(.note-tree-item.active) {
    background: var(--surface);
    color: var(--fg);
    font-weight: 600;
    box-shadow: var(--shadow-sm);
  }

  :global(.item-main) {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    min-width: 0;
    flex: 1;
  }

  :global(.item-icon) {
    color: var(--muted);
    flex-shrink: 0;
  }

  :global(.item-title) {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-family: var(--font-ui);
  }

  :global(.item-badge) {
    font-family: var(--font-ui);
    font-size: 0.68rem;
    font-weight: 500;
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
    background: color-mix(in srgb, var(--fg) 7%, transparent);
    color: var(--muted);
    flex-shrink: 0;
    white-space: nowrap;
  }

  .sidebar-footer {
    padding: 0.65rem 0.85rem;
    border-top: 1px solid var(--line);
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.78rem;
    color: var(--muted);
    background: transparent;
    font-family: var(--font-ui);
  }

  .sync-indicator {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .sync-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--success);
    transition: background 0.3s ease;
  }

  .sync-indicator.syncing .sync-dot {
    background: var(--warning);
    animation: pulse 1s infinite alternate;
  }

  @keyframes pulse {
    from { opacity: 0.4; }
    to { opacity: 1; }
  }

  .sidebar-cours-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--muted);
    text-decoration: none;
    font-family: var(--font-ui);
  }

  .sidebar-cours-link:hover {
    color: var(--fg);
  }

  /* -------------------------------------------------------------
     2. Zone principale : Document Notion
     ------------------------------------------------------------- */
  .notes-main {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
    background: var(--bg);
    height: calc(100dvh - 3.75rem);
    overflow: hidden;
    font-family: var(--font-ui);
  }

  .doc-topbar {
    min-height: 3rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.4rem 1.25rem;
    border-bottom: 1px solid var(--line);
    background: var(--bg);
    gap: 1rem;
    flex-shrink: 0;
    font-family: var(--font-ui);
  }

  .topbar-left {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
  }

  .doc-breadcrumbs {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.83rem;
    font-family: var(--font-ui);
    color: var(--muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .doc-breadcrumbs a {
    color: var(--muted);
    text-decoration: none;
  }

  .doc-breadcrumbs a:hover {
    color: var(--fg);
  }

  .crumb-sep {
    opacity: 0.5;
  }

  .crumb-title {
    color: var(--fg);
    font-weight: 600;
  }

  .topbar-right {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-shrink: 0;
  }

  .autosave-badge {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.76rem;
    font-family: var(--font-ui);
    color: var(--muted);
    padding: 0.2rem 0.45rem;
    border-radius: var(--r-sm);
    background: var(--soft);
    transition: color 0.2s ease, opacity 0.2s ease;
  }

  .autosave-badge.saving {
    color: var(--warning);
  }

  .autosave-badge.saved {
    color: var(--success);
  }

  /* Commutateur de police (Sans vs Serif) */
  .font-style-group,
  .view-mode-group {
    display: flex;
    background: var(--soft);
    padding: 2px;
    border-radius: var(--r-sm);
  }

  .btn-font-toggle,
  .btn-mode {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    border: none;
    background: none;
    padding: 0.25rem 0.5rem;
    border-radius: calc(var(--r-sm) - 2px);
    font-size: 0.78rem;
    font-family: var(--font-ui);
    color: var(--muted);
    cursor: pointer;
    transition: background 0.12s ease, color 0.12s ease;
  }

  .btn-font-toggle.active,
  .btn-mode.active {
    background: var(--surface);
    color: var(--fg);
    font-weight: 600;
    box-shadow: var(--shadow-sm);
  }

  .topbar-actions {
    display: flex;
    align-items: center;
    gap: 0.2rem;
  }

  .btn-icon {
    display: inline-grid;
    place-items: center;
    width: 1.85rem;
    height: 1.85rem;
    border: none;
    background: none;
    border-radius: var(--r-sm);
    color: var(--muted);
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .btn-icon:hover {
    background: var(--soft);
    color: var(--fg);
  }

  .btn-danger-icon:hover {
    background: color-mix(in srgb, var(--danger) 15%, transparent);
    color: var(--danger);
  }

  /* -------------------------------------------------------------
     Canvas Notion
     ------------------------------------------------------------- */
  .doc-canvas-wrapper {
    flex: 1;
    overflow-y: auto;
    padding: 2.25rem 1.5rem 6rem;
    display: flex;
    justify-content: center;
  }

  .doc-canvas {
    width: 100%;
    max-width: 46rem;
    display: flex;
    flex-direction: column;
    position: relative;
    --doc-current-font: var(--font-ui);
  }

  .doc-canvas.font-serif {
    --doc-current-font: var(--font-text);
  }

  .doc-canvas.font-sans {
    --doc-current-font: var(--font-ui);
  }

  .doc-cover-area {
    margin-bottom: 0.35rem;
    position: relative;
  }

  .page-icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--r-sm);
    border: 1px solid transparent;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    transition: border-color 0.15s ease, background 0.15s ease, color 0.15s ease;
  }

  .page-icon-btn:hover {
    background: var(--soft);
    color: var(--fg);
  }

  .icon-picker-popover {
    position: absolute;
    top: 52px;
    left: 0;
    background: var(--surface);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-md);
    border-radius: var(--radius);
    padding: 0.65rem;
    z-index: 50;
    width: 190px;
    font-family: var(--font-ui);
  }

  .picker-title {
    display: block;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--muted);
    margin-bottom: 0.45rem;
    text-transform: uppercase;
  }

  .picker-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.35rem;
  }

  .picker-item {
    display: grid;
    place-items: center;
    height: 36px;
    border: 1px solid var(--line);
    background: var(--bg);
    border-radius: var(--r-sm);
    color: var(--fg);
    cursor: pointer;
    transition: background 0.12s ease;
  }

  .picker-item:hover {
    background: var(--soft);
    border-color: var(--accent);
  }

  .doc-title-wrap {
    margin: 0.4rem 0 0.85rem;
  }

  .notion-title-input {
    width: 100%;
    border: none;
    outline: none;
    background: transparent;
    font-family: var(--doc-current-font, var(--font-ui));
    font-size: clamp(1.85rem, 1.5rem + 1.4vw, 2.5rem);
    font-weight: 700;
    line-height: 1.18;
    color: var(--fg);
    letter-spacing: -0.02em;
    padding: 0;
  }

  .notion-title-input::placeholder {
    color: var(--line-strong);
    opacity: 0.6;
  }

  /* Propriétés Notion */
  .notion-properties {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin: 0.4rem 0 1rem;
    font-size: 0.84rem;
    font-family: var(--font-ui);
  }

  .prop-row {
    display: flex;
    align-items: center;
    min-height: 1.9rem;
    border-radius: var(--r-sm);
    margin-inline: -0.35rem;
    padding-inline: 0.35rem;
    transition: background 0.12s ease;
  }

  .prop-row:hover {
    background: var(--soft);
  }

  .prop-label {
    width: 120px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--muted);
    font-size: 0.82rem;
    font-family: var(--font-ui);
  }

  .prop-value {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    font-family: var(--font-ui);
  }

  .prop-select {
    padding: 0.2rem 0.4rem;
    font-size: 0.84rem;
    font-family: var(--font-ui);
    border: 1px solid transparent;
    border-radius: var(--r-sm);
    background: transparent;
    color: var(--fg);
    outline: none;
    cursor: pointer;
    transition: background 0.12s ease, border-color 0.12s ease;
  }

  .prop-select:hover,
  .prop-select:focus {
    background: var(--surface);
    border-color: var(--line);
  }

  .prop-custom-input {
    padding: 0.2rem 0.45rem;
    font-size: 0.82rem;
    font-family: var(--font-ui);
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    background: var(--surface);
    color: var(--fg);
    outline: none;
  }

  .btn-inline-add {
    font-size: 0.75rem;
    font-family: var(--font-ui);
    background: none;
    border: none;
    color: var(--accent);
    cursor: pointer;
    padding: 0.15rem 0.35rem;
    border-radius: 4px;
    opacity: 0;
    transition: opacity 0.15s ease;
  }

  .prop-row:hover .btn-inline-add,
  .btn-inline-add:focus-visible {
    opacity: 1;
  }

  .btn-inline-add:hover {
    background: var(--surface);
  }

  .notion-separator {
    border: none;
    border-top: 1px solid var(--line);
    margin: 0.6rem 0 1rem;
  }

  /* Barre de formatage sticky */
  .notion-format-toolbar {
    display: flex;
    align-items: center;
    gap: 0.2rem;
    padding: 0.25rem 0;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
    margin-bottom: 1.1rem;
    flex-wrap: wrap;
    position: sticky;
    top: -2.25rem;
    z-index: 10;
    opacity: 0.55;
    transition: opacity 0.15s ease;
    font-family: var(--font-ui);
  }

  .fmt-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.2rem 0.4rem;
    min-width: 1.65rem;
    height: 1.65rem;
    border: none;
    background: none;
    border-radius: 4px;
    color: var(--muted);
    font-size: 0.78rem;
    font-family: var(--font-ui);
    cursor: pointer;
    transition: background 0.12s ease, color 0.12s ease;
  }

  .fmt-btn:hover {
    background: var(--soft);
    color: var(--fg);
  }

  .notion-format-toolbar:hover,
  .notion-format-toolbar:focus-within,
  .doc-canvas:focus-within .notion-format-toolbar {
    opacity: 1;
  }

  .fmt-mark {
    background: color-mix(in srgb, var(--warning) 30%, transparent);
    color: inherit;
    padding: 0 0.25rem;
    border-radius: 2px;
  }

  .fmt-sep {
    width: 1px;
    height: 1.1rem;
    background: var(--line);
    margin: 0 0.25rem;
  }

  /* Zone split : Édition / Rendu */
  .notion-editor-split {
    display: flex;
    gap: 1.5rem;
    min-height: 50vh;
  }

  .notion-editor-split.mode-split .editor-pane,
  .notion-editor-split.mode-split .preview-pane {
    flex: 1;
    display: block !important;
    width: 50%;
  }

  .notion-editor-split.mode-split .preview-pane {
    border-left: 1px solid var(--line);
    padding-left: 1.5rem;
  }

  .notion-editor-split.mode-preview .editor-pane {
    display: none !important;
  }

  .notion-editor-split.mode-preview .preview-pane {
    display: block !important;
    width: 100%;
  }

  .editor-pane {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .notion-textarea {
    width: 100%;
    min-height: 50vh;
    overflow: hidden;
    border: none;
    outline: none;
    background: transparent;
    color: var(--fg);
    font-family: var(--doc-current-font, var(--font-ui));
    font-size: 1.02rem;
    line-height: 1.7;
    resize: none;
    padding: 0;
  }

  .preview-pane {
    overflow-y: auto;
  }

  /* Rendu Markdown façon Notion */
  .notion-rendered-content {
    font-family: var(--doc-current-font, var(--font-ui));
    font-size: 1.02rem;
    line-height: 1.7;
    color: var(--fg);
  }

  :global(.notion-rendered-content .notion-h1) {
    font-size: 1.75rem;
    font-weight: 700;
    margin: 1.5rem 0 0.45rem;
    letter-spacing: -0.02em;
    font-family: var(--doc-current-font, var(--font-ui));
  }

  :global(.notion-rendered-content .notion-h2) {
    font-size: 1.35rem;
    font-weight: 650;
    margin: 1.35rem 0 0.35rem;
    letter-spacing: -0.015em;
    font-family: var(--doc-current-font, var(--font-ui));
  }

  :global(.notion-rendered-content .notion-h3) {
    font-size: 1.15rem;
    font-weight: 600;
    margin: 1.15rem 0 0.3rem;
    font-family: var(--doc-current-font, var(--font-ui));
  }

  :global(.notion-rendered-content .notion-p) {
    margin: 0.55rem 0;
  }

  :global(.notion-rendered-content .notion-callout) {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.8rem 0.95rem;
    border-radius: var(--radius);
    background: var(--soft);
    border-left: 3px solid var(--accent);
    margin: 0.9rem 0;
    font-size: 0.94rem;
  }

  :global(.notion-rendered-content .notion-callout-icon) {
    color: var(--accent);
    display: inline-flex;
    padding-top: 0.2rem;
  }

  :global(.notion-rendered-content .notion-callout--important),
  :global(.notion-rendered-content .notion-callout--warning) {
    border-left-color: var(--warning);
  }

  :global(.notion-rendered-content .notion-quote) {
    margin: 0.9rem 0;
    padding-left: 0.9rem;
    border-left: 3px solid var(--line-strong);
    color: var(--muted);
    font-style: italic;
  }

  :global(.notion-rendered-content .notion-todo-item) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0.3rem 0;
    cursor: pointer;
  }

  :global(.notion-rendered-content .notion-todo-item.completed .notion-todo-label) {
    text-decoration: line-through;
    color: var(--muted);
  }

  :global(.notion-rendered-content .notion-bullet-item) {
    margin-left: 1.25rem;
    list-style-type: disc;
  }

  :global(.notion-rendered-content .notion-numbered-item) {
    margin-left: 1.25rem;
    list-style-type: decimal;
  }

  :global(.notion-rendered-content .notion-code-block) {
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    background: var(--soft);
    margin: 0.9rem 0;
    overflow: hidden;
  }

  :global(.notion-rendered-content .notion-code-header) {
    display: flex;
    justify-content: flex-end;
    padding: 0.25rem 0.75rem;
    font-size: 0.7rem;
    font-family: var(--font-ui);
    color: var(--muted);
    background: color-mix(in srgb, var(--surface) 60%, transparent);
    border-bottom: 1px solid var(--line);
    text-transform: uppercase;
  }

  :global(.notion-rendered-content pre) {
    margin: 0;
    padding: 0.8rem 0.95rem;
    overflow-x: auto;
    font-size: 0.86rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  }

  :global(.notion-rendered-content .notion-inline-code) {
    background: var(--soft);
    padding: 0.15rem 0.35rem;
    border-radius: 4px;
    font-size: 0.88em;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }

  :global(.notion-rendered-content .notion-highlight) {
    background: color-mix(in srgb, var(--warning) 28%, transparent);
    color: inherit;
    padding: 0.1rem 0.25rem;
    border-radius: 2px;
  }

  :global(.notion-rendered-content .notion-divider) {
    border: none;
    border-top: 1px solid var(--line);
    margin: 1.5rem 0;
  }

  :global(.notion-rendered-content .notion-empty-placeholder) {
    color: var(--muted);
    font-style: italic;
    padding: 2rem 0;
  }

  /* -------------------------------------------------------------
     Menu contextuel Slash Command Notion (/)
     ------------------------------------------------------------- */
  .slash-command-menu {
    position: fixed;
    width: 260px;
    background: var(--surface);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-md);
    border-radius: var(--radius);
    padding: 0.35rem;
    z-index: 100;
    font-family: var(--font-ui);
  }

  .slash-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.3rem 0.45rem 0.35rem;
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--muted);
    text-transform: uppercase;
    border-bottom: 1px solid var(--line);
    margin-bottom: 0.25rem;
  }

  .slash-close-btn {
    border: none;
    background: none;
    color: var(--muted);
    cursor: pointer;
    font-size: 0.8rem;
    padding: 0 0.2rem;
    line-height: 1;
    border-radius: 3px;
  }

  .slash-close-btn:hover {
    color: var(--fg);
    background: var(--soft);
  }

  .slash-list {
    list-style: none;
    margin: 0;
    padding: 0;
    max-height: 230px;
    overflow-y: auto;
  }

  .slash-item {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.35rem 0.45rem;
    border-radius: var(--r-sm);
    cursor: pointer;
    transition: background 0.1s ease;
  }

  .slash-item:hover,
  .slash-item.active {
    background: var(--soft);
  }

  .slash-icon {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 4px;
    background: var(--bg);
    border: 1px solid var(--line);
    color: var(--fg);
    flex-shrink: 0;
    font-family: var(--font-ui);
  }

  .slash-info {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .slash-name {
    font-size: 0.82rem;
    font-weight: 550;
    color: var(--fg);
    font-family: var(--font-ui);
  }

  .slash-desc {
    font-size: 0.7rem;
    color: var(--muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    font-family: var(--font-ui);
  }

  /* -------------------------------------------------------------
     Responsive mobile (< 52rem & 375px)
     ------------------------------------------------------------- */
  @media (max-width: 52rem) {
    .notes-sidebar {
      position: absolute;
      top: 0;
      bottom: 0;
      left: 0;
      box-shadow: var(--shadow-md);
      z-index: 50;
    }

    .notes-sidebar.collapsed {
      transform: translateX(-100%);
      margin-left: 0;
    }

    .btn-toggle-sidebar {
      display: inline-grid !important;
    }

    .sidebar-backdrop {
      display: block;
      position: absolute;
      inset: 0;
      background: rgb(0 0 0 / .35);
      z-index: 40;
    }
    .notes-sidebar.collapsed + .sidebar-backdrop {
      display: none;
    }

    .mode-text,
    #autosave-label,
    .doc-breadcrumbs a,
    .doc-breadcrumbs .crumb-sep:first-of-type {
      display: none;
    }

    .doc-topbar {
      padding: 0.4rem 0.6rem;
      gap: 0.5rem;
    }
    .topbar-right {
      gap: 0.35rem;
    }

    .doc-canvas-wrapper {
      padding: 1.5rem 1rem 4rem;
    }

    .notion-title-input {
      font-size: 1.75rem;
    }

    .notion-properties {
      font-size: 0.8rem;
    }

    .prop-label {
      width: 95px;
    }

    .notion-editor-split.mode-split .editor-pane,
    .notion-editor-split.mode-split .preview-pane {
      width: 100%;
    }

    .notion-editor-split.mode-split {
      flex-direction: column;
    }
  }

  :global(.btn-group-add-note) {
    display: inline-grid;
    place-items: center;
    width: 18px;
    height: 18px;
    border-radius: 4px;
    border: none;
    background: transparent;
    color: var(--muted);
    font-size: 0.85rem;
    cursor: pointer;
    line-height: 1;
    opacity: 0;
    transition: opacity 0.12s ease, background 0.12s ease, color 0.12s ease;
  }

  :global(.subject-group-header:hover .btn-group-add-note) {
    opacity: 1;
  }

  :global(.btn-group-add-note:hover) {
    background: var(--surface);
    color: var(--fg);
  }

  :global(.subject-empty-hint) {
    padding: 0.35rem 0.5rem;
    font-size: 0.76rem;
    color: var(--muted);
    font-style: italic;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  :global(.btn-inline-new) {
    font-size: 0.75rem;
    background: none;
    border: none;
    color: var(--accent);
    cursor: pointer;
    padding: 0.1rem 0.3rem;
    border-radius: 3px;
    text-decoration: underline;
  }

  :global(.btn-inline-new:hover) {
    background: var(--surface);
  }

  .fmt-btn--accent {
    font-weight: 600;
    color: var(--fg);
    gap: 0.25rem;
    padding: 0.2rem 0.5rem;
  }
</style>

<script>
  import {
    getLocalNotes,
    fetchUnifiedNotes,
    saveUnifiedNote,
    deleteUnifiedNote,
    renderNotionMarkdown,
    computeNoteStats,
    type NoteItem,
  } from '../../utils/notes';
  import { getUserCoursesImmediate } from '../../utils/supabase';

  function initNotesApp() {
    const root = document.querySelector('[data-notes-workspace]') as HTMLElement | null;
    if (!root) return;

    // Éléments du DOM
    const sidebar = document.getElementById('notes-sidebar');
    const btnCollapseSidebar = document.getElementById('btn-collapse-sidebar');
    const btnExpandSidebar = document.getElementById('btn-expand-sidebar');
    const searchInput = document.getElementById('notes-search-input') as HTMLInputElement;
    const btnCreateNote = document.getElementById('btn-create-note');
    const notesTree = document.getElementById('notes-tree-container');
    const syncStatusLabel = document.getElementById('sync-status-label');
    const sidebarSyncIndicator = document.getElementById('sidebar-sync-indicator');

    // Canvas document
    const docCanvas = document.getElementById('doc-canvas');
    const crumbSubjectLabel = document.getElementById('crumb-subject-label');
    const crumbTitleLabel = document.getElementById('crumb-title-label');
    const autosaveStatus = document.getElementById('autosave-status');
    const autosaveLabel = document.getElementById('autosave-label');

    const noteTitle = document.getElementById('note-title') as HTMLInputElement;
    const noteBody = document.getElementById('note-body') as HTMLTextAreaElement;
    const propSubjectSelect = document.getElementById('prop-subject-select') as HTMLSelectElement;
    const propCategorySelect = document.getElementById('prop-category-select') as HTMLSelectElement;
    const propCustomCategory = document.getElementById('prop-custom-category-input') as HTMLInputElement;
    const btnAddCustomSubject = document.getElementById('btn-add-custom-subject');
    const propUpdatedTime = document.getElementById('prop-updated-time');
    const propStatsLabel = document.getElementById('prop-stats-label');

    const btnChooseIcon = document.getElementById('btn-choose-icon');
    const pageIconDisplay = document.getElementById('page-icon-display');
    const iconPickerPopover = document.getElementById('icon-picker-popover');

    const splitContainer = document.getElementById('editor-split-container');
    const previewContent = document.getElementById('preview-content');
    const btnZenMode = document.getElementById('btn-zen-mode');
    const btnExport = document.getElementById('btn-export-markdown');
    const btnDelete = document.getElementById('btn-delete-note');

    const slashMenu = document.getElementById('slash-command-menu');
    const btnCloseSlash = document.getElementById('btn-close-slash');

    const ICON_SVGS: Record<string, string> = {
      file: '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M9 13h6M9 17h4"/></svg>',
      book: '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v15H6.5A2.5 2.5 0 0 0 4 20.5z"/><path d="M4 20.5A2.5 2.5 0 0 0 6.5 23H20v-5"/></svg>',
      code: '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="m8 8-4 4 4 4M16 8l4 4-4 4M13.5 5l-3 14"/></svg>',
      edit: '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>',
      sparkle: '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M12 3v4M12 17v4M3 12h4M17 12h4M6 6l2.5 2.5M15.5 15.5 18 18M6 18l2.5-2.5M15.5 8.5 18 6"/></svg>',
      clock: '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>',
    };

    // Données des matières de base reçues du serveur
    const rawSubjects = root.getAttribute('data-subjects');
    const baseSubjects: Array<{ id: string; name: string; subfolders: string[] }> = rawSubjects
      ? JSON.parse(rawSubjects)
      : [];

    const esc = (v: string) =>
      String(v ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
    const collapsedGroups = new Set<string>(JSON.parse(localStorage.getItem('marges_notes_collapsed') || '[]'));
    const isMobile = () => window.matchMedia('(max-width: 52rem)').matches;

    function autoGrow() {
      noteBody.style.height = 'auto';
      noteBody.style.height = `${noteBody.scrollHeight}px`;
    }

    let notes: NoteItem[] = [];
    let currentNoteId: string | null = null;
    let autoSaveTimer: any = null;
    let isSaving = false;
    let slashDismissedPos: number | null = null;

    // Gestion du style de police (Sans-serif par défaut vs Serif)
    const savedFont = localStorage.getItem('marges_note_font') || 'sans';
    applyDocFont(savedFont);

    function applyDocFont(fontType: string) {
      if (!docCanvas) return;
      docCanvas.classList.remove('font-sans', 'font-serif');
      docCanvas.classList.add(fontType === 'serif' ? 'font-serif' : 'font-sans');
      document.querySelectorAll('.btn-font-toggle').forEach((btn) => {
        btn.classList.toggle('active', btn.getAttribute('data-font') === fontType);
      });
      localStorage.setItem('marges_note_font', fontType);
    }

    document.querySelectorAll('.btn-font-toggle').forEach((btn) => {
      btn.addEventListener('click', () => {
        const fontType = btn.getAttribute('data-font') || 'sans';
        applyDocFont(fontType);
      });
    });

    // Récupérer la liste complète et unifiée des matières (instantané en 0 ms)
    function getAllSubjects(): Array<{ name: string; count: number }> {
      const subjectMap = new Map<string, number>();

      // 1. Matières de base issues de l'arborescence physique
      baseSubjects.forEach((s) => {
        if (!subjectMap.has(s.name)) subjectMap.set(s.name, 0);
      });

      // 2. Matières issues du stockage de cours (Supabase / local)
      const dbCourses = getUserCoursesImmediate();
      dbCourses.forEach((c) => {
        let sName = '';
        if (c.tags && c.tags.includes('Matière') && c.title) {
          sName = c.title.trim();
        } else if (c.tags && c.tags.length > 0) {
          const clean = c.tags.filter(
            (t) =>
              !t.startsWith('icon:') &&
              t !== 'note' &&
              t !== 'Université' &&
              t !== 'Dossier importé' &&
              t !== 'Matière' &&
              t !== 'Supports de cours'
          );
          if (clean.length > 0) sName = clean[0].trim();
        }
        if (sName && !subjectMap.has(sName)) {
          subjectMap.set(sName, 0);
        }
      });

      // 3. Matières issues des notes actuelles
      notes.forEach((n) => {
        const s = (n.subject || 'Général').trim();
        if (!subjectMap.has(s)) subjectMap.set(s, 0);
      });

      // 4. Compter les notes par matière
      notes.forEach((n) => {
        const s = (n.subject || 'Général').trim();
        subjectMap.set(s, (subjectMap.get(s) || 0) + 1);
      });

      if (subjectMap.size === 0) {
        subjectMap.set('Général', notes.length);
      }

      return Array.from(subjectMap.entries())
        .map(([name, count]) => ({ name, count }))
        .sort((a, b) => a.name.localeCompare(b.name, 'fr'));
    }

    // 1. Initialisation de la liste déroulante des matières
    function refreshSubjectsDropdown(selectedSubject?: string) {
      const all = getAllSubjects();
      propSubjectSelect.innerHTML = '';
      all.forEach(({ name }) => {
        const opt = document.createElement('option');
        opt.value = name;
        opt.textContent = name;
        if (selectedSubject && selectedSubject === name) {
          opt.selected = true;
        }
        propSubjectSelect.appendChild(opt);
      });

      if (!selectedSubject && all.length > 0) {
        propSubjectSelect.value = all[0].name;
      }
    }

    // Helper formatage badge catégorie
    function formatCategoryBadge(cat: string): string {
      if (!cat) return '';
      const c = cat.trim();
      if (c === 'Fiches de révisions') return 'Fiche';
      if (c === 'Documents racines') return 'Général';
      if (c === 'CM' || c === 'TD') return c;
      return c.length > 10 ? c.slice(0, 9) + '…' : c;
    }

    // 2. Rendu de l'arbre des notes dans la barre latérale
    function renderNotesTree(filterQuery: string = '') {
      if (!notesTree) return;
      const q = filterQuery.toLowerCase().trim();

      const allSubjects = getAllSubjects();

      // Regrouper les notes par matière
      const groups = new Map<string, NoteItem[]>();
      allSubjects.forEach(({ name }) => groups.set(name, []));

      notes.forEach((n) => {
        const sub = (n.subject || 'Général').trim();
        if (!groups.has(sub)) groups.set(sub, []);
        groups.get(sub)!.push(n);
      });

      notesTree.innerHTML = '';

      let hasAnyVisible = false;

      Array.from(groups.keys())
        .sort((a, b) => a.localeCompare(b, 'fr'))
        .forEach((subjectName) => {
          const list = groups.get(subjectName) || [];

          // En mode recherche, masquer les matières sans correspondance
          const matchingNotes = q
            ? list.filter(
                (n) =>
                  (n.title && n.title.toLowerCase().includes(q)) ||
                  (n.body_md && n.body_md.toLowerCase().includes(q)) ||
                  subjectName.toLowerCase().includes(q)
              )
            : list;

          if (q && matchingNotes.length === 0 && !subjectName.toLowerCase().includes(q)) {
            return;
          }

          hasAnyVisible = true;
          const groupEl = document.createElement('div');
          groupEl.className = 'subject-group';

          const isCollapsed = !q && collapsedGroups.has(subjectName);

          const headerEl = document.createElement('div');
          headerEl.className = 'subject-group-header';
          headerEl.setAttribute('role', 'button');
          headerEl.setAttribute('tabindex', '0');
          headerEl.setAttribute('aria-expanded', String(!isCollapsed));
          headerEl.innerHTML = `
            <div class="group-title-wrap">
              <svg class="group-chevron ${isCollapsed ? 'collapsed' : ''}" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M3 7.5A2.5 2.5 0 0 1 5.5 5h3.6l2 2.2h7.4A2.5 2.5 0 0 1 21 9.7v7.8a2.5 2.5 0 0 1-2.5 2.5h-13A2.5 2.5 0 0 1 3 17.5z"/></svg>
              <span class="group-name" title="${esc(subjectName)}">${esc(subjectName)}</span>
            </div>
            <div style="display: flex; align-items: center; gap: 0.35rem;">
              <button type="button" class="btn-group-add-note" data-subject="${esc(subjectName)}" title="Ajouter une note dans ${esc(subjectName)}">+</button>
              <span class="group-badge">${list.length}</span>
            </div>
          `;

          const toggleGroup = () => {
            if (collapsedGroups.has(subjectName)) collapsedGroups.delete(subjectName);
            else collapsedGroups.add(subjectName);
            localStorage.setItem('marges_notes_collapsed', JSON.stringify([...collapsedGroups]));
            renderNotesTree(searchInput?.value || '');
          };

          headerEl.addEventListener('click', (e) => {
            const target = e.target as HTMLElement;
            if (target && target.classList.contains('btn-group-add-note')) {
              e.stopPropagation();
              createNewNote(subjectName);
              return;
            }
            toggleGroup();
          });

          headerEl.addEventListener('keydown', (ev) => {
            if (ev.key === 'Enter' || ev.key === ' ') {
              ev.preventDefault();
              toggleGroup();
            }
          });

          groupEl.appendChild(headerEl);

          if (!isCollapsed) {
            const listEl = document.createElement('div');
            listEl.className = 'subject-notes-list';

            if (matchingNotes.length === 0) {
              const emptyItem = document.createElement('div');
              emptyItem.className = 'subject-empty-hint';
              emptyItem.innerHTML = `<span>Aucune note.</span> <button type="button" class="btn-inline-new" data-sub="${esc(subjectName)}">+ Rédiger</button>`;
              emptyItem.querySelector('.btn-inline-new')?.addEventListener('click', () => createNewNote(subjectName));
              listEl.appendChild(emptyItem);
            } else {
              matchingNotes.forEach((n) => {
                const itemEl = document.createElement('div');
                itemEl.className = `note-tree-item ${n.id === currentNoteId ? 'active' : ''}`;
                itemEl.setAttribute('data-id', n.id);

                const displayTitle = n.title.trim() || 'Sans titre';
                const badgeLabel = formatCategoryBadge(n.category);

                itemEl.innerHTML = `
                  <div class="item-main">
                    <svg class="item-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M9 13h6M9 17h4"/></svg>
                    <span class="item-title" title="${esc(displayTitle)}">${esc(displayTitle)}</span>
                  </div>
                  ${badgeLabel ? `<span class="item-badge" title="${esc(n.category)}">${esc(badgeLabel)}</span>` : ''}
                `;

                itemEl.addEventListener('click', () => {
                  loadNoteIntoCanvas(n.id);
                  if (isMobile()) collapseSidebar();
                });

                listEl.appendChild(itemEl);
              });
            }

            groupEl.appendChild(listEl);
          }

          notesTree.appendChild(groupEl);
        });

      if (!hasAnyVisible) {
        notesTree.innerHTML = `<div class="sidebar-empty">Aucune note ne correspond à "${esc(q)}".</div>`;
      }
    }

    // 3. Charger une note dans le canvas
    function loadNoteIntoCanvas(id: string) {
      const target = notes.find((n) => n.id === id);
      if (!target) return;

      currentNoteId = target.id;

      // URL history
      const newUrl = new URL(window.location.href);
      newUrl.searchParams.set('id', target.id);
      window.history.replaceState({}, '', newUrl.toString());

      // Titre & corps
      noteTitle.value = target.title === 'Sans titre' ? '' : target.title;
      noteBody.value = target.body_md || '';

      // Matière & catégorie
      refreshSubjectsDropdown(target.subject || 'Général');
      if (propSubjectSelect) propSubjectSelect.value = target.subject || 'Général';

      if (propCategorySelect) {
        const opts = Array.from(propCategorySelect.options).map((o) => o.value);
        if (opts.includes(target.category)) {
          propCategorySelect.value = target.category;
          if (propCustomCategory) propCustomCategory.style.display = 'none';
        } else if (target.category) {
          propCategorySelect.value = '__new__';
          if (propCustomCategory) {
            propCustomCategory.style.display = 'inline-block';
            propCustomCategory.value = target.category;
          }
        }
      }

      // Icône de page
      if (pageIconDisplay) {
        const iconName = target.icon || 'file';
        pageIconDisplay.innerHTML = ICON_SVGS[iconName] || ICON_SVGS.file;
      }

      // Breadcrumbs
      if (crumbSubjectLabel) crumbSubjectLabel.textContent = target.subject || 'Général';
      if (crumbTitleLabel) crumbTitleLabel.textContent = target.title || 'Sans titre';

      // Temps et statistiques
      updateStatsAndTimestamp(target.body_md, target.updated_at);

      // Aperçu direct
      updatePreview(target.body_md);
      requestAnimationFrame(autoGrow);

      // Mise en surbrillance de l'item actif dans la barre
      document.querySelectorAll('.note-tree-item').forEach((el) => {
        el.classList.toggle('active', el.getAttribute('data-id') === target.id);
      });
    }

    // 4. Mettre à jour les stats (mots, lecture, date)
    function updateStatsAndTimestamp(text: string, updatedIso?: string) {
      const stats = computeNoteStats(text);
      if (propStatsLabel) {
        propStatsLabel.textContent = `${stats.words} mot${stats.words > 1 ? 's' : ''} · ${stats.readMinutes} min de lecture`;
      }

      if (propUpdatedTime) {
        const d = updatedIso ? new Date(updatedIso) : new Date();
        propUpdatedTime.textContent = d.toLocaleDateString('fr-FR', {
          day: 'numeric',
          month: 'short',
          hour: '2-digit',
          minute: '2-digit',
        });
      }
    }

    // 5. Mettre à jour l'aperçu Markdown
    function updatePreview(text: string) {
      if (previewContent) {
        previewContent.innerHTML = renderNotionMarkdown(text);
      }
    }

    // 6. Sauvegarde automatique optimiste
    async function triggerAutoSave() {
      if (!currentNoteId) return;
      const target = notes.find((n) => n.id === currentNoteId);
      if (!target) return;

      const titleVal = noteTitle.value.trim() || 'Sans titre';
      const bodyVal = noteBody.value;
      const subjectVal = propSubjectSelect.value || 'Général';
      const categoryVal =
        propCategorySelect.value === '__new__'
          ? propCustomCategory.value.trim() || 'Fiches de révisions'
          : propCategorySelect.value;

      if (
        target.title === titleVal &&
        target.body_md === bodyVal &&
        target.subject === subjectVal &&
        target.category === categoryVal
      ) {
        return;
      }

      target.title = titleVal;
      target.body_md = bodyVal;
      target.subject = subjectVal;
      target.category = categoryVal;

      if (crumbSubjectLabel) crumbSubjectLabel.textContent = subjectVal;
      if (crumbTitleLabel) crumbTitleLabel.textContent = titleVal;

      if (autosaveStatus) {
        autosaveStatus.className = 'autosave-badge saving';
        if (autosaveLabel) autosaveLabel.textContent = 'Enregistrement...';
      }

      if (sidebarSyncIndicator) sidebarSyncIndicator.classList.add('syncing');
      if (syncStatusLabel) syncStatusLabel.textContent = 'Synchronisation...';

      isSaving = true;
      try {
        const saved = await saveUnifiedNote(target);
        target.updated_at = saved.updated_at;

        if (autosaveStatus) {
          autosaveStatus.className = 'autosave-badge saved';
          if (autosaveLabel) {
            const now = new Date();
            autosaveLabel.textContent = `Enregistré à ${now.toLocaleTimeString('fr-FR', {
              hour: '2-digit',
              minute: '2-digit',
            })}`;
          }
        }

        if (sidebarSyncIndicator) sidebarSyncIndicator.classList.remove('syncing');
        if (syncStatusLabel) syncStatusLabel.textContent = 'Synchronisé';

        updateStatsAndTimestamp(target.body_md, target.updated_at);
        renderNotesTree(searchInput?.value || '');
      } catch (err) {
        console.warn('[AutoSave Note] Erreur:', err);
      } finally {
        isSaving = false;
      }
    }

    function scheduleAutoSave() {
      if (autosaveStatus) {
        autosaveStatus.className = 'autosave-badge saving';
        if (autosaveLabel) autosaveLabel.textContent = 'Modifié...';
      }
      clearTimeout(autoSaveTimer);
      autoSaveTimer = setTimeout(() => {
        triggerAutoSave();
      }, 400);
    }

    // 7. Créer une nouvelle note
    function createNewNote(customSubject?: string) {
      const all = getAllSubjects();
      const defaultSubject = customSubject || propSubjectSelect?.value || (all.length > 0 ? all[0].name : 'Général');
      const newNote: NoteItem = {
        id: typeof crypto !== 'undefined' && crypto.randomUUID ? crypto.randomUUID() : 'note_' + Date.now(),
        title: 'Sans titre',
        body_md: '',
        subject: defaultSubject,
        category: 'Fiches de révisions',
        icon: 'file',
        created_at: new Date().toISOString(),
        updated_at: new Date().toISOString(),
      };

      notes.unshift(newNote);
      saveUnifiedNote(newNote); // Sauvegarde non bloquante en tâche de fond
      refreshSubjectsDropdown(defaultSubject);
      renderNotesTree(searchInput?.value || '');
      loadNoteIntoCanvas(newNote.id);
      noteTitle.focus();
    }

    // 8. Écouteurs d'édition en direct
    noteTitle?.addEventListener('input', () => {
      scheduleAutoSave();
    });

    noteBody?.addEventListener('input', () => {
      autoGrow();
      updatePreview(noteBody.value);
      updateStatsAndTimestamp(noteBody.value);
      scheduleAutoSave();
      checkSlashTrigger();
    });

    // Reclassification directe dans une matière
    propSubjectSelect?.addEventListener('change', () => {
      scheduleAutoSave();
      renderNotesTree(searchInput?.value || '');
    });

    propCategorySelect?.addEventListener('change', () => {
      if (propCategorySelect.value === '__new__') {
        if (propCustomCategory) {
          propCustomCategory.style.display = 'inline-block';
          propCustomCategory.focus();
        }
      } else {
        if (propCustomCategory) propCustomCategory.style.display = 'none';
        scheduleAutoSave();
      }
    });

    propCustomCategory?.addEventListener('input', () => {
      scheduleAutoSave();
    });

    // Bouton ajouter une matière custom
    btnAddCustomSubject?.addEventListener('click', () => {
      const name = prompt('Nom de la nouvelle matière :');
      if (name && name.trim()) {
        const clean = name.trim();
        const opt = document.createElement('option');
        opt.value = clean;
        opt.textContent = clean;
        opt.selected = true;
        propSubjectSelect.appendChild(opt);
        scheduleAutoSave();
        renderNotesTree(searchInput?.value || '');
      }
    });

    // Gestion intelligente du menu Slash Command (/)
    function checkSlashTrigger() {
      if (!slashMenu) return;
      const cursorPos = noteBody.selectionStart;
      const val = noteBody.value;
      const lineStart = val.lastIndexOf('\n', cursorPos - 1) + 1;
      const lineToCursor = val.substring(lineStart, cursorPos);

      if (slashDismissedPos === cursorPos) return;
      slashDismissedPos = null;

      const match = lineToCursor.match(/(?:^|\s)\/+([a-zA-Z0-9_-]*)$/);
      if (match) {
        const query = match[1].toLowerCase();
        openSlashMenu(query);
      } else {
        closeSlashMenu();
      }
    }

    noteBody?.addEventListener('keydown', (e) => {
      // Raccourci explicite Ctrl+/ ou Cmd+/ pour invoquer le menu n'importe où
      if ((e.ctrlKey || e.metaKey) && (e.key === '/' || e.code === 'Slash')) {
        e.preventDefault();
        slashDismissedPos = null;
        openSlashMenu('');
        return;
      }

      if (slashMenu && slashMenu.style.display !== 'none') {
        if (e.key === 'Escape') {
          e.preventDefault();
          slashDismissedPos = noteBody.selectionStart;
          closeSlashMenu();
        } else if (e.key === 'ArrowDown') {
          e.preventDefault();
          moveSlashSelection(1);
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          moveSlashSelection(-1);
        } else if (e.key === 'Enter' || e.key === 'Tab') {
          e.preventDefault();
          executeActiveSlashCommand();
        }
      } else if (e.key === '/' || e.key === ':') {
        // Réinitialiser tout verrouillage et déclencher dès insertion
        slashDismissedPos = null;
        setTimeout(() => checkSlashTrigger(), 10);
      }
    });

    function openSlashMenu(query: string = '') {
      if (!slashMenu) return;

      // Filtrer les éléments selon la recherche
      const items = Array.from(document.querySelectorAll<HTMLElement>('.slash-item'));
      let visibleCount = 0;
      let firstVisible: HTMLElement | null = null;

      items.forEach((item) => {
        const name = (item.querySelector('.slash-name')?.textContent || '').toLowerCase();
        const desc = (item.querySelector('.slash-desc')?.textContent || '').toLowerCase();
        const cmd = (item.getAttribute('data-cmd') || '').toLowerCase();
        const matches = !query || name.includes(query) || desc.includes(query) || cmd.includes(query);

        item.style.display = matches ? 'flex' : 'none';
        item.classList.remove('active');
        if (matches) {
          visibleCount++;
          if (!firstVisible) firstVisible = item;
        }
      });

      if (visibleCount === 0) {
        closeSlashMenu();
        return;
      }

      if (firstVisible) {
        (firstVisible as HTMLElement).classList.add('active');
      }

      const rect = noteBody.getBoundingClientRect();
      const lineH = parseFloat(getComputedStyle(noteBody).lineHeight) || 28;
      const lineIdx = noteBody.value.substring(0, noteBody.selectionStart).split('\n').length;
      const calculatedTop = rect.top + lineIdx * lineH + 6;
      const maxTop = window.innerHeight - 260;

      slashMenu.style.top = `${Math.max(48, Math.min(maxTop, calculatedTop))}px`;
      slashMenu.style.left = `${Math.max(16, Math.min(window.innerWidth - 280, rect.left + 8))}px`;
      slashMenu.style.display = 'block';
    }

    function closeSlashMenu() {
      if (slashMenu) slashMenu.style.display = 'none';
    }

    btnCloseSlash?.addEventListener('click', () => {
      slashDismissedPos = noteBody.selectionStart;
      closeSlashMenu();
    });

    function moveSlashSelection(direction: number) {
      const items = Array.from(document.querySelectorAll<HTMLElement>('.slash-item')).filter(
        (i) => i.style.display !== 'none'
      );
      if (items.length === 0) return;
      let activeIdx = items.findIndex((i) => i.classList.contains('active'));
      activeIdx = (activeIdx + direction + items.length) % items.length;
      items.forEach((i, idx) => i.classList.toggle('active', idx === activeIdx));
      items[activeIdx].scrollIntoView({ block: 'nearest' });
    }

    function executeActiveSlashCommand() {
      const active = document.querySelector('.slash-item.active') as HTMLElement | null;
      if (!active) return;
      const cmd = active.getAttribute('data-cmd') || 'p';
      applySlashCommand(cmd);
      closeSlashMenu();
    }

    function applySlashCommand(cmd: string) {
      const cursor = noteBody.selectionStart;
      const val = noteBody.value;
      const lineStart = val.lastIndexOf('\n', cursor - 1) + 1;
      const lineToCursor = val.substring(lineStart, cursor);

      // Trouver le ou les slashes et la requête à remplacer
      const match = lineToCursor.match(/\/+([a-zA-Z0-9_-]*)$/);
      const replaceStart = match ? lineStart + (lineToCursor.length - match[0].length) : cursor;

      let prefix = '';
      if (cmd === 'h1') prefix = '# ';
      else if (cmd === 'h2') prefix = '## ';
      else if (cmd === 'h3') prefix = '### ';
      else if (cmd === 'todo') prefix = '- [ ] ';
      else if (cmd === 'bullet') prefix = '- ';
      else if (cmd === 'callout') prefix = '> [!NOTE] ';
      else if (cmd === 'quote') prefix = '> ';
      else if (cmd === 'code') prefix = '```\n\n```';
      else if (cmd === 'divider') prefix = '---\n';

      const before = val.substring(0, replaceStart);
      const after = val.substring(cursor);

      noteBody.value = before + prefix + after;
      noteBody.focus();
      let newPos = before.length + prefix.length;
      if (cmd === 'code') {
        newPos = before.length + 4; // place le curseur au milieu du bloc de code
      }
      noteBody.setSelectionRange(newPos, newPos);

      slashDismissedPos = null;
      autoGrow();
      updatePreview(noteBody.value);
      scheduleAutoSave();
    }

    document.querySelectorAll('.slash-item').forEach((item) => {
      item.addEventListener('click', () => {
        const cmd = item.getAttribute('data-cmd') || 'p';
        applySlashCommand(cmd);
        closeSlashMenu();
      });
    });

    // Sélection d'icône de page
    btnChooseIcon?.addEventListener('click', (e) => {
      e.stopPropagation();
      if (iconPickerPopover) {
        iconPickerPopover.style.display = iconPickerPopover.style.display === 'none' ? 'block' : 'none';
      }
    });

    document.querySelectorAll<HTMLButtonElement>('.picker-item').forEach((item) => {
      item.addEventListener('click', (e) => {
        e.stopPropagation();
        const iconName = item.getAttribute('data-icon') || 'file';
        if (!currentNoteId) return;
        const target = notes.find((n) => n.id === currentNoteId);
        if (!target) return;
        target.icon = iconName;
        if (pageIconDisplay) {
          pageIconDisplay.innerHTML = ICON_SVGS[iconName] || ICON_SVGS.file;
        }
        if (iconPickerPopover) iconPickerPopover.style.display = 'none';
        scheduleAutoSave();
      });
    });

    document.addEventListener('click', (e) => {
      if (slashMenu && slashMenu.style.display !== 'none' && !slashMenu.contains(e.target as Node) && e.target !== noteBody) {
        closeSlashMenu();
      }
      if (iconPickerPopover && iconPickerPopover.style.display !== 'none' && !iconPickerPopover.contains(e.target as Node) && e.target !== btnChooseIcon) {
        iconPickerPopover.style.display = 'none';
      }
    });

    // 9. Formatage depuis la barre d'outils
    document.querySelectorAll<HTMLButtonElement>('.fmt-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const fmt = btn.getAttribute('data-fmt');
        if (fmt === 'slash') {
          // Bouton + Bloc : ouvre directement le menu des commandes
          slashDismissedPos = null;
          const cursorPos = noteBody.selectionStart;
          const val = noteBody.value;
          const before = val.substring(0, cursorPos);
          const needsNewline = before.length > 0 && !before.endsWith('\n');
          const insert = needsNewline ? '\n/' : '/';
          noteBody.setRangeText(insert, cursorPos, cursorPos, 'end');
          noteBody.focus();
          autoGrow();
          setTimeout(() => openSlashMenu(''), 10);
          return;
        }

        const start = noteBody.selectionStart;
        const end = noteBody.selectionEnd;
        const selected = noteBody.value.substring(start, end);
        let insert = '';

        if (fmt === 'h1') insert = '\n# ' + (selected || 'Titre 1') + '\n';
        else if (fmt === 'h2') insert = '\n## ' + (selected || 'Titre 2') + '\n';
        else if (fmt === 'h3') insert = '\n### ' + (selected || 'Titre 3') + '\n';
        else if (fmt === 'bold') insert = `**${selected || 'texte'}**`;
        else if (fmt === 'italic') insert = `*${selected || 'texte'}*`;
        else if (fmt === 'code') insert = `\`${selected || 'code'}\``;
        else if (fmt === 'highlight') insert = `==${selected || 'surligné'}==`;
        else if (fmt === 'bullet') insert = '\n- ' + (selected || 'Point clé') + '\n';
        else if (fmt === 'todo') insert = '\n- [ ] ' + (selected || 'Tâche') + '\n';
        else if (fmt === 'quote') insert = '\n> ' + (selected || 'Citation') + '\n';
        else if (fmt === 'callout') insert = '\n> [!NOTE] ' + (selected || 'Remarque') + '\n';
        else if (fmt === 'codeblock') insert = '\n```\n' + (selected || 'code') + '\n```\n';
        else if (fmt === 'divider') insert = '\n---\n';

        noteBody.setRangeText(insert, start, end, 'end');
        noteBody.focus();
        autoGrow();
        updatePreview(noteBody.value);
        scheduleAutoSave();
      });
    });

    // 10. Bascule des modes d'affichage
    document.querySelectorAll<HTMLButtonElement>('.btn-mode').forEach((btn) => {
      btn.addEventListener('click', () => {
        const mode = btn.getAttribute('data-mode');
        document.querySelectorAll('.btn-mode').forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');

        if (!splitContainer) return;
        splitContainer.className = `notion-editor-split mode-${mode}`;

        if (mode === 'preview' || mode === 'split') {
          updatePreview(noteBody.value);
        }
      });
    });

    // 11. Mode plein écran Zen
    btnZenMode?.addEventListener('click', () => {
      root.classList.toggle('zen-mode');
    });

    // 12. Masquage / affichage barre latérale
    function collapseSidebar() {
      sidebar?.classList.add('collapsed');
      if (btnExpandSidebar) btnExpandSidebar.style.display = 'inline-grid';
    }

    function expandSidebar() {
      sidebar?.classList.remove('collapsed');
      if (btnExpandSidebar) btnExpandSidebar.style.display = 'none';
    }

    btnCollapseSidebar?.addEventListener('click', collapseSidebar);
    btnExpandSidebar?.addEventListener('click', expandSidebar);
    document.getElementById('sidebar-backdrop')?.addEventListener('click', collapseSidebar);
    if (isMobile()) collapseSidebar();

    // 13. Téléchargement Markdown
    btnExport?.addEventListener('click', () => {
      if (!currentNoteId) return;
      const target = notes.find((n) => n.id === currentNoteId);
      if (!target) return;

      const titleSlug = (target.title || 'note').toLowerCase().replace(/[^a-z0-9_-]+/g, '-');
      const blob = new Blob([target.body_md || ''], { type: 'text/markdown;charset=utf-8' });
      const dlUrl = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = dlUrl;
      a.download = `${titleSlug}.md`;
      a.click();
      URL.revokeObjectURL(dlUrl);
    });

    // 14. Suppression de note
    btnDelete?.addEventListener('click', async () => {
      if (!currentNoteId) return;
      const target = notes.find((n) => n.id === currentNoteId);
      if (!target) return;

      if (confirm(`Supprimer définitivement la note « ${target.title} » ?`)) {
        const idToDelete = target.id;
        notes = notes.filter((n) => n.id !== idToDelete);
        deleteUnifiedNote(idToDelete);

        if (notes.length > 0) {
          loadNoteIntoCanvas(notes[0].id);
        } else {
          createNewNote();
        }
        renderNotesTree(searchInput?.value || '');
      }
    });

    // 15. Gestionnaire cases à cocher interactives dans l'aperçu
    previewContent?.addEventListener('change', (e) => {
      const target = e.target as HTMLInputElement;
      if (target && target.classList.contains('notion-todo-cb')) {
        const idx = parseInt(target.getAttribute('data-index') || '0', 10);
        let count = 0;
        noteBody.value = noteBody.value.replace(/-\s*\[([ xX])\]/g, (match) => {
          if (count === idx) {
            count++;
            return target.checked ? '- [x]' : '- [ ]';
          }
          count++;
          return match;
        });
        updatePreview(noteBody.value);
        scheduleAutoSave();
      }
    });

    // 16. Bouton Nouvelle Note
    btnCreateNote?.addEventListener('click', () => {
      createNewNote();
    });

    // 17. Recherche en direct
    searchInput?.addEventListener('input', () => {
      renderNotesTree(searchInput.value);
    });

    // 18. Raccourcis clavier (Ctrl+S, Ctrl+N)
    window.addEventListener('keydown', (e) => {
      if ((e.ctrlKey || e.metaKey) && e.key === 's') {
        e.preventDefault();
        triggerAutoSave();
      } else if ((e.ctrlKey || e.metaKey) && e.key === 'n') {
        e.preventDefault();
        createNewNote();
      }
    });

    // 19. Sauvegarder impérativement si l'utilisateur quitte la page
    window.addEventListener('beforeunload', () => {
      if (isSaving || autoSaveTimer) {
        triggerAutoSave();
      }
    });

    // Écouter les mises à jour des cours en direct
    window.addEventListener('marges:courses-changed', () => {
      refreshSubjectsDropdown();
      renderNotesTree(searchInput?.value || '');
    });

    // 20. Chargement initial instantané (0 milliseconde de latence)
    function loadAppNotes() {
      // 1. Chargement instantané depuis le cache local
      notes = getLocalNotes();
      refreshSubjectsDropdown();

      const urlParams = new URLSearchParams(window.location.search);
      const reqId = urlParams.get('id');

      if (notes.length === 0) {
        // Création synchrone sans bloquer l'UI
        createNewNote();
      } else {
        const found = reqId ? notes.find((n) => n.id === reqId) : null;
        loadNoteIntoCanvas(found ? found.id : notes[0].id);
        renderNotesTree();
      }

      // 2. Synchronisation transparente avec Supabase en arrière-plan
      fetchUnifiedNotes()
        .then((fresh) => {
          if (fresh && fresh.length > 0) {
            notes = fresh;
            refreshSubjectsDropdown();
            renderNotesTree(searchInput?.value || '');
            if (currentNoteId) {
              const upToDate = notes.find((n) => n.id === currentNoteId);
              if (upToDate && document.activeElement !== noteBody && document.activeElement !== noteTitle) {
                loadNoteIntoCanvas(upToDate.id);
              }
            }
          }
        })
        .catch((syncErr) => {
          console.warn('[Notes App] Erreur synchro arrière-plan:', syncErr);
        });
    }

    loadAppNotes();
  }

  if (typeof window !== 'undefined') {
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initNotesApp);
    } else {
      initNotesApp();
    }
  }
</script>
