---
import Base from '../../layouts/Base.astro';
---

<Base
  title="Emploi du temps"
  description="Emploi du temps universitaire hebdomadaire au design moderne et épuré."
>
  <div class="calendar-app-root" data-timetable-root>
    <!-- Barre de contrôle supérieure type iOS Calendar -->
    <header class="cal-top-bar">
      <div class="cal-top-left">
        <button type="button" class="btn-cal-month" id="cal-prev" title="Semaine précédente">‹</button>
        <h1 class="cal-month-title" id="cal-month-display">Octobre 2026</h1>
        <button type="button" class="btn-cal-month" id="cal-next" title="Semaine suivante">›</button>
      </div>

      <div class="cal-top-actions">
        <button type="button" class="icon-btn active" id="btn-view-week" title="Vue Semaine">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="9" y1="3" x2="9" y2="21"/><line x1="15" y1="3" x2="15" y2="21"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="3" y1="15" x2="21" y2="15"/></svg>
        </button>
        <button type="button" class="icon-btn" id="btn-view-agenda" title="Vue Liste">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
        </button>
        <a href="/configuration/#calendar-settings" class="icon-btn" title="Paramètres & Import">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
        </a>
      </div>
    </header>

    <!-- Bandeau sélecteur de la semaine (L, M, M, J, V, S, D + pastille rouge Aujourd'hui) -->
    <nav class="cal-week-strip" aria-label="Jours de la semaine">
      <div class="week-strip-inner" id="week-strip-container">
        <!-- Rempli dynamiquement en JS -->
      </div>
    </nav>

    <!-- Vue Grille Calendrier Hebdomadaire (7 jours) -->
    <div class="calendar-scroll-viewport" data-week-view>
      <div class="cal-grid-frame">
        <!-- En-têtes de colonnes des 7 jours (ex: mar. - 13 oct.) -->
        <div class="cal-columns-header" id="cal-columns-header">
          <!-- Rempli en JS -->
        </div>

        <!-- Section des tâches / habitudes toute la journée (ex: 20 pompes mini) -->
        <div class="cal-allday-row" id="cal-allday-row">
          <!-- Rempli en JS -->
        </div>

        <!-- Corps principal avec axe des heures et les 7 colonnes -->
        <div class="cal-grid-body">
          <!-- Axe vertical des heures (08:00 à 20:00) -->
          <div class="cal-time-axis" aria-hidden="true">
            <div class="time-label">08:00</div>
            <div class="time-label">09:00</div>
            <div class="time-label">10:00</div>
            <div class="time-label">11:00</div>
            <div class="time-label">12:00</div>
            <div class="time-label">13:00</div>
            <div class="time-label">14:00</div>
            <div class="time-label">15:00</div>
            <div class="time-label">16:00</div>
            <div class="time-label">17:00</div>
            <div class="time-label">18:00</div>
            <div class="time-label">19:00</div>
            <div class="time-label">20:00</div>

            <!-- Pastille de l'heure courante (ex: 19:06) -->
            <div class="current-time-badge" id="current-time-badge" style="display: none;">
              <span id="current-time-text">19:06</span>
            </div>
          </div>

          <!-- Lignes horizontales séparatrices d'heures -->
          <div class="cal-hour-lines" aria-hidden="true" id="cal-hour-lines">
            <!-- Rempli en JS -->
          </div>

          <!-- Les 7 colonnes de jours pour les cours -->
          <div class="cal-day-columns" id="cal-day-columns">
            <!-- Rempli en JS -->
          </div>
        </div>
      </div>
    </div>

    <!-- Vue Liste / Agenda alternatif -->
    <div class="agenda-view-wrapper" data-agenda-view hidden>
      <div class="container">
        <ul class="agenda-card-list" id="agenda-card-list" role="list">
          <!-- Rempli en JS -->
        </ul>
      </div>
    </div>

    <!-- Barre d'action inférieure flottante type iOS ("Aujourd'hui") -->
    <aside class="cal-floating-bar" aria-label="Raccourcis calendrier">
      <button type="button" class="btn-today-pill" id="btn-today-pill">
        <span class="red-dot"></span>
        <span>Aujourd’hui</span>
      </button>
    </aside>

    <!-- Modal d'inspection détaillée d'un cours au clic -->
    <dialog class="cal-event-dialog" id="event-modal">
      <div class="dialog-content">
        <header class="dialog-header">
          <span class="dialog-badge" id="modal-category">COURS</span>
          <button type="button" class="btn-close-modal" id="modal-close" aria-label="Fermer">✕</button>
        </header>
        <h2 class="dialog-title" id="modal-title">Titre du cours</h2>
        <div class="dialog-meta-list">
          <p class="dialog-meta" id="modal-time">🕒 Horaires</p>
          <p class="dialog-meta" id="modal-location">📍 Salle</p>
          <p class="dialog-desc" id="modal-desc"></p>
        </div>
        <div class="dialog-actions">
          <a href="/cours/" class="btn-modal-action" id="modal-link-course">Consulter les supports de cours →</a>
        </div>
      </div>
    </dialog>
  </div>
</Base>

<script is:inline src="https://cdn.jsdelivr.net/npm/ical.js@1.5.0/build/ical.min.js"></script>

<script>
  import { generateWeekEvents } from '../../utils/timetable';
  import { STORAGE_KEYS, loadPersistent } from '../../utils/persistence';

  interface CalendarEvent {
    id: string;
    title: string;
    start: Date;
    end: Date;
    location?: string;
    description?: string;
    category?: 'cm' | 'td' | 'tp' | 'habit' | 'other';
  }

  const START_HOUR = 8;
  const END_HOUR = 20;
  const TOTAL_HOURS = END_HOUR - START_HOUR; // 12 heures

  let activeDate = new Date();
  let currentEvents: CalendarEvent[] = [];

  function getStartOfWeek(d: Date): Date {
    const date = new Date(d);
    const day = date.getDay();
    // Lundi comme 1er jour de semaine (0 = Dimanche -> recul de 6j)
    const diff = date.getDate() - day + (day === 0 ? -6 : 1);
    date.setDate(diff);
    date.setHours(0, 0, 0, 0);
    return date;
  }

  function formatTime(d: Date): string {
    return d.toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' });
  }

  function parseIcs(rawIcs: string): CalendarEvent[] {
    try {
      // @ts-ignore
      const jcal = window.ICAL ? window.ICAL.parse(rawIcs) : null;
      if (!jcal) return [];
      // @ts-ignore
      const comp = new window.ICAL.Component(jcal);
      const vevents = comp.getAllSubcomponents('vevent');
      const list: CalendarEvent[] = [];

      for (const vevent of vevents) {
        // @ts-ignore
        const ev = new window.ICAL.Event(vevent);
        const title = ev.summary || 'Cours sans titre';
        let category: 'cm' | 'td' | 'tp' | 'habit' | 'other' = 'cm';
        if (title.toUpperCase().includes('TD')) category = 'td';
        else if (title.toUpperCase().includes('TP')) category = 'tp';
        else if (title.toUpperCase().includes('POMPE') || title.toUpperCase().includes('HABIT')) category = 'habit';

        list.push({
          id: ev.uid || Math.random().toString(),
          title,
          start: ev.startDate.toJSDate(),
          end: ev.endDate.toJSDate(),
          location: ev.location || '',
          description: ev.description || '',
          category,
        });
      }
      return list;
    } catch (e) {
      console.warn('Erreur parsing ICS:', e);
      return [];
    }
  }

  function loadEventsForCurrentWeek(): CalendarEvent[] {
    const monday = getStartOfWeek(activeDate);
    const sunday = new Date(monday.getTime() + 7 * 24 * 60 * 60 * 1000);

    // Vérifier si l'utilisateur a importé son fichier .ics dans les cookies/localStorage
    const savedIcs = loadPersistent(STORAGE_KEYS.TIMETABLE_ICS);
    if (savedIcs && savedIcs.trim().length > 20) {
      try {
        const parsed = parseIcs(savedIcs);
        const thisWeekEvents = parsed.filter((e) => e.start >= monday && e.start <= sunday);
        if (thisWeekEvents.length > 0) {
          return parsed;
        }
      } catch (err) {
        console.warn('Erreur lors de la lecture de l’ICS personnalisé:', err);
      }
    }

    // Par défaut : cours récurrents du cursus exactement conformes à sa maquette
    return generateWeekEvents(monday);
  }

  function getEventColorClass(ev: CalendarEvent): string {
    const t = ev.title.toUpperCase();
    if (t.includes('POMPE') || ev.category === 'habit') return 'card-habit';
    if (t.includes('MATLAB') || t.includes('ALGÈBRE') || t.includes('ALGEBRE') || t.includes('PROGRAMMATION')) {
      return 'card-magenta-vivid';
    }
    if (t.startsWith('TD') || ev.category === 'td') return 'card-td';
    return 'card-cm';
  }

  function renderCalendar() {
    const monday = getStartOfWeek(activeDate);
    currentEvents = loadEventsForCurrentWeek();

    // 1. Titre du mois en haut
    const monthDisplay = document.getElementById('cal-month-display');
    if (monthDisplay) {
      const monthStr = activeDate.toLocaleDateString('fr-FR', { month: 'long', year: 'numeric' });
      monthDisplay.textContent = monthStr.charAt(0).toUpperCase() + monthStr.slice(1);
    }

    // 2. Les 7 dates de la semaine
    const weekDays: Date[] = [];
    for (let i = 0; i < 7; i++) {
      const d = new Date(monday);
      d.setDate(monday.getDate() + i);
      weekDays.push(d);
    }

    const todayDate = new Date();
    const todayDateString = todayDate.toDateString();

    // 3. Bandeau supérieur des jours (L, M, M, J, V, S, D + numéro)
    const stripContainer = document.getElementById('week-strip-container');
    if (stripContainer) {
      const letters = ['L', 'M', 'M', 'J', 'V', 'S', 'D'];
      stripContainer.innerHTML = weekDays
        .map((day, i) => {
          const isToday = day.toDateString() === todayDateString;
          const isSelected = day.toDateString() === activeDate.toDateString();
          return `
          <button type="button" class="strip-day-btn ${isToday ? 'is-today' : ''} ${isSelected ? 'is-selected' : ''}" data-day-idx="${i}">
            <span class="strip-letter">${letters[i]}</span>
            <span class="strip-num">${day.getDate()}</span>
          </button>
        `;
        })
        .join('');

      stripContainer.querySelectorAll('[data-day-idx]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const idx = parseInt(btn.getAttribute('data-day-idx') || '0', 10);
          activeDate = new Date(weekDays[idx]);
          renderCalendar();
        });
      });
    }

    // 4. En-têtes des 7 colonnes (ex: "mar. - 13 oct." en rouge si aujourd'hui)
    const colHeaderContainer = document.getElementById('cal-columns-header');
    if (colHeaderContainer) {
      let html = '<div class="col-header-corner"></div>';
      for (const day of weekDays) {
        const isToday = day.toDateString() === todayDateString;
        const formatted = day.toLocaleDateString('fr-FR', { weekday: 'short', day: 'numeric', month: 'short' });
        // Formatage "mar. - 13 oct."
        const parts = formatted.split(' ');
        const label = `${parts[0]} - ${parts.slice(1).join(' ')}`;
        html += `
          <div class="col-header-cell ${isToday ? 'header-today' : ''}">
            <span>${label}</span>
          </div>
        `;
      }
      colHeaderContainer.innerHTML = html;
    }

    // 5. Bandeau d'habitudes / toute la journée (ex: 20 pompes mini)
    const allDayRow = document.getElementById('cal-allday-row');
    if (allDayRow) {
      let html = '<div class="allday-corner"></div>';
      for (const day of weekDays) {
        // Recherche des événements de type habit pour ce jour
        const habitEv = currentEvents.find(
          (e) => e.start.toDateString() === day.toDateString() && (e.category === 'habit' || e.title.includes('pompes'))
        );
        html += `
          <div class="allday-cell">
            ${
              habitEv
                ? `<div class="habit-badge" title="${habitEv.title}">
                    <span class="habit-circle"></span>
                    <span class="habit-title">${habitEv.title}</span>
                  </div>`
                : ''
            }
          </div>
        `;
      }
      allDayRow.innerHTML = html;
    }

    // 6. Lignes horizontales d'heures (arborescence d'arrière plan)
    const hourLinesContainer = document.getElementById('cal-hour-lines');
    if (hourLinesContainer) {
      let linesHtml = '';
      for (let h = 0; h < TOTAL_HOURS; h++) {
        linesHtml += `<div class="hour-line" style="top: ${(h / TOTAL_HOURS) * 100}%;"></div>`;
      }
      hourLinesContainer.innerHTML = linesHtml;
    }

    // 7. Colonnes de jours et cartes de cours
    const columnsContainer = document.getElementById('cal-day-columns');
    if (columnsContainer) {
      let colsHtml = '';

      weekDays.forEach((day, dayIndex) => {
        const isToday = day.toDateString() === todayDateString;
        // Filtrer les événements de ce jour (hors tâches habit toute la journée)
        const dayEvents = currentEvents.filter(
          (e) => e.start.toDateString() === day.toDateString() && e.category !== 'habit' && !e.title.includes('pompes')
        );

        let eventsHtml = '';
        dayEvents.forEach((ev) => {
          const startH = ev.start.getHours() + ev.start.getMinutes() / 60;
          const endH = ev.end.getHours() + ev.end.getMinutes() / 60;

          const clampedStart = Math.max(START_HOUR, Math.min(END_HOUR, startH));
          const clampedEnd = Math.max(START_HOUR, Math.min(END_HOUR, endH));
          const duration = Math.max(0.65, clampedEnd - clampedStart);

          const topPercent = ((clampedStart - START_HOUR) / TOTAL_HOURS) * 100;
          const heightPercent = (duration / TOTAL_HOURS) * 100;

          const cardTypeClass = getEventColorClass(ev);

          eventsHtml += `
            <div
              class="course-card ${cardTypeClass}"
              style="top: ${topPercent}%; height: ${heightPercent}%;"
              data-ev-id="${ev.id}"
            >
              <div class="card-inner">
                <h3 class="card-title">${ev.title}</h3>
                ${ev.location ? `<div class="card-meta">📍 ${ev.location}</div>` : ''}
                <div class="card-meta">🕒 ${formatTime(ev.start)} – ${formatTime(ev.end)}</div>
              </div>
            </div>
          `;
        });

        colsHtml += `
          <div class="cal-day-col ${isToday ? 'col-today' : ''}" data-col-day="${dayIndex}">
            ${eventsHtml}
            ${isToday ? '<div class="now-indicator-line" id="now-line"></div>' : ''}
          </div>
        `;
      });

      columnsContainer.innerHTML = colsHtml;

      // Clic sur une carte pour ouvrir le modal
      columnsContainer.querySelectorAll('[data-ev-id]').forEach((card) => {
        card.addEventListener('click', () => {
          const id = card.getAttribute('data-ev-id');
          const ev = currentEvents.find((e) => e.id === id);
          if (ev) openEventModal(ev);
        });
      });
    }

    // 8. Rendu de l'indicateur temporel rouge en direct
    updateCurrentTimeIndicator();

    // 9. Mise à jour vue liste agenda
    renderAgendaView();
  }

  function updateCurrentTimeIndicator() {
    const now = new Date();
    const nowLine = document.getElementById('now-line');
    const badge = document.getElementById('current-time-badge');
    const textEl = document.getElementById('current-time-text');

    const curH = now.getHours() + now.getMinutes() / 60;
    if (curH >= START_HOUR && curH <= END_HOUR) {
      const topPercent = ((curH - START_HOUR) / TOTAL_HOURS) * 100;
      if (nowLine) {
        nowLine.style.top = `${topPercent}%`;
        nowLine.style.display = 'block';
      }
      if (badge && textEl) {
        badge.style.top = `${topPercent}%`;
        badge.style.display = 'flex';
        textEl.textContent = formatTime(now);
      }
    } else {
      if (nowLine) nowLine.style.display = 'none';
      if (badge) badge.style.display = 'none';
    }
  }

  function renderAgendaView() {
    const listEl = document.getElementById('agenda-card-list');
    if (!listEl) return;

    if (currentEvents.length === 0) {
      listEl.innerHTML = '<li class="no-events meta">Aucun cours trouvé pour cette semaine.</li>';
      return;
    }

    const sorted = [...currentEvents].sort((a, b) => a.start.getTime() - b.start.getTime());

    listEl.innerHTML = sorted
      .map((ev) => {
        const colorClass = getEventColorClass(ev);
        return `
        <li class="agenda-item ${colorClass}">
          <div class="agenda-date">
            <strong>${ev.start.toLocaleDateString('fr-FR', { weekday: 'short', day: 'numeric', month: 'short' })}</strong>
            <span>${formatTime(ev.start)} – ${formatTime(ev.end)}</span>
          </div>
          <div class="agenda-info">
            <h3 class="agenda-title">${ev.title}</h3>
            ${ev.location ? `<p class="agenda-loc">📍 ${ev.location}</p>` : ''}
          </div>
        </li>
      `;
      })
      .join('');
  }

  function openEventModal(ev: CalendarEvent) {
    const modal = document.getElementById('event-modal') as HTMLDialogElement;
    if (!modal) return;

    const catEl = document.getElementById('modal-category');
    const titleEl = document.getElementById('modal-title');
    const timeEl = document.getElementById('modal-time');
    const locEl = document.getElementById('modal-location');
    const descEl = document.getElementById('modal-desc');

    if (catEl) catEl.textContent = ev.title.toUpperCase().startsWith('TD') ? 'TD' : 'CM';
    if (titleEl) titleEl.textContent = ev.title;
    if (timeEl) timeEl.textContent = `🕒 ${formatTime(ev.start)} – ${formatTime(ev.end)}`;
    if (locEl) locEl.textContent = ev.location ? `📍 ${ev.location}` : 'Salle non spécifiée';
    if (descEl) descEl.textContent = ev.description || '';

    modal.showModal();
  }

  function initTimetable() {
    renderCalendar();

    // Boutons de navigation semaines
    document.getElementById('cal-prev')?.addEventListener('click', () => {
      const prev = new Date(activeDate);
      prev.setDate(prev.getDate() - 7);
      activeDate = prev;
      renderCalendar();
    });

    document.getElementById('cal-next')?.addEventListener('click', () => {
      const next = new Date(activeDate);
      next.setDate(next.getDate() + 7);
      activeDate = next;
      renderCalendar();
    });

    // Bouton Aujourd'hui (Pill flottante iOS)
    document.getElementById('btn-today-pill')?.addEventListener('click', () => {
      activeDate = new Date();
      renderCalendar();
      // Scroll doux vers aujourd'hui sur mobile
      const todayCol = document.querySelector('.col-today');
      todayCol?.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
    });

    // Bascule vues Semaine / Liste
    const weekView = document.querySelector('[data-week-view]') as HTMLElement;
    const agendaView = document.querySelector('[data-agenda-view]') as HTMLElement;
    const btnWeek = document.getElementById('btn-view-week');
    const btnAgenda = document.getElementById('btn-view-agenda');

    btnWeek?.addEventListener('click', () => {
      btnWeek.classList.add('active');
      btnAgenda?.classList.remove('active');
      if (weekView) weekView.hidden = false;
      if (agendaView) agendaView.hidden = true;
    });

    btnAgenda?.addEventListener('click', () => {
      btnAgenda.classList.add('active');
      btnWeek?.classList.remove('active');
      if (weekView) weekView.hidden = true;
      if (agendaView) agendaView.hidden = false;
    });

    // Fermeture modal
    document.getElementById('modal-close')?.addEventListener('click', () => {
      (document.getElementById('event-modal') as HTMLDialogElement)?.close();
    });

    document.getElementById('event-modal')?.addEventListener('click', (e) => {
      const modal = document.getElementById('event-modal') as HTMLDialogElement;
      if (e.target === modal) modal.close();
    });

    // Actualisation de l'indicateur de temps toutes les minutes
    setInterval(updateCurrentTimeIndicator, 30000);
  }

  if (typeof window !== 'undefined') {
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initTimetable);
    } else {
      initTimetable();
    }
    document.addEventListener('astro:page-load', initTimetable);
  }
</script>

<style>
  /* ==============================================================
     TOKENS CALENDRIER THEMATIQUES (CLAIR / SOMBRE)
     ============================================================== */

  /* THÈME CLAIR (par défaut si data-theme="light" ou système clair) */
  :root,
  :root[data-theme='light'] {
    --cal-bg: #ffffff;
    --cal-surface: #f4f4f5;
    --cal-border: #e4e4e7;
    --cal-text: #09090b;
    --cal-text-muted: #71717a;
    --cal-hour-line: rgba(0, 0, 0, 0.06);
    --cal-today-col: rgba(255, 59, 48, 0.03);

    --cal-btn-bg: #f4f4f5;
    --cal-btn-hover: #e4e4e7;
    --cal-btn-fg: #18181b;

    --cal-pill-bg: rgba(255, 255, 255, 0.92);
    --cal-pill-border: rgba(0, 0, 0, 0.12);
    --cal-pill-text: #09090b;
    --cal-pill-shadow: 0 4px 16px rgba(0, 0, 0, 0.12);

    --cal-modal-bg: #ffffff;
    --cal-modal-border: #e4e4e7;
    --cal-modal-text: #09090b;

    /* Carré Magenta Éclatant (Matlab, Algèbre, Programmation) */
    --card-magenta-bg: #fdf2f8;
    --card-magenta-border: #f472b6;
    --card-magenta-bar: #db2777;
    --card-magenta-title: #831843;
    --card-magenta-meta: #9d174d;

    /* Carré TD (Violet / Pourpre riche) */
    --card-td-bg: #f5f3ff;
