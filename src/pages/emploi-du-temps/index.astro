---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { url } from '../../utils/url';
---

<Base
  title="Emploi du temps"
  description="Emploi du temps universitaire clair, épuré et lisible. Consultez vos cours de la semaine, du jour ou en liste."
>
  <div class="container container--wide app-page timetable-page" data-timetable-root>
    <!-- En-tête de page -->
    <header class="page-header timetable-hero">
      <div class="timetable-hero-main">
        <p class="crumbs"><a href={url('/')}>Accueil</a> / Emploi du temps</p>
        <h1 class="timetable-title">Emploi du temps</h1>
        <p class="timetable-sub">Planning universitaire · Semestre en cours</p>
      </div>

      <div class="timetable-hero-actions">
        <button type="button" class="btn btn--primary btn--sm" id="btn-open-add-event">
          <Icon name="plus" size={14} />
          <span>Ajouter un cours</span>
        </button>
        <button type="button" class="btn btn--sm" id="btn-export-ics" title="Exporter au format .ics (Apple, Google, Outlook)">
          <Icon name="calendar" size={14} />
          <span>Exporter (.ics)</span>
        </button>
        <a href={url('/configuration/#calendar-settings')} class="btn btn--sm" title="Paramètres et synchronisation">
          <Icon name="settings" size={14} />
          <span class="btn-label-desktop">Réglages</span>
        </a>
      </div>
    </header>

    <!-- Carte contextuelle "En direct / Prochain cours" -->
    <section class="panel live-status-card" id="live-status-card" aria-label="Statut du jour">
      <div class="live-status-indicator">
        <span class="live-pulse" id="live-pulse"></span>
        <span class="live-badge" id="live-badge">Aujourd'hui</span>
      </div>
      <div class="live-status-content" id="live-status-text">
        <strong id="live-title">Chargement des cours du jour…</strong>
        <span class="meta" id="live-meta">Calcul de votre planning en temps réel</span>
      </div>
      <div class="live-status-action" id="live-action-wrap" style="display: none;">
        <a href={url('/cours/')} class="btn btn--sm" id="live-course-link">
          Supports du cours <Icon name="arrow-right" size={13} />
        </a>
      </div>
    </section>

    <!-- Barre de contrôle (Navigation semaine, vues & filtres) -->
    <nav class="timetable-toolbar" aria-label="Contrôles du planning">
      <!-- Groupe Navigation temporelle -->
      <div class="nav-date-group">
        <button type="button" class="btn-nav-arrow" id="btn-prev-week" title="Semaine précédente" aria-label="Semaine précédente">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
        </button>
        <button type="button" class="btn-today-pill" id="btn-today" title="Revenir à la semaine actuelle">
          Aujourd’hui
        </button>
        <button type="button" class="btn-nav-arrow" id="btn-next-week" title="Semaine suivante" aria-label="Semaine suivante">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
        </button>
        <span class="current-date-heading" id="current-date-heading">Chargement…</span>
      </div>

      <!-- Groupe Vues & Filtres -->
      <div class="toolbar-right-group">
        <!-- Filtre par type -->
        <div class="filter-pills" role="radiogroup" aria-label="Filtrer par type de cours">
          <button type="button" class="filter-chip active" data-filter="all">Tous</button>
          <button type="button" class="filter-chip chip-cm" data-filter="cm">CM</button>
          <button type="button" class="filter-chip chip-td" data-filter="td">TD</button>
          <button type="button" class="filter-chip chip-tp" data-filter="tp">TP</button>
        </div>

        <!-- Bascule Week-end -->
        <button type="button" class="btn-weekend-toggle" id="btn-toggle-weekend" title="Afficher ou masquer le samedi et dimanche">
          <span class="weekend-toggle-check" id="weekend-toggle-check"></span>
          <span>Week-end</span>
        </button>

        <!-- Sélecteur de vue (Semaine / Jour / Liste) -->
        <div class="view-segmented-control" role="tablist">
          <button type="button" class="view-tab-btn active" id="tab-view-week" role="tab" aria-selected="true" aria-controls="view-week">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
            <span>Semaine</span>
          </button>
          <button type="button" class="view-tab-btn" id="tab-view-day" role="tab" aria-selected="false" aria-controls="view-day">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            <span>Jour</span>
          </button>
          <button type="button" class="view-tab-btn" id="tab-view-list" role="tab" aria-selected="false" aria-controls="view-list">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
            <span>Liste</span>
          </button>
        </div>
      </div>
    </nav>

    <!-- ========================================================
         VUE 1 : GRILLE SEMAINE (ÉPURÉE & SANS CHEVAUCHEMENT)
         ======================================================== -->
    <section class="timetable-view view-week" id="view-week" role="tabpanel" aria-labelledby="tab-view-week">
      <div class="week-grid-container" id="week-grid-container">
        <!-- En-têtes des jours (ex: LUNDI 12 OCT.) -->
        <div class="week-columns-header" id="week-columns-header">
          <!-- Injecté dynamiquement en JS -->
        </div>

        <!-- Corps de la grille avec axe temporel et colonnes des jours -->
        <div class="week-grid-body" id="week-grid-body">
          <!-- Axe des heures (08:00 à 20:00) -->
          <div class="time-axis" aria-hidden="true" id="time-axis">
            <!-- Rempli en JS -->
          </div>

          <!-- Lignes horizontales des heures -->
          <div class="grid-hour-lines" aria-hidden="true" id="grid-hour-lines">
            <!-- Rempli en JS -->
          </div>

          <!-- Colonnes de cours -->
          <div class="day-columns-container" id="day-columns-container">
            <!-- Rempli en JS -->
          </div>
        </div>
      </div>
    </section>

    <!-- ========================================================
         VUE 2 : JOUR PAR JOUR (FOCUS QUOTIDIEN CONFORTABLE)
         ======================================================== -->
    <section class="timetable-view view-day" id="view-day" role="tabpanel" aria-labelledby="tab-view-day" hidden>
      <!-- Sélecteur rapide de jour (Lun, Mar, Mer, Jeu, Ven, Sam, Dim) -->
      <div class="day-selector-bar" id="day-selector-bar" role="tablist" aria-label="Choisir le jour">
        <!-- Rempli en JS -->
      </div>

      <!-- En-tête du jour sélectionné -->
      <div class="day-view-header">
        <div>
          <h2 class="day-view-title" id="day-view-title">Lundi 12 octobre 2026</h2>
          <p class="meta" id="day-view-stats">Chargement de la journée…</p>
        </div>
      </div>

      <!-- Liste des cours du jour sous forme de cartes aérées -->
      <div class="day-courses-list" id="day-courses-list">
        <!-- Rempli en JS -->
      </div>
    </section>

    <!-- ========================================================
         VUE 3 : LISTE / AGENDA (CHRONOLOGIQUE GLOBAL)
         ======================================================== -->
    <section class="timetable-view view-list" id="view-list" role="tabpanel" aria-labelledby="tab-view-list" hidden>
      <div class="agenda-list-wrapper" id="agenda-list-wrapper">
        <!-- Rempli en JS -->
      </div>
    </section>

    <!-- ========================================================
         MODAL 1 : INSPECTION DÉTAILLÉE D'UN COURS
         ======================================================== -->
    <dialog class="cal-dialog" id="event-modal">
      <div class="cal-dialog-content">
        <header class="cal-dialog-header">
          <div class="dialog-type-tag" id="modal-badge">COURS</div>
          <button type="button" class="btn-close-dialog" id="modal-close" aria-label="Fermer la boîte">✕</button>
        </header>

        <h2 class="cal-dialog-title" id="modal-title">Intitulé du cours</h2>

        <div class="cal-dialog-details">
          <div class="detail-row">
            <span class="detail-icon"><Icon name="clock" size={16} /></span>
            <div>
              <span class="detail-label">Horaires</span>
              <strong class="detail-value" id="modal-time">09:00 — 10:30 (1h30)</strong>
            </div>
          </div>

          <div class="detail-row">
            <span class="detail-icon"><Icon name="pin" size={16} /></span>
            <div style="flex: 1;">
              <span class="detail-label">Salle / Lieu</span>
              <strong class="detail-value" id="modal-location">Salle non spécifiée</strong>
            </div>
            <button type="button" class="btn btn--sm btn-copy-loc" id="btn-copy-loc" title="Copier la salle">
              Copier
            </button>
          </div>

          <div class="detail-row" id="modal-desc-row">
            <span class="detail-icon"><Icon name="file" size={16} /></span>
            <div style="flex: 1;">
              <span class="detail-label">Description du cours</span>
              <p class="detail-text" id="modal-desc">Aucune note particulière.</p>
            </div>
          </div>
        </div>

        <div class="cal-dialog-actions">
          <button type="button" class="btn btn--danger btn--sm" id="btn-delete-event" style="display: none;">
            Supprimer ce créneau
          </button>
          <a href={url('/cours/')} class="btn btn--primary btn--sm" id="modal-link-course">
            <span>Voir les supports de cours</span>
            <Icon name="arrow-right" size={14} />
          </a>
        </div>
      </div>
    </dialog>

    <!-- ========================================================
         MODAL 2 : AJOUT D'UN CRÉNEAU DE COURS
         ======================================================== -->
    <dialog class="cal-dialog" id="dialog-add-event">
      <div class="cal-dialog-content">
        <header class="cal-dialog-header">
          <div class="dialog-type-tag">NOUVEAU CRÉNEAU</div>
          <button type="button" class="btn-close-dialog" id="btn-close-add-event" aria-label="Fermer la boîte">✕</button>
        </header>

        <h2 class="cal-dialog-title">Ajouter un créneau à l'emploi du temps</h2>

        <form id="form-add-event" class="dialog-form">
          <div class="form-field">
            <label for="new-ev-title">Intitulé du cours <span class="required">*</span></label>
            <input
              type="text"
              id="new-ev-title"
              name="title"
              placeholder="Ex : Analyse numérique 1"
              required
            />
          </div>

          <div class="form-row-2">
            <div class="form-field">
              <label for="new-ev-type">Type de cours</label>
              <select id="new-ev-type" name="category">
                <option value="cm">CM (Cours Magistral)</option>
                <option value="td" selected>TD (Travaux Dirigés)</option>
                <option value="tp">TP (Travaux Pratiques)</option>
                <option value="other">Autre / Examen</option>
              </select>
            </div>

            <div class="form-field">
              <label for="new-ev-day">Jour de la semaine</label>
              <select id="new-ev-day" name="day">
                <option value="1">Lundi</option>
                <option value="2">Mardi</option>
                <option value="3">Mercredi</option>
                <option value="4">Jeudi</option>
                <option value="5">Vendredi</option>
                <option value="6">Samedi</option>
                <option value="7">Dimanche</option>
              </select>
            </div>
          </div>

          <div class="form-row-2">
            <div class="form-field">
              <label for="new-ev-start">Heure de début <span class="required">*</span></label>
              <input type="time" id="new-ev-start" name="start" value="09:00" required />
            </div>

            <div class="form-field">
              <label for="new-ev-end">Heure de fin <span class="required">*</span></label>
              <input type="time" id="new-ev-end" name="end" value="10:30" required />
            </div>
          </div>

          <div class="form-field">
            <label for="new-ev-loc">Salle / Lieu</label>
            <input type="text" id="new-ev-loc" name="location" placeholder="Ex : Salle E109, Amphi C..." />
          </div>

          <div class="form-field">
            <label for="new-ev-notes">Notes complémentaires</label>
            <input type="text" id="new-ev-notes" name="notes" placeholder="Ex : Groupe 2, apporter calculatrice..." />
          </div>

          <div class="cal-dialog-actions" style="margin-top: 1.5rem;">
            <button type="button" class="btn btn--sm" id="btn-cancel-add-event">Annuler</button>
            <button type="submit" class="btn btn--primary btn--sm" id="btn-submit-add-event">
              Enregistrer le créneau
            </button>
          </div>
        </form>
      </div>
    </dialog>
  </div>
</Base>

<script>
  import { syncTimetableState, parseIcsEvents } from '../../utils/timetable';
  import { STORAGE_KEYS, loadPersistent } from '../../utils/persistence';
  import {
    fetchUserScheduleEvents,
    createUserScheduleEvent,
    deleteUserScheduleEvent,
  } from '../../utils/supabase';
  import { toast } from '../../utils/toast';
  import { url } from '../../utils/url';

  interface CalendarEvent {
    id: string;
    title: string;
    start: Date;
    end: Date;
    location?: string;
    description?: string;
    category?: 'cm' | 'td' | 'tp' | 'habit' | 'other';
    isCustom?: boolean;
    dbId?: string;
  }

  interface CleanCourseInfo {
    kind: 'CM' | 'TD' | 'TP' | 'Autre';
    cleanTitle: string;
    group: string;
    folderSlug: string;
  }

  const START_HOUR = 8;
  const END_HOUR = 20;
  const TOTAL_HOURS = END_HOUR - START_HOUR; // 12h (08:00 à 20:00)

  let activeDate = new Date();
  let currentEvents: CalendarEvent[] = [];
  let currentFilter: 'all' | 'cm' | 'td' | 'tp' = 'all';
  let showWeekend = false;
  let activeDayIndex = (new Date().getDay() + 6) % 7; // 0 = Lundi, 6 = Dimanche
  let selectedEvent: CalendarEvent | null = null;

  // -------------------------------------------------------------
  // Helpers Dates & Heures
  // -------------------------------------------------------------

  function getStartOfWeek(d: Date): Date {
    const date = new Date(d);
    const day = date.getDay();
    const diff = date.getDate() - day + (day === 0 ? -6 : 1);
    date.setDate(diff);
    date.setHours(0, 0, 0, 0);
    return date;
  }

  function formatTime(d: Date): string {
    return d.toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' });
  }

  function formatDuration(start: Date, end: Date): string {
    const diffMin = Math.round((end.getTime() - start.getTime()) / (60 * 1000));
    const h = Math.floor(diffMin / 60);
    const m = diffMin % 60;
    if (h === 0) return `${m} min`;
    if (m === 0) return `${h}h`;
    return `${h}h${String(m).padStart(2, '0')}`;
  }

  /**
   * Analyse et nettoie le titre d'un cours universitaire
   * Exemple: "CM - ECUE Analyse numérique 1 G01" -> { kind: 'CM', cleanTitle: 'Analyse numérique 1', group: 'G01' }
   */
  function parseCourse(title: string, category?: string): CleanCourseInfo {
    let clean = (title || '').trim();
    let kind: 'CM' | 'TD' | 'TP' | 'Autre' = 'CM';

    if (category === 'td' || /^TD\b/i.test(clean)) kind = 'TD';
    else if (category === 'tp' || /^TP\b/i.test(clean)) kind = 'TP';
    else if (category === 'cm' || /^CM\b/i.test(clean)) kind = 'CM';
    else kind = 'Autre';

    // Retirer préfixes "CM -", "TD -", "TP -"
    clean = clean.replace(/^(CM|TD|TP)\s*[-—:]\s*/i, '');

    // Retirer codes type "ECUE ", "MA3 "
    clean = clean.replace(/^(ECUE|MA3)\s+/i, '');

    // Extraire le groupe s'il existe (ex: "G01", "G02/2")
    let group = '';
    const groupMatch = clean.match(/\b(G\d+(\/\d+)?)\b/i);
    if (groupMatch) {
      group = groupMatch[1];
      clean = clean.replace(/\b(G\d+(\/\d+)?)\b/i, '').trim();
    }

    // Nettoyer ponctuations résiduelles
    clean = clean.replace(/\s*[-—]\s*$/, '').trim();

    // Slug pour retrouver les supports de cours
    const folderSlug = clean
      .toLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/^-|-$/g, '');

    return {
      kind,
      cleanTitle: clean || title,
      group,
      folderSlug,
    };
  }

  function getSubjectUrl(slug: string): string {
    const basePath = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');
    if (slug.includes('analyse')) return `${basePath}/cours/#folder-analyse-numerique`;
    if (slug.includes('algebre') || slug.includes('matlab') || slug.includes('scilab'))
      return `${basePath}/cours/#folder-algebre-lineaire-numerique-scilab`;
    if (slug.includes('edo') || slug.includes('dynamique'))
      return `${basePath}/cours/#folder-edo`;
    if (slug.includes('langage') || slug.includes('informatique'))
      return `${basePath}/cours/#folder-informatique-theorique`;
    if (slug.includes('maths') || slug.includes('ingenieur'))
      return `${basePath}/cours/#folder-maths-de-l-ingenieur`;
    return `${basePath}/cours/`;
  }

  // -------------------------------------------------------------
  // Chargement des événements (Supabase > LocalStorage > Template)
  // -------------------------------------------------------------

  async function loadEvents(): Promise<CalendarEvent[]> {
    const monday = getStartOfWeek(activeDate);
    const sunday = new Date(monday.getTime() + 7 * 24 * 60 * 60 * 1000 - 1);
    const events: CalendarEvent[] = [];
    const seen = new Set<string>();

    function addCalEvent(ev: CalendarEvent) {
      const s = ev.start;
      const key = `${s.getTime()}-${ev.title.toLowerCase().trim()}`;
      if (!seen.has(key)) {
        seen.add(key);
        events.push(ev);
      }
    }

    // 0. Auto-synchronisation Supabase Cloud (PC <-> Mobile)
    await syncTimetableState().catch(() => {});

    // 1. Fichier ICS personnalisé (analyse précise par date et récurrence)
    const savedIcs = loadPersistent(STORAGE_KEYS.TIMETABLE_ICS);
    if (savedIcs && savedIcs.trim().length > 30) {
      const parsed = parseIcsEvents(savedIcs, monday, sunday);
      parsed.forEach((p) => {
        addCalEvent({
          id: p.id,
          title: p.title,
          start: p.start,
          end: p.end,
          location: p.location,
          description: p.description,
          category: p.category,
        });
      });
    }

    // 2. Créneaux hebdomadaires créés manuellement par l'étudiant dans Supabase
    try {
      const dbEvents = await fetchUserScheduleEvents();
      if (dbEvents && dbEvents.length > 0) {
        dbEvents.forEach((dbEv) => {
          const dayOffset = (dbEv.day_of_week || 1) - 1;
          const d = new Date(monday.getFullYear(), monday.getMonth(), monday.getDate() + dayOffset);
          const [sH, sM] = (dbEv.start_time || '08:30').split(':').map(Number);
          const [eH, eM] = (dbEv.end_time || '10:30').split(':').map(Number);
          const start = new Date(d);
          start.setHours(sH, sM, 0, 0);
          const end = new Date(d);
          end.setHours(eH, eM, 0, 0);

          let cat: 'cm' | 'td' | 'tp' | 'other' = 'cm';
          const t = dbEv.title.toUpperCase();
          if (t.includes('TD')) cat = 'td';
          else if (t.includes('TP')) cat = 'tp';

          addCalEvent({
            id: dbEv.id || `db-${Math.random()}`,
            title: dbEv.title,
            start,
            end,
            location: dbEv.location || '',
            description: dbEv.notes || '',
            category: cat,
            isCustom: true,
            dbId: dbEv.id,
          });
        });
      }
    } catch {
      // Ignorer si pas connecté à Supabase
    }

    // 3. Événements personnalisés sauvegardés localement (localStorage fallback)
    try {
      const localCustom = localStorage.getItem('marges_custom_schedule_events');
      if (localCustom) {
        const parsedCustom: Array<{
          id: string;
          title: string;
          dayOffset: number;
          startH: number;
          startM: number;
          endH: number;
          endM: number;
          location?: string;
          notes?: string;
          category?: any;
        }> = JSON.parse(localCustom);

        parsedCustom.forEach((c) => {
          const d = new Date(monday.getFullYear(), monday.getMonth(), monday.getDate() + c.dayOffset);
          const start = new Date(d);
          start.setHours(c.startH, c.startM, 0, 0);
          const end = new Date(d);
          end.setHours(c.endH, c.endM, 0, 0);
          addCalEvent({
            id: c.id,
            title: c.title,
            start,
            end,
            location: c.location || '',
            description: c.notes || '',
            category: c.category || 'cm',
            isCustom: true,
          });
        });
      }
    } catch {}

    // Renvoyer les cours réels de l'utilisateur
    return events;
  }

  // -------------------------------------------------------------
  // Algorithme de disposition intelligente sans chevauchement
  // -------------------------------------------------------------

  interface GridDayLayout {
    ev: CalendarEvent;
    startMin: number;
    endMin: number;
    col: number;
    totalCols: number;
  }

  function layoutDayEvents(events: CalendarEvent[]): GridDayLayout[] {
    if (!events.length) return [];

    const items = events.map((ev) => {
      const startMin = ev.start.getHours() * 60 + ev.start.getMinutes();
      const endMin = ev.end.getHours() * 60 + ev.end.getMinutes();
      return {
        ev,
        startMin,
        endMin: Math.max(endMin, startMin + 45), // au moins 45 min visuelles pour lisibilité
        col: 0,
        totalCols: 1,
      };
    });

    items.sort((a, b) => a.startMin - b.startMin || (b.endMin - b.startMin) - (a.endMin - a.startMin));

    // Regroupement en clusters de chevauchement
    const clusters: (typeof items)[] = [];
    let currentCluster: typeof items = [];
    let clusterEnd = -1;

    for (const item of items) {
      if (!currentCluster.length) {
        currentCluster.push(item);
        clusterEnd = item.endMin;
      } else if (item.startMin < clusterEnd) {
        currentCluster.push(item);
        clusterEnd = Math.max(clusterEnd, item.endMin);
      } else {
        clusters.push(currentCluster);
        currentCluster = [item];
        clusterEnd = item.endMin;
      }
    }
    if (currentCluster.length) clusters.push(currentCluster);

    const result: GridDayLayout[] = [];
    for (const cluster of clusters) {
      const colEndTimes: number[] = [];
      for (const item of cluster) {
        let placed = -1;
        for (let i = 0; i < colEndTimes.length; i++) {
          if (colEndTimes[i] <= item.startMin) {
            placed = i;
            colEndTimes[i] = item.endMin;
            break;
          }
        }
        if (placed === -1) {
          placed = colEndTimes.length;
          colEndTimes.push(item.endMin);
        }
        item.col = placed;
      }

      const totalCols = Math.max(1, colEndTimes.length);
      for (const item of cluster) {
        item.totalCols = totalCols;
        result.push(item);
      }
    }

    return result;
  }

  // -------------------------------------------------------------
  // Rendu de la carte "En direct / Prochain cours"
  // -------------------------------------------------------------

  function updateLiveStatusCard() {
    const card = document.getElementById('live-status-card');
    const badge = document.getElementById('live-badge');
    const titleEl = document.getElementById('live-title');
    const metaEl = document.getElementById('live-meta');
    const actionWrap = document.getElementById('live-action-wrap');
    const linkEl = document.getElementById('live-course-link') as HTMLAnchorElement | null;
    const pulse = document.getElementById('live-pulse');

    if (!card || !titleEl || !metaEl) return;

    const now = new Date();
    const todayEvents = currentEvents
      .filter((e) => e.start.toDateString() === now.toDateString())
      .sort((a, b) => a.start.getTime() - b.start.getTime());

    if (todayEvents.length === 0) {
      badge!.textContent = 'Aujourd’hui';
      titleEl.textContent = 'Aucun cours programmé aujourd’hui.';
      metaEl.textContent = 'Profitez-en pour réviser ou lire un texte.';
      if (pulse) pulse.style.display = 'none';
      if (actionWrap) actionWrap.style.display = 'none';
      return;
    }

    const currentLive = todayEvents.find((e) => now >= e.start && now <= e.end);
    const upcoming = todayEvents.filter((e) => e.start > now);

    if (currentLive) {
      const info = parseCourse(currentLive.title, currentLive.category);
      if (badge) {
        badge.textContent = 'En cours';
        badge.className = 'live-badge live-badge--active';
      }
      if (pulse) pulse.style.display = 'inline-block';
      titleEl.textContent = `${info.kind} · ${info.cleanTitle}`;
      metaEl.textContent = `Jusqu’à ${formatTime(currentLive.end)} ${currentLive.location ? '· Salle ' + currentLive.location : ''}`;

      if (actionWrap && linkEl) {
        linkEl.href = getSubjectUrl(info.folderSlug);
        actionWrap.style.display = 'block';
      }
    } else if (upcoming.length > 0) {
      const next = upcoming[0];
      const info = parseCourse(next.title, next.category);
      if (badge) {
        badge.textContent = 'Prochain cours';
        badge.className = 'live-badge';
      }
      if (pulse) pulse.style.display = 'none';
      titleEl.textContent = `${info.kind} · ${info.cleanTitle} à ${formatTime(next.start)}`;
      metaEl.textContent = `Durée ${formatDuration(next.start, next.end)} ${next.location ? '· ' + next.location : ''} · ${upcoming.length} cours restant${upcoming.length > 1 ? 's' : ''}`;

      if (actionWrap && linkEl) {
        linkEl.href = getSubjectUrl(info.folderSlug);
        actionWrap.style.display = 'block';
      }
    } else {
      if (badge) {
        badge.textContent = 'Terminé';
        badge.className = 'live-badge';
      }
      if (pulse) pulse.style.display = 'none';
      titleEl.textContent = 'Tous les cours de la journée sont terminés.';
      metaEl.textContent = `Bonne fin de journée · ${todayEvents.length} cours suivis aujourd’hui.`;
      if (actionWrap) actionWrap.style.display = 'none';
    }
  }

  // -------------------------------------------------------------
  // Rendu Vue Semaine (Grille hebdomadaire)
  // -------------------------------------------------------------

  function renderWeekView(weekDays: Date[]) {
    const headerContainer = document.getElementById('week-columns-header');
    const timeAxisContainer = document.getElementById('time-axis');
    const hourLinesContainer = document.getElementById('grid-hour-lines');
    const dayColsContainer = document.getElementById('day-columns-container');
    const gridContainer = document.getElementById('week-grid-container');

    if (!headerContainer || !dayColsContainer || !gridContainer) return;

    const visibleDays = showWeekend ? weekDays : weekDays.slice(0, 5);
    const dayCount = visibleDays.length;
    const todayStr = new Date().toDateString();

    gridContainer.style.setProperty('--day-columns-count', String(dayCount));

    // 1. En-têtes des jours
    let headerHtml = '<div class="header-corner-cell"></div>';
    visibleDays.forEach((day, idx) => {
      const isToday = day.toDateString() === todayStr;
      const dayName = day.toLocaleDateString('fr-FR', { weekday: 'long' });
      const dayNum = day.toLocaleDateString('fr-FR', { day: 'numeric', month: 'short' });

      // Compter le nombre de cours pour ce jour
      const dayEvs = currentEvents.filter((e) => e.start.toDateString() === day.toDateString());
      const filteredCount = filterEvents(dayEvs).length;

      headerHtml += `
        <div class="col-header-day ${isToday ? 'is-today' : ''}" data-day-index="${idx}">
          <span class="day-name">${dayName.toUpperCase()}</span>
          <span class="day-num">${dayNum}</span>
          ${filteredCount > 0 ? `<span class="day-count-badge">${filteredCount} cours</span>` : ''}
        </div>
      `;
    });
    headerContainer.innerHTML = headerHtml;

    // 2. Axe temporel (08:00 à 20:00)
    if (timeAxisContainer) {
      let axisHtml = '';
      for (let h = START_HOUR; h <= END_HOUR; h++) {
        const timeStr = `${String(h).padStart(2, '0')}:00`;
        axisHtml += `<div class="time-axis-tick"><span>${timeStr}</span></div>`;
      }
      timeAxisContainer.innerHTML = axisHtml;
    }

    // 3. Lignes horizontales des heures
    if (hourLinesContainer) {
      let linesHtml = '';
      for (let h = 0; h < TOTAL_HOURS; h++) {
        linesHtml += `<div class="hour-line" style="top: ${(h / TOTAL_HOURS) * 100}%;"></div>`;
      }
      hourLinesContainer.innerHTML = linesHtml;
    }

    // 4. Colonnes et cartes de cours
    let bodyHtml = '';
    const now = new Date();
    const curHour = now.getHours() + now.getMinutes() / 60;
    const nowTopPercent = ((curHour - START_HOUR) / TOTAL_HOURS) * 100;

    visibleDays.forEach((day, dayIndex) => {
      const isToday = day.toDateString() === todayStr;
      const dayEvs = filterEvents(
        currentEvents.filter((e) => e.start.toDateString() === day.toDateString())
      );

      const layoutItems = layoutDayEvents(dayEvs);
      let cardsHtml = '';

      layoutItems.forEach(({ ev, col, totalCols }) => {
        const startH = ev.start.getHours() + ev.start.getMinutes() / 60;
        const endH = ev.end.getHours() + ev.end.getMinutes() / 60;

        const clampedStart = Math.max(START_HOUR, Math.min(END_HOUR, startH));
        const clampedEnd = Math.max(START_HOUR, Math.min(END_HOUR, endH));
        const durationH = Math.max(0.75, clampedEnd - clampedStart);

        const topPercent = ((clampedStart - START_HOUR) / TOTAL_HOURS) * 100;
        const heightPercent = (durationH / TOTAL_HOURS) * 100;

        const widthPercent = 100 / totalCols;
        const leftPercent = col * widthPercent;

        const info = parseCourse(ev.title, ev.category);
        const kindClass = `card-kind--${info.kind.toLowerCase()}`;
        const isTight = totalCols > 1;
        const isShort = durationH <= 1.1;

        cardsHtml += `
          <article
            class="cal-course-card ${kindClass} ${isTight ? 'is-tight' : ''} ${isShort ? 'is-short' : ''}"
            style="top: ${topPercent}%; height: ${heightPercent}%; left: calc(${leftPercent}% + 3px); width: calc(${widthPercent}% - 6px);"
            data-event-id="${ev.id}"
            tabindex="0"
            role="button"
            aria-label="${info.kind} ${info.cleanTitle}, de ${formatTime(ev.start)} à ${formatTime(ev.end)}${ev.location ? ', ' + ev.location : ''}"
          >
            <div class="card-inner">
              <header class="card-top-row">
                <span class="card-tag tag-${info.kind.toLowerCase()}">${info.kind}</span>
                <span class="card-time">${formatTime(ev.start)} – ${formatTime(ev.end)}</span>
              </header>
              <h3 class="card-course-title">${info.cleanTitle}</h3>
              <div class="card-bottom-row">
                ${
                  ev.location
                    ? `<span class="card-loc"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg> ${ev.location}</span>`
                    : ''
                }
                ${info.group ? `<span class="card-group-pill">${info.group}</span>` : ''}
              </div>
            </div>
          </article>
        `;
      });

      bodyHtml += `
        <div class="day-col ${isToday ? 'is-today-col' : ''}" data-day-col="${dayIndex}">
          ${cardsHtml}
          ${
            isToday && curHour >= START_HOUR && curHour <= END_HOUR
              ? `<div class="current-time-line" style="top: ${nowTopPercent}%;" title="Heure actuelle (${formatTime(now)})"><span class="line-dot"></span></div>`
              : ''
          }
        </div>
      `;
    });

    dayColsContainer.innerHTML = bodyHtml;

    // Événements de clic sur les cartes pour ouvrir la modale
    dayColsContainer.querySelectorAll<HTMLElement>('[data-event-id]').forEach((card) => {
      card.addEventListener('click', () => {
        const id = card.getAttribute('data-event-id');
        const ev = currentEvents.find((e) => e.id === id);
        if (ev) openCourseModal(ev);
      });
      card.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          const id = card.getAttribute('data-event-id');
          const ev = currentEvents.find((e) => e.id === id);
          if (ev) openCourseModal(ev);
        }
      });
    });
  }

  // -------------------------------------------------------------
  // Rendu Vue Jour (Focus Quotidien)
  // -------------------------------------------------------------

  function renderDayView(weekDays: Date[]) {
    const selectorBar = document.getElementById('day-selector-bar');
    const dayTitle = document.getElementById('day-view-title');
    const dayStats = document.getElementById('day-view-stats');
    const listEl = document.getElementById('day-courses-list');

    if (!selectorBar || !dayTitle || !dayStats || !listEl) return;

    const visibleDays = showWeekend ? weekDays : weekDays.slice(0, 5);
    const todayStr = new Date().toDateString();

    // 1. Boutons sélecteurs de jours
    let barHtml = '';
    visibleDays.forEach((day, idx) => {
      const isSelected = idx === activeDayIndex;
      const isToday = day.toDateString() === todayStr;
      const name = day.toLocaleDateString('fr-FR', { weekday: 'short' });
      const num = day.getDate();

      barHtml += `
        <button
          type="button"
          class="day-pill-btn ${isSelected ? 'active' : ''} ${isToday ? 'is-today' : ''}"
          data-day-select="${idx}"
        >
          <span class="pill-name">${name}</span>
          <span class="pill-num">${num}</span>
          ${isToday ? '<span class="pill-today-dot" title="Aujourd\'hui"></span>' : ''}
        </button>
      `;
    });
    selectorBar.innerHTML = barHtml;

    selectorBar.querySelectorAll<HTMLButtonElement>('[data-day-select]').forEach((btn) => {
      btn.addEventListener('click', () => {
        activeDayIndex = parseInt(btn.getAttribute('data-day-select') || '0', 10);
        renderDayView(weekDays);
      });
    });

    // 2. Jour actif
    const selectedDate = visibleDays[activeDayIndex] || visibleDays[0];
    const fullDateStr = selectedDate.toLocaleDateString('fr-FR', {
      weekday: 'long',
      day: 'numeric',
      month: 'long',
      year: 'numeric',
    });
    dayTitle.textContent = fullDateStr.charAt(0).toUpperCase() + fullDateStr.slice(1);

    const dayEvs = filterEvents(
      currentEvents.filter((e) => e.start.toDateString() === selectedDate.toDateString())
    ).sort((a, b) => a.start.getTime() - b.start.getTime());

    const totalMinutes = dayEvs.reduce(
      (acc, e) => acc + Math.round((e.end.getTime() - e.start.getTime()) / 60000),
      0
    );
    const totH = Math.floor(totalMinutes / 60);
    const totM = totalMinutes % 60;
    const durationLabel = totH > 0 ? `${totH}h${totM ? String(totM).padStart(2, '0') : ''} de cours` : '';

    dayStats.textContent =
      dayEvs.length > 0
        ? `${dayEvs.length} cours programmé${dayEvs.length > 1 ? 's' : ''} · ${durationLabel}`
        : 'Aucun cours programmé ce jour-là.';

    // 3. Liste des cartes confortables
    if (dayEvs.length === 0) {
      listEl.innerHTML = `
        <div class="empty-day-panel">
          <div class="empty-icon"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg></div>
          <h3>Aucun cours ce jour-là</h3>
          <p class="meta">Votre planning est totalement libre. Profitez-en pour réviser ou explorer les fiches de cours.</p>
          <a href="${url('/cours/')}" class="btn btn--sm" style="margin-top: 1rem;">Accéder aux supports de cours</a>
        </div>
      `;
      return;
    }

    const now = new Date();
    let coursesHtml = '';

    dayEvs.forEach((ev) => {
      const info = parseCourse(ev.title, ev.category);
      const isPast = now > ev.end;
      const isLive = now >= ev.start && now <= ev.end;
      const statusLabel = isLive ? 'En cours' : isPast ? 'Terminé' : 'À venir';
      const statusClass = isLive ? 'status-live' : isPast ? 'status-past' : 'status-upcoming';

      coursesHtml += `
        <div class="day-course-card card-kind--${info.kind.toLowerCase()} ${statusClass}" data-event-id="${ev.id}" role="button" tabindex="0" title="Cliquer pour afficher la description et les détails">
          <div class="card-time-column">
            <span class="time-start">${formatTime(ev.start)}</span>
            <span class="time-sep">↓</span>
            <span class="time-end">${formatTime(ev.end)}</span>
            <span class="duration-badge">${formatDuration(ev.start, ev.end)}</span>
          </div>

          <div class="card-content-column">
            <div class="card-header-tags">
              <span class="card-tag tag-${info.kind.toLowerCase()}">${info.kind}</span>
              <span class="card-status-pill ${statusClass}">${statusLabel}</span>
              ${ev.location ? `<span class="location-pill"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg> ${ev.location}</span>` : ''}
              ${info.group ? `<span class="group-pill">${info.group}</span>` : ''}
            </div>

            <h3 class="day-card-title">${info.cleanTitle}</h3>

            <div class="day-card-actions">
              <a href="${getSubjectUrl(info.folderSlug)}" class="btn btn--sm btn-course-docs" onclick="event.stopPropagation()">
                <span>Consulter les supports</span>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </a>
              <button type="button" class="btn btn--sm btn-inspect-details" data-inspect-id="${ev.id}">
                <span>Détails & description</span>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
              </button>
            </div>
          </div>
        </div>
      `;
    });

    listEl.innerHTML = coursesHtml;

    listEl.querySelectorAll<HTMLElement>('.day-course-card').forEach((card) => {
      card.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('a')) return;
        const id = card.getAttribute('data-event-id');
        const ev = currentEvents.find((item) => item.id === id);
        if (ev) openCourseModal(ev);
      });
      card.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          const id = card.getAttribute('data-event-id');
          const ev = currentEvents.find((item) => item.id === id);
          if (ev) openCourseModal(ev);
        }
      });
    });
  }

  // -------------------------------------------------------------
  // Rendu Vue Liste (Agenda Chronologique)
  // -------------------------------------------------------------

  function renderListView(weekDays: Date[]) {
    const listWrapper = document.getElementById('agenda-list-wrapper');
    if (!listWrapper) return;

    const visibleDays = showWeekend ? weekDays : weekDays.slice(0, 5);
    const filteredAll = filterEvents(currentEvents);

    if (filteredAll.length === 0) {
      listWrapper.innerHTML = `
        <div class="empty-day-panel">
          <p class="meta">Aucun cours trouvé pour cette sélection.</p>
        </div>
      `;
      return;
    }

    let agendaHtml = '';
    visibleDays.forEach((day) => {
      const dayEvs = filterEvents(
        currentEvents.filter((e) => e.start.toDateString() === day.toDateString())
      ).sort((a, b) => a.start.getTime() - b.start.getTime());

      if (dayEvs.length === 0) return;

      const dateLabel = day.toLocaleDateString('fr-FR', {
        weekday: 'long',
        day: 'numeric',
        month: 'long',
      });

      agendaHtml += `
        <div class="agenda-day-block">
          <h3 class="agenda-day-header">
            <span>${dateLabel.charAt(0).toUpperCase() + dateLabel.slice(1)}</span>
            <span class="meta">${dayEvs.length} cours</span>
          </h3>
          <div class="agenda-cards-grid">
            ${dayEvs
              .map((ev) => {
                const info = parseCourse(ev.title, ev.category);
                return `
                <div class="agenda-card card-kind--${info.kind.toLowerCase()}" data-event-id="${ev.id}" role="button" tabindex="0" title="Cliquer pour afficher la description et les détails">
                  <div class="agenda-time">
                    <strong>${formatTime(ev.start)}</strong>
                    <span class="meta">${formatTime(ev.end)}</span>
                  </div>
                  <div class="agenda-body">
                    <div class="agenda-meta-row">
                      <span class="card-tag tag-${info.kind.toLowerCase()}">${info.kind}</span>
                      ${ev.location ? `<span class="card-loc"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg> ${ev.location}</span>` : ''}
                      ${info.group ? `<span class="group-pill">${info.group}</span>` : ''}
                    </div>
                    <h4 class="agenda-title">${info.cleanTitle}</h4>
                  </div>
                </div>
              `;
              })
              .join('')}
          </div>
        </div>
      `;
    });

    listWrapper.innerHTML = agendaHtml || '<p class="meta">Aucun cours cette semaine.</p>';

    listWrapper.querySelectorAll<HTMLElement>('[data-event-id]').forEach((card) => {
      card.addEventListener('click', () => {
        const id = card.getAttribute('data-event-id');
        const ev = currentEvents.find((e) => e.id === id);
        if (ev) openCourseModal(ev);
      });
    });
  }

  // -------------------------------------------------------------
  // Filtres
  // -------------------------------------------------------------

  function filterEvents(events: CalendarEvent[]): CalendarEvent[] {
    if (currentFilter === 'all') return events;
    return events.filter((e) => {
      const info = parseCourse(e.title, e.category);
      return info.kind.toLowerCase() === currentFilter;
    });
  }

  // -------------------------------------------------------------
  // Rendu Global de l'Emploi du Temps
  // -------------------------------------------------------------

  async function renderAll() {
    const monday = getStartOfWeek(activeDate);
    const sunday = new Date(monday.getTime() + 6 * 24 * 60 * 60 * 1000);

    // Titre de la semaine active
    const headingEl = document.getElementById('current-date-heading');
    if (headingEl) {
      const monthStr = activeDate.toLocaleDateString('fr-FR', { month: 'long', year: 'numeric' });
      const mDay = monday.getDate();
      const sDay = sunday.getDate();
      headingEl.textContent = `${mDay} — ${sDay} ${monthStr}`;
    }

    currentEvents = await loadEvents();

    // Vérifier si le weekend a des cours
    const hasWeekendEvents = currentEvents.some((e) => {
      const day = e.start.getDay();
      return day === 0 || day === 6; // Dimanche ou Samedi
    });
    if (hasWeekendEvents && !showWeekend) {
      showWeekend = true;
      const checkEl = document.getElementById('weekend-toggle-check');
      if (checkEl) checkEl.classList.add('checked');
    }

    // 7 jours de la semaine
    const weekDays: Date[] = [];
    for (let i = 0; i < 7; i++) {
      const d = new Date(monday);
      d.setDate(monday.getDate() + i);
      weekDays.push(d);
    }

    // Mettre à jour le statut en direct
    updateLiveStatusCard();

    // Rendu des 3 vues
    renderWeekView(weekDays);
    renderDayView(weekDays);
    renderListView(weekDays);
  }

  // -------------------------------------------------------------
  // Modale Détails du cours
  // -------------------------------------------------------------

  function openCourseModal(ev: CalendarEvent) {
    selectedEvent = ev;
    const modal = document.getElementById('event-modal') as HTMLDialogElement | null;
    if (!modal) return;

    const info = parseCourse(ev.title, ev.category);
    const badgeEl = document.getElementById('modal-badge');
    const titleEl = document.getElementById('modal-title');
    const timeEl = document.getElementById('modal-time');
    const locEl = document.getElementById('modal-location');
    const descEl = document.getElementById('modal-desc');
    const descRow = document.getElementById('modal-desc-row');
    const linkCourse = document.getElementById('modal-link-course') as HTMLAnchorElement | null;
    const btnDelete = document.getElementById('btn-delete-event');

    if (badgeEl) {
      badgeEl.textContent = info.kind;
      badgeEl.className = `dialog-type-tag tag-${info.kind.toLowerCase()}`;
    }
    if (titleEl) {
      titleEl.textContent = info.group ? `${info.cleanTitle} (${info.group})` : info.cleanTitle;
    }
    if (timeEl) timeEl.textContent = `${formatTime(ev.start)} — ${formatTime(ev.end)} (${formatDuration(ev.start, ev.end)})`;
    if (locEl) locEl.textContent = ev.location || 'Salle non spécifiée';

    if (descEl && descRow) {
      const desc = (ev.description || '').trim();
      descEl.textContent = desc || 'Aucune description spécifique renseignée pour ce cours.';
      descRow.style.display = 'flex';
    }

    if (linkCourse) {
      linkCourse.href = getSubjectUrl(info.folderSlug);
    }

    // Bouton de suppression (créneaux custom / DB)
    if (btnDelete) {
      if (ev.isCustom) {
        btnDelete.style.display = 'inline-flex';
      } else {
        btnDelete.style.display = 'none';
      }
    }

    modal.showModal();
  }

  // -------------------------------------------------------------
  // Export .ICS dynamique
  // -------------------------------------------------------------

  function exportScheduleToIcs() {
    if (!currentEvents.length) {
      toast('Aucun cours à exporter.', 'error');
      return;
    }

    const pad = (n: number) => String(n).padStart(2, '0');
    const toIcsDate = (d: Date) =>
      `${d.getFullYear()}${pad(d.getMonth() + 1)}${pad(d.getDate())}T${pad(d.getHours())}${pad(d.getMinutes())}${pad(d.getSeconds())}`;

    let icsContent = `BEGIN:VCALENDAR\r\nVERSION:2.0\r\nPRODID:-//Marges Universitaire//FR\r\nCALSCALE:GREGORIAN\r\n`;

    currentEvents.forEach((ev, idx) => {
      icsContent += `BEGIN:VEVENT\r\n`;
      icsContent += `UID:marges-${idx}-${ev.start.getTime()}@marges.app\r\n`;
      icsContent += `DTSTAMP:${toIcsDate(new Date())}Z\r\n`;
      icsContent += `DTSTART:${toIcsDate(ev.start)}\r\n`;
      icsContent += `DTEND:${toIcsDate(ev.end)}\r\n`;
      icsContent += `SUMMARY:${ev.title.replace(/\r?\n/g, ' ')}\r\n`;
      if (ev.location) icsContent += `LOCATION:${ev.location}\r\n`;
      if (ev.description) icsContent += `DESCRIPTION:${ev.description.replace(/\r?\n/g, ' ')}\r\n`;
      icsContent += `END:VEVENT\r\n`;
    });

    icsContent += `END:VCALENDAR\r\n`;

    const blob = new Blob([icsContent], { type: 'text/calendar;charset=utf-8;' });
    const link = document.createElement('a');
    link.href = URL.createObjectURL(blob);
    link.download = 'mon-emploi-du-temps.ics';
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    toast('Emploi du temps téléchargé au format .ics !', 'success');
  }

  // -------------------------------------------------------------
  // Initialisation des événements et contrôleurs
  // -------------------------------------------------------------

  function initTimetable() {
    renderAll();

    // Navigation semaines
    document.getElementById('btn-prev-week')?.addEventListener('click', async () => {
      const prev = new Date(activeDate);
      prev.setDate(prev.getDate() - 7);
      activeDate = prev;
      await renderAll();
    });

    document.getElementById('btn-next-week')?.addEventListener('click', async () => {
      const next = new Date(activeDate);
      next.setDate(next.getDate() + 7);
      activeDate = next;
      await renderAll();
    });

    document.getElementById('btn-today')?.addEventListener('click', async () => {
      activeDate = new Date();
      activeDayIndex = (new Date().getDay() + 6) % 7;
      await renderAll();
    });

    // Bascule Week-end
    const btnWeekend = document.getElementById('btn-toggle-weekend');
    const checkWeekend = document.getElementById('weekend-toggle-check');
    btnWeekend?.addEventListener('click', async () => {
      showWeekend = !showWeekend;
      checkWeekend?.classList.toggle('checked', showWeekend);
      await renderAll();
    });

    // Filtres par type (Tous, CM, TD, TP)
    document.querySelectorAll<HTMLButtonElement>('.filter-chip').forEach((chip) => {
      chip.addEventListener('click', () => {
        document.querySelectorAll('.filter-chip').forEach((c) => c.classList.remove('active'));
        chip.classList.add('active');
        currentFilter = (chip.getAttribute('data-filter') as any) || 'all';
        renderAll();
      });
    });

    // Bascule des vues (Semaine / Jour / Liste)
    const tabWeek = document.getElementById('tab-view-week');
    const tabDay = document.getElementById('tab-view-day');
    const tabList = document.getElementById('tab-view-list');

    const viewWeek = document.getElementById('view-week');
    const viewDay = document.getElementById('view-day');
    const viewList = document.getElementById('view-list');

    function switchView(viewName: 'week' | 'day' | 'list') {
      [tabWeek, tabDay, tabList].forEach((t) => {
        t?.classList.remove('active');
        t?.setAttribute('aria-selected', 'false');
      });
      [viewWeek, viewDay, viewList].forEach((v) => {
        if (v) v.hidden = true;
      });

      if (viewName === 'week') {
        tabWeek?.classList.add('active');
        tabWeek?.setAttribute('aria-selected', 'true');
        if (viewWeek) viewWeek.hidden = false;
      } else if (viewName === 'day') {
        tabDay?.classList.add('active');
        tabDay?.setAttribute('aria-selected', 'true');
        if (viewDay) viewDay.hidden = false;
      } else if (viewName === 'list') {
        tabList?.classList.add('active');
        tabList?.setAttribute('aria-selected', 'true');
        if (viewList) viewList.hidden = false;
      }
    }

    tabWeek?.addEventListener('click', () => switchView('week'));
    tabDay?.addEventListener('click', () => switchView('day'));
    tabList?.addEventListener('click', () => switchView('list'));

    // Export ICS
    document.getElementById('btn-export-ics')?.addEventListener('click', exportScheduleToIcs);

    // Copie de la salle dans le presse-papier
    document.getElementById('btn-copy-loc')?.addEventListener('click', () => {
      const locText = document.getElementById('modal-location')?.textContent;
      if (locText && locText !== 'Salle non spécifiée') {
        navigator.clipboard?.writeText(locText);
        toast(`Salle "${locText}" copiée !`, 'success');
      }
    });

    // Fermeture modale d'inspection
    const modalInspection = document.getElementById('event-modal') as HTMLDialogElement | null;
    document.getElementById('modal-close')?.addEventListener('click', () => {
      modalInspection?.close();
    });
    modalInspection?.addEventListener('click', (e) => {
      if (e.target === modalInspection) modalInspection.close();
    });

    // Suppression d'un cours custom
    document.getElementById('btn-delete-event')?.addEventListener('click', async () => {
      if (!selectedEvent) return;
      if (!confirm(`Supprimer le cours "${selectedEvent.title}" ?`)) return;

      if (selectedEvent.dbId) {
        try {
          await deleteUserScheduleEvent(selectedEvent.dbId);
        } catch (e: any) {
          toast(e.message || 'Erreur lors de la suppression.', 'error');
        }
      } else {
        try {
          const raw = localStorage.getItem('marges_custom_schedule_events');
          if (raw) {
            let list = JSON.parse(raw);
            list = list.filter((item: any) => item.id !== selectedEvent?.id);
            localStorage.setItem('marges_custom_schedule_events', JSON.stringify(list));
          }
        } catch {}
      }

      modalInspection?.close();
      toast('Cours supprimé.', 'success');
      await renderAll();
    });

    // Modale Ajout de créneau
    const dialogAdd = document.getElementById('dialog-add-event') as HTMLDialogElement | null;
    const btnOpenAdd = document.getElementById('btn-open-add-event');
    const btnCloseAdd = document.getElementById('btn-close-add-event');
    const btnCancelAdd = document.getElementById('btn-cancel-add-event');
    const formAdd = document.getElementById('form-add-event') as HTMLFormElement | null;

    btnOpenAdd?.addEventListener('click', () => dialogAdd?.showModal());
    btnCloseAdd?.addEventListener('click', () => dialogAdd?.close());
    btnCancelAdd?.addEventListener('click', () => dialogAdd?.close());
    dialogAdd?.addEventListener('click', (e) => {
      if (e.target === dialogAdd) dialogAdd.close();
    });

    formAdd?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const titleInput = document.getElementById('new-ev-title') as HTMLInputElement | null;
      const typeInput = document.getElementById('new-ev-type') as HTMLSelectElement | null;
      const dayInput = document.getElementById('new-ev-day') as HTMLSelectElement | null;
      const startInput = document.getElementById('new-ev-start') as HTMLInputElement | null;
      const endInput = document.getElementById('new-ev-end') as HTMLInputElement | null;
      const locInput = document.getElementById('new-ev-loc') as HTMLInputElement | null;
      const notesInput = document.getElementById('new-ev-notes') as HTMLInputElement | null;

      if (!titleInput || !dayInput || !startInput || !endInput) return;

      const rawTitle = titleInput.value.trim();
      const cat = typeInput?.value || 'td';
      const dayOfWeek = parseInt(dayInput.value, 10); // 1 = Lundi, 7 = Dimanche
      const startStr = startInput.value;
      const endStr = endInput.value;
      const locStr = locInput?.value.trim() || '';
      const notesStr = notesInput?.value.trim() || '';

      const [sH, sM] = startStr.split(':').map(Number);
      const [eH, eM] = endStr.split(':').map(Number);

      // Préfixe propre si manquant
      const title =
        rawTitle.toUpperCase().startsWith('CM') ||
        rawTitle.toUpperCase().startsWith('TD') ||
        rawTitle.toUpperCase().startsWith('TP')
          ? rawTitle
          : `${cat.toUpperCase()} - ${rawTitle}`;

      // Tenter Supabase
      let savedToDb = false;
      try {
        await createUserScheduleEvent({
          title,
          day_of_week: dayOfWeek,
          start_time: `${startStr}:00`,
          end_time: `${endStr}:00`,
          location: locStr || undefined,
          notes: notesStr || undefined,
        });
        savedToDb = true;
      } catch {
        // Fallback localStorage
      }

      if (!savedToDb) {
        try {
          const raw = localStorage.getItem('marges_custom_schedule_events') || '[]';
          const list = JSON.parse(raw);
          list.push({
            id: `custom-${Date.now()}`,
            title,
            dayOffset: dayOfWeek - 1,
            startH: sH,
            startM: sM,
            endH: eH,
            endM: eM,
            location: locStr,
            notes: notesStr,
            category: cat,
          });
          localStorage.setItem('marges_custom_schedule_events', JSON.stringify(list));
        } catch {}
      }

      dialogAdd?.close();
      formAdd.reset();
      toast('Nouveau créneau enregistré !', 'success');
      await renderAll();
    });

    // Actualisation du statut direct toutes les 30 secondes
    setInterval(updateLiveStatusCard, 30000);
  }

  if (typeof window !== 'undefined') {
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initTimetable);
    } else {
      initTimetable();
    }
    document.addEventListener('astro:page-load', initTimetable);
  }
</script>

