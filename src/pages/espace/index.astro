          <div class="tags-row">${tags}</div>
          <div class="card-bottom">
            <button type="button" class="btn btn--sm btn-read-course" data-id="${c.id}">Lire</button>
            <button type="button" class="btn btn--danger btn--sm btn-del-course" data-id="${c.id}">Supprimer</button>
          </div>
        `;

        card.querySelector('.btn-read-course')?.addEventListener('click', () => {
          openCourseReader(c);
        });

        card.querySelector('.btn-del-course')?.addEventListener('click', async () => {
          if (confirm(`Supprimer définitivement le cours "${c.title}" ?`)) {
            try {
              if (c.id) await deleteUserCourse(c.id);
              notify('Cours supprimé.');
              await loadCourses();
            } catch (err: any) {
              notify(err.message, true);
            }
          }
