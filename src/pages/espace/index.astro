---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { getCourses } from '../../utils/courses';
import { url } from '../../utils/url';

const localPresetCourses = getCourses().map((s) => {
  let md = `## Supports de cours & organisation\n\n`;
  if (s.folder.subfolders && s.folder.subfolders.length > 0) {
    s.folder.subfolders.forEach((sub) => {
      md += `### ${sub.name}\n\n`;
      if (sub.files && sub.files.length > 0) {
        sub.files.forEach((f) => {
          const mb = (f.size / (1024 * 1024)).toFixed(1);
          md += `- [${f.name}](${f.viewerUrl}) (${mb} Mo)\n`;
        });
      } else {
        md += `*Aucun fichier dans ce sous-dossier.*\n`;
      }
      md += `\n`;
    });
  }
  if (s.folder.files && s.folder.files.length > 0) {
    md += `### Documents généraux\n\n`;
    s.folder.files.forEach((f) => {
      const mb = (f.size / (1024 * 1024)).toFixed(1);
      md += `- [${f.name}](${f.viewerUrl}) (${mb} Mo)\n`;
    });
    md += `\n`;
  }
  return {
    title: s.name,
    body_md: md,
    tags: ['Université', s.name],
  };
});
---

<Base
  title="Mon Espace Personnel"
  description="Accédez à vos cours privés, votre emploi du temps et vos rappels synchronisés en toute sécurité."
>
  <div class="container container--wide app-page espace-page" data-espace-root data-local-presets={JSON.stringify(localPresetCourses)}>
    <header class="page-header espace-hero">
      <div class="espace-hero-top">
        <div>
          <p class="crumbs"><a href={url('/')}>Accueil</a> / Espace Personnel</p>
          <h1 class="espace-title">Mon Espace</h1>
          <p class="espace-motto">
            Données privées protégées par Row Level Security (RLS) et synchronisées avec Supabase.
          </p>
        </div>
        <div class="espace-auth-actions" id="user-top-actions" style="display: none;">
          <div class="user-badge">
            <span class="user-status-dot"></span>
            <span id="user-display-email" class="user-email-text">utilisateur</span>
          </div>
          <button type="button" class="btn btn--sm" id="btn-logout">
            <Icon name="log-out" size={14} />
            Se déconnecter
          </button>
        </div>
      </div>
    </header>

    <!-- Zone de messages / notifications -->
    <div id="espace-banner" class="panel espace-banner" style="display: none;">
      <span class="banner-dot"></span>
      <span id="espace-banner-text">Message</span>
    </div>

    <!-- 1. VUE NON CONNECTÉ (FORMULAIRE DE CONNEXION) -->
    <div id="view-login" class="espace-section">
      <div class="panel auth-card">
        <div class="card-head">
          <span class="icon-tile"><Icon name="user" size={20} /></span>
          <div>
            <h2>Connexion à votre espace</h2>
            <p class="meta">Entrez les identifiants fournis par l'administrateur</p>
          </div>
        </div>

        <form id="form-login" class="espace-form">
          <div class="form-group">
            <label for="login-email" class="field-label">Adresse email :</label>
            <input
              type="email"
              id="login-email"
              placeholder="votre-nom@exemple.fr"
              required
              autocomplete="username"
            />
          </div>

          <div class="form-group">
            <label for="login-password" class="field-label">Mot de passe :</label>
            <input
              type="password"
              id="login-password"
              placeholder="••••••••••••"
              required
              autocomplete="current-password"
            />
          </div>

          <div id="login-error-box" class="login-error" style="display: none;">
            <span id="login-error-text">Identifiants invalides.</span>
          </div>

          <div class="card-actions">
            <button type="submit" class="btn btn--primary" id="btn-submit-login">
              Se connecter
            </button>
            <button type="button" class="btn btn--sm" id="btn-toggle-supabase-config">
              <Icon name="settings" size={14} />
              Paramètres Supabase
            </button>
          </div>
        </form>

        <!-- Configuration Supabase intégrée (évite les blocages d'accès) -->
        <div id="box-supabase-inline" class="auth-supabase-inline" style="display: none; margin-top: 1.5rem; padding-top: 1.25rem; border-top: 1px solid var(--border-color, #e5e5e5);">
          <h3 style="font-size: 1rem; margin-bottom: 0.35rem;">Configuration directe de Supabase</h3>
          <p class="meta" style="font-size: 0.85rem; margin-bottom: 1rem;">
            Renseignez votre Project URL et clé publique ci-dessous pour connecter l'application à votre instance Supabase.
          </p>
          <form id="form-inline-supabase" class="espace-form">
            <div class="form-group">
              <label for="inline-supabase-url" class="field-label">Project URL (Supabase) :</label>
              <input type="url" id="inline-supabase-url" placeholder="https://votre-projet.supabase.co" required />
            </div>
            <div class="form-group">
              <label for="inline-supabase-key" class="field-label">Clé publique (Anon / Publishable) :</label>
              <input type="text" id="inline-supabase-key" placeholder="sb_publishable_... ou eyJhbGci..." required />
            </div>
            <div class="card-actions">
              <button type="submit" class="btn btn--primary btn--sm" id="btn-save-inline-supabase">
                Enregistrer et activer
              </button>
              <button type="button" class="btn btn--sm" id="btn-close-inline-supabase">
                Masquer
              </button>
            </div>
          </form>
        </div>

        <div class="auth-security-notice meta">
          <p>
            <strong>Protection des données :</strong> Les comptes sont créés sur invitation. Chaque utilisateur dispose de son espace étanche : grâce aux politiques PostgreSQL Row Level Security (RLS), vos cours privés, plannings et rappels ne sont accessibles que par vous.
          </p>
        </div>
      </div>
    </div>

    <!-- 2. VUE CONNECTÉ (TABLEAU DE BORD PERSONNEL) -->
    <div id="view-dashboard" class="espace-section" style="display: none;">
      <!-- Navigation par onglets -->
      <nav class="espace-tabs" aria-label="Sections de mon espace">
        <button type="button" class="tab-btn active" data-tab="courses">
          <Icon name="folder" size={16} />
          <span>Mes Cours Privés</span>
          <span class="tab-badge" id="badge-courses-count">0</span>
        </button>
        <button type="button" class="tab-btn" data-tab="schedule">
          <Icon name="calendar" size={16} />
          <span>Mon Emploi du Temps</span>
          <span class="tab-badge" id="badge-schedule-count">0</span>
        </button>
        <button type="button" class="tab-btn" data-tab="reminders">
          <Icon name="bell" size={16} />
          <span>Mes Rappels</span>
          <span class="tab-badge" id="badge-reminders-count">0</span>
        </button>
        <button type="button" class="tab-btn" data-tab="security">
          <Icon name="settings" size={16} />
          <span>Compte & Sécurité</span>
        </button>
      </nav>

      <!-- ONGLET A : COURS PRIVÉS -->
      <section id="tab-panel-courses" class="tab-panel active">
        <div class="panel-section-head">
          <div>
            <h2>Mes Cours et Notes Personnels</h2>
            <p class="meta">Rédigez et consultez vos fiches au format Markdown, stockées de manière privée</p>
          </div>
          <div class="courses-actions-group" style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
            <button type="button" class="btn btn--sm" id="btn-import-local-preset" title="Importer automatiquement les 6 matières locales détectées">
              <Icon name="folder" size={14} />
              Importer mes 6 matières locales
            </button>
            <label class="btn btn--sm" style="margin: 0; cursor: pointer; display: inline-flex; align-items: center; gap: 0.35rem;" title="Choisir un dossier sur votre ordinateur avec arborescence automatique">
              <Icon name="file" size={14} />
              Importer un dossier de cours...
              <input type="file" id="input-import-folder" webkitdirectory directory multiple style="display: none;" />
            </label>
            <button type="button" class="btn btn--primary btn--sm" id="btn-open-course-modal">
              <Icon name="plus" size={14} />
              Nouveau cours
            </button>
          </div>
        </div>

        <div id="courses-list-loading" class="meta loading-state">Chargement de vos cours...</div>
        <div id="courses-list-empty" class="panel empty-state" style="display: none;">
          <p>Aucun cours privé enregistré pour le moment.</p>
          <div style="display: flex; gap: 0.5rem; justify-content: center; flex-wrap: wrap; margin-top: 1rem;">
            <button type="button" class="btn btn--primary btn--sm" id="btn-import-local-preset-empty">
              <Icon name="folder" size={14} />
              Importer mes 6 matières locales
            </button>
            <label class="btn btn--sm" style="margin: 0; cursor: pointer; display: inline-flex; align-items: center; gap: 0.35rem;">
              <Icon name="file" size={14} />
              Importer un dossier complet...
              <input type="file" id="input-import-folder-empty" webkitdirectory directory multiple style="display: none;" />
            </label>
            <button type="button" class="btn btn--sm" id="btn-create-first-course">
              Créer manuellement
            </button>
          </div>
        </div>
        <div id="courses-grid" class="cards-grid"></div>
      </section>

      <!-- ONGLET B : EMPLOI DU TEMPS -->
      <section id="tab-panel-schedule" class="tab-panel" style="display: none;">
        <div class="panel-section-head">
          <div>
            <h2>Mon Emploi du Temps Personnel</h2>
            <p class="meta">Vos créneaux personnalisés de cours, TD ou séances de travail</p>
          </div>
          <button type="button" class="btn btn--primary btn--sm" id="btn-open-schedule-modal">
            <Icon name="plus" size={14} />
            Ajouter un créneau
          </button>
        </div>

        <div id="schedule-list-loading" class="meta loading-state">Chargement de votre planning...</div>
        <div id="schedule-list-empty" class="panel empty-state" style="display: none;">
          <p>Aucun créneau personnalisé enregistré.</p>
          <button type="button" class="btn btn--sm" id="btn-create-first-schedule">
            Ajouter un créneau de cours
          </button>
        </div>
        <div id="schedule-days-container" class="schedule-days-grid"></div>
      </section>

      <!-- ONGLET C : RAPPELS -->
      <section id="tab-panel-reminders" class="tab-panel" style="display: none;">
        <div class="panel-section-head">
          <div>
            <h2>Mes Rappels Personnels</h2>
            <p class="meta">Vos alertes quotidiennes de révisions et lectures</p>
          </div>
          <button type="button" class="btn btn--primary btn--sm" id="btn-open-reminder-modal">
            <Icon name="plus" size={14} />
            Nouveau rappel
          </button>
        </div>

        <div id="reminders-list-loading" class="meta loading-state">Chargement de vos rappels...</div>
        <div id="reminders-list-empty" class="panel empty-state" style="display: none;">
          <p>Aucun rappel personnel configuré.</p>
          <button type="button" class="btn btn--sm" id="btn-create-first-reminder">
            Créer un rappel
          </button>
        </div>
        <div id="reminders-list" class="reminders-list"></div>
      </section>

      <!-- ONGLET D : COMPTE & SÉCURITÉ -->
      <section id="tab-panel-security" class="tab-panel" style="display: none;">
        <div class="security-grid">
          <div class="panel security-card">
            <h3>Mon Profil</h3>
            <p class="meta">Personnalisez votre nom ou prénom affiché sur le site</p>

            <form id="form-update-profile" class="espace-form">
              <div class="form-group">
                <label for="profile-full-name" class="field-label">Nom ou prénom affiché :</label>
                <input type="text" id="profile-full-name" placeholder="Ex: Tom" />
              </div>
              <div class="card-actions">
                <button type="submit" class="btn btn--primary btn--sm" id="btn-submit-profile">
                  Enregistrer mon nom
                </button>
              </div>
            </form>
          </div>

          <div class="panel security-card">
            <h3>Changer mon mot de passe</h3>
            <p class="meta">Mettez à jour le mot de passe initial attribué par l'administrateur</p>

            <form id="form-change-password" class="espace-form">
              <div class="form-group">
                <label for="new-password" class="field-label">Nouveau mot de passe :</label>
                <input type="password" id="new-password" minlength="8" required placeholder="8 caractères minimum" />
              </div>
              <div class="form-group">
                <label for="confirm-password" class="field-label">Confirmer le mot de passe :</label>
                <input type="password" id="confirm-password" minlength="8" required placeholder="Confirmez" />
              </div>
              <div class="card-actions">
                <button type="submit" class="btn btn--primary btn--sm" id="btn-submit-pwd">
                  Mettre à jour le mot de passe
                </button>
              </div>
            </form>
          </div>

          <div class="panel security-card">
            <h3>Sauvegarde et Export de mes données</h3>
            <p class="meta">Téléchargez l'intégralité de vos cours, planning et rappels au format JSON</p>
            <div class="card-actions" style="margin-top: 1.5rem;">
              <button type="button" class="btn btn--sm" id="btn-export-data">
                <Icon name="book" size={14} />
                Exporter mes données (JSON)
              </button>
            </div>
            <p class="help-text" style="margin-top: 1rem;">
              En cas de suppression de compte, toutes vos données Supabase sont automatiquement supprimées en cascade (politique <code>ON DELETE CASCADE</code>).
            </p>
          </div>
        </div>
      </section>
    </div>

    <!-- MODAL : AJOUT / ÉDITION DE COURS -->
    <div id="modal-course" class="modal-overlay" style="display: none;">
      <div class="modal-dialog modal-dialog--wide">
        <div class="modal-header">
          <h3 id="modal-course-title">Rédiger un cours privé</h3>
          <button type="button" class="btn-close" id="btn-close-course-modal" aria-label="Fermer">✕</button>
        </div>
        <form id="form-save-course" class="modal-body espace-form">
          <div class="form-group">
            <label for="course-input-title" class="field-label">Titre du cours ou de la fiche :</label>
            <input type="text" id="course-input-title" placeholder="Ex: Philosophie de l'Esprit — Séance 1" required />
          </div>
          <div class="form-group">
            <label for="course-input-tags" class="field-label">Étiquettes (séparées par des virgules) :</label>
            <input type="text" id="course-input-tags" placeholder="Ex: Métaphysique, Conscience, Fiche" />
          </div>
          <div class="form-group">
            <div class="editor-tabs-head">
              <label for="course-input-body" class="field-label">Contenu (Markdown) :</label>
              <div class="editor-switch">
                <button type="button" class="btn-subtab active" id="tab-write">Écrire</button>
                <button type="button" class="btn-subtab" id="tab-preview">Aperçu</button>
              </div>
            </div>
            <textarea id="course-input-body" rows="12" placeholder="Écrivez vos notes en Markdown ici... (# Titre, **gras**, listes, citations)"></textarea>
            <div id="course-preview-area" class="markdown-preview" style="display: none;"></div>
          </div>
          <div class="modal-footer card-actions">
            <button type="submit" class="btn btn--primary" id="btn-submit-course">Enregistrer le cours</button>
            <button type="button" class="btn btn--sm" id="btn-cancel-course">Annuler</button>
          </div>
        </form>
      </div>
    </div>

    <!-- MODAL : LECTURE DE COURS -->
    <div id="modal-view-course" class="modal-overlay" style="display: none;">
      <div class="modal-dialog modal-dialog--wide">
        <div class="modal-header">
          <div>
            <h3 id="view-course-modal-title">Titre</h3>
            <p class="meta" id="view-course-modal-meta">Tags</p>
          </div>
          <button type="button" class="btn-close" id="btn-close-view-modal" aria-label="Fermer">✕</button>
        </div>
        <div class="modal-body">
          <div id="view-course-body" class="markdown-rendered-view"></div>
        </div>
        <div class="modal-footer card-actions">
          <button type="button" class="btn btn--sm" id="btn-close-view-bottom">Fermer la lecture</button>
        </div>
      </div>
    </div>

    <!-- MODAL : AJOUT DE CRÉNEAU D'EMPLOI DU TEMPS -->
    <div id="modal-schedule" class="modal-overlay" style="display: none;">
      <div class="modal-dialog">
        <div class="modal-header">
          <h3>Ajouter un créneau d'emploi du temps</h3>
          <button type="button" class="btn-close" id="btn-close-schedule-modal" aria-label="Fermer">✕</button>
        </div>
        <form id="form-save-schedule" class="modal-body espace-form">
          <div class="form-group">
            <label for="schedule-input-title" class="field-label">Intitulé du cours / créneau :</label>
            <input type="text" id="schedule-input-title" placeholder="Ex: TD Éthique contemporaine" required />
          </div>
          <div class="form-group">
            <label for="schedule-input-day" class="field-label">Jour de la semaine :</label>
            <select id="schedule-input-day" required>
              <option value="1">Lundi</option>
              <option value="2">Mardi</option>
              <option value="3">Mercredi</option>
              <option value="4">Jeudi</option>
              <option value="5">Vendredi</option>
              <option value="6">Samedi</option>
              <option value="7">Dimanche</option>
            </select>
          </div>
          <div class="times-subgrid">
            <div class="form-group">
              <label for="schedule-input-start" class="field-label">Début :</label>
              <input type="time" id="schedule-input-start" value="08:30" required />
            </div>
            <div class="form-group">
              <label for="schedule-input-end" class="field-label">Fin :</label>
              <input type="time" id="schedule-input-end" value="10:30" required />
            </div>
          </div>
          <div class="form-group">
            <label for="schedule-input-location" class="field-label">Salle / Bâtiment (optionnel) :</label>
            <input type="text" id="schedule-input-location" placeholder="Ex: Bâtiment B, Salle 204" />
          </div>
          <div class="form-group">
            <label for="schedule-input-notes" class="field-label">Notes (optionnel) :</label>
            <input type="text" id="schedule-input-notes" placeholder="Ex: Professeur M. Dupont, apporter le recueil de textes" />
          </div>
          <div class="modal-footer card-actions">
            <button type="submit" class="btn btn--primary" id="btn-submit-schedule">Enregistrer le créneau</button>
            <button type="button" class="btn btn--sm" id="btn-cancel-schedule">Annuler</button>
          </div>
        </form>
      </div>
    </div>

    <!-- MODAL : AJOUT DE RAPPEL -->
    <div id="modal-reminder" class="modal-overlay" style="display: none;">
      <div class="modal-dialog">
        <div class="modal-header">
          <h3>Nouveau rappel personnel</h3>
          <button type="button" class="btn-close" id="btn-close-reminder-modal" aria-label="Fermer">✕</button>
        </div>
        <form id="form-save-reminder" class="modal-body espace-form">
          <div class="form-group">
            <label for="reminder-input-label" class="field-label">Intitulé du rappel :</label>
            <input type="text" id="reminder-input-label" placeholder="Ex: Relire le texte du jour" required />
          </div>
          <div class="form-group">
            <label for="reminder-input-kind" class="field-label">Type d'élément visé :</label>
            <select id="reminder-input-kind" required>
              <option value="texte">Texte philosophique</option>
              <option value="cours">Support de cours</option>
              <option value="libre">Rappel libre</option>
            </select>
          </div>
          <div class="form-group">
            <label for="reminder-input-time" class="field-label">Heure du rappel :</label>
            <input type="time" id="reminder-input-time" value="09:00" required />
          </div>
          <div class="modal-footer card-actions">
            <button type="submit" class="btn btn--primary" id="btn-submit-reminder">Créer le rappel</button>
            <button type="button" class="btn btn--sm" id="btn-cancel-reminder">Annuler</button>
          </div>
        </form>
      </div>
    </div>

  </div>
</Base>

<script>
  import {
    getSupabase,
    getSupabaseCredentials,
    saveSupabaseCredentials,
    loginWithPassword,
    logoutUser,
    getCurrentSession,
    updatePassword,
    updateUserProfile,
    fetchUserCourses,
    createUserCourse,
    createBatchUserCourses,
    deleteUserCourse,
    fetchUserScheduleEvents,
    createUserScheduleEvent,
    deleteUserScheduleEvent,
    fetchUserReminders,
    createUserReminder,
    toggleUserReminder,
    deleteUserReminder,
    type DbCourse,
    type DbScheduleEvent,
    type DbReminder,
  } from '../../utils/supabase';

  // Parser Markdown ultra-léger et sécurisé
  function renderMarkdown(md: string): string {
    if (!md) return '<p class="meta">Aucun contenu.</p>';
    const escaped = md
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;');

    return escaped
      .replace(/^### (.*$)/gim, '<h3>$1</h3>')
      .replace(/^## (.*$)/gim, '<h2>$1</h2>')
      .replace(/^# (.*$)/gim, '<h1>$1</h1>')
      .replace(/^\> (.*$)/gim, '<blockquote>$1</blockquote>')
      .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" target="_blank" rel="noopener noreferrer" style="color: var(--color-accent, #0066cc); text-decoration: underline;">$1</a>')
      .replace(/\*\*(.*?)\*\*/gim, '<strong>$1</strong>')
      .replace(/\*(.*?)\*/gim, '<em>$1</em>')
      .replace(/`([^`]+)`/gim, '<code>$1</code>')
      .replace(/^\- (.*$)/gim, '<li>$1</li>')
      .replace(/\n\n+/g, '</p><p>')
      .replace(/\n/g, '<br />');
  }

  const DAY_NAMES = ['', 'Lundi', 'Mardi', 'Mercredi', 'Jeudi', 'Vendredi', 'Samedi', 'Dimanche'];

  function initEspace() {
    const viewLogin = document.getElementById('view-login');
    const viewDashboard = document.getElementById('view-dashboard');
    const userTopActions = document.getElementById('user-top-actions');
    const userDisplayEmail = document.getElementById('user-display-email');
    const btnLogout = document.getElementById('btn-logout');

    const formLogin = document.getElementById('form-login') as HTMLFormElement;
    const loginEmailInput = document.getElementById('login-email') as HTMLInputElement;
    const loginPwdInput = document.getElementById('login-password') as HTMLInputElement;
    const loginErrorBox = document.getElementById('login-error-box');
    const loginErrorText = document.getElementById('login-error-text');

    const espaceBanner = document.getElementById('espace-banner');
    const espaceBannerText = document.getElementById('espace-banner-text');

    // Configuration Supabase intégrée
    const boxSupabaseInline = document.getElementById('box-supabase-inline');
    const btnToggleSupabase = document.getElementById('btn-toggle-supabase-config');
    const btnCloseInlineSupabase = document.getElementById('btn-close-inline-supabase');
    const formInlineSupabase = document.getElementById('form-inline-supabase') as HTMLFormElement | null;
    const inlineSupabaseUrl = document.getElementById('inline-supabase-url') as HTMLInputElement | null;
    const inlineSupabaseKey = document.getElementById('inline-supabase-key') as HTMLInputElement | null;

    btnToggleSupabase?.addEventListener('click', () => {
      if (!boxSupabaseInline) return;
      const isHidden = boxSupabaseInline.style.display === 'none';
