    // Écoute de session
    async function refreshSessionState() {
      const { url: currentUrl, anonKey: currentKey, isConfigured } = getSupabaseCredentials();
      const isExplicitSetup = window.location.search.includes('setup=1') || window.location.hash.includes('supabase');

      if (!isConfigured) {
        if (loginErrorBox && loginErrorText) {
          loginErrorBox.style.display = 'block';
          loginErrorText.textContent =
            'Supabase n’est pas encore configuré avec vos clés réelles. Renseignez votre Project URL et clé publique ci-dessous pour vous connecter.';
        }
        if (boxSupabaseInline) boxSupabaseInline.style.display = 'block';
      } else {
        if (loginErrorBox && loginErrorText && loginErrorText.textContent?.includes('Supabase n’est pas encore configuré')) {
          loginErrorBox.style.display = 'none';
        }
        if (boxSupabaseInline && !isExplicitSetup) {
          boxSupabaseInline.style.display = 'none';
        }
      }

      if (inlineSupabaseUrl && !inlineSupabaseUrl.value && !currentUrl.includes('xxxx.supabase.co')) {
        inlineSupabaseUrl.value = currentUrl;
      }
      if (inlineSupabaseKey && !inlineSupabaseKey.value && !currentKey.includes('dummy')) {
        inlineSupabaseKey.value = currentKey;
      }

      try {
        const session = await getCurrentSession();
        if (session && session.user) {
          if (viewLogin) viewLogin.style.display = 'none';
          if (viewDashboard) viewDashboard.style.display = 'block';
          if (userTopActions) userTopActions.style.display = 'flex';
          if (userDisplayEmail) {
            const fullName = session.user.user_metadata?.full_name;
            userDisplayEmail.textContent = fullName ? `${fullName} (${session.user.email})` : (session.user.email || 'Connecté');
          }
          const profileInput = document.getElementById('profile-full-name') as HTMLInputElement | null;
          if (profileInput && session.user.user_metadata?.full_name) {
            profileInput.value = session.user.user_metadata.full_name;
          }

          await Promise.all([loadCourses(), loadSchedule(), loadReminders()]);
        } else {
          if (viewLogin) viewLogin.style.display = 'block';
          if (viewDashboard) viewDashboard.style.display = 'none';
          if (userTopActions) userTopActions.style.display = 'none';
        }
      } catch (err: any) {
        console.error('Erreur session:', err);
      }
    }

    // Connexion
    formLogin?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (loginErrorBox) loginErrorBox.style.display = 'none';
      const email = loginEmailInput.value.trim();
      const pwd = loginPwdInput.value;

      try {
        const btn = document.getElementById('btn-submit-login') as HTMLButtonElement;
        if (btn) btn.disabled = true;
        await loginWithPassword(email, pwd);
        notify('Connexion réussie.');
        document.documentElement.classList.add('is-authenticated');
        const redirectParam = new URLSearchParams(window.location.search).get('redirect');
        if (redirectParam && redirectParam.startsWith('/')) {
          window.location.replace(redirectParam);
          return;
        }
        await refreshSessionState();
      } catch (err: any) {
        if (loginErrorBox && loginErrorText) {
          loginErrorBox.style.display = 'block';
          loginErrorText.textContent = err.message || 'Échec de connexion. Vérifiez vos identifiants.';
        }
      } finally {
        const btn = document.getElementById('btn-submit-login') as HTMLButtonElement;
        if (btn) btn.disabled = false;
      }
    });

