      cachedCourses.forEach((c) => {
        const card = document.createElement('div');
        card.className = 'panel course-card';
        const tags = c.tags && c.tags.length ? c.tags.map((t) => `<span class="tag-pill">${t}</span>`).join(' ') : '';
