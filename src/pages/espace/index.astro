    const btnImportPresetEmpty = document.getElementById('btn-import-local-preset-empty');
    btnImportPreset?.addEventListener('click', importLocalPresetCourses);
    btnImportPresetEmpty?.addEventListener('click', importLocalPresetCourses);

    // Importation d'un dossier complet depuis le disque (arborescence automatique)
    async function handleFolderUpload(fileList: FileList | null) {
      if (!fileList || fileList.length === 0) return;

      const files = Array.from(fileList);
      notify(`Lecture du dossier (${files.length} fichiers détectés)...`);

      // Détecter la hiérarchie relative (ex: "Dossier/Matiere/SousDossier/fichier.pdf")
      const subjectsMap: Record<string, { subfolders: Record<string, string[]>; rootFiles: string[] }> = {};

      const paths = files.map((f) => f.webkitRelativePath.split('/').filter(Boolean));
      const topSegments = new Set(paths.map((p) => p[0]));
      // Si un seul dossier racine entoure plusieurs sous-dossiers (ex: "Mes Cours/EDO/CM/...")
      const isWrappedInTopFolder = topSegments.size === 1 && paths.some((p) => p.length >= 3);

      paths.forEach((parts) => {
        let subjectName = '';
        let category = 'Documents';
        const fileName = parts[parts.length - 1];

        if (isWrappedInTopFolder) {
          subjectName = parts[1] || parts[0];
          if (parts.length >= 4) {
            category = parts.slice(2, -1).join(' / ');
          }
        } else {
          subjectName = parts[0];
          if (parts.length >= 3) {
            category = parts.slice(1, -1).join(' / ');
          }
        }

        if (!subjectsMap[subjectName]) {
          subjectsMap[subjectName] = { subfolders: {}, rootFiles: [] };
        }

        if (category === 'Documents') {
          subjectsMap[subjectName].rootFiles.push(fileName);
        } else {
          if (!subjectsMap[subjectName].subfolders[category]) {
            subjectsMap[subjectName].subfolders[category] = [];
          }
          subjectsMap[subjectName].subfolders[category].push(fileName);
        }
      });

      const newCourses: Array<{ title: string; body_md: string; tags: string[] }> = [];

      Object.entries(subjectsMap).forEach(([subjectName, data]) => {
        let md = `## Arborescence et documents de ${subjectName}\n\n`;
        const subCats = Object.entries(data.subfolders);
        if (subCats.length > 0) {
          subCats.forEach(([catName, fileNames]) => {
            md += `### ${catName}\n\n`;
            fileNames.forEach((fn) => {
              md += `- ${fn}\n`;
            });
            md += `\n`;
          });
        }
        if (data.rootFiles.length > 0) {
          md += `### Documents généraux\n\n`;
          data.rootFiles.forEach((fn) => {
            md += `- ${fn}\n`;
          });
          md += `\n`;
        }

        newCourses.push({
          title: subjectName,
          body_md: md,
          tags: ['Dossier importé', subjectName],
        });
      });

      if (newCourses.length === 0) {
        notify('Aucun document valide trouvé dans le dossier.', true);
        return;
      }

      try {
        notify(`Enregistrement de ${newCourses.length} matière(s) sur votre compte...`);
        await createBatchUserCourses(newCourses);
        notify(`${newCourses.length} matière(s) et ${files.length} document(s) importés avec succès !`);
        await loadCourses();
      } catch (err: any) {
        notify('Erreur lors de l’enregistrement : ' + err.message, true);
      }
    }

