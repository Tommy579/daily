    // -------------------------------------------------------------
    // GESTION DE L'EMPLOI DU TEMPS
    // -------------------------------------------------------------
    async function loadSchedule() {
      if (scheduleLoading) scheduleLoading.style.display = 'block';
      if (scheduleEmpty) scheduleEmpty.style.display = 'none';
      try {
        cachedSchedule = await fetchUserScheduleEvents();
        if (badgeSchedule) badgeSchedule.textContent = String(cachedSchedule.length);
        renderSchedule();
      } catch (err: any) {
        notify('Erreur planning: ' + err.message, true);
      } finally {
        if (scheduleLoading) scheduleLoading.style.display = 'none';
      }
    }

    function renderSchedule() {
      if (!scheduleGrid) return;
      scheduleGrid.innerHTML = '';
      if (cachedSchedule.length === 0) {
        if (scheduleEmpty) scheduleEmpty.style.display = 'block';
        return;
      }
      if (scheduleEmpty) scheduleEmpty.style.display = 'none';

      // Regrouper par jour
      const grouped: Record<number, DbScheduleEvent[]> = {};
      for (let day = 1; day <= 7; day++) grouped[day] = [];
      cachedSchedule.forEach((evt) => {
        if (!grouped[evt.day_of_week]) grouped[evt.day_of_week] = [];
        grouped[evt.day_of_week].push(evt);
      });

      for (let day = 1; day <= 7; day++) {
        const events = grouped[day];
        if (events.length === 0) continue;

        const dayCol = document.createElement('div');
        dayCol.className = 'panel schedule-day-col';
        dayCol.innerHTML = `
          <div class="day-head">
            <h4>${DAY_NAMES[day]}</h4>
            <span class="meta">${events.length} cours</span>
          </div>
          <div class="day-events-list"></div>
        `;

        const eventsList = dayCol.querySelector('.day-events-list');
        events.forEach((evt) => {
          const item = document.createElement('div');
          item.className = 'schedule-event-item';
          const start = evt.start_time.slice(0, 5);
          const end = evt.end_time.slice(0, 5);
          const loc = evt.location ? `<span class="event-loc">${evt.location}</span>` : '';
          const notes = evt.notes ? `<p class="event-notes meta">${evt.notes}</p>` : '';

          item.innerHTML = `
            <div class="event-top">
              <span class="event-time">${start} – ${end}</span>
              <button type="button" class="btn-del-event" title="Supprimer ce créneau">✕</button>
            </div>
            <strong class="event-title">${evt.title}</strong>
            ${loc}
            ${notes}
          `;

          item.querySelector('.btn-del-event')?.addEventListener('click', async () => {
            if (confirm(`Supprimer le créneau "${evt.title}" ?`)) {
              try {
                if (evt.id) await deleteUserScheduleEvent(evt.id);
                notify('Créneau supprimé.');
                await loadSchedule();
              } catch (err: any) {
                notify(err.message, true);
              }
            }
          });

          eventsList?.appendChild(item);
        });

        scheduleGrid.appendChild(dayCol);
      }
    }

