    // Importation des 6 matières locales pré-configurées
    async function importLocalPresetCourses() {
      const root = document.querySelector('[data-local-presets]') as HTMLElement | null;
      if (!root) return;
      const raw = root.getAttribute('data-local-presets');
      if (!raw) return;
      let presets: Array<{ title: string; body_md: string; tags: string[] }> = [];
      try {
        presets = JSON.parse(raw);
      } catch (e) {
        return;
      }
      if (presets.length === 0) {
        notify('Aucune matière locale détectée.', true);
        return;
      }

      // Filtrer les cours déjà présents pour éviter les doublons accidentels
      const existingTitles = new Set(cachedCourses.map((c) => c.title.toLowerCase().trim()));
      let toImport = presets.filter((p) => !existingTitles.has(p.title.toLowerCase().trim()));

      if (toImport.length === 0) {
        if (!confirm('Toutes les 6 matières sont déjà enregistrées dans votre compte. Souhaitez-vous quand même les réimporter ?')) {
          return;
        }
        toImport = [...presets];
      }

      try {
        notify('Importation en cours...');
        await createBatchUserCourses(toImport);
        notify(`${toImport.length} matière(s) locale(s) importée(s) avec succès dans votre espace !`);
        await loadCourses();
      } catch (err: any) {
        notify('Erreur lors de l’import : ' + err.message, true);
      }
    }

