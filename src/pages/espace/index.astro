    function renderReminders() {
      if (!remindersList) return;
      remindersList.innerHTML = '';
      if (cachedReminders.length === 0) {
        if (remindersEmpty) remindersEmpty.style.display = 'block';
        return;
      }
      if (remindersEmpty) remindersEmpty.style.display = 'none';

      cachedReminders.forEach((r) => {
        const item = document.createElement('div');
        item.className = 'panel reminder-row';
        const timeFormatted = r.time_of_day.slice(0, 5);

        item.innerHTML = `
          <div class="reminder-left">
            <span class="tag-pill tag-kind">${r.kind}</span>
            <strong class="reminder-label">${r.label || 'Rappel'}</strong>
            <span class="reminder-time-tag">${timeFormatted}</span>
          </div>
          <div class="reminder-actions">
            <label class="toggle-switch" title="Activer / Désactiver">
              <input type="checkbox" class="chk-toggle-reminder" ${r.enabled ? 'checked' : ''} />
              <span class="toggle-slider"></span>
            </label>
            <button type="button" class="btn btn--danger btn--sm btn-del-reminder">Supprimer</button>
          </div>
        `;

        item.querySelector('.chk-toggle-reminder')?.addEventListener('change', async (e) => {
          const target = e.target as HTMLInputElement;
          try {
            if (r.id) await toggleUserReminder(r.id, target.checked);
            notify(`Rappel ${target.checked ? 'activé' : 'désactivé'}.`);
          } catch (err: any) {
            notify(err.message, true);
            target.checked = !target.checked;
          }
        });

        item.querySelector('.btn-del-reminder')?.addEventListener('click', async () => {
          if (confirm(`Supprimer le rappel "${r.label}" ?`)) {
            try {
              if (r.id) await deleteUserReminder(r.id);
              notify('Rappel supprimé.');
              await loadReminders();
            } catch (err: any) {
              notify(err.message, true);
            }
          }
        });

        remindersList.appendChild(item);
      });
    }

    // Modal Rappel
    const modalReminder = document.getElementById('modal-reminder');
    const btnOpenReminderModal = document.getElementById('btn-open-reminder-modal');
    const btnCreateFirstReminder = document.getElementById('btn-create-first-reminder');
    const btnCloseReminderModal = document.getElementById('btn-close-reminder-modal');
    const btnCancelReminder = document.getElementById('btn-cancel-reminder');
    const formSaveReminder = document.getElementById('form-save-reminder') as HTMLFormElement;

    function openReminderModal() {
      if (formSaveReminder) formSaveReminder.reset();
      if (modalReminder) modalReminder.style.display = 'flex';
    }

    btnOpenReminderModal?.addEventListener('click', openReminderModal);
    btnCreateFirstReminder?.addEventListener('click', openReminderModal);
    btnCloseReminderModal?.addEventListener('click', () => {
      if (modalReminder) modalReminder.style.display = 'none';
    });
    btnCancelReminder?.addEventListener('click', () => {
      if (modalReminder) modalReminder.style.display = 'none';
    });

    formSaveReminder?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const label = (document.getElementById('reminder-input-label') as HTMLInputElement).value.trim();
      const kind = (document.getElementById('reminder-input-kind') as HTMLSelectElement).value as any;
      const time_of_day = (document.getElementById('reminder-input-time') as HTMLInputElement).value;

      try {
        await createUserReminder({
          label,
          kind,
          time_of_day,
          enabled: true,
          days_of_week: [1, 2, 3, 4, 5, 6, 7],
        });
        if (modalReminder) modalReminder.style.display = 'none';
        notify('Rappel personnel enregistré.');
        await loadReminders();
      } catch (err: any) {
        notify(err.message, true);
      }
    });

    // -------------------------------------------------------------
    // PROFIL UTILISATEUR (NOM & PRÉNOM)
    // -------------------------------------------------------------
    const formProfile = document.getElementById('form-update-profile') as HTMLFormElement | null;
    formProfile?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const inputProfile = document.getElementById('profile-full-name') as HTMLInputElement | null;
      const name = inputProfile?.value.trim() || '';
      const btn = document.getElementById('btn-submit-profile') as HTMLButtonElement | null;
      if (btn) btn.disabled = true;
      try {
        await updateUserProfile({ full_name: name });
        notify('Votre nom a été enregistré avec succès.');
        await refreshSessionState();
      } catch (err: any) {
        notify('Erreur: ' + (err.message || 'Impossible d’enregistrer le nom.'), true);
      } finally {
        if (btn) btn.disabled = false;
      }
    });

    // -------------------------------------------------------------
    // SÉCURITÉ & CHANGEMENT DE MOT DE PASSE
    // -------------------------------------------------------------
    const formPwd = document.getElementById('form-change-password') as HTMLFormElement;
    formPwd?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const newPwd = (document.getElementById('new-password') as HTMLInputElement).value;
      const confPwd = (document.getElementById('confirm-password') as HTMLInputElement).value;

      if (newPwd !== confPwd) {
        notify('Les deux mots de passe ne correspondent pas.', true);
        return;
      }

      try {
        const btn = document.getElementById('btn-submit-pwd') as HTMLButtonElement;
        if (btn) btn.disabled = true;
        await updatePassword(newPwd);
        notify('Mot de passe mis à jour avec succès.');
        formPwd.reset();
      } catch (err: any) {
        notify('Erreur: ' + err.message, true);
      } finally {
        const btn = document.getElementById('btn-submit-pwd') as HTMLButtonElement;
        if (btn) btn.disabled = false;
      }
    });

    // Export des données JSON
    const btnExport = document.getElementById('btn-export-data');
    btnExport?.addEventListener('click', () => {
      const dump = {
        exportedAt: new Date().toISOString(),
        courses: cachedCourses,
        schedule: cachedSchedule,
        reminders: cachedReminders,
      };
      const blob = new Blob([JSON.stringify(dump, null, 2)], { type: 'application/json' });
      const dlUrl = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = dlUrl;
      a.download = `marges-backup-${new Date().toISOString().slice(0, 10)}.json`;
      a.click();
      URL.revokeObjectURL(dlUrl);
      notify('Export JSON téléchargé avec succès.');
    });

    // Écouter les changements d'état Supabase
    try {
      const sb = getSupabase();
      sb.auth.onAuthStateChange(() => {
        refreshSessionState();
      });
    } catch (e) {
      // Ignorer si pas configuré
    }

    // Initialisation au chargement
    refreshSessionState();
  }

  document.addEventListener('astro:page-load', initEspace);
</script>

