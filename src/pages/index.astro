---
import Base from '../layouts/Base.astro';
import TextCard from '../components/TextCard.astro';
import { getTextes } from '../utils/textes';
import { THEMES, type ThemeSlug } from '../data/themes';

const textes = await getTextes();
const latest = textes.slice(0, 6);

const counts = new Map<ThemeSlug, number>();
textes.forEach((t) => t.data.themes.forEach((th) => counts.set(th, (counts.get(th) ?? 0) + 1)));
const themes = (Object.keys(THEMES) as ThemeSlug[]).filter((t) => counts.has(t));
---

<Base>
  <section class="container hero" aria-labelledby="manifeste">
    <h1 id="manifeste" class="visually-hidden">Marges — manifeste</h1>
    <p class="manifesto">
      <span class="first">Penser lentement ce que les machines font&nbsp;vite.</span>
      Des essais, des questions ouvertes, des dialogues et des fragments sur la place de l’intelligence artificielle dans
      nos vies — le travail, les relations, la création, la conscience, le pouvoir.
    </p>
    <p class="manifesto-end">Rien à vendre, rien à suivre&#8239;: seulement des textes à&nbsp;lire.</p>
  </section>

  <section class="container latest" aria-labelledby="derniers">
    <div class="section-head">
      <h2 id="derniers" class="label">Derniers textes</h2>
      <a class="more" href="/textes/">Tous les textes <span aria-hidden="true">→</span></a>
    </div>
    <ol class="list" role="list">
      {
        latest.map((entry) => (
          <li>
            <TextCard entry={entry} headingLevel={3} />
          </li>
        ))
      }
    </ol>
  </section>

  {
    themes.length > 0 && (
      <section class="container home-themes" aria-labelledby="themes">
        <h2 id="themes" class="label">Thèmes</h2>
        <ul class="theme-cloud" role="list">
          {themes.map((t) => (
            <li>
              <a href={`/themes/${t}/`}>
                {THEMES[t].label}
                <sup class="count">{counts.get(t)}</sup>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Base>

<style>
  .hero {
    padding-block: clamp(3rem, 2rem + 7vw, 7.5rem) clamp(2.5rem, 2rem + 3vw, 4.5rem);
  }
  .manifesto {
    font-size: clamp(1.45rem, 1.1rem + 1.6vw, 2.15rem);
    line-height: 1.38;
    letter-spacing: -.012em;
    margin: 0 0 1.4rem;
    color: var(--muted);
    text-wrap: pretty;
    hyphens: manual;
  }
  .manifesto .first {
    display: block;
    color: var(--fg);
    font-weight: 600;
    letter-spacing: -.025em;
    margin-bottom: .5rem;
    text-wrap: balance;
  }
  .manifesto-end {
    margin: 0;
    font-style: italic;
    color: var(--fg);
    font-size: clamp(1.1rem, 1rem + .4vw, 1.3rem);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero > * {
      animation: rise .9s var(--ease) both;
    }
    .hero > :nth-child(3) { animation-delay: .12s; }
    .latest { animation: rise .9s .2s var(--ease) both; }
  }
  @keyframes rise {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: none; }
  }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: .9rem;
    border-bottom: 1px solid var(--fg);
  }
  .section-head h2 { color: var(--fg); }

  .list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .list > li + li { border-top: 1px solid var(--line); }

  .home-themes { margin-top: 4.5rem; }
  .home-themes h2 {
    color: var(--fg);
    padding-bottom: .9rem;
    border-bottom: 1px solid var(--fg);
    margin-bottom: 1.4rem;
  }
  .theme-cloud {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: .5rem 1.6rem;
  }
  .theme-cloud a {
    font-size: 1.15rem;
    font-style: italic;
    text-decoration-color: transparent;
  }
  .theme-cloud a:hover { text-decoration-color: currentColor; }
  .count {
    font-family: var(--font-ui);
    font-style: normal;
    font-size: .62rem;
    color: var(--muted);
    margin-left: .15rem;
    font-feature-settings: 'tnum' 1;
  }
</style>
