---
import Base from '../layouts/Base.astro';
import TextCard from '../components/TextCard.astro';
import Icon from '../components/Icon.astro';
import { getTextes } from '../utils/textes';
import { THEMES, type ThemeSlug } from '../data/themes';
import { getCourses } from '../utils/courses';
import { url } from '../utils/url';

const textes = await getTextes();
const latest = textes.slice(0, 3);
const subjects = getCourses();

const counts = new Map<ThemeSlug, number>();
textes.forEach((t) => t.data.themes.forEach((th) => counts.set(th, (counts.get(th) ?? 0) + 1)));
const themes = (Object.keys(THEMES) as ThemeSlug[]).filter((t) => counts.has(t));

const shortcuts = [
  { href: url('/emploi-du-temps/'), icon: 'calendar', title: 'Emploi du temps', desc: 'Semaine en cours' },
  { href: url('/cours/'), icon: 'folder', title: 'Cours', desc: `${subjects.length} matières` },
  { href: url('/rappels/'), icon: 'bell', title: 'Rappels', desc: 'Lecture & révision' },
  { href: url('/textes/'), icon: 'book', title: 'Textes', desc: `${textes.length} publications` },
] as const;
---

<Base>
  <div class="container container--wide app-page home">
    <!-- En-tête : salutation contextuelle -->
    <header class="home-hero">
      <p class="crumbs" data-today-date>&nbsp;</p>
      <h1 class="home-greeting"><span data-greeting>Bonjour</span>.</h1>
    </header>

    <div class="home-grid">
      <!-- Colonne principale -->
      <div class="home-main">
        <!-- Widget Aujourd'hui -->
        <section class="panel today" aria-labelledby="today-title" data-today>
          <div class="today-head">
            <div>
              <h2 id="today-title" class="today-title">Aujourd'hui</h2>
              <p class="today-sub" data-today-summary>Chargement de votre journée…</p>
            </div>
            <a href={url('/emploi-du-temps/')} class="btn btn--sm">
              Semaine <Icon name="arrow-right" size={14} />
            </a>
          </div>
          <ol class="timeline" role="list" data-today-list></ol>
          <noscript><p class="hint">Activez JavaScript pour afficher vos cours du jour.</p></noscript>
        </section>

        <!-- Raccourcis -->
        <nav class="shortcuts" aria-label="Accès rapides">
          {shortcuts.map((s) => (
            <a href={s.href} class="panel panel--link shortcut">
              <span class="icon-tile"><Icon name={s.icon} size={18} /></span>
              <span class="shortcut-text">
                <strong>{s.title}</strong>
                <small>{s.desc}</small>
              </span>
            </a>
          ))}
        </nav>

        <!-- Lectures récentes -->
        <section class="section" aria-labelledby="derniers">
          <div class="section-head">
            <h2 id="derniers">Lectures récentes</h2>
            <a class="more" href={url('/textes/')}>Tous les textes <span aria-hidden="true">→</span></a>
          </div>
          <ol class="text-list" role="list">
            {latest.map((entry) => (
              <li><TextCard entry={entry} headingLevel={3} /></li>
            ))}
          </ol>
        </section>
      </div>

      <!-- Colonne latérale -->
      <aside class="home-aside">
        {subjects.length > 0 && (
          <section aria-labelledby="matieres-title">
            <div class="section-head">
              <h2 id="matieres-title">Matières</h2>
              <a href={url('/cours/')} class="more">Tout voir <span aria-hidden="true">→</span></a>
            </div>
            <ul class="subject-list" role="list" id="home-subject-list">
              {subjects.map((sub) => (
                <li>
                  <a href={url(`/cours/#folder-${sub.id}`)} class="subject-row">
                    <span class="subject-initial" aria-hidden="true">{sub.name.charAt(0).toUpperCase()}</span>
                    <span class="subject-text">
                      <strong>{sub.name}</strong>
                      <small>{sub.stats.totalFiles} fichiers · {sub.stats.pdfCount} PDF</small>
                    </span>
                    <Icon name="arrow-right" size={14} class="subject-arrow" />
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}

        {themes.length > 0 && (
          <section class="aside-section" aria-labelledby="themes">
            <div class="section-head">
              <h2 id="themes">Thèmes</h2>
            </div>
            <ul class="theme-chips" role="list">
              {themes.map((t) => (
                <li>
                  <a href={url(`/themes/${t}/`)}>
                    {THEMES[t].label}
                    <span class="count">{counts.get(t)}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}
      </aside>
    </div>
  </div>
</Base>

<script>
  import { STORAGE_KEYS, loadPersistent } from '../utils/persistence';
  import { getCurrentSession, fetchUserScheduleEvents } from '../utils/supabase';
  import { syncTimetableState, parseIcsEvents } from '../utils/timetable';

  interface HomeEvent {
    title: string;
    start: Date;
    end: Date;
    location?: string;
  }

  const fmtTime = (d: Date) => d.toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' });

  function mondayOf(d: Date): Date {
    const m = new Date(d);
    const day = m.getDay();
    m.setDate(m.getDate() - day + (day === 0 ? -6 : 1));
    m.setHours(0, 0, 0, 0);
    return m;
  }

  /** « CM - ECUE Analyse numérique 1 G01 » → { kind: 'CM', label: 'Analyse numérique 1 G01' } */
  function splitTitle(title: string): { kind: string | null; label: string } {
    const m = title.match(/^(CM|TD|TP)\s*-\s*(.*)$/i);
    const raw = m ? m[2] : title;
    return { kind: m ? m[1].toUpperCase() : null, label: raw.replace(/^ECUE\s+/i, '') };
  }

  function el<K extends keyof HTMLElementTagNameMap>(tag: K, cls?: string, text?: string) {
    const node = document.createElement(tag);
    if (cls) node.className = cls;
    if (text) node.textContent = text;
    return node;
  }

  function renderItem(ev: HomeEvent, now: Date, showDay = false): HTMLLIElement {
    const li = el('li', 'tl-item');
    const state = now > ev.end ? 'past' : now >= ev.start ? 'live' : 'next';
    li.dataset.state = state;

    const time = el('div', 'tl-time');
    time.append(el('strong', '', fmtTime(ev.start)), el('span', '', fmtTime(ev.end)));

    const body = el('div', 'tl-body');
    const { kind, label } = splitTitle(ev.title);
    const top = el('div', 'tl-top');
    if (kind) top.append(el('span', `tl-kind tl-kind--${kind.toLowerCase()}`, kind));
    if (state === 'live') top.append(el('span', 'badge badge--success', 'En cours'));
    if (showDay) {
      const day = ev.start.toLocaleDateString('fr-FR', { weekday: 'long' });
      top.append(el('span', 'badge', day.charAt(0).toUpperCase() + day.slice(1)));
    }
    body.append(top, el('p', 'tl-title', label));
    if (ev.location) body.append(el('p', 'tl-loc', ev.location));

    li.append(time, body);
    return li;
  }

  async function initHome() {
    const root = document.querySelector<HTMLElement>('[data-today]');
    if (!root) return;
    const now = new Date();

    // Salutation & date
    const h = now.getHours();
    const greeting = document.querySelector('[data-greeting]');
    const salute = h < 5 ? 'Bonne nuit' : h < 18 ? 'Bonjour' : 'Bonsoir';
    if (greeting) {
      greeting.textContent = salute;
      try {
        getCurrentSession().then((session) => {
          const name = session?.user?.user_metadata?.full_name;
          if (name && greeting) {
            greeting.textContent = `${salute}, ${name}`;
          }
        });
      } catch {}
    }
    const dateEl = document.querySelector('[data-today-date]');
    if (dateEl) {
      const s = now.toLocaleDateString('fr-FR', { weekday: 'long', day: 'numeric', month: 'long' });
      dateEl.textContent = s.charAt(0).toUpperCase() + s.slice(1);
    }

    // 0. Auto-synchronisation Supabase Cloud (PC <-> Mobile)
    await syncTimetableState().catch(() => {});

    // Définition de la fenêtre du jour strict et des 14 prochains jours
    const startOfToday = new Date(now.getFullYear(), now.getMonth(), now.getDate(), 0, 0, 0);
    const maxUpcoming = new Date(startOfToday.getTime() + 14 * 24 * 60 * 60 * 1000);

    const allEvents: HomeEvent[] = [];
    const seen = new Set<string>();

    function addEvent(ev: HomeEvent) {
      const key = `${ev.title}|${ev.start.getTime()}`;
      if (!seen.has(key)) {
        seen.add(key);
        allEvents.push(ev);
      }
    }

    // 1. Calendrier ICS de l'étudiant (analyse précise avec dates et récurrences)
    const savedIcs = loadPersistent(STORAGE_KEYS.TIMETABLE_ICS);
    if (savedIcs && savedIcs.trim().length > 30) {
      const parsed = parseIcsEvents(savedIcs, startOfToday, maxUpcoming);
      parsed.forEach((ev) => {
        addEvent({
          title: ev.title,
          start: ev.start,
          end: ev.end,
          location: ev.location,
        });
      });
    }

    // 2. Créneaux hebdomadaires créés manuellement par l'étudiant (fallback)
    try {
      const dbEvents = await fetchUserScheduleEvents();
      if (dbEvents && dbEvents.length > 0) {
        const monday = mondayOf(now);
        dbEvents.forEach((dbEv) => {
          const dayOffset = (dbEv.day_of_week || 1) - 1;
          const [sH, sM] = (dbEv.start_time || '08:30').split(':').map(Number);
          const [eH, eM] = (dbEv.end_time || '10:30').split(':').map(Number);

          for (let w = 0; w < 2; w++) {
            const d = new Date(monday.getFullYear(), monday.getMonth(), monday.getDate() + dayOffset + w * 7);
            const start = new Date(d);
            start.setHours(sH, sM, 0, 0);
            const end = new Date(d);
            end.setHours(eH, eM, 0, 0);
            if (end >= startOfToday && start <= maxUpcoming) {
              addEvent({ title: dbEv.title, start, end, location: dbEv.location });
            }
          }
        });
      }
    } catch {}

    allEvents.sort((a, b) => a.start.getTime() - b.start.getTime());

    // FILTRAGE STRICT : Uniquement les cours qui ont lieu AUJOURD'HUI
    const today = allEvents.filter((e) => e.start.toDateString() === now.toDateString());
    const list = root.querySelector<HTMLOListElement>('[data-today-list]');
    const summary = root.querySelector('[data-today-summary]');
    if (!list || !summary) return;
    list.replaceChildren();

    if (today.length > 0) {
      const remaining = today.filter((e) => e.end > now);
      const live = today.find((e) => now >= e.start && now <= e.end);
      if (live) summary.textContent = `En cours jusqu'à ${fmtTime(live.end)} · ${remaining.length} cours restant${remaining.length > 1 ? 's' : ''}`;
      else if (remaining.length) summary.textContent = `Prochain cours à ${fmtTime(remaining[0].start)} · ${remaining.length} restant${remaining.length > 1 ? 's' : ''}`;
      else summary.textContent = `Journée de cours terminée (${today.length} créneau${today.length > 1 ? 'x' : ''} aujourd’hui).`;
      today.forEach((ev) => list.append(renderItem(ev, now)));
    } else {
      summary.textContent = 'Aucun cours aujourd’hui.';
      list.innerHTML = '<li class="meta" style="padding: 0.75rem 0;">Aucun cours planifié pour cette journée.</li>';
      const nextUpcoming = allEvents.find((e) => e.start > now);
      if (nextUpcoming) {
        const nextCaption = el('li', 'tl-caption', 'Prochain cours à venir');
        const nextItem = renderItem(nextUpcoming, now, true);
        list.append(nextCaption, nextItem);
      }
    }

    // Matières personnalisées ajoutées par l'utilisateur
    try {
      const basePath = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');
      const rawCustom = localStorage.getItem('marges_custom_subjects');
      const customSubs: Array<{ id: string; name: string }> = rawCustom ? JSON.parse(rawCustom) : [];
      const subList = document.getElementById('home-subject-list');
      if (subList && customSubs.length > 0) {
        customSubs.forEach((sub) => {
          const targetHref = `${basePath}/cours/#folder-${sub.id}`;
          if (!subList.querySelector(`a[href="${targetHref}"]`)) {
            const li = document.createElement('li');
            li.innerHTML = `
              <a href="${targetHref}" class="subject-row">
                <span class="subject-initial" aria-hidden="true">${sub.name.charAt(0).toUpperCase()}</span>
                <span class="subject-text">
                  <strong>${sub.name}</strong>
                  <small>Matière personnalisée</small>
                </span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="subject-arrow"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </a>
            `;
            subList.appendChild(li);
          }
        });
      }
    } catch {}
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHome);
  } else {
    initHome();
  }
  document.addEventListener('astro:page-load', initHome);
</script>

<style>
  .home-hero { padding-block: clamp(2rem, 1.5rem + 3vw, 3.75rem) clamp(1.5rem, 1rem + 2vw, 2.5rem); }
  .home-greeting {
    font-family: var(--font-text);
    font-size: clamp(2.2rem, 1.7rem + 2.4vw, 3.4rem);
    letter-spacing: -.035em;
    margin: .35rem 0 .35rem;
  }
  .home-motto {
    font-family: var(--font-text);
    font-style: italic;
    font-size: 1.15rem;
    color: var(--muted);
    margin: 0;
  }

  .home-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 20rem;
    gap: 2.5rem;
    align-items: start;
  }
  .home-aside { position: sticky; top: 5rem; display: grid; gap: 2.25rem; }

  /* Widget Aujourd'hui */
  .today-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 1rem;
  }
  .today-title { font-size: 1.15rem; margin: 0; }
  .today-sub { margin: .15rem 0 0; color: var(--muted); font-size: .88rem; }

  .timeline { list-style: none; margin: 0; padding: 0; display: grid; gap: .5rem; }
  .timeline :global(.tl-caption) {
    font-size: .72rem;
    font-weight: 600;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--muted);
    margin-top: .25rem;
  }
  .timeline :global(.tl-item) {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr);
    gap: 1rem;
    padding: .75rem .9rem;
    border-radius: var(--radius);
    background: var(--soft);
    border-left: 3px solid var(--line-strong);
    transition: opacity .2s ease;
  }
  .timeline :global(.tl-item[data-state='past']) { opacity: .5; }
  .timeline :global(.tl-item[data-state='live']) {
    border-left-color: var(--success);
    background: color-mix(in srgb, var(--success) 8%, var(--soft));
  }
  .timeline :global(.tl-time) {
    display: grid;
    align-content: start;
    font-variant-numeric: tabular-nums;
    font-size: .82rem;
    color: var(--muted);
  }
  .timeline :global(.tl-time strong) { color: var(--fg); font-size: .92rem; font-weight: 600; }
  .timeline :global(.tl-top) { display: flex; gap: .4rem; align-items: center; flex-wrap: wrap; margin-bottom: .2rem; }
  .timeline :global(.tl-kind) {
    font-size: .68rem;
    font-weight: 700;
    letter-spacing: .06em;
    padding: .1rem .4rem;
    border-radius: 4px;
    background: var(--surface);
    border: 1px solid var(--line);
  }
  .timeline :global(.tl-kind--td) { color: var(--tone-philo); }
  .timeline :global(.tl-kind--cm) { color: var(--accent); }
  .timeline :global(.tl-title) { margin: 0; font-weight: 600; font-size: .95rem; line-height: 1.35; }
  .timeline :global(.tl-loc) { margin: .15rem 0 0; font-size: .82rem; color: var(--muted); }

  /* Raccourcis */
  .shortcuts {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: .75rem;
    margin-top: 1rem;
  }
  .shortcut { display: flex; align-items: center; gap: .75rem; padding: .85rem 1rem; }
  .shortcut-text { display: grid; min-width: 0; }
  .shortcut-text strong { font-size: .9rem; font-weight: 600; }
  .shortcut-text small { font-size: .78rem; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

  /* Lectures */
  .text-list { list-style: none; margin: 0; padding: 0; }
  .text-list > li { border-top: 1px solid var(--line); }
  .text-list > li:last-child { border-bottom: 1px solid var(--line); }

  /* Matières */
  .subject-list { list-style: none; margin: 0; padding: 0; display: grid; gap: .35rem; }
  .subject-row {
    display: flex;
    align-items: center;
    gap: .75rem;
    padding: .6rem .7rem;
    margin-inline: -.7rem;
    border-radius: var(--radius);
    text-decoration: none;
    transition: background-color .15s ease;
  }
  .subject-row:hover { background: var(--soft); text-decoration: none; }
  .subject-initial {
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    flex: none;
    border-radius: var(--r-sm);
    background: var(--fg);
    color: var(--bg);
    font-weight: 700;
    font-size: .85rem;
  }
  .subject-text { display: grid; flex: 1; min-width: 0; }
  .subject-text strong { font-size: .92rem; font-weight: 600; }
  .subject-text small { font-size: .78rem; color: var(--muted); }
  .subject-row :global(.subject-arrow) { color: var(--muted); opacity: 0; transform: translateX(-4px); transition: all .2s var(--ease); }
  .subject-row:hover :global(.subject-arrow) { opacity: 1; transform: none; }

  /* Thèmes */
  .theme-chips { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: .4rem; }
  .theme-chips a {
    display: inline-flex;
    align-items: center;
    gap: .4rem;
    padding: .3rem .7rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: .84rem;
    text-decoration: none;
    transition: border-color .15s ease, background-color .15s ease;
  }
  .theme-chips a:hover { border-color: var(--fg); text-decoration: none; }
  .count { font-size: .72rem; color: var(--muted); font-variant-numeric: tabular-nums; }

  @media (max-width: 62rem) {
    .home-grid { grid-template-columns: 1fr; }
    .home-aside { position: static; grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr)); }
  }
  @media (max-width: 52rem) {
    .shortcuts { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 36rem) {
    .shortcuts { grid-template-columns: 1fr; }
    .shortcut-text small { white-space: normal; }
    .today-head { flex-direction: column; align-items: flex-start; gap: 0.35rem; }
    .timeline :global(.tl-item) {
      grid-template-columns: 3.25rem minmax(0, 1fr);
      gap: 0.65rem;
      padding: 0.65rem 0.75rem;
    }
  }
</style>
