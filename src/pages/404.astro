---
import Base from '../layouts/Base.astro';
import { url } from '../utils/url';
---

<Base title="Page introuvable" description="Cette page n'existe pas." noindex>
  <div class="container notfound">
    <p class="label">Erreur 404</p>
    <h1>Cette page n’existe pas.</h1>
    <p class="lede">Ou pas encore. Ou plus. C’est parfois difficile à dire.</p>
    <blockquote>
      <p>« Il faut imaginer Sisyphe heureux. »</p>
      <p>— Albert Camus</p>
    </blockquote>
    <p class="links">
      <a class="more" href={url('/')}><span aria-hidden="true">←</span> Retour à l’accueil</a>
      <a class="more" href={url('/textes/')}><span aria-hidden="true">→</span> Parcourir les textes</a>
    </p>
  </div>
</Base>

<style>
  .notfound { padding-block: clamp(3rem, 2rem + 6vw, 7rem) 2rem; }
  .notfound .label { margin-bottom: 1rem; }
  blockquote { margin: 3rem 0; }
  blockquote p:last-child { font-style: normal; font-family: var(--font-ui); font-size: .8rem; }
  .links { display: flex; flex-wrap: wrap; gap: 1rem 2rem; }
  @media (max-width: 30rem) {
    .links { flex-direction: column; gap: 0.75rem; }
  }
  .more:first-child:hover span { transform: translateX(-3px); }
</style>
