---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { getTextes } from '../../utils/textes';
import { getCourses } from '../../utils/courses';
import { url } from '../../utils/url';

const textes = await getTextes();
const subjects = getCourses();

const serializedTextes = textes.map((t) => ({
  id: t.id,
  title: t.data.title,
  author: t.data.epigraphAuthor || '',
  url: url(`/textes/${t.id}/`),
}));

const serializedCourses = subjects.map((s) => ({
  id: s.id,
  title: s.name,
  url: `/cours/#folder-${s.id}`,
}));
---

<Base
  title="Rappels & Notifications"
  description="Suivi de vos alertes programmées pour lire un texte philosophique ou réviser un cours."
>
  <div
    class="container container--wide app-page reminders-page"
    data-reminders-root
    data-textes={JSON.stringify(serializedTextes)}
    data-courses={JSON.stringify(serializedCourses)}
  >
    <header class="page-header reminders-hero">
      <div class="reminders-hero-top">
        <div>
          <p class="crumbs"><a href={url('/')}>Accueil</a> / Notifications</p>
          <h1 class="reminders-title">Rappels automatiques</h1>
          <p class="reminders-motto">
            Votre assistant personnel pour rythmer vos lectures philosophiques et révisions académiques.
          </p>
        </div>
        <div class="header-action">
          <a href={url('/configuration/')} class="btn btn--sm">
            <Icon name="settings" size={14} />
            Modifier les réglages
          </a>
        </div>
      </div>
    </header>

    <!-- Statut des notifications Web -->
    <div class="panel permission-banner" data-permission-banner>
      <div class="banner-content">
        <strong id="perm-title">Statut du système d'alerte :</strong>
        <span id="perm-status" class="meta">Vérification...</span>
      </div>
      <button type="button" class="btn btn--primary btn--sm" id="btn-request-perm">
        Activer les notifications
      </button>
    </div>

    <div class="reminders-grid">
      <!-- Colonne principale -->
      <div class="reminders-main">
        <!-- Carte du planning récurrent actif -->
        <section class="panel schedule-summary-card">
          <div class="schedule-header">
            <div class="status-indicator">
              <span class="dot-status" id="schedule-dot"></span>
              <h2 class="label" id="schedule-state-title">Programme de rappels actif</h2>
            </div>
            <div style="display: flex; gap: 0.75rem; align-items: center;">
              <button type="button" class="btn btn--sm" id="btn-toggle-adjust-reminders">Modifier mes réglages</button>
              <a href={url('/configuration/')} class="more">Paramètres avancés <span aria-hidden="true">→</span></a>
            </div>
          </div>

          <div class="schedule-details">
            <div class="detail-block">
              <span class="meta detail-label">Fréquence configurée</span>
              <strong class="detail-value" id="schedule-freq-text">Quotidienne</strong>
            </div>
            <div class="detail-block">
              <span class="meta detail-label">Heures d'envoi</span>
              <strong class="detail-value" id="schedule-times-text">09:00</strong>
            </div>
            <div class="detail-block">
              <span class="meta detail-label">Sélection du support</span>
              <strong class="detail-value" id="schedule-pref-text">Aléatoire (texte philo ou cours)</strong>
            </div>
          </div>

          <!-- Formulaire de réglage directement accessible -->
          <div id="panel-adjust-reminders" style="display: none; margin-top: 1.25rem; padding-top: 1.25rem; border-top: 1px solid var(--line);">
            <form id="form-rappels-config" class="config-form" style="display: grid; gap: 1rem;">
              <div class="form-group">
                <label class="form-checkbox main-toggle" style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
                  <input type="checkbox" id="rappels-enabled" checked />
                  <strong>Activer la programmation automatique des alertes</strong>
                </label>
              </div>

              <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem;">
                <div class="form-group" style="display: grid; gap: 0.35rem;">
                  <label for="rappels-frequency" class="field-label" style="font-size: 0.85rem; font-weight: 600;">Fréquence :</label>
                  <select id="rappels-frequency" style="padding: 0.5rem 0.75rem; border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); color: var(--fg);">
                    <option value="daily">Quotidienne (chaque jour)</option>
                    <option value="twice_daily">Deux fois par jour (Matin & Soir)</option>
                    <option value="weekly">Hebdomadaire (un jour précis)</option>
                  </select>
                </div>

                <div class="form-group" style="display: grid; gap: 0.35rem;">
                  <label for="rappels-content" class="field-label" style="font-size: 0.85rem; font-weight: 600;">Type de contenu :</label>
                  <select id="rappels-content" style="padding: 0.5rem 0.75rem; border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); color: var(--fg);">
                    <option value="all">Aléatoire (Textes & Cours)</option>
                    <option value="philo">Textes de philosophie uniquement</option>
                    <option value="cours">Supports de cours uniquement</option>
                  </select>
                </div>
              </div>

              <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1rem;">
                <div class="form-group" id="grp-rappels-time-1" style="display: grid; gap: 0.35rem;">
                  <label for="rappels-time-1" class="field-label" id="lbl-rappels-time-1" style="font-size: 0.85rem; font-weight: 600;">Heure quotidienne :</label>
                  <input type="time" id="rappels-time-1" value="09:00" style="padding: 0.5rem 0.75rem; border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); color: var(--fg);" />
                </div>

                <div class="form-group" id="grp-rappels-time-2" style="display: none; grid-gap: 0.35rem;">
                  <label for="rappels-time-2" class="field-label" style="font-size: 0.85rem; font-weight: 600;">Deuxième heure (soir) :</label>
                  <input type="time" id="rappels-time-2" value="18:30" style="padding: 0.5rem 0.75rem; border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); color: var(--fg);" />
                </div>

                <div class="form-group" id="grp-rappels-weekday" style="display: none; grid-gap: 0.35rem;">
                  <label for="rappels-weekday" class="field-label" style="font-size: 0.85rem; font-weight: 600;">Jour de la semaine :</label>
                  <select id="rappels-weekday" style="padding: 0.5rem 0.75rem; border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); color: var(--fg);">
                    <option value="1">Lundi</option>
                    <option value="2">Mardi</option>
                    <option value="3">Mercredi</option>
                    <option value="4">Jeudi</option>
                    <option value="5">Vendredi</option>
                    <option value="6">Samedi</option>
                    <option value="7">Dimanche</option>
                  </select>
                </div>
              </div>

              <div class="card-actions" style="display: flex; gap: 0.75rem; margin-top: 0.5rem;">
                <button type="submit" class="btn btn--primary btn--sm" id="btn-save-rappels-config">Enregistrer et synchroniser</button>
                <button type="button" class="btn btn--sm" id="btn-cancel-rappels-config">Fermer</button>
              </div>
            </form>
          </div>

          <div class="schedule-footer" style="margin-top: 1rem;">
            <button type="button" class="btn btn--primary btn--sm" id="btn-trigger-now">
              Déclencher un rappel maintenant (test)
            </button>
          </div>
        </section>

        <!-- Section des rappels personnels synchronisés (Supabase) -->
        <section class="panel db-reminders-section" id="section-db-reminders" style="margin-top: 1.5rem;">
          <div class="list-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
            <div>
              <h2 class="label" style="margin: 0;">Mes rappels enregistrés dans la base</h2>
              <p class="meta" style="margin: 0.25rem 0 0; font-size: 0.85rem;">Synchronisés en direct avec votre compte Supabase</p>
            </div>
            <span class="meta" id="db-reminders-count">0 rappel</span>
          </div>

          <div id="db-reminders-list" class="reminders-list" style="display: grid; gap: 0.75rem;">
            <!-- Rempli en JS -->
          </div>
        </section>

        <!-- Historique des notifications envoyées -->
        <section class="panel history-section">
          <div class="list-header">
            <h2 class="label">Historique des notifications récentes</h2>
            <span class="meta" id="history-count">0 notification</span>
          </div>

          <ul class="history-list" id="history-list" role="list">
            <!-- Rempli en JS -->
          </ul>
        </section>
      </div>

      <!-- Colonne latérale : Suggestion actuelle -->
      <aside class="reminders-aside">
        <section class="panel suggestion-card" id="suggestion-card">
          <div class="section-head">
            <h2 class="label">Prochaine suggestion</h2>
          </div>
          <div class="suggestion-type meta" id="sug-type">Philosophie</div>
          <h3 class="suggestion-title" id="sug-title">Chargement...</h3>
          <p class="suggestion-desc meta" id="sug-desc">
            Ce contenu sera automatiquement proposé lors de votre prochaine notification.
          </p>
          <div class="suggestion-actions">
            <a href="#" class="btn btn--primary btn--sm" id="sug-link">
              Consulter <Icon name="arrow-right" size={13} />
            </a>
            <button type="button" class="btn btn--sm" id="btn-refresh-suggestion">
              Tirer au sort
            </button>
          </div>
        </section>
      </aside>
    </div>
  </div>
</Base>

<script>
  import {
    STORAGE_KEYS,
    savePersistentJSON,
    loadPersistentJSON,
    type ReminderScheduleConfig,
    type NotificationLogItem,
  } from '../../utils/persistence';
  import {
    getUnifiedReminderConfig,
    saveUnifiedReminderConfig,
    formatFrequencyLabel,
    formatTimesLabel,
    formatContentLabel,
  } from '../../utils/reminders';
  import {
    fetchUserReminders,
    toggleUserReminder,
    deleteUserReminder,
    type DbReminder,
  } from '../../utils/supabase';

  interface SuggestionItem {
    type: 'philo' | 'cours';
    typeLabel: string;
    title: string;
    desc: string;
    url: string;
  }

  async function initRemindersPage() {
    const root = document.querySelector('[data-reminders-root]');
    if (!root) return;

    const rawTextes = root.getAttribute('data-textes');
    const rawCourses = root.getAttribute('data-courses');
    const textes: Array<{ id: string; title: string; author: string; url: string }> = rawTextes ? JSON.parse(rawTextes) : [];
    const courses: Array<{ id: string; title: string; url: string }> = rawCourses ? JSON.parse(rawCourses) : [];

    const scheduleDot = document.getElementById('schedule-dot');
    const scheduleStateTitle = document.getElementById('schedule-state-title');
    const scheduleFreqText = document.getElementById('schedule-freq-text');
    const scheduleTimesText = document.getElementById('schedule-times-text');
    const schedulePrefText = document.getElementById('schedule-pref-text');

    const sugType = document.getElementById('sug-type');
    const sugTitle = document.getElementById('sug-title');
    const sugDesc = document.getElementById('sug-desc');
    const sugLink = document.getElementById('sug-link') as HTMLAnchorElement;
    const btnRefresh = document.getElementById('btn-refresh-suggestion');

    const historyList = document.getElementById('history-list');
    const historyCount = document.getElementById('history-count');
    const btnTriggerNow = document.getElementById('btn-trigger-now');

    const statusEl = document.getElementById('perm-status');
    const btnReq = document.getElementById('btn-request-perm');

    // Éléments du formulaire d'ajustement rapide
    const btnToggleAdjust = document.getElementById('btn-toggle-adjust-reminders');
    const panelAdjust = document.getElementById('panel-adjust-reminders');
    const formConfig = document.getElementById('form-rappels-config') as HTMLFormElement | null;
    const chkEnabled = document.getElementById('rappels-enabled') as HTMLInputElement | null;
    const selFreq = document.getElementById('rappels-frequency') as HTMLSelectElement | null;
    const selContent = document.getElementById('rappels-content') as HTMLSelectElement | null;
    const time1Input = document.getElementById('rappels-time-1') as HTMLInputElement | null;
    const time2Input = document.getElementById('rappels-time-2') as HTMLInputElement | null;
    const weekdayInput = document.getElementById('rappels-weekday') as HTMLSelectElement | null;
    const grpTime2 = document.getElementById('grp-rappels-time-2');
    const grpWeekday = document.getElementById('grp-rappels-weekday');
    const lblTime1 = document.getElementById('lbl-rappels-time-1');
    const btnCancelConfig = document.getElementById('btn-cancel-rappels-config');

    // 1. Charger la configuration synchronisée (Supabase + localStorage)
    let config: ReminderScheduleConfig = await getUnifiedReminderConfig();

    function updateSummaryDisplay(cfg: ReminderScheduleConfig) {
      if (scheduleDot && scheduleStateTitle) {
        if (cfg.enabled) {
          scheduleDot.className = 'dot-status dot-active';
          scheduleStateTitle.textContent = 'Programme de rappels actif';
        } else {
          scheduleDot.className = 'dot-status dot-inactive';
          scheduleStateTitle.textContent = 'Rappels désactivés';
        }
      }

      if (scheduleFreqText) scheduleFreqText.textContent = formatFrequencyLabel(cfg);
      if (scheduleTimesText) scheduleTimesText.textContent = formatTimesLabel(cfg);
      if (schedulePrefText) schedulePrefText.textContent = formatContentLabel(cfg);
    }

    function populateFormInputs(cfg: ReminderScheduleConfig) {
      if (chkEnabled) chkEnabled.checked = cfg.enabled;
      if (selFreq) selFreq.value = cfg.frequency;
      if (selContent && cfg.contentType) selContent.value = cfg.contentType;
      if (time1Input && cfg.times && cfg.times[0]) time1Input.value = cfg.times[0];
      if (time2Input && cfg.times && cfg.times[1]) time2Input.value = cfg.times[1];
      if (weekdayInput && cfg.weekday) weekdayInput.value = String(cfg.weekday);
      updateFreqInputsUI();
    }

    function updateFreqInputsUI() {
      if (!selFreq) return;
      const val = selFreq.value;
      if (val === 'twice_daily') {
        if (grpTime2) grpTime2.style.display = 'grid';
        if (grpWeekday) grpWeekday.style.display = 'none';
        if (lblTime1) lblTime1.textContent = 'Première heure (matin) :';
      } else if (val === 'weekly') {
        if (grpTime2) grpTime2.style.display = 'none';
        if (grpWeekday) grpWeekday.style.display = 'grid';
        if (lblTime1) lblTime1.textContent = 'Heure du rappel :';
      } else {
        if (grpTime2) grpTime2.style.display = 'none';
        if (grpWeekday) grpWeekday.style.display = 'none';
        if (lblTime1) lblTime1.textContent = 'Heure quotidienne :';
      }
    }

    updateSummaryDisplay(config);
    populateFormInputs(config);

    selFreq?.addEventListener('change', updateFreqInputsUI);

    btnToggleAdjust?.addEventListener('click', () => {
      if (!panelAdjust) return;
      const isHidden = panelAdjust.style.display === 'none';
      panelAdjust.style.display = isHidden ? 'block' : 'none';
      if (isHidden) populateFormInputs(config);
    });

    btnCancelConfig?.addEventListener('click', () => {
      if (panelAdjust) panelAdjust.style.display = 'none';
    });

    formConfig?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!chkEnabled || !selFreq || !selContent || !time1Input) return;

      const times: string[] = [];
      if (time1Input.value) times.push(time1Input.value);
      if (selFreq.value === 'twice_daily' && time2Input?.value) times.push(time2Input.value);

      const newConfig: ReminderScheduleConfig = {
        enabled: chkEnabled.checked,
        frequency: selFreq.value as any,
        times,
        weekday: weekdayInput ? parseInt(weekdayInput.value, 10) : 1,
        contentType: selContent.value as any,
      };

      const submitBtn = document.getElementById('btn-save-rappels-config') as HTMLButtonElement | null;
      if (submitBtn) submitBtn.disabled = true;

      try {
        await saveUnifiedReminderConfig(newConfig);
        config = newConfig;
        updateSummaryDisplay(config);
        if (panelAdjust) panelAdjust.style.display = 'none';
        await loadAndRenderDbReminders();
      } catch (err: any) {
        alert(err.message || 'Erreur lors de la sauvegarde.');
      } finally {
        if (submitBtn) submitBtn.disabled = false;
      }
    });

    // 2. Afficher la liste des rappels enregistrés dans Supabase
    async function loadAndRenderDbReminders() {
      const container = document.getElementById('db-reminders-list');
      const countEl = document.getElementById('db-reminders-count');
      if (!container) return;

      try {
        const reminders = await fetchUserReminders();
        if (countEl) countEl.textContent = `${reminders.length} rappel${reminders.length > 1 ? 's' : ''}`;

        if (reminders.length === 0) {
          container.innerHTML = '<p class="meta" style="padding: 0.5rem 0;">Aucun rappel individuel spécifique dans votre compte.</p>';
          return;
        }

        container.innerHTML = '';
        reminders.forEach((r) => {
          const row = document.createElement('div');
          row.style.cssText = 'display: flex; justify-content: space-between; align-items: center; padding: 0.65rem 0.85rem; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); gap: 1rem;';
          const timeShort = r.time_of_day.slice(0, 5);

          row.innerHTML = `
            <div style="display: flex; align-items: center; gap: 0.65rem; min-width: 0;">
              <span class="badge" style="font-size: 0.72rem; text-transform: uppercase;">${r.kind}</span>
              <strong style="font-size: 0.9rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">${r.label || 'Rappel'}</strong>
              <span class="meta" style="font-size: 0.82rem;">${timeShort}</span>
            </div>
            <div style="display: flex; align-items: center; gap: 0.5rem;">
              <input type="checkbox" class="chk-db-reminder" ${r.enabled ? 'checked' : ''} title="Activer / Désactiver" />
              <button type="button" class="btn btn--danger btn--sm btn-del-db-reminder" style="font-size: 0.75rem; padding: 0.2rem 0.5rem;">Supprimer</button>
            </div>
          `;

          row.querySelector('.chk-db-reminder')?.addEventListener('change', async (e) => {
            const chk = e.target as HTMLInputElement;
            try {
              if (r.id) await toggleUserReminder(r.id, chk.checked);
            } catch (err: any) {
              alert(err.message || 'Erreur mise à jour');
              chk.checked = !chk.checked;
            }
          });

          row.querySelector('.btn-del-db-reminder')?.addEventListener('click', async () => {
            if (!confirm(`Supprimer le rappel "${r.label}" ?`)) return;
            try {
              if (r.id) await deleteUserReminder(r.id);
              await loadAndRenderDbReminders();
            } catch (err: any) {
              alert(err.message || 'Erreur suppression');
            }
          });

          container.appendChild(row);
        });
      } catch (err) {
        console.warn('Erreur chargement db reminders:', err);
      }
    }

    await loadAndRenderDbReminders();

    // 2. Sélectionner une suggestion aléatoire
    function getRandomContent(): SuggestionItem {
      let pickPhilo = true;
      if (config.contentType === 'philo') pickPhilo = true;
      else if (config.contentType === 'cours') pickPhilo = false;
      else {
        pickPhilo = Math.random() < 0.5;
      }

      if (pickPhilo && textes.length > 0) {
        const item = textes[Math.floor(Math.random() * textes.length)];
        return {
          type: 'philo' as const,
          typeLabel: 'Texte philosophique',
          title: item.title,
          desc: item.author ? `Auteur : ${item.author}` : 'Article philosophique',
          url: item.url,
        };
      } else if (courses.length > 0) {
        const item = courses[Math.floor(Math.random() * courses.length)];
        return {
          type: 'cours' as const,
          typeLabel: 'Support de cours',
          title: item.title,
          desc: 'Matière universitaire & fiches de révision',
          url: item.url,
        };
      } else {
        return {
          type: 'philo' as const,
          typeLabel: 'Bibliothèque',
          title: 'Explorer les textes',
          desc: 'Retrouvez vos lectures et essais',
          url: '/textes/',
        };
      }
    }

    let currentSuggestion = getRandomContent();

    function renderSuggestion() {
      if (sugType) sugType.textContent = currentSuggestion.typeLabel;
      if (sugTitle) sugTitle.textContent = currentSuggestion.title;
      if (sugDesc) sugDesc.textContent = currentSuggestion.desc;
      if (sugLink) sugLink.href = currentSuggestion.url;
    }

    btnRefresh?.addEventListener('click', () => {
      currentSuggestion = getRandomContent();
      renderSuggestion();
    });

    renderSuggestion();

    // 3. Historique des notifications
    function loadHistory(): NotificationLogItem[] {
      return loadPersistentJSON(STORAGE_KEYS.NOTIFICATIONS_HISTORY, []);
    }

    function renderHistory() {
      const history = loadHistory();
      if (!historyList || !historyCount) return;

      historyCount.textContent = `${history.length} notification${history.length > 1 ? 's' : ''}`;

      if (history.length === 0) {
        historyList.innerHTML = '<li class="no-history meta">Aucun rappel déclenché pour le moment.</li>';
        return;
      }

      historyList.innerHTML = history
        .slice(0, 10)
        .map((item) => {
          const date = new Date(item.timestamp);
          const timeStr = date.toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' });
          const dateStr = date.toLocaleDateString('fr-FR', { day: 'numeric', month: 'short' });
          const isPhilo = item.type === 'philo';

          return `
          <li class="history-item">
            <div class="history-time meta">
              <strong>${timeStr}</strong>
              <small>${dateStr}</small>
            </div>
            <div class="history-info">
              <span class="history-badge ${isPhilo ? 'badge-philo' : 'badge-cours'}">
                ${isPhilo ? 'Philo' : 'Cours'}
              </span>
              <a href="${item.url}" class="history-link">${item.title}</a>
            </div>
            <a href="${item.url}" class="meta config-shortcut">Consulter →</a>
          </li>
        `;
        })
        .join('');
    }

    renderHistory();

    // 4. Déclencher un rappel maintenant
    function triggerNotification() {
      const sug = getRandomContent();
      const notificationTitle = sug.type === 'philo' ? `Lecture philosophique : ${sug.title}` : `Révision de cours : ${sug.title}`;
      const notificationBody = sug.desc;

      if ('Notification' in window && Notification.permission === 'granted') {
        const notif = new Notification(notificationTitle, {
          body: notificationBody,
          icon: '/favicon.svg',
        });
        notif.onclick = () => {
          window.open(sug.url, '_blank');
        };
      } else {
        alert(`${notificationTitle}\n\n${notificationBody}\n\nLien : ${window.location.origin}${sug.url}`);
      }

      const history = loadHistory();
      history.unshift({
        id: Math.random().toString(),
        timestamp: Date.now(),
        title: sug.title,
        type: sug.type,
        url: sug.url,
      });
      savePersistentJSON(STORAGE_KEYS.NOTIFICATIONS_HISTORY, history.slice(0, 50));
      renderHistory();
    }

    btnTriggerNow?.addEventListener('click', triggerNotification);

    // 5. Autorisations du navigateur
    function updatePermissionUI() {
      if (!('Notification' in window)) {
        if (statusEl) statusEl.textContent = 'Non supporté par ce navigateur.';
        if (btnReq) (btnReq as HTMLButtonElement).disabled = true;
        return;
      }
      const perm = Notification.permission;
      if (statusEl) {
        if (perm === 'granted') statusEl.textContent = 'Autorisées & actives';
        else if (perm === 'denied') statusEl.textContent = 'Bloquées dans votre navigateur';
        else statusEl.textContent = 'En attente d’autorisation';
      }
      if (btnReq) {
        btnReq.style.display = perm === 'granted' ? 'none' : 'inline-block';
      }
    }

    updatePermissionUI();
    document.getElementById('btn-request-perm')?.addEventListener('click', async () => {
      if ('Notification' in window) {
        await Notification.requestPermission();
        updatePermissionUI();
      }
    });

    // 6. Surveillance récurrente
    setInterval(() => {
      if (!config.enabled) return;
      const now = new Date();
      const currentHHMM = now.toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' });

      if (now.getSeconds() < 15) {
        if (config.frequency === 'weekly') {
          const currentDay = now.getDay() === 0 ? 7 : now.getDay();
          if (currentDay !== config.weekday) return;
        }

        if (config.times && config.times.includes(currentHHMM)) {
          triggerNotification();
        }
      }
    }, 15000);
  }

  if (typeof window !== 'undefined') {
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initRemindersPage);
    } else {
      initRemindersPage();
    }
    document.addEventListener('astro:page-load', initRemindersPage);
  }
</script>

