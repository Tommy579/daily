---
import Base from '../../layouts/Base.astro';
import { getTextes } from '../../utils/textes';
import { getCourses } from '../../utils/courses';

const textes = await getTextes();
const subjects = getCourses();

const serializedTextes = textes.map((t) => ({
  id: t.id,
  title: t.data.title,
  author: t.data.epigraphAuthor || '',
  url: `/textes/${t.id}/`,
}));

const serializedCourses = subjects.map((s) => ({
  id: s.id,
  title: s.name,
  url: `/cours/#folder-${s.id}`,
}));
---

<Base
  title="Rappels & Notifications"
  description="Suivi de vos alertes programmées pour lire un texte philosophique ou réviser un cours."
>
  <div
    class="container reminders-page"
    data-reminders-root
    data-textes={JSON.stringify(serializedTextes)}
    data-courses={JSON.stringify(serializedCourses)}
  >
    <header class="page-header">
      <div class="header-split">
        <div>
          <p class="label"><a href="/dashboard/">Espace de travail</a> / Notifications</p>
          <h1>Rappels automatiques</h1>
          <p class="lede">
            Votre assistant personnel vous invite régulièrement à découvrir un texte philosophique ou à réviser vos cours universitaires.
          </p>
        </div>
        <div class="header-action">
          <a href="/configuration/" class="btn btn-config">
            ⚙️ Modifier les horaires & réglages
          </a>
        </div>
      </div>
    </header>

    <!-- Statut des notifications Web -->
    <div class="permission-banner" data-permission-banner>
      <div class="banner-content">
        <strong id="perm-title">Statut du système d'alerte :</strong>
        <span id="perm-status" class="meta">Vérification...</span>
      </div>
      <button type="button" class="btn btn-primary" id="btn-request-perm">
        Activer les notifications
      </button>
    </div>

    <!-- Carte du planning récurrent actif -->
    <section class="schedule-summary-card">
      <div class="schedule-header">
        <div class="status-indicator">
          <span class="dot-status" id="schedule-dot"></span>
          <h2 class="label" id="schedule-state-title">Programme de rappels actif</h2>
        </div>
        <a href="/configuration/" class="meta config-shortcut">Ajuster dans Configuration →</a>
      </div>

      <div class="schedule-details">
        <div class="detail-block">
          <span class="meta detail-label">Fréquence configurée</span>
          <strong class="detail-value" id="schedule-freq-text">Quotidienne</strong>
        </div>
        <div class="detail-block">
          <span class="meta detail-label">Heures d'envoi</span>
          <strong class="detail-value" id="schedule-times-text">09:00</strong>
        </div>
        <div class="detail-block">
          <span class="meta detail-label">Sélection du support</span>
          <strong class="detail-value" id="schedule-pref-text">Aléatoire (texte philo ou cours)</strong>
        </div>
      </div>

      <div class="schedule-footer">
        <button type="button" class="btn btn-primary" id="btn-trigger-now">
          ✨ Déclencher un rappel maintenant (test)
        </button>
      </div>
    </section>

    <!-- Proposition / Aperçu du prochain contenu aléatoire -->
    <section class="suggestion-section">
      <h2 class="label section-label">Suggestion actuelle de lecture ou révision</h2>
      <div class="suggestion-card" id="suggestion-card">
        <div class="suggestion-type meta" id="sug-type">Philosophie</div>
        <h3 class="suggestion-title" id="sug-title">Chargement...</h3>
        <p class="suggestion-desc meta" id="sug-desc">
          Ce contenu sera automatiquement proposé lors de votre prochaine notification.
        </p>
        <div class="suggestion-actions">
          <a href="#" class="btn btn-primary" id="sug-link">Lire ce contenu maintenant →</a>
          <button type="button" class="btn-subtle" id="btn-refresh-suggestion">Tirer un autre au sort 🎲</button>
        </div>
      </div>
    </section>

    <!-- Historique des notifications envoyées -->
    <section class="history-section">
      <div class="list-header">
        <h2 class="label">Historique des notifications récentes</h2>
        <span class="meta" id="history-count">0 notification</span>
      </div>

      <ul class="history-list" id="history-list" role="list">
        <!-- Rempli en JS -->
      </ul>
    </section>
  </div>
</Base>

<script>
  import {
    STORAGE_KEYS,
    loadPersistentJSON,
    savePersistentJSON,
    type ReminderScheduleConfig,
  } from '../../utils/persistence';

  interface HistoryItem {
    id: string;
    title: string;
    type: 'philo' | 'cours';
    url: string;
    sentAt: string;
  }

  function initRemindersPage() {
    const root = document.querySelector('[data-reminders-root]') as HTMLElement;
    if (!root) return;

    const textes = JSON.parse(root.dataset.textes || '[]');
    const courses = JSON.parse(root.dataset.courses || '[]');

    const scheduleDot = document.getElementById('schedule-dot');
    const scheduleStateTitle = document.getElementById('schedule-state-title');
    const scheduleFreqText = document.getElementById('schedule-freq-text');
    const scheduleTimesText = document.getElementById('schedule-times-text');
    const schedulePrefText = document.getElementById('schedule-pref-text');

    const sugType = document.getElementById('sug-type');
    const sugTitle = document.getElementById('sug-title');
    const sugDesc = document.getElementById('sug-desc');
    const sugLink = document.getElementById('sug-link') as HTMLAnchorElement;
    const btnRefreshSug = document.getElementById('btn-refresh-suggestion');
    const btnTriggerNow = document.getElementById('btn-trigger-now');

    const historyList = document.getElementById('history-list');
    const historyCount = document.getElementById('history-count');

    const defaultSchedule: ReminderScheduleConfig = {
      enabled: true,
      frequency: 'daily',
      contentPreference: 'random',
      times: ['09:00'],
      weekDay: 1,
    };

    const config = loadPersistentJSON<ReminderScheduleConfig>(
      STORAGE_KEYS.REMINDERS_CONFIG,
      defaultSchedule
    );

    let history: HistoryItem[] = loadPersistentJSON<HistoryItem[]>(STORAGE_KEYS.REMINDERS, []);

    // 1. Mise à jour de l'affichage du planning
    if (config.enabled) {
      if (scheduleDot) scheduleDot.className = 'dot-status dot-active';
      if (scheduleStateTitle) scheduleStateTitle.textContent = 'Programme automatique activé';
    } else {
      if (scheduleDot) scheduleDot.className = 'dot-status dot-inactive';
      if (scheduleStateTitle) scheduleStateTitle.textContent = 'Programme automatique en pause';
    }

    if (scheduleFreqText) {
      if (config.frequency === 'twice_daily') scheduleFreqText.textContent = 'Pluri-quotidienne (2x par jour)';
      else if (config.frequency === 'weekly') scheduleFreqText.textContent = 'Hebdomadaire (1x par semaine)';
      else scheduleFreqText.textContent = 'Quotidienne (1x par jour)';
    }

    if (scheduleTimesText) {
      scheduleTimesText.textContent = config.times?.join(' et ') || '09:00';
    }

    if (schedulePrefText) {
      if (config.contentPreference === 'philo') schedulePrefText.textContent = 'Textes philosophiques uniquement';
      else if (config.contentPreference === 'cours') schedulePrefText.textContent = 'Supports de cours uniquement';
      else schedulePrefText.textContent = 'Aléatoire (texte philo ou cours)';
    }

    // 2. Gestion de la pioche aléatoire de contenu
    function getRandomContent(preference: 'random' | 'philo' | 'cours' = config.contentPreference) {
      let pickPhilo = true;
      if (preference === 'philo') {
        pickPhilo = true;
      } else if (preference === 'cours') {
        pickPhilo = false;
      } else {
        pickPhilo = Math.random() < 0.5;
      }

      if (pickPhilo && textes.length > 0) {
        const item = textes[Math.floor(Math.random() * textes.length)];
        return {
          type: 'philo' as const,
          typeLabel: '📖 Texte philosophique',
          title: item.title,
          desc: item.author ? `Auteur : ${item.author}` : 'Article philosophique',
          url: item.url,
        };
      } else if (courses.length > 0) {
        const item = courses[Math.floor(Math.random() * courses.length)];
        return {
          type: 'cours' as const,
          typeLabel: '📂 Support de cours',
          title: item.title,
          desc: 'Matière universitaire & fiches de révision',
          url: item.url,
        };
      } else {
        return {
          type: 'philo' as const,
          typeLabel: '📖 Espace de travail',
          title: 'Explorer la bibliothèque',
          desc: 'Retrouvez vos textes et cours de philosophie',
          url: '/textes/',
        };
      }
    }

    let currentSuggestion = getRandomContent();

    function renderSuggestion() {
      if (sugType) sugType.textContent = currentSuggestion.typeLabel;
      if (sugTitle) sugTitle.textContent = currentSuggestion.title;
      if (sugDesc) sugDesc.textContent = currentSuggestion.desc;
      if (sugLink) sugLink.href = currentSuggestion.url;
    }

    renderSuggestion();

    btnRefreshSug?.addEventListener('click', () => {
      currentSuggestion = getRandomContent();
      renderSuggestion();
    });

    // 3. Déclenchement de notification
    function triggerNotification(contentItem = getRandomContent()) {
      if (!('Notification' in window)) {
        alert("Les notifications ne sont pas supportées par votre navigateur.");
        return;
      }

      if (Notification.permission !== 'granted') {
        Notification.requestPermission().then((perm) => {
          if (perm === 'granted') {
            sendNotification(contentItem);
          }
        });
      } else {
        sendNotification(contentItem);
      }
    }

    function sendNotification(contentItem: ReturnType<typeof getRandomContent>) {
      const notif = new Notification(`Marges — Rappel d'étude`, {
        body: `C'est le moment : découvrez "${contentItem.title}" (${contentItem.typeLabel})`,
        icon: '/favicon.svg',
      });

      notif.onclick = () => {
        window.focus();
        window.location.href = contentItem.url;
      };

      // Sauvegarde dans l'historique
      const newHistoryItem: HistoryItem = {
        id: 'hist-' + Date.now(),
        title: contentItem.title,
        type: contentItem.type,
        url: contentItem.url,
        sentAt: new Date().toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' }),
      };

      history.unshift(newHistoryItem);
      if (history.length > 20) history.pop();
      savePersistentJSON(STORAGE_KEYS.REMINDERS, history);
      renderHistory();
    }

    btnTriggerNow?.addEventListener('click', () => {
      triggerNotification(currentSuggestion);
    });

    // 4. Historique
    function renderHistory() {
      if (!historyList) return;
      if (historyCount) historyCount.textContent = `${history.length} notification${history.length > 1 ? 's' : ''}`;

      if (history.length === 0) {
        historyList.innerHTML = '<li class="no-history meta">Aucun rappel déclenché récemment. Le système enverra automatiquement le prochain à l\'heure prévue.</li>';
        return;
      }

      historyList.innerHTML = history
        .map(
          (item) => `
        <li class="history-item">
          <div class="history-time meta">${item.sentAt}</div>
          <div class="history-info">
            <span class="history-badge ${item.type === 'philo' ? 'badge-philo' : 'badge-cours'}">
              ${item.type === 'philo' ? 'Texte philo' : 'Cours'}
            </span>
            <strong>${item.title}</strong>
          </div>
          <a href="${item.url}" class="meta history-link">Consulter →</a>
        </li>
      `
        )
        .join('');
    }

    renderHistory();

    // 5. Statut permissions
    function updatePermissionUI() {
      const statusEl = document.getElementById('perm-status');
      const btnReq = document.getElementById('btn-request-perm');
      if (!('Notification' in window)) {
        if (statusEl) statusEl.textContent = 'Non supporté par ce navigateur.';
        if (btnReq) (btnReq as HTMLButtonElement).disabled = true;
        return;
      }
      const perm = Notification.permission;
      if (statusEl) {
        if (perm === 'granted') statusEl.textContent = 'Autorisées & actives ✅';
        else if (perm === 'denied') statusEl.textContent = 'Bloquées dans votre navigateur ❌';
        else statusEl.textContent = 'En attente d’autorisation ⚠️';
      }
      if (btnReq) {
        btnReq.style.display = perm === 'granted' ? 'none' : 'inline-block';
      }
    }

    updatePermissionUI();
    document.getElementById('btn-request-perm')?.addEventListener('click', async () => {
      if ('Notification' in window) {
        await Notification.requestPermission();
        updatePermissionUI();
      }
    });

    // 6. Surveillance en arrière-plan des heures prévues (comparaison HH:MM)
    let lastCheckedMinute = '';
    setInterval(() => {
      if (!config.enabled) return;
      const now = new Date();
      const currentHHMM = now.toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' });

      if (currentHHMM !== lastCheckedMinute) {
        lastCheckedMinute = currentHHMM;

        if (config.frequency === 'weekly') {
          const currentDay = now.getDay();
          if (config.weekDay !== undefined && currentDay !== config.weekDay) {
            return;
          }
        }

        if (config.times && config.times.includes(currentHHMM)) {
          triggerNotification();
        }
      }
    }, 15000);
  }

  document.addEventListener('astro:page-load', initRemindersPage);
</script>

<style>
  .reminders-page {
    padding-bottom: 5rem;
  }
  .header-split {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .btn-config {
    text-decoration: none;
    font-size: 0.9rem;
  }
  .permission-banner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: var(--soft);
    border-radius: var(--radius);
    padding: 1.25rem 1.5rem;
    margin-bottom: 2.5rem;
    border-left: 3px solid var(--fg);
  }

  /* Carte de planification */
  .schedule-summary-card {
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.75rem;
    margin-bottom: 3rem;
  }
  .schedule-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--line);
    padding-bottom: 1rem;
    margin-bottom: 1.5rem;
  }
  .status-indicator {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .dot-status {
    width: 9px;
    height: 9px;
    border-radius: 50%;
  }
  .dot-active {
    background: #10b981;
  }
  .dot-inactive {
    background: #9ca3af;
  }
  .config-shortcut {
    color: var(--muted);
    text-decoration: underline;
    font-size: 0.85rem;
  }
  .config-shortcut:hover {
    color: var(--fg);
  }
  .schedule-details {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.5rem;
    margin-bottom: 1.75rem;
  }
  .detail-block {
    display: grid;
    gap: 0.25rem;
  }
  .detail-label {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .detail-value {
    font-size: 1.15rem;
  }
  .schedule-footer {
    display: flex;
    gap: 1rem;
    align-items: center;
  }

  /* Carte suggestion */
  .section-label {
    margin-bottom: 1rem;
  }
  .suggestion-section {
    margin-bottom: 3.5rem;
  }
  .suggestion-card {
    background: var(--soft);
    border-radius: var(--radius);
    padding: 1.75rem;
    border: 1px solid var(--line);
  }
  .suggestion-type {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
  }
  .suggestion-title {
    margin: 0 0 0.5rem;
    font-size: 1.4rem;
  }
  .suggestion-desc {
    margin: 0 0 1.5rem;
  }
  .suggestion-actions {
    display: flex;
    gap: 1rem;
    align-items: center;
    flex-wrap: wrap;
  }

  /* Historique */
  .history-section {
    border-top: 1px solid var(--line);
    padding-top: 2rem;
  }
  .list-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 1.25rem;
  }
  .history-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }
  .history-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.25rem;
    background: var(--soft);
    border-radius: var(--radius);
    gap: 1rem;
  }
  .history-time {
    width: 60px;
    flex: none;
  }
  .history-info {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .history-badge {
    font-size: 0.75rem;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    font-family: var(--font-ui);
  }
  .badge-philo {
    background: rgba(59, 130, 246, 0.15);
    color: #2563eb;
  }
  .badge-cours {
    background: rgba(16, 185, 129, 0.15);
    color: #059669;
  }
  .history-link {
    color: var(--fg);
    text-decoration: underline;
  }
  .no-history {
    font-style: italic;
    padding: 2rem 0;
    text-align: center;
  }

  /* Boutons */
  .btn {
    padding: 0.6rem 1.25rem;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--bg);
    cursor: pointer;
    font-family: var(--font-ui);
    font-size: 0.9rem;
    transition: all 0.15s ease;
    display: inline-flex;
    align-items: center;
  }
  .btn-primary {
    background: var(--fg);
    color: var(--bg);
    border-color: var(--fg);
  }
  .btn-primary:hover {
    opacity: 0.85;
  }
  .btn-subtle {
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 0.55rem 0.9rem;
    font-size: 0.85rem;
    cursor: pointer;
  }
  .btn-subtle:hover {
    border-color: var(--fg);
  }

  @media (max-width: 40rem) {
    .header-split {
      flex-direction: column;
      align-items: flex-start;
    }
    .history-item {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
