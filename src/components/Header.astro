---
import ThemeToggle from './ThemeToggle.astro';
import { SITE } from '../consts';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isTextes = path.startsWith('/textes') || path.startsWith('/themes');
const isCours = path.startsWith('/cours');
const isEmploi = path.startsWith('/emploi-du-temps');
const isRappels = path.startsWith('/rappels');
const isDashboard = path.startsWith('/dashboard');
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label={`${SITE.title} — accueil`} aria-current={path === '/' ? 'page' : undefined}>
      {SITE.title}
    </a>
    <nav class="nav" aria-label="Navigation principale">
      <a href="/dashboard/" aria-current={isDashboard ? 'page' : undefined}>Espace</a>
      <span class="dot" aria-hidden="true">·</span>
      <a href="/textes/" aria-current={isTextes ? 'page' : undefined}>Textes</a>
      <span class="dot" aria-hidden="true">·</span>
      <a href="/emploi-du-temps/" aria-current={isEmploi ? 'page' : undefined}>Emploi du temps</a>
      <span class="dot" aria-hidden="true">·</span>
      <a href="/cours/" aria-current={isCours ? 'page' : undefined}>Cours</a>
      <span class="dot" aria-hidden="true">·</span>
      <a href="/rappels/" aria-current={isRappels ? 'page' : undefined}>Rappels</a>
      <span class="dot" aria-hidden="true">·</span>
      <ThemeToggle />
    </nav>
  </div>
</header>

<style>
  .site-header {
    padding-block: 1.6rem;
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .brand {
    font-family: var(--font-text);
    font-size: 1.2rem;
    font-weight: 650;
    letter-spacing: -.01em;
    text-decoration: none;
    font-style: italic;
  }
  .brand:hover { text-decoration: none; opacity: .7; }

  .nav {
    display: flex;
    align-items: center;
    gap: .55rem;
    font-family: var(--font-ui);
    font-size: .9rem;
    flex-wrap: wrap;
  }
  .nav a {
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
    color: var(--muted);
    transition: color .15s ease, text-decoration-color .15s ease;
  }
  .nav a:hover { color: var(--fg); text-decoration-color: currentColor; }
  .nav a[aria-current='page'] { color: var(--fg); text-decoration-color: currentColor; font-weight: 500; }

  .dot { color: var(--muted); opacity: .6; }
</style>
