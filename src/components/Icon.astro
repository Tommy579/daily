---
/**
 * Jeu d'icônes linéaires cohérent (trait 1.75, 24×24) — remplace les emojis
 * hétérogènes de l'interface. Décoratives par défaut (aria-hidden).
 */
export type IconName =
  | 'calendar'
  | 'folder'
  | 'bell'
  | 'settings'
  | 'book'
  | 'file'
  | 'code'
  | 'clock'
  | 'pin'
  | 'arrow-right'
  | 'chevron-down'
  | 'search'
  | 'refresh'
  | 'sparkle'
  | 'database'
  | 'sun'
  | 'user'
  | 'plus'
  | 'trash'
  | 'edit'
  | 'check'
  | 'log-out'
  | 'palette'
  | 'layout'
  | 'list'
  | 'heading'
  | 'check-square'
  | 'quote'
  | 'tag'
  | 'download'
  | 'columns'
  | 'maximize'
  | 'minimize';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

