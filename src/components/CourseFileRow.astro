---
import Icon from './Icon.astro';
import { formatFileSize, type CourseFile } from '../utils/courses';

interface Props {
  file: CourseFile;
}
const { file } = Astro.props;
const ext = file.ext ? file.ext.replace('.', '').toUpperCase() : 'BIN';
const icon = file.type === 'code' ? 'code' : 'file';
---

<li class="file-row" data-file-name={file.name.toLowerCase()}>
  <a href={file.viewerUrl} class="file-link">
    <span class={`file-icon file-icon--${file.type}`}><Icon name={icon} size={16} /></span>
    <span class="file-name">{file.name}</span>
    <span class="file-ext">{ext}</span>
    <span class="file-size">{formatFileSize(file.size)}</span>
  </a>
</li>

<style>
  .file-link {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto 4.5rem;
    align-items: center;
    gap: .75rem;
    padding: .55rem .75rem;
    border-radius: var(--r-sm);
    text-decoration: none;
    font-size: .9rem;
    transition: background-color .12s ease;
  }
  .file-link:hover { background: var(--soft); text-decoration: none; }
  .file-icon {
    display: grid;
    place-items: center;
    width: 1.9rem;
    height: 1.9rem;
    border-radius: var(--r-sm);
    background: var(--soft);
    color: var(--muted);
  }
  .file-icon--pdf { color: var(--danger); background: color-mix(in srgb, var(--danger) 10%, transparent); }
  .file-icon--code { color: var(--accent); background: color-mix(in srgb, var(--accent) 10%, transparent); }
  .file-icon--text { color: var(--success); background: color-mix(in srgb, var(--success) 10%, transparent); }
  .file-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 500; }
  .file-ext {
    font-size: .68rem;
    font-weight: 600;
    letter-spacing: .06em;
    color: var(--muted);
    padding: .1rem .4rem;
    border: 1px solid var(--line);
    border-radius: 4px;
  }
  .file-size { font-size: .8rem; color: var(--muted); text-align: right; font-variant-numeric: tabular-nums; }

  @media (max-width: 34rem) {
    .file-link { grid-template-columns: auto minmax(0, 1fr) auto; }
    .file-size { display: none; }
  }
</style>
