---
import Icon from './Icon.astro';
---

<dialog class="panel course-modal" id="modal-manage-course">
  <div class="modal-inner">
    <header class="modal-header">
      <div>
        <span class="label">Gestion des cours</span>
        <h2 class="modal-title">Ajouter ou classer des cours</h2>
      </div>
      <button type="button" class="btn-close" id="btn-close-course-modal" aria-label="Fermer">✕</button>
    </header>

    <!-- Onglets : Nouvelle Matière / Nouveau Document -->
    <div class="modal-tabs" role="tablist">
      <button type="button" class="modal-tab active" data-tab="tab-subject" role="tab" aria-selected="true">
        <Icon name="folder" size={15} />
        Nouvelle Matière
      </button>
      <button type="button" class="modal-tab" data-tab="tab-file" role="tab" aria-selected="false">
        <Icon name="file" size={15} />
        Importer un Fichier
      </button>
      <button type="button" class="modal-tab" data-tab="tab-folder" role="tab" aria-selected="false">
        <Icon name="folder" size={15} />
        Importer un Dossier
      </button>
      <button type="button" class="modal-tab" data-tab="tab-note" role="tab" aria-selected="false">
        <Icon name="edit" size={15} />
        Rédiger un Cours (Markdown)
      </button>
    </div>

    <!-- 1. Formulaire : Créer une matière -->
    <form id="form-create-subject" class="modal-tab-panel active" data-panel="tab-subject">
      <p class="meta tab-desc">
        Créez un nouveau répertoire de matière ou d'unité d'enseignement (ex : « Philosophie contemporaine », « Logique formelle »).
      </p>

      <div class="form-group">
        <label for="new-subject-name" class="field-label">Nom de la matière :</label>
        <input
          type="text"
          id="new-subject-name"
          placeholder="ex : Philosophie des sciences"
          required
          autocomplete="off"
        />
      </div>

      <div class="form-group">
        <label class="field-label">Sous-dossiers par défaut créés automatiquement :</label>
        <div class="preset-subfolders">
          <label class="tag-check">
            <input type="checkbox" id="preset-cm" checked />
            <span>CM (Cours Magistral)</span>
          </label>
          <label class="tag-check">
            <input type="checkbox" id="preset-td" checked />
            <span>TD (Travaux Dirigés)</span>
          </label>
          <label class="tag-check">
            <input type="checkbox" id="preset-revisions" checked />
            <span>Fiches de révisions</span>
          </label>
        </div>
      </div>

      <div class="modal-actions">
        <button type="button" class="btn btn--sm" id="btn-cancel-subject">Annuler</button>
        <button type="submit" class="btn btn--primary btn--sm">Créer la matière</button>
      </div>
    </form>

    <!-- 2. Formulaire : Importer / Classer un fichier de cours -->
    <form id="form-upload-file" class="modal-tab-panel" data-panel="tab-file">
      <p class="meta tab-desc">
        Importez un support (PDF, DOCX, C, Scilab, Markdown...) et classez-le directement dans la matière et la catégorie de votre choix.
      </p>

      <div class="form-group">
        <label for="select-target-subject" class="field-label">Matière de rattachement :</label>
        <select id="select-target-subject" required>
          <option value="" disabled selected>Sélectionner une matière...</option>
        </select>
      </div>

      <div class="form-group">
        <label for="select-target-folder" class="field-label">Catégorie / Dossier :</label>
        <select id="select-target-folder">
          <option value="">Documents racines (Général)</option>
          <option value="CM">CM (Cours Magistral)</option>
          <option value="TD">TD (Travaux Dirigés)</option>
          <option value="Fiches de révisions">Fiches de révisions</option>
          <option value="__custom__">+ Créer un nouveau sous-dossier...</option>
        </select>
      </div>

      <div class="form-group" id="group-custom-folder" style="display: none;">
        <label for="input-custom-folder" class="field-label">Nom du nouveau sous-dossier :</label>
        <input
          type="text"
          id="input-custom-folder"
          placeholder="ex : TP, Projet Scilab, Partiels blancs"
        />
      </div>

      <div class="form-group">
        <label for="course-file-input" class="field-label">Fichier à importer :</label>
        <input
          type="file"
          id="course-file-input"
          accept=".pdf,.doc,.docx,.odt,.txt,.md,.c,.h,.cpp,.m,.sci,.sce,.py,.sh"
          required
        />
        <span class="help-text meta">Formats pris en charge : PDF, Word/Doc, Texte, Code C/Scilab. Le fichier sera sauvegardé directement dans votre dossier de cours.</span>
      </div>

      <div class="modal-actions">
        <button type="button" class="btn btn--sm" id="btn-cancel-file">Annuler</button>
        <button type="submit" class="btn btn--primary btn--sm">Importer et répertorier</button>
      </div>
    </form>

    <!-- 2b. Formulaire : Importer un dossier complet -->
    <div id="panel-import-folder" class="modal-tab-panel" data-panel="tab-folder">
      <p class="meta tab-desc">
        Importez un dossier entier depuis votre machine (avec ses matières, sous-dossiers CM, TD et fichiers PDF). L'arborescence sera automatiquement structurée et tous les fichiers PDF pourront être lus instantanément dans le lecteur.
      </p>

      <div class="form-group">
        <label for="course-folder-input" class="field-label">Dossier de cours à importer :</label>
        <input
          type="file"
          id="course-folder-input"
          {...{ webkitdirectory: '', directory: '' }}
          multiple
          class="input-file"
        />
        <span class="help-text meta">Tous les documents PDF et supports détectés seront sauvegardés dans votre mémoire locale sécurisée pour lecture immédiate.</span>
      </div>

      <div id="folder-import-status" class="meta" style="display: none; padding: 0.5rem 0; font-weight: 500; color: var(--accent);"></div>

      <div class="modal-actions">
        <button type="button" class="btn btn--sm" id="btn-cancel-folder">Annuler</button>
        <button type="button" class="btn btn--primary btn--sm" id="btn-start-folder-import">Lancer l'importation</button>
      </div>
    </div>

    <!-- 3. Formulaire : Rédiger un cours / note en Markdown -->
    <form id="form-create-note" class="modal-tab-panel" data-panel="tab-note">
      <p class="meta tab-desc">
        Rédigez directement vos notes ou fiches de révisions en Markdown. Elles seront stockées de manière privée dans votre base de données Supabase.
      </p>

      <div class="form-group">
        <label for="select-note-subject" class="field-label">Matière :</label>
        <select id="select-note-subject" required>
          <option value="" disabled selected>Sélectionner une matière...</option>
        </select>
      </div>

      <div class="form-group">
        <label for="select-note-folder" class="field-label">Catégorie :</label>
        <select id="select-note-folder">
          <option value="CM">CM (Cours Magistral)</option>
          <option value="TD">TD (Travaux Dirigés)</option>
          <option value="Fiches de révisions" selected>Fiches de révisions</option>
          <option value="Documents racines">Général</option>
        </select>
      </div>

      <div class="form-group">
        <label for="note-title-input" class="field-label">Titre du cours / de la note :</label>
        <input
          type="text"
          id="note-title-input"
          placeholder="ex : Séance 2 — La Critique de la Raison Pure"
          required
        />
      </div>

      <div class="form-group">
        <label for="note-body-input" class="field-label">Contenu (Markdown) :</label>
        <textarea
          id="note-body-input"
          rows="8"
          placeholder="Rédigez ici vos notes (# Titre, **gras**, listes, citations...)"
          required
        ></textarea>
      </div>

      <div class="modal-actions">
        <button type="button" class="btn btn--sm" id="btn-cancel-note">Annuler</button>
        <button type="submit" class="btn btn--primary btn--sm">Enregistrer dans Supabase</button>
      </div>
    </form>
  </div>
</dialog>

<style>
  .course-modal {
    border-radius: var(--radius);
    padding: 0;
    max-width: 540px;
    width: min(calc(100vw - 1.5rem), 540px);
    max-height: calc(100dvh - 2rem);
    overflow-y: auto;
    margin: auto;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--fg);
    box-shadow: var(--shadow-md);
  }
  .course-modal::backdrop {
    background: rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }
  .modal-inner {
    padding: clamp(1rem, 0.75rem + 1vw, 1.75rem);
    display: grid;
    gap: 1.25rem;
  }
  .modal-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--line);
  }
  .modal-title {
    margin: 0.2rem 0 0;
    font-family: var(--font-text);
    font-size: 1.35rem;
    letter-spacing: -.02em;
  }
  .btn-close {
    background: none;
    border: none;
    color: var(--muted);
    font-size: 1.2rem;
    cursor: pointer;
    line-height: 1;
    padding: 0.2rem;
    border-radius: 4px;
    transition: color .15s ease;
  }
  .btn-close:hover {
    color: var(--fg);
  }

  .modal-tabs {
    display: flex;
    gap: 0.4rem;
    border-bottom: 1px solid var(--line);
    padding-bottom: 0.5rem;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    flex-wrap: nowrap;
  }
  .modal-tabs::-webkit-scrollbar { display: none; }
  .modal-tab {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.75rem;
    border-radius: var(--r-sm);
    background: transparent;
    border: 1px solid transparent;
    color: var(--muted);
    font-family: var(--font-ui);
    font-size: 0.85rem;
    font-weight: 500;
    cursor: pointer;
    white-space: nowrap;
    flex-shrink: 0;
    transition: all .15s ease;
  }
  .modal-tab:hover {
    color: var(--fg);
    background: var(--soft);
  }
  .modal-tab.active {
    background: var(--soft);
    color: var(--fg);
    border-color: var(--line);
    font-weight: 600;
  }

  .modal-tab-panel {
    display: none;
    grid-gap: 1.25rem;
  }
  .modal-tab-panel.active {
    display: grid;
  }
  .tab-desc {
    margin: 0;
    font-size: 0.86rem;
    line-height: 1.5;
  }

  .form-group {
    display: grid;
    gap: 0.4rem;
  }
  .field-label {
    font-family: var(--font-ui);
    font-size: 0.85rem;
    font-weight: 600;
  }
  .modal-tab-panel input[type="text"],
  .modal-tab-panel input[type="file"],
  .modal-tab-panel select {
    padding: 0.6rem 0.8rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg);
    color: var(--fg);
    font-family: inherit;
    font-size: 0.92rem;
    transition: border-color .15s ease;
  }
  .modal-tab-panel input:focus,
  .modal-tab-panel select:focus {
    border-color: var(--fg);
    outline: none;
  }

  .preset-subfolders {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.2rem;
  }
  .tag-check {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.65rem;
    background: var(--soft);
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 0.8rem;
    cursor: pointer;
  }

  .help-text {
    font-size: 0.78rem;
    line-height: 1.4;
  }

  .modal-actions {
    display: flex;
    justify-content: flex-end;
    gap: 0.6rem;
    margin-top: 0.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
    flex-wrap: wrap;
  }
  @media (max-width: 30rem) {
    .modal-actions {
      flex-direction: column;
      align-items: stretch;
    }
    .modal-actions .btn {
      width: 100%;
    }
  }
</style>
