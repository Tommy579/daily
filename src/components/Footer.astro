---
import { SITE } from '../consts';
import { url } from '../utils/url';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container container--wide footer-inner">
    <div class="footer-brand">
      <a href={url('/')} class="footer-title">{SITE.title}</a>
      <p class="footer-motto">Sans publicité, sans traçage, sans algorithme.</p>
    </div>
    <nav class="footer-links" aria-label="Liens secondaires">
      <a href={url('/textes/')}>Textes</a>
      <a href={url('/themes/')}>Thèmes</a>
      <a href={url('/emploi-du-temps/')}>Emploi du temps</a>
      <a href={url('/cours/')}>Cours</a>
      <a href={url('/rappels/')}>Rappels</a>
      <a href={url('/configuration/')}>Configuration</a>
      <a href={url('/rss.xml')}>RSS</a>
      <a href={url('/mentions-legales/')}>Mentions légales</a>
      <a href={`mailto:${SITE.email}`}>Contact</a>
    </nav>
    <p class="footer-copy">
      © {year} {SITE.title} · Textes sous licence
      <a href={SITE.license.url} rel="license noopener" target="_blank">{SITE.license.name}</a>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 5rem;
    border-top: 1px solid var(--line);
    font-family: var(--font-ui);
    font-size: .84rem;
    color: var(--muted);
  }
  .footer-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1.25rem 2rem;
    padding-block: 2.25rem 2.5rem;
  }
  .footer-title {
    font-family: var(--font-text);
    font-style: italic;
    font-weight: 650;
    font-size: 1.05rem;
    color: var(--fg);
    text-decoration: none;
  }
  .footer-motto { margin: .25rem 0 0; }
  .footer-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    align-content: start;
    gap: .35rem 1.1rem;
    max-width: 34rem;
  }
  .footer-links a { color: var(--muted); text-decoration: none; }
  .footer-links a:hover { color: var(--fg); }
  .footer-copy { grid-column: 1 / -1; margin: 0; font-size: .78rem; }
  .footer-copy a { color: inherit; }

  @media (max-width: 40rem) {
    .footer-inner { grid-template-columns: 1fr; }
    .footer-links { justify-content: flex-start; }
  }
</style>
